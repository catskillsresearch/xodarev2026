module

public import StochLean.Probability.Martingale.Convergence.ContinuousL1Limit

/-! # A closing variable and its actual terminal projection

A closing variable need not be measurable in the sigma-field generated by
the filtration. The actual limit is its conditional expectation onto that
sigma-field, not the arbitrary closing variable itself. The integer-time
Levy upward theorem identifies the limit; full-time UI convergence supplies
the separate whole-half-line convergence assertion.
-/

@[expose] public section

open ProbabilityTheory Filter
open scoped NNReal ENNReal Topology

namespace MeasureTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
  {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Y Z : Ω → ℝ}

theorem ae_eq_condExp_iSup_of_closing_limit
    (hclose : ∀ t, X t =ᵐ[P] P[Y | F t])
    (hlim : ∀ᵐ ω ∂P, Tendsto (fun t : ℝ≥0 ↦ X t ω) atTop (𝓝 (Z ω))) :
    Z =ᵐ[P] P[Y | ⨆ t, F t] := by
  let e : ℕ → ℝ≥0 := Nat.cast
  have he : Monotone e := fun _ _ h ↦ Nat.cast_le.mpr h
  let G := F.reindex e he
  have hsup : (⨆ n, G n) = ⨆ t, F t := by
    apply le_antisymm
    · exact iSup_le fun n ↦ le_iSup (fun t ↦ F t) (e n)
    · apply iSup_le
      intro t
      obtain ⟨n, hn⟩ := exists_nat_ge t
      exact (F.mono hn).trans (le_iSup (fun n ↦ G n) n)
  have hY := tendsto_ae_condExp (ℱ := G) (μ := P) Y
  have hN : ∀ᵐ ω ∂P, ∀ n : ℕ, X (e n) ω = P[Y | F (e n)] ω :=
    eventually_countable_forall.mpr (fun n ↦ hclose (e n))
  filter_upwards [hlim, hY, hN] with ω hω hYω hNω
  have hZn : Tendsto (fun n : ℕ ↦ X (e n) ω) atTop (𝓝 (Z ω)) :=
    hω.comp tendsto_natCast_atTop_atTop
  have hYn : Tendsto (fun n : ℕ ↦ X (e n) ω) atTop
      (𝓝 (P[Y | ⨆ n, G n] ω)) := hYω.congr (fun n ↦ (hNω n).symm)
  simpa only [hsup] using tendsto_nhds_unique hZn hYn

/-- The arbitrary-closing-variable martingale assertion of Protter I.10:
the full-time limit is the terminal sigma-field projection of that variable.
The statement also gives L1 convergence and closure by the actual limit. -/
theorem Martingale.tendsto_terminalProjection_of_integrable_closing
    (hX : Martingale X F P) (hc : HasRightContinuousPaths X P) (hY : Integrable Y P)
    (hclose : ∀ t, X t =ᵐ[P] P[Y | F t]) :
    (∀ᵐ ω ∂P, Tendsto (fun t : ℝ≥0 ↦ X t ω) atTop (𝓝 (P[Y | ⨆ t, F t] ω))) ∧
      Tendsto (fun t : ℝ≥0 ↦ eLpNorm (X t - P[Y | ⨆ t, F t]) 1 P) atTop (𝓝 0) ∧
      (∀ t, X t =ᵐ[P] P[P[Y | ⨆ t, F t] | F t]) := by
  obtain ⟨Z, _, hlim, hL, hZclose⟩ := hX.exists_integrable_limit_of_uniformIntegrable hc
    (Martingale.uniformIntegrable_of_integrable_closing hY hclose)
  have he := ae_eq_condExp_iSup_of_closing_limit hclose hlim
  refine ⟨?_, ?_, ?_⟩
  · filter_upwards [hlim, he] with ω hω heω
    rwa [heω] at hω
  · exact hL.congr' (Eventually.of_forall fun _ ↦
      eLpNorm_congr_ae (EventuallyEq.rfl.sub he))
  · intro t
    exact (hZclose t).trans (condExp_congr_ae he)

end MeasureTheory
