module

public import StochLean.Probability.Process.Stopping.AfterCoefficient

/-! # Cadlag and optional generators of the finite stopped sigma-field

Protter I.6 is a finite-stopping-time theorem. The everywhere-cadlag identity
requires no usual conditions. Its source almost-sure-cadlag version uses
initial completeness through an indistinguishable optional version; exceptional
sample paths are not implicitly declared optional.
-/

@[expose] public section

open MeasureTheory Set
open scoped NNReal

namespace ProbabilityTheory.FiniteStoppingTime

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}

/-- Protter I.6 with everywhere-cadlag generators and the native stopped field. -/
theorem measurableSpace_eq_iSup_comap_cadlag (τ : FiniteStoppingTime F) :
    τ.measurableSpace = ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : Adapted F X)
      (_ : ∀ ω, IsCadlagPath (fun t ↦ X t ω)),
      MeasurableSpace.comap (fun ω ↦ X (τ ω) ω) inferInstance := by
  classical
  apply le_antisymm
  · intro A hA
    let Z : Ω → ℝ := A.indicator (fun _ ↦ 1)
    let X : ℝ≥0 → Ω → ℝ := fun t ↦ {ω | τ.withTop ω ≤ t}.indicator Z
    have hz : StronglyMeasurable[τ.isStoppingTime.measurableSpace] Z :=
      (measurable_const.indicator hA).stronglyMeasurable
    have ha : Adapted F X :=
      fun t ↦ (hz.indicator_stoppingTime_le τ.isStoppingTime t).measurable
    have hc : ∀ ω, IsCadlagPath (fun t ↦ X t ω) :=
      isCadlagPath_indicator_lifetime_le τ.withTop Z
    have hle : MeasurableSpace.comap (fun ω ↦ X (τ ω) ω) inferInstance ≤
        ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : Adapted F X)
          (_ : ∀ ω, IsCadlagPath (fun t ↦ X t ω)),
          MeasurableSpace.comap (fun ω ↦ X (τ ω) ω) inferInstance :=
      le_iSup_of_le X (le_iSup_of_le ha (le_iSup_of_le hc le_rfl))
    have hm := hle _ (comap_measurable (fun ω ↦ X (τ ω) ω) (measurableSet_singleton (1 : ℝ)))
    convert hm using 1
    ext ω
    change ω ∈ A ↔ X (τ ω) ω = 1
    have he : X (τ ω) ω = Z ω :=
      Set.indicator_of_mem (s := {u | τ.withTop u ≤ (τ ω : WithTop ℝ≥0)})
        (show τ.withTop ω ≤ (τ ω : WithTop ℝ≥0) from le_rfl) Z
    rw [he]
    simp [Z]
  · refine iSup_le fun X ↦ iSup_le fun ha ↦ iSup_le fun hc ↦ ?_
    have hm := (ha.isStronglyOptional_of_cadlag hc).stronglyMeasurable_finiteStoppingTime τ
    exact hm.measurable.comap_le

/-- All optional real samples generate the same stopped field. -/
theorem measurableSpace_eq_iSup_comap_optional (τ : FiniteStoppingTime F) :
    τ.measurableSpace = ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsStronglyOptional F X),
      MeasurableSpace.comap (fun ω ↦ X (τ ω) ω) inferInstance := by
  apply le_antisymm
  · rw [τ.measurableSpace_eq_iSup_comap_cadlag]
    refine iSup_le fun X ↦ iSup_le fun ha ↦ iSup_le fun hc ↦ ?_
    exact le_iSup_of_le X (le_iSup_of_le (ha.isStronglyOptional_of_cadlag hc) le_rfl)
  · refine iSup_le fun X ↦ iSup_le fun hX ↦ ?_
    exact (hX.stronglyMeasurable_finiteStoppingTime τ).measurable.comap_le

end ProbabilityTheory.FiniteStoppingTime

namespace MeasureTheory.IsStoppingTime

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
  {τ : Ω → WithTop ℝ≥0}

/-- The native stopped field at an arbitrary lifetime is generated by optional
samples with explicit terminal-filtration-measurable values at infinity. -/
theorem measurableSpace_eq_iSup_comap_optional_terminal (hτ : IsStoppingTime F τ) :
    hτ.measurableSpace = ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsStronglyOptional F X)
      (Z : Ω → ℝ) (_ : StronglyMeasurable[⨆ t, F t] Z),
      MeasurableSpace.comap (stoppedValueWithTerminal X Z τ) inferInstance := by
  classical
  apply le_antisymm
  · intro A hA
    let Z : Ω → ℝ := A.indicator (fun _ ↦ 1)
    let X : ℝ≥0 → Ω → ℝ := fun t ↦ {ω | τ ω ≤ (t : WithTop ℝ≥0)}.indicator Z
    have hz : StronglyMeasurable[hτ.measurableSpace] Z :=
      (measurable_const.indicator hA).stronglyMeasurable
    have hz' : StronglyMeasurable[⨆ t, F t] Z := hz.mono hτ.measurableSpace_le'
    have hx : IsStronglyOptional F X := hz.isStronglyOptional_indicator_stoppingTime_le hτ
    have hle : MeasurableSpace.comap (stoppedValueWithTerminal X Z τ) inferInstance ≤
        ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsStronglyOptional F X)
          (Z : Ω → ℝ) (_ : StronglyMeasurable[⨆ t, F t] Z),
          MeasurableSpace.comap (stoppedValueWithTerminal X Z τ) inferInstance :=
      le_iSup_of_le X (le_iSup_of_le hx (le_iSup_of_le Z (le_iSup_of_le hz' le_rfl)))
    have hm := hle _ (comap_measurable (stoppedValueWithTerminal X Z τ)
      (measurableSet_singleton (1 : ℝ)))
    have he : stoppedValueWithTerminal X Z τ = Z := by
      funext ω
      by_cases ht : τ ω = ⊤
      · exact stoppedValueWithTerminal_of_top ht
      · rw [stoppedValueWithTerminal_of_ne_top ht]
        change {u | τ u ≤ ((τ ω).untopA : WithTop ℝ≥0)}.indicator Z ω = Z ω
        apply Set.indicator_of_mem
        change τ ω ≤ ((τ ω).untopA : WithTop ℝ≥0)
        rw [WithTop.untopA_eq_untop ht, WithTop.coe_untop]
    rw [he] at hm
    convert hm using 1
    ext ω
    simp [Z]
  · refine iSup_le fun X ↦ iSup_le fun hX ↦ iSup_le fun Z ↦ iSup_le fun hZ ↦ ?_
    exact (hX.stronglyMeasurable_stoppedValueWithTerminal hZ hτ).measurable.comap_le

end MeasureTheory.IsStoppingTime

namespace MeasureTheory.Adapted

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
  {P : Measure Ω} {X : ℝ≥0 → Ω → ℝ}

theorem measurable_finiteStoppingTime_of_hasCadlagPaths (ha : Adapted F X)
    (hF : F.IsUsual P) (hc : ProbabilityTheory.HasCadlagPaths X P)
    (τ : ProbabilityTheory.FiniteStoppingTime F) :
    Measurable[τ.measurableSpace] (fun ω ↦ X (τ ω) ω) := by
  obtain ⟨Y, hXY, hY, _⟩ := ha.exists_optional_indistinguishable_of_usual hF hc
  have hcomplete : IsCompleteSubMeasurableSpace P τ.measurableSpace := by
    intro A hA
    exact (τ.isStoppingTime.le_measurableSpace_of_const_le fun _ ↦ bot_le) A
      (hF.complete_initial A hA)
  refine hcomplete.measurable_congr_ae
    (hY.stronglyMeasurable_finiteStoppingTime τ).measurable ?_
  filter_upwards [hXY] with ω hω
  exact (hω (τ ω)).symm

end MeasureTheory.Adapted

namespace ProbabilityTheory.FiniteStoppingTime

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ} {P : Measure Ω}

/-- Protter I.6 with the source almost-sure cadlag convention. -/
theorem measurableSpace_eq_iSup_comap_hasCadlagPaths (τ : FiniteStoppingTime F)
    (hF : F.IsUsual P) :
    τ.measurableSpace = ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : Adapted F X) (_ : HasCadlagPaths X P),
      MeasurableSpace.comap (fun ω ↦ X (τ ω) ω) inferInstance := by
  apply le_antisymm
  · rw [τ.measurableSpace_eq_iSup_comap_cadlag]
    refine iSup_le fun X ↦ iSup_le fun ha ↦ iSup_le fun hc ↦ ?_
    exact le_iSup_of_le X (le_iSup_of_le ha
      (le_iSup_of_le (Filter.Eventually.of_forall hc : HasCadlagPaths X P) le_rfl))
  · refine iSup_le fun X ↦ iSup_le fun ha ↦ iSup_le fun hc ↦ ?_
    exact (ha.measurable_finiteStoppingTime_of_hasCadlagPaths hF hc τ).comap_le

end ProbabilityTheory.FiniteStoppingTime
