module

public import StochLean.Probability.Independence.OrderedPast
public import Mathlib.Probability.Process.Adapted
public import Mathlib.Data.Finset.Sort
public import Mathlib.Algebra.BigOperators.Intervals

/-! # The whole finite future vector is independent of the past

If an adapted real process has each future increment independent of the
entire filtration at its left endpoint, then any finite vector of future
increments is independent of that past filtration.

For a true ordered grid, the past field itself is the zeroth member of a
family of measurable spaces. Subsequent members are generated by actual
adjacent increments. Each is independent of a field containing all preceding
members, so the existing ordered-past theorem proves joint independence.
The native disjoint-supremum theorem separates the original past from the
whole increment family, not merely from one coordinate at a time.

Sorting the requested finite lags and applying actual telescoping partial
sums then recovers the desired vector. No stationarity, zero initial value,
path regularity, additional filtration completion, or supplied joint-law
certificate is assumed.
-/

@[expose] public section

open MeasureTheory Set
open scoped NNReal

namespace ProbabilityTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
  [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}

private theorem indep_ordered_future_grid
    (ha : Adapted F X)
    (hi : ∀ s t, s ≤ t → Indep (F s)
      (MeasurableSpace.comap (fun ω ↦ X t ω - X s ω) inferInstance) P)
    (s : ℝ≥0) (v : ℕ → ℝ≥0) (hv : Monotone v) :
    Indep (F s) (MeasurableSpace.comap
      (fun ω j ↦ X (s + v (j + 1)) ω - X (s + v j) ω) inferInstance) P := by
  let D : ℕ → Ω → ℝ := fun j ω ↦ X (s + v (j + 1)) ω - X (s + v j) ω
  let m : ℕ → MeasurableSpace Ω
    | 0 => F s
    | j + 1 => MeasurableSpace.comap (D j) inferInstance
  let n : ℕ → MeasurableSpace Ω
    | 0 => ⊥
    | j + 1 => F (s + v j)
  have hprev : ∀ i j, i < j → m i ≤ n j := by
    intro i j hij
    cases j with
    | zero => omega
    | succ j =>
        cases i with
        | zero =>
            change F s ≤ F (s + v j)
            exact F.mono (le_add_of_nonneg_right (show 0 ≤ v j from bot_le))
        | succ i =>
            change MeasurableSpace.comap (D i) inferInstance ≤ F (s + v j)
            have hend : s + v (i + 1) ≤ s + v j :=
              add_le_add le_rfl (hv (by omega : i + 1 ≤ j))
            have hstart : s + v i ≤ s + v j :=
              add_le_add le_rfl (hv (by omega : i ≤ j))
            exact ((ha.measurable_le hend).sub (ha.measurable_le hstart)).comap_le
  have hstep : ∀ j, Indep (n j) (m j) P := by
    intro j
    cases j with
    | zero => exact indep_bot_left (F s)
    | succ j => exact hi _ _ (add_le_add le_rfl (hv (Nat.le_succ j)))
  have hjoint : iIndep m P := iIndep_of_indep_previous hprev hstep
  have hm : ∀ j, m j ≤ mΩ := by
    intro j
    cases j with
    | zero => exact F.le s
    | succ j => exact (ha.measurable.sub ha.measurable).comap_le
  let mFuture : MeasurableSpace Ω := ⨆ j ∈ Ioi (0 : ℕ), m j
  have hsplit : Indep (F s) mFuture P := by
    have hdis : Disjoint ({0} : Set ℕ) (Ioi 0) := by
      apply Set.disjoint_left.mpr
      intro j hj hpos
      exact (lt_irrefl 0) ((mem_singleton_iff.mp hj) ▸ hpos)
    simpa only [mem_singleton_iff, iSup_iSup_eq_left] using
      indep_iSup_of_disjoint hm hjoint hdis
  have hD (j : ℕ) : Measurable[mFuture] (D j) :=
    Measurable.of_comap_le
      (le_iSup_of_le (j + 1) (le_iSup_of_le (Nat.zero_lt_succ j) le_rfl))
  have hvector : Measurable[mFuture] (fun ω j ↦ D j ω) :=
    measurable_pi_iff.mpr hD
  exact indep_of_indep_of_le_right hsplit hvector.comap_le

/-- Entire finite future-increment vectors are independent of the past field
when each actual increment is independent of its own full past filtration.
Coordinatewise independence alone is not used as a joint conclusion. -/
theorem indep_finite_future_of_indep_increment {I : Type*} [Finite I]
    (ha : Adapted F X)
    (hi : ∀ s t, s ≤ t → Indep (F s)
      (MeasurableSpace.comap (fun ω ↦ X t ω - X s ω) inferInstance) P)
    (s : ℝ≥0) (t : I → ℝ≥0) :
    Indep (F s) (MeasurableSpace.comap
      (fun ω i ↦ X (s + t i) ω - X s ω) inferInstance) P := by
  classical
  let := Fintype.ofFinite I
  let S : Finset ℝ≥0 := insert 0 (Finset.univ.image t)
  have hzero : 0 ∈ S := Finset.mem_insert_self _ _
  have hSne : S.Nonempty := ⟨0, hzero⟩
  obtain ⟨k, hcard⟩ := Nat.exists_eq_succ_of_ne_zero
    (ne_of_gt (Finset.card_pos.mpr hSne))
  let e : Fin (k + 1) ↪o ℝ≥0 := S.orderEmbOfFin hcard
  let v : ℕ → ℝ≥0 := fun j ↦ e ⟨min j k, Nat.lt_succ_of_le (min_le_right j k)⟩
  have hv : Monotone v := fun i j hij ↦ e.monotone (min_le_min_right k hij)
  have hv0 : v 0 = 0 := by
    simp only [v, Nat.zero_min]
    rw [show e ⟨0, Nat.lt_succ_of_le (min_le_right 0 k)⟩ = S.min' hSne from
      Finset.orderEmbOfFin_zero hcard (Nat.succ_pos k)]
    exact le_antisymm (S.min'_le 0 hzero) bot_le
  have htmem (i : I) : t i ∈ S :=
    Finset.mem_insert_of_mem (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩)
  let idx : I → Fin (k + 1) := fun i ↦ (S.orderIsoOfFin hcard).symm ⟨t i, htmem i⟩
  have hidx (i : I) : v (idx i) = t i := by
    simp only [v, min_eq_left (Nat.le_of_lt_succ (idx i).isLt)]
    exact congrArg Subtype.val ((S.orderIsoOfFin hcard).apply_symm_apply ⟨t i, htmem i⟩)
  let Y : Ω → ℕ → ℝ := fun ω j ↦ X (s + v (j + 1)) ω - X (s + v j) ω
  let Φ : (ℕ → ℝ) → I → ℝ := fun y i ↦ ∑ j ∈ Finset.range (idx i).val, y j
  have hΦ : Measurable Φ :=
    measurable_pi_iff.mpr fun i ↦
      Finset.measurable_sum _ fun _ _ ↦ measurable_pi_apply _
  have hcompose : Measurable[MeasurableSpace.comap Y inferInstance] (Φ ∘ Y) :=
    hΦ.comp (comap_measurable Y)
  have hresult := indep_of_indep_of_le_right
    (indep_ordered_future_grid ha hi s v hv) hcompose.comap_le
  have hrecover : Φ ∘ Y = (fun ω i ↦ X (s + t i) ω - X s ω) := by
    funext ω i
    change (∑ j ∈ Finset.range (idx i).val,
      (X (s + v (j + 1)) ω - X (s + v j) ω)) = _
    rw [Finset.sum_range_sub (fun j ↦ X (s + v j) ω) (idx i).val,
      hidx, hv0, add_zero]
  rw [hrecover] at hresult
  exact hresult

end ProbabilityTheory
