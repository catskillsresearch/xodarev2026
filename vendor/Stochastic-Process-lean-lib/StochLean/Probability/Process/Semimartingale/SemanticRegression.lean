open ProbabilityTheory

/-- A source representation with a completely irrelevant, potentially unbounded coefficient. -/
def emptyIntervalRep {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ)
    (Z : Ω → ℝ) (hZ : Measurable[F 0] Z) : SimplePredictableRep F where
  partition := StoppingTimePartition.deterministic F (TimePartition.single 0)
  initial := 0
  measurable_initial := by exact measurable_const
  coefficient := fun _ ↦ Z
  measurable_coefficient := by
    intro i
    fin_cases i
    change Measurable[(isStoppingTime_const F 0).measurableSpace] Z
    rw [IsStoppingTime.measurableSpace_const]
    exact hZ

theorem emptyIntervalRep_toProcess {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (Z : Ω → ℝ) (hZ : Measurable[F 0] Z) :
    (emptyIntervalRep F Z hZ).toProcess = 0 := by
  funext t ω
  by_cases ht : t = 0 <;>
    simp [emptyIntervalRep, SimplePredictableRep.toProcess, StoppingTimePartition.deterministic,
      TimePartition.single, ht]

/-- A zero simple process has zero integral even when its unused coefficient has no bound. -/
theorem emptyIntervalRep_integral {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (Z : Ω → ℝ) (hZ : Measurable[F 0] Z) (X : ℝ≥0 → Ω → ℝ) :
    (emptyIntervalRep F Z hZ).integral X = 0 := by
  rw [(emptyIntervalRep F Z hZ).integral_congr (SimplePredictableRep.zero F)
    ((emptyIntervalRep_toProcess F Z hZ).trans (SimplePredictableRep.toProcess_zeroRep F).symm) X,
    SimplePredictableRep.integral_zero]

/-- A coefficient on an empty cell needs no bound or integrability even in the
martingale-preservation theorem for bounded simple processes. -/
theorem emptyIntervalRep_integral_martingale {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] (F : Filtration ℝ≥0 mΩ)
    [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : Martingale X F P) (hF : F.IsUsual P) (hr : HasRightContinuousPaths X P)
    (Z : Ω → ℝ) (hZ : Measurable[F 0] Z) :
    Martingale ((emptyIntervalRep F Z hZ).integralProcess X) F P := by
  apply (emptyIntervalRep F Z hZ).martingale_integralProcess hX hF hr 0
  intro t ω
  rw [emptyIntervalRep_toProcess]
  simp

/-- The source continuous-local example has no unmasked initial-integrability premise. -/
theorem continuous_local_is_semimartingale {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P) :
    IsSemimartingale X F P := hX.isSemimartingale hF

/-- Increment-only sums vanish for every constant integrator, even with nonzero initial value. -/
theorem leftRiemannSum_constant_integrator {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (π : StoppingTimePartition F) (Y : ℝ≥0 → Ω → ℝ) (Z : Ω → ℝ) :
    π.leftRiemannSumProcess Y (fun _ ↦ Z) = 0 := by
  funext t ω
  simp [StoppingTimePartition.leftRiemannSumProcess]

open Filter Set in
open scoped Topology in
/-- A jump strictly inside a cell produces a unit sampling discrepancy, however
small the cell is. Finer meshes alone do not justify a UCP integrand approximation. -/
theorem leftSample_jump_inside_cell {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (π : StoppingTimePartition F) (ω : Ω) (i : Fin π.size)
    {c t : ℝ≥0} (hl : π.point i.castSucc ω < c) (hct : c < t)
    (hr : t ≤ π.point i.succ ω) :
    let Y := fun u (_ : Ω) ↦ if c ≤ u then (1 : ℝ) else 0
    ‖π.leftSampleProcess Y t ω - leftLimitProcess Y t ω‖ = 1 := by
  dsimp only
  have ht0 : t ≠ 0 := ne_of_gt ((show (0 : ℝ≥0) ≤ c from bot_le).trans_lt hct)
  have hlim : leftLimitProcess (fun u (_ : Ω) ↦ if c ≤ u then (1 : ℝ) else 0) t ω = 1 := by
    let : (𝓝[<] t).NeBot := nhdsLT_neBot_of_exists_lt ⟨c, hct⟩
    rw [leftLimitProcess, if_neg ht0]
    apply leftLim_eq_of_tendsto
    apply tendsto_const_nhds.congr'
    filter_upwards [nhdsWithin_le_nhds (Ioi_mem_nhds hct)] with u hu
    exact (if_pos (show c ≤ u from hu.le)).symm
  rw [hlim]
  change ‖(π.path ω).leftStep (fun u ↦ if c ≤ u then (1 : ℝ) else 0) t - 1‖ = 1
  rw [(π.path ω).leftStep_eq_of_mem_cell _ ⟨hl.trans hct, hr⟩]
  change ‖(if c ≤ π.point i.castSucc ω then (1 : ℝ) else 0) - 1‖ = 1
  rw [if_neg (not_le_of_gt hl)]
  norm_num

/-- At an existing initial endpoint, strict projection advances to the first
positive endpoint. Ordinary ceiling projection would incorrectly stay at zero. -/
theorem strictCeiling_single_zero {T : ℝ≥0} (hT : 0 < T) :
    (TimePartition.single T).strictCeilingPoint 0 = T := by
  let π := TimePartition.single T
  have hi : π.left (0 : Fin 1) < T ∧ T ≤ π.right (0 : Fin 1) := ⟨hT, le_rfl⟩
  have hn : ¬ π.strictCeilingPoint 0 < T := by
    rw [π.strictCeilingPoint_lt_iff_of_mem_cell hi]
    exact lt_irrefl 0
  exact le_antisymm (π.strictCeilingPoint_le_horizon 0) (le_of_not_gt hn)

/-- A pure initial spike contributes a first-cell increment before the mesh
limit. Dropping it from the exact sampled formula is not valid. -/
theorem leftRiemannSum_initial_spike_single {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (T : ℝ≥0) (Z : Ω → ℝ) (X : ℝ≥0 → Ω → ℝ) :
    (StoppingTimePartition.deterministic F (TimePartition.single T)).leftRiemannSumProcess
      (fun u ω ↦ if u = 0 then Z ω else 0) X =
        fun t ω ↦ Z ω * (X (min T t) ω - X 0 ω) := by
  funext t ω
  change (∑ i : Fin 1, (if (![0, T] : Fin 2 → ℝ≥0) i.castSucc = 0 then Z ω else 0) *
    (X (min ((![0, T] : Fin 2 → ℝ≥0) i.succ) t) ω -
      X (min ((![0, T] : Fin 2 → ℝ≥0) i.castSucc) t) ω)) = _
  rw [Fin.sum_univ_one]
  simp

/-- The cadlag theorem integrates the source left limit, whose initial value
is zero even when neither original initial random variable is integrable. -/
theorem cadlag_riemann_limit_initial_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (ha : Adapted F Y) (hr : HasCadlagPaths Y P) :
    hX.stochasticIntegral hF (ha.leftLimitProcess_of_usual hF hr)
      hr.hasCagladPaths_leftLimitProcess 0 =ᵐ[P] 0 := by
  filter_upwards [hX.stochasticIntegral_zero_ae hF
    (ha.leftLimitProcess_of_usual hF hr) hr.hasCagladPaths_leftLimitProcess] with ω hω
  simpa only [leftLimitProcess_zero, Pi.zero_apply, zero_mul] using hω

/-- Raw square sums of a constant path retain its initial square, regardless
of measurability, integrability, partition size or repeated endpoints. -/
theorem rawSquareSum_constant_integrator {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (π : StoppingTimePartition F) (Z : Ω → ℝ) :
    π.quadraticVariationSumProcess (fun _ ↦ Z) = fun _ ω ↦ (Z ω) ^ 2 := by
  funext t ω
  simp [StoppingTimePartition.quadraticVariationSumProcess]

/-- Zero stopping is not zero normalization: the stopped raw bracket still
contains the original initial square. -/
theorem quadraticVariation_stopped_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    Indistinguishable
      ((hX.stoppedProcess hF (isStoppingTime_const F 0)).quadraticVariation hF)
      (fun _ ω ↦ (X 0 ω) ^ 2) P := by
  filter_upwards [hX.quadraticVariation_stoppedProcess hF (isStoppingTime_const F 0),
    hX.quadraticVariation_zero_ae hF] with ω hs h0 t
  apply (hs t).trans
  change hX.quadraticVariation hF (min (t : WithTop ℝ≥0) 0).untopA ω = _
  rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ t from bot_le)]
  exact h0

/-- A constant first path annihilates every mixed increment, but not the
initial product. No moment or measurability assumption is needed. -/
theorem rawCrossSum_constant_left {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (π : StoppingTimePartition F) (Z : Ω → ℝ)
    (Y : ℝ≥0 → Ω → ℝ) :
    π.quadraticCovariationSumProcess (fun _ ↦ Z) Y = fun _ ω ↦ Z ω * Y 0 ω := by
  funext t ω
  simp [StoppingTimePartition.quadraticCovariationSumProcess, StochLean.covariationSum,
    TimePartition.increment]

/-- Even continuous linear paths refute the proposed exact finite-sum
single-argument stopping identity when the stop lies inside a cell. -/
theorem mixed_increment_single_cell_one_stop_counterexample :
    covariationSum (TimePartition.single 2)
      (fun u ↦ ((min u 1 : ℝ≥0) : ℝ)) (fun u ↦ (u : ℝ)) = 2 ∧
    covariationSum (TimePartition.single 2)
      (fun u ↦ ((min u 1 : ℝ≥0) : ℝ)) (fun u ↦ ((min u 1 : ℝ≥0) : ℝ)) = 1 := by
  constructor <;> rw [covariationSum_single] <;> norm_num

/-- The extended-valued weighted theorem still forces a zero mixed integral
when one energy vanishes, even when the other energy may be infinite. -/
theorem weightedCovariation_zero_energy {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {μ ν ξ : Measure Ω} [SigmaFinite μ] [SigmaFinite ν] [SigmaFinite ξ]
    (h : ∀ r : ℝ≥0, (2 * r) • μ ≤ (r ^ 2) • ν + ξ)
    {f g : Ω → ℝ≥0∞} (hf : Measurable f) (hg : Measurable g)
    (hz : (∫⁻ ω, (f ω) ^ 2 ∂ν) = 0) : (∫⁻ ω, f ω * g ω ∂μ) = 0 := by
  have hbound := lintegral_mul_le_of_quadratic_measure_domination h hf hg
  simpa [hz] using hbound

/-- The Stieltjes realization used for KW is an increment measure. Its lack
of an initial atom does not change the raw bracket's initial product. -/
theorem bracketStieltjes_initial_atom_zero (B : StieltjesFunction ℝ≥0) :
    B.measure {0} = 0 := variationStieltjes_measure_zero B

/-- Stopping only the first argument at zero retains the original initial
product, regardless of the initial variables' integrability. -/
theorem quadraticCovariation_stopped_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P)
    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P) :
    Indistinguishable
      ((hX.stoppedProcess hF (isStoppingTime_const F 0)).quadraticCovariation hY hF)
      (fun _ ω ↦ X 0 ω * Y 0 ω) P := by
  filter_upwards [hX.quadraticCovariation_stoppedProcess_left hY hF (isStoppingTime_const F 0),
    hX.quadraticCovariation_zero_ae hY hF] with ω hs h0 t
  apply (hs t).trans
  change hX.quadraticCovariation hY hF (min (t : WithTop ℝ≥0) 0).untopA ω = _
  rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ t from bot_le)]
  exact h0

/-- A mixed raw-bracket integral retains the initial product, even without
integrability of either initial random variable. -/
theorem raw_mixed_bracket_integral_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y H : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P)
    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCagladPaths H P) :
    (hX.isSemimartingale_quadraticCovariation hY hF).stochasticIntegral hF ha hr 0 =ᵐ[P]
      fun ω ↦ H 0 ω * (X 0 ω * Y 0 ω) := by
  filter_upwards [
    (hX.isSemimartingale_quadraticCovariation hY hF).stochasticIntegral_zero_ae hF ha hr,
    hX.quadraticCovariation_zero_ae hY hF]
      with ω hi hq
  exact hi.trans (congrArg (fun z ↦ H 0 ω * z) hq)

/-- The vector closure theorem covers the empty-coordinate edge case. -/
theorem empty_coordinate_transform_isSemimartingale {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : Fin 0 → ℝ≥0 → Ω → ℝ} {f : (Fin 0 → ℝ) → ℝ}
    (hF : F.IsUsual P) (hf : ContDiff ℝ 2 f) :
    IsSemimartingale (fun t ω ↦ f (fun i ↦ X i t ω)) F P :=
  isSemimartingale_contDiff_comp_finiteCoordinates (fun i ↦ Fin.elim0 i) hF hf

/-- Both ordered off-diagonal Hessian terms are needed before multiplying
by one half. Keeping only one triangular mixed term gives the wrong answer. -/
theorem ordered_offDiagonal_taylor_terms :
    (1 / 2 : ℝ) * (∑ i : Fin 2, ∑ j : Fin 2,
      (if i = j then (0 : ℝ) else 1) * (![2, 3] : Fin 2 → ℝ) i *
        (![2, 3] : Fin 2 → ℝ) j) = 6 := by
  norm_num [Fin.sum_univ_two]

/-- Replacing continuous covariation by the raw bracket would already give
a spurious initial value of three for the constant pair (3, 2). -/
theorem fiskStratonovich_raw_initial_correction_counterexample
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let h3 := isSemimartingale_const_initial (F := F) (P := P)
      (Z := fun _ ↦ (3 : ℝ)) measurable_const
    let h2 := isSemimartingale_const_initial (F := F) (P := P)
      (Z := fun _ ↦ (2 : ℝ)) measurable_const
    ∀ᵐ ω ∂P, h3.fiskStratonovichIntegral h2 hF 0 ω = 0 ∧
      (1 / 2 : ℝ) * h2.quadraticCovariation h3 hF 0 ω = 3 := by
  dsimp only
  let h3 := isSemimartingale_const_initial (F := F) (P := P)
    (Z := fun _ ↦ (3 : ℝ)) measurable_const
  let h2 := isSemimartingale_const_initial (F := F) (P := P)
    (Z := fun _ ↦ (2 : ℝ)) measurable_const
  filter_upwards [h3.fiskStratonovichIntegral_zero_ae h2 hF,
    h2.quadraticCovariation_zero_ae h3 hF] with ω h0 hraw
  exact ⟨h0, by rw [hraw]; norm_num⟩

/-- Even a quadratic transformation has a nonzero first-order jump
correction. Stratonovich's continuous-path chain rule cannot drop it. -/
theorem quadratic_first_order_jump_correction :
    (1 : ℝ) ^ 2 - (0 : ℝ) ^ 2 - deriv (fun x : ℝ ↦ x ^ 2) 0 * (1 - 0) = 1 := by
  norm_num [deriv_pow]

/-- The complex source left limit is zero at zero, not the initial complex value. -/
theorem complex_source_initial_left_limit :
    complexLeftLimitProcess (fun (_ : ℝ≥0) (_ : Unit) ↦ (⟨3, 2⟩ : ℂ)) 0 () = 0 := by
  simp only [complexLeftLimitProcess_zero, Pi.zero_apply]

/-- The imaginary-imaginary Hessian entry for the real part of z squared
is negative, unlike the positive energy bracket with complex conjugation. -/
theorem complex_quadratic_imaginary_hessian :
    coordinateSecondDeriv (fun x : Fin 2 → ℝ ↦ (complexCoordinates x ^ 2).re)
      1 1 0 = -2 := by
  have hf : Differentiable ℂ (fun z : ℂ ↦ z ^ 2) := by fun_prop
  have hd : deriv (fun z : ℂ ↦ z ^ 2) = fun z ↦ 2 * z := by funext z; simp
  change coordinateSecondDeriv
    (fun x ↦ Complex.reCLM ((fun z : ℂ ↦ z ^ 2) (complexCoordinates x))) 1 1 0 = -2
  rw [coordinateSecondDeriv_complex_component hf, hd]
  norm_num

/-- A zero product factor does not erase the mixed Hessian entries. -/
theorem exponential_product_zero_factor_mixed_hessian :
    coordinateSecondDeriv exponentialProductCoordinates 0 1 0 = 1 ∧
      coordinateSecondDeriv exponentialProductCoordinates 1 0 0 = 1 := by
  simp [coordinateSecondDeriv_exponentialProductCoordinates]

/-- The general equation keeps exp(X(0)); its integral starts at zero even
without any moment assumption on the random initial value. -/
theorem stochastic_exponential_equation_zero_initial_integral
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    let hE := hX.isSemimartingale_stochasticExponential hF
    ∀ᵐ ω ∂P, hX.stochasticIntegral hF
      (hE.adapted.leftLimitProcess_of_usual hF hE.hasCadlagPaths)
      hE.hasCadlagPaths.hasCagladPaths_leftLimitProcess 0 ω = 0 := by
  dsimp only
  filter_upwards [hX.stochasticExponential_sub_initial_eq_integral hF] with ω he
  simpa only [IsSemimartingale.stochasticExponential_zero, sub_self] using (he 0).symm

/-- At constant initial coordinates one and two, omitting the raw bracket's
initial product changes exp(5) into exp(3). -/
theorem exponential_product_raw_initial_correction_nontrivial :
    Real.exp ((1 : ℝ) + 2 + 1 * 2) ≠ Real.exp 1 * Real.exp 2 := by
  rw [← Real.exp_add]
  intro h
  have he := Real.exp_injective h
  norm_num at he

/-- The product formula retains an absorbing minus-one jump even when the
other coordinate jumps at the same instant. -/
theorem exponential_product_absorbing_jump (v : ℝ) :
    exponentialJumpFactor ((-1 : ℝ) + v + (-1) * v) = 0 := by
  rw [exponentialJumpFactor_add_add_mul, exponentialJumpFactor_neg_one, zero_mul, zero_mul]

/-- The raw-bracket inverse formula is false without its zero-initial
guard, already for the constant process one. -/
theorem exponential_inverse_raw_initial_guard_essential :
    Real.exp ((-1 : ℝ) + 1 ^ 2) ≠ (Real.exp 1)⁻¹ := by
  rw [← Real.exp_neg]
  intro h
  have he := Real.exp_injective h
  norm_num at he

/-- The initial characteristic phase has unit norm without X(0)=0 or
any integrability hypothesis on X(0). -/
theorem characteristic_exponential_initial_norm
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (u : ℝ) (ω : Ω) :
    ‖hX.characteristicExponential hF u 0 ω‖ = 1 := by
  rw [hX.norm_characteristicExponential, hX.continuousQuadraticVariation_zero,
    mul_zero, Real.exp_zero]

/-- The imaginary coefficient makes the compensating real drift positive. -/
theorem characteristic_exponential_compensation_sign (x : ℝ) :
    ‖Complex.exp (⟨(1 / 2 : ℝ), x⟩ : ℂ)‖ = Real.exp (1 / 2) :=
  Complex.norm_exp _

/-- Zero frequency gives the constant one process, including time zero. -/
theorem characteristic_exponential_zero_frequency
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (t : ℝ≥0) (ω : Ω) :
    hX.characteristicExponential hF 0 t ω = 1 := by
  simp only [IsSemimartingale.characteristicExponential, IsSemimartingale.characteristicExponent,
    complexProcess, zero_pow (by decide : 2 ≠ 0), mul_zero, zero_mul]
  exact Complex.exp_zero

/-- Levy's increment law includes a repeated endpoint and the actual zero
variance Gaussian, rather than silently requiring strictly ordered times. -/
theorem levy_zero_length_increment_law
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (hq : Indistinguishable ((hM.isSemimartingale hF).continuousQuadraticVariation hF)
      (fun t _ ↦ (t : ℝ)) P) (t : ℝ≥0) :
    HasLaw (fun ω ↦ X t ω - X t ω) (Measure.dirac 0) P := by
  simpa using hM.hasLaw_gaussian_increment_of_bracket_eq_time hF hq (s := t) le_rfl

/-- Initial shifts must not be accepted by the Brownian owner merely because
the continuous bracket ignores them. -/
theorem levy_nonzero_initial_not_brownian
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {X : ℝ≥0 → Ω → ℝ} {c : ℝ} (hc : c ≠ 0) (h0 : X 0 =ᵐ[P] fun _ ↦ c) :
    ¬ IsBrownianReal X P := by
  intro hB
  have hf : ∀ᵐ ω ∂P, False := by
    filter_upwards [h0, hB.eval_zero_ae_eq_zero] with ω hx hz
    exact hc (hx.symm.trans hz)
  exact (Filter.Eventually.exists hf).elim (fun _ h ↦ h)

/-- Revealing every future observation at time zero destroys the Brownian
martingale property; the filtration clause in Levy's equivalence is essential. -/
theorem levy_fullInformation_filtration_rejected
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {X : ℝ≥0 → Ω → ℝ} (hB : IsBrownianReal X P) :
    ¬ Martingale X (Filtration.const ℝ≥0 mΩ le_rfl) P :=
  hB.toIsPreBrownianReal.not_martingale_fullInformation

/-- A flat deterministic bracket interval has the genuine Dirac increment
law; no positive-variance premise may be added. -/
theorem deterministic_bracket_flat_interval_law
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {q : ℝ≥0 → ℝ}
    (hM : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (hq : Indistinguishable ((hM.isSemimartingale hF).continuousQuadraticVariation hF)
      (fun t _ ↦ q t) P) {s t : ℝ≥0} (hst : s ≤ t) (hflat : q t = q s) :
    HasLaw (fun ω ↦ X t ω - X s ω) (Measure.dirac 0) P := by
  simpa only [hflat, sub_self, Real.toNNReal_zero, gaussianReal_zero_var] using
    hM.hasLaw_gaussian_increment_of_deterministic_bracket hF hq hst

/-- The finite-projection law permits an empty coordinate family and does
not normalize by a possibly zero coefficient norm. -/
theorem levy_empty_projection_law
    {ι Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ι → ℝ≥0 → Ω → ℝ}
    (hX : ∀ i, IsContinuousLocalMartingale (X i) F P) (hF : F.IsUsual P) (a : ι → ℝ)
    (hd : ∀ i, Indistinguishable
      (((hX i).isSemimartingale hF).continuousQuadraticVariation hF) (fun t _ ↦ (t : ℝ)) P)
    (ho : ∀ i j, i ≠ j → Indistinguishable
      (((hX i).isSemimartingale hF).continuousQuadraticCovariation
        ((hX j).isSemimartingale hF) hF) 0 P) {s t : ℝ≥0} (hst : s ≤ t) :
    HasLaw (fun ω ↦ ∑ i ∈ (∅ : Finset ι), a i * (X i t ω - X i s ω)) (Measure.dirac 0) P := by
  simpa using hasLaw_gaussian_linearCombination_increment_of_orthogonal ∅ hX hF a hd ho hst

/-- Repeating one coordinate retains both ordered cross terms, giving
four times its bracket, not twice. -/
theorem continuous_bracket_repeated_coordinate_sum
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    Indistinguishable ((isSemimartingale_finset_linearCombination Finset.univ
      (fun _ : Fin 2 ↦ hX) (fun _ ↦ 1)).continuousQuadraticVariation hF)
      (fun t ω ↦ 4 * hX.continuousQuadraticVariation hF t ω) P := by
  filter_upwards [continuousQuadraticVariation_finset_linearCombination Finset.univ
    (fun _ : Fin 2 ↦ hX) hF (fun _ ↦ 1), hX.continuousQuadraticCovariation_self hF]
    with ω hq hc t
  rw [hq t]
  simp only [Fin.sum_univ_two, one_mul, hc t]
  ring

/-- The joint increment law includes repeated endpoints and a genuine zero
random vector, with no nondegenerate covariance premise. -/
theorem levy_vector_zero_length_increment
    {ι Ω : Type*} [Fintype ι] {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ι → ℝ≥0 → Ω → ℝ}
    (hX : ∀ i, IsContinuousLocalMartingale (X i) F P) (hF : F.IsUsual P)
    (hd : ∀ i, Indistinguishable
      (((hX i).isSemimartingale hF).continuousQuadraticVariation hF) (fun t _ ↦ (t : ℝ)) P)
    (ho : ∀ i j, i ≠ j → Indistinguishable
      (((hX i).isSemimartingale hF).continuousQuadraticCovariation
        ((hX j).isSemimartingale hF) hF) 0 P) (t : ℝ≥0) :
    HasLaw (fun _ : Ω ↦ (0 : EuclideanSpace ℝ ι))
      ((Measure.pi (fun _ : ι ↦ Measure.dirac (0 : ℝ))).map (WithLp.toLp 2)) P := by
  simpa only [sub_self, tsub_self, gaussianReal_zero_var, ← Pi.zero_def, WithLp.toLp_zero] using
    hasLaw_gaussian_vector_increment_of_orthogonal hX hF hd ho (s := t) le_rfl

/-- Zero-dimensional vectors retain the normalized characteristic function. -/
theorem levy_empty_vector_characteristic (v : ℝ≥0) (u : EuclideanSpace ℝ (Fin 0)) :
    charFun ((Measure.pi (fun _ : Fin 0 ↦ gaussianReal 0 v)).map (WithLp.toLp 2)) u = 1 := by
  simpa using charFun_pi_centered_gaussian v u

/-- The final theorem implies cross-coordinate independence at independently
chosen times; its conclusion is not just a same-time statement. -/
theorem levy_coordinate_independence_unequal_times
    {ι Ω : Type*} [Finite ι] {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ι → ℝ≥0 → Ω → ℝ}
    (hX : ∀ i, IsContinuousLocalMartingale (X i) F P) (hF : F.IsUsual P)
    (hd : ∀ i, Indistinguishable
      (((hX i).isSemimartingale hF).quadraticVariation hF) (fun t _ ↦ (t : ℝ)) P)
    (ho : ∀ i j, i ≠ j → Indistinguishable
      (((hX i).isSemimartingale hF).quadraticCovariation ((hX j).isSemimartingale hF) hF) 0 P)
    {i j : ι} (hij : i ≠ j) (s t : ℝ≥0) : IndepFun (X i s) (X j t) P :=
  ((levy_multidimensional hX hF hd ho).2.indepFun hij).comp
    (measurable_pi_apply s) (measurable_pi_apply t)

/-- Finite-sum linearity retains the source initial product, even without
initial moment assumptions or bounds on the coefficients. -/
theorem finite_integral_sum_initial_product
    {ι Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {H : ι → ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (S : Finset ι)
    (ha : ∀ i, Adapted F (H i)) (hr : ∀ i, HasCagladPaths (H i) P) :
    (hX.stochasticIntegral hF
      (fun t ↦ Finset.measurable_sum S (fun i _ ↦ ha i t))
      (HasCagladPaths.finset_sum S (fun i _ ↦ hr i))) 0 =ᵐ[P]
      fun ω ↦ ∑ i ∈ S, H i 0 ω * X 0 ω := by
  simpa only [Finset.sum_mul] using hX.stochasticIntegral_zero_ae hF
    (fun t ↦ Finset.measurable_sum S (fun i _ ↦ ha i t))
    (HasCagladPaths.finset_sum S (fun i _ ↦ hr i))

/-- The trace-zero composition theorem handles an empty coordinate family
without selecting a nonexistent coordinate to serve as its clock. -/
theorem trace_zero_empty_coordinate_family
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    (X : Fin 0 → ℝ≥0 → Ω → ℝ) {f : (Fin 0 → ℝ) → ℝ} (hf : ContDiff ℝ 2 f) :
    IsContinuousLocalMartingale (fun t ω ↦ f (fun i ↦ X i t ω)) F P := by
  apply isContinuousLocalMartingale_comp_of_isotropic_trace_zero_on_paths (A := 0)
    (fun i ↦ Fin.elim0 i) hF (fun i ↦ Fin.elim0 i) (fun i ↦ Fin.elim0 i) hf
  exact Filter.Eventually.of_forall (fun _ _ ↦ by simp)

/-- Smoothness and a strictly positive canonical Laplacian do not remove
the integrability requirement in the definition of a true submartingale. -/
theorem positive_laplacian_does_not_imply_submartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
    {B : ℝ≥0 → Ω → ℝ} (hB : IsBrownianReal B P) (F : Filtration ℝ≥0 mΩ) :
    ContDiff ℝ 2 (fun x : ℝ ↦ Real.exp (x ^ 2 / 2)) ∧
      (∀ x : ℝ, 0 < Laplacian.laplacian (fun y : ℝ ↦ Real.exp (y ^ 2 / 2)) x) ∧
      ¬ Submartingale (fun t ω ↦ Real.exp ((B t ω) ^ 2 / 2)) F P :=
  ⟨by fun_prop, laplacian_exp_half_sq_pos, hB.not_submartingale_exp_half_sq F⟩

/-- An empty coordinate family still gives a true submartingale: the composed
value is a deterministic constant, so the required envelope is integrable. -/
theorem submartingale_empty_coordinate_family
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    (X : Fin 0 → ℝ≥0 → Ω → ℝ) {f : (Fin 0 → ℝ) → ℝ} (hf : ContDiff ℝ 2 f) :
    Submartingale (fun t ω ↦ f (fun i ↦ X i t ω)) F P := by
  apply submartingale_comp_of_isotropic_trace_nonneg_of_integrable_envelope (A := 0)
    (fun i ↦ Fin.elim0 i) hF (fun i ↦ Fin.elim0 i) (fun i ↦ Fin.elim0 i) hf
    (Filter.Eventually.of_forall (fun _ _ ↦ by simp))
  intro T
  refine ⟨fun _ ↦ ‖f 0‖, integrable_const _, Filter.Eventually.of_forall (fun ω t _ ↦ ?_)⟩
  have he : (fun i ↦ X i t ω) = 0 := Subsingleton.elim _ _
  simp only [he, le_refl]

/-- A zero increasing drift does not make a nonintegrable initial value legal
for a true submartingale. The Protter-masked local property remains valid. -/
theorem local_submartingale_nonintegrable_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) {Z : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hi : ¬ Integrable Z P) :
    Locally (fun Y ↦ Submartingale Y F P) F (fun _ ↦ Z) P ∧
      ¬ Submartingale (fun _ : ℝ≥0 ↦ Z) F P := by
  constructor
  · have hM := isContinuousLocalMartingale_const_initial (P := P) hZ
    have h := hM.1.locally_submartingale_add_of_monotone (A := 0) hF
      (fun _ ↦ measurable_const) (Filter.Eventually.of_forall (fun _ ↦ continuous_const))
      (Filter.Eventually.of_forall (fun _ ↦ monotone_const))
      (Filter.Eventually.of_forall (fun _ ↦ rfl))
    simpa only [add_zero] using h
  · exact fun h ↦ hi (h.integrable 0)

/-- A negative initial Stieltjes integral is consistent with an increasing
path; monotonicity must not be confused with nonnegativity at time zero. -/
theorem increasing_integral_negative_initial :
    ∃ (hv : LocallyBoundedVariationOn (fun t : ℝ≥0 ↦ (t : ℝ) - 3) Set.univ)
      (hr : ∀ t, ContinuousWithinAt (fun s : ℝ≥0 ↦ (s : ℝ) - 3) (Set.Ici t) t),
      Monotone (pathStieltjesIntegral (fun t : ℝ≥0 ↦ (t : ℝ) - 3) hv hr (fun _ ↦ 1)) ∧
      pathStieltjesIntegral (fun t : ℝ≥0 ↦ (t : ℝ) - 3) hv hr (fun _ ↦ 1) 0 = -3 := by
  have hm : Monotone (fun t : ℝ≥0 ↦ (t : ℝ) - 3) :=
    fun s t h ↦ sub_le_sub_right (show (s : ℝ) ≤ (t : ℝ) from h) 3
  let hv := (hm.monotoneOn Set.univ).locallyBoundedVariationOn
  have hr : ∀ t, ContinuousWithinAt (fun s : ℝ≥0 ↦ (s : ℝ) - 3) (Set.Ici t) t :=
    fun _ ↦ (continuous_subtype_val.sub continuous_const).continuousWithinAt
  refine ⟨hv, hr, ?_, ?_⟩
  · apply monotone_pathStieltjesIntegral_of_nonneg hm hr hv
    · intro T
      exact integrableOn_variationStieltjes_of_bounded measurable_const
        (C := 1) (fun _ _ ↦ by norm_num)
    · exact fun _ ↦ zero_le_one
  · simp only [pathStieltjesIntegral_zero, NNReal.coe_zero, one_mul, zero_sub]

/-- The extension transports the canonical Laplacian on a neighborhood, not
merely the values on the closed set. Values outside the domain are unrestricted. -/
theorem closed_extension_laplacian
    {ι : Type*} [Fintype ι] {K D : Set (EuclideanSpace ℝ ι)}
    {f : EuclideanSpace ℝ ι → ℝ} (hK : IsClosed K) (hD : IsOpen D)
    (hKD : K ⊆ D) (hf : ContDiffOn ℝ 2 f D) :
    ∃ g : EuclideanSpace ℝ ι → ℝ, ContDiff ℝ 2 g ∧
      ∀ x ∈ K, g x = f x ∧ Laplacian.laplacian g x = Laplacian.laplacian f x := by
  obtain ⟨g, hg, he⟩ := exists_contDiff_extension_near_closed hK hD hKD hf
  exact ⟨g, hg, fun x hx ↦ ⟨(he x hx).eq_of_nhds,
    (InnerProductSpace.laplacian_congr_nhds (he x hx)).eq_of_nhds⟩⟩

/-- At a zero exit time the patched coordinates equal the chosen domain
point, even if the original initial coordinates lie outside that domain. -/
theorem region_patch_zero
    {ι Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ι → ℝ≥0 → Ω → ℝ}
    (hX : ∀ i, IsContinuousLocalMartingale (X i) F P) (hF : F.IsUsual P)
    (c : ι → ℝ) :
    ∃ (Y : ι → ℝ≥0 → Ω → ℝ) (hY : ∀ i, IsContinuousLocalMartingale (Y i) F P),
      (∀ ω t i, Y i t ω = c i) ∧
      ∀ i, Indistinguishable (((hY i).isSemimartingale hF).continuousQuadraticVariation hF)
        (stoppedProcess (((hX i).isSemimartingale hF).continuousQuadraticVariation hF)
          (fun _ ↦ 0)) P := by
  obtain ⟨Y, hY, hd, _, _, _, hz⟩ := exists_region_patched_stopped_coordinates
    hX hF (isStoppingTime_const F 0) (R := fun v ↦ v = c) c rfl
      (Filter.Eventually.of_forall (fun _ h ↦ False.elim ((lt_irrefl _) h)))
  exact ⟨Y, hY, fun ω ↦ hz ω rfl, hd⟩

/-- Open-domain localization works in dimension zero without choosing a
coordinate. Only membership in the domain is required of the unique vector. -/
theorem open_domain_empty_coordinate_family
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    (X : Fin 0 → ℝ≥0 → Ω → ℝ) {D : Set (EuclideanSpace ℝ (Fin 0))}
    {f : EuclideanSpace ℝ (Fin 0) → ℝ} (hD : IsOpen D)
    (hf : InnerProductSpace.HarmonicOnNhd f D) (h0 : 0 ∈ D) :
    IsContinuousLocalMartingale (fun t ω ↦ f (WithLp.toLp 2 (fun i ↦ X i t ω))) F P := by
  apply protter_harmonic_composition (A := 0)
    (fun i ↦ Fin.elim0 i) hF (fun i ↦ Fin.elim0 i) (fun i ↦ Fin.elim0 i) hD hf
  exact Filter.Eventually.of_forall (fun _ _ ↦ by
    simpa only [Subsingleton.elim (WithLp.toLp 2 _) 0] using h0)

/-- A raw common clock can start at nine. Its continuous part is centered,
so the scalar constant-three process has zero continuous bracket. -/
theorem raw_clock_nonzero_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    ∃ hX : IsSemimartingale (fun _ : ℝ≥0 ↦ fun _ : Ω ↦ (3 : ℝ)) F P,
      Indistinguishable (hX.quadraticVariation hF) (fun _ _ ↦ 9) P ∧
      Indistinguishable (hX.continuousQuadraticVariation hF) 0 P := by
  let hX := (isContinuousLocalMartingale_const_initial (P := P)
    (F := F) (Z := fun _ : Ω ↦ (3 : ℝ)) measurable_const).isSemimartingale hF
  have hd : Indistinguishable (hX.quadraticVariation hF) (fun _ _ ↦ 9) P := by
    convert quadraticVariation_const_initial
      (P := P) (F := F) (Z := fun _ : Ω ↦ (3 : ℝ)) measurable_const hF using 1
    norm_num
  have h := continuous_brackets_of_raw_orthogonal_clock_centered
    (ι := Fin 1) (fun _ ↦ hX) hF
    (fun _ ↦ Filter.Eventually.of_forall (fun _ ↦ continuous_const)) (fun _ ↦ hd)
    (fun i j hij ↦ False.elim (hij (Subsingleton.elim i j)))
  refine ⟨hX, hd, ?_⟩
  filter_upwards [h.1 0] with ω hω t
  simpa only [sub_self, Pi.zero_apply] using hω t

/-- The common-event theorem can be evaluated at arbitrary random endpoints;
neither endpoint needs to be a stopping time or even measurable. -/
theorem random_constancy_intervals
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (S T : Ω → ℝ≥0) :
    ∀ᵐ ω ∂P, S ω ≤ T ω →
      ((hX.isSemimartingale hF).quadraticVariation hF (S ω) ω =
          (hX.isSemimartingale hF).quadraticVariation hF (T ω) ω ↔
        Set.EqOn (X · ω) (fun _ ↦ X (S ω) ω) (Set.Icc (S ω) (T ω))) :=
  (hX.ae_quadraticVariation_eq_iff_eqOn_Icc hF).mono fun ω h ↦ h (S ω) (T ω)

/-- A constant path never departs, even with nonzero initial value and a
positive departure start. Infinity remains a genuine extended stopping time. -/
theorem constant_path_constancyExit_top (r : ℝ≥0) :
    constancyExit (fun (_ : ℝ≥0) (_ : Unit) ↦ (7 : ℝ)) r () = ⊤ := by
  simp [constancyExit, hittingAfter_eq_top_iff]

/-- The first departure can be zero even though the path is still at its
starting value there: an open target need not be attained at its infimum. -/
theorem immediate_constancy_exit :
    constancyExit (fun (t : ℝ≥0) (_ : Unit) ↦ (t : ℝ)) 0 () = 0 := by
  apply le_antisymm _ bot_le
  apply WithTop.le_of_forall_lt_iff_le.mp
  intro t ht
  apply hittingAfter_le_of_mem (by exact bot_le)
  have hp : (0 : ℝ≥0) < t := WithTop.coe_lt_coe.mp ht
  change (t : ℝ) - min (t : ℝ) 0 ≠ 0
  rw [min_eq_right t.coe_nonneg, sub_zero]
  exact ne_of_gt (show (0 : ℝ) < (t : ℝ) from hp)

/-- The identity clock has exactly the identity inverse, including level zero. -/
theorem inverse_clock_identity (s : ℝ≥0) : rightClockInverse id s = s := by
  apply (rightClockInverse_eq_iff_sublevel continuous_id monotone_id rfl s s).mpr
  exact fun _ ↦ Iff.rfl

/-- An initial flat interval makes T_0 positive. In particular T_(a_0) need
not equal zero; the inverse is not a two-sided inverse of the time map. -/
theorem inverse_clock_delayed (s : ℝ≥0) :
    rightClockInverse (fun t : ℝ≥0 ↦ t - 1) s = (s + 1 : ℝ≥0) := by
  apply (rightClockInverse_eq_iff_sublevel (by fun_prop)
    (fun _ _ h ↦ tsub_le_tsub_right h 1) (zero_tsub 1) s (s + 1)).mpr
  exact fun _ ↦ tsub_le_iff_right

/-- Bounded clocks can have infinite inverse times. No finite level identity
is asserted without the unboundedness hypothesis used by the DDS construction. -/
theorem inverse_clock_bounded : rightClockInverse (fun _ : ℝ≥0 ↦ 0) 1 = ⊤ := by
  simp [rightClockInverse, hittingAfter_eq_top_iff]

/-- The finite inverse may move time zero, while factorization retains an
arbitrary (here seven) initial process value on the flat clock fiber. -/
theorem inverse_clock_factorization_initial :
    rightClockInverse (fun t : ℝ≥0 ↦ t - 1) 0 = (1 : ℝ≥0) ∧
      (fun t : ℝ≥0 ↦ (7 : ℝ) + (t - 1 : ℝ≥0))
        (rightClockInverse (fun t : ℝ≥0 ↦ t - 1) 0).untopA = 7 := by
  have he := inverse_clock_delayed 0
  norm_num at he
  refine ⟨he, ?_⟩
  rw [he]
  norm_num [WithTop.untopA]

/-- Coincident inverse levels give the degenerate Gaussian law, without a
zero initial-value assumption on the original local martingale. -/
theorem dds_zero_length_increment
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (hu : ∀ᵐ ω ∂P, Filter.Tendsto
      ((hM.isSemimartingale hF).quadraticVariation hF · ω) Filter.atTop Filter.atTop)
    (s : ℝ≥0) :
    let T := clockInverseTime ((hM.isSemimartingale hF).continuousBracketClock hF) s
    HasLaw (fun ω ↦ stoppedValue X T ω - stoppedValue X T ω) (Measure.dirac 0) P := by
  simpa only [tsub_self, gaussianReal_zero_var] using
    (hM.hasLaw_and_indep_inverse_clock_increment hF hu (le_refl s)).1

/-- Flat fibers retain the initial value. Thus a standard Brownian conclusion
for the uncentered sampled process necessarily forces the original start to zero. -/
theorem dds_zero_initial_necessary
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (hu : ∀ᵐ ω ∂P, Filter.Tendsto
      ((hM.isSemimartingale hF).quadraticVariation hF · ω) Filter.atTop Filter.atTop)
    (hB : IsBrownianReal (fun s ↦ stoppedValue X
      (clockInverseTime ((hM.isSemimartingale hF).continuousBracketClock hF) s)) P) :
    X 0 =ᵐ[P] 0 := by
  obtain ⟨_, _, _, _, hrec, _, _⟩ := hM.inverse_quadraticVariation_timeChange hF hu
  filter_upwards [hrec.ae_eq 0, hB.toIsPreBrownianReal.eval_zero_ae_eq_zero] with ω hr hb
  simpa only [(hM.isSemimartingale hF).continuousBracketClock_zero hF, hb,
    Pi.zero_apply] using hr.symm

/-- The source factorization is common-event, so even a nonmeasurable random
time may be substituted. This is stronger than separate deterministic-time AE equalities. -/
theorem dds_source_random_reconstruction
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (h0 : X 0 =ᵐ[P] 0)
    (hu : ∀ᵐ ω ∂P, Filter.Tendsto
      ((hM.isSemimartingale hF).quadraticVariation hF · ω) Filter.atTop Filter.atTop)
    (R : Ω → ℝ≥0) :
    let Q := (hM.isSemimartingale hF).quadraticVariation hF
    ∀ᵐ ω ∂P, stoppedValue X
      (hittingAfter Q (Set.Ioi (((Q (R ω) ω).toNNReal : ℝ≥0) : ℝ)) 0) ω = X (R ω) ω := by
  obtain ⟨_, _, _, _, _, _, hrec, _, _⟩ := hM.dambis_dubins_schwarz hF h0 hu
  exact hrec.mono fun ω h ↦ h (R ω)

/-- The source antisymmetric integral starts at zero without assuming either
coordinate starts at zero, is integrable, or is Brownian. -/
theorem levy_area_initial_guard
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P) :
    hX.stochasticArea hX hF = 0 ∧ hX.stochasticArea hY hF 0 =ᵐ[P] 0 :=
  ⟨hX.stochasticArea_self hF, hX.stochasticArea_zero_ae hY hF⟩

/-- Both backward Riccati coefficients are even in the Fourier parameter;
the proof and deterministic norm bound must not impose a positive parameter. -/
theorem levy_area_parameter_sign (u T t : ℝ) :
    levyAreaAlpha (-u) T t = levyAreaAlpha u T t ∧
      levyAreaBeta (-u) T t = levyAreaBeta u T t := by
  simp [levyAreaAlpha, levyAreaBeta]

/-- At the terminal time all real compensating terms vanish, leaving the
actual characteristic-function integrand with the source area normalization. -/
theorem levy_area_terminal_exponent (u T a x y : ℝ) :
    Complex.exp (Complex.I * (u : ℂ) * a -
      (levyAreaAlpha u T T : ℂ) / 2 * ((x : ℂ) ^ 2 + (y : ℂ) ^ 2) +
        (levyAreaBeta u T T : ℂ)) = Complex.exp (Complex.I * (u : ℂ) * a) := by
  simp only [levyAreaAlpha_terminal, levyAreaBeta_terminal, Complex.ofReal_zero,
    zero_div, zero_mul, sub_zero, add_zero]

/-- At Fourier parameter zero the constructed area exponential is exactly one,
for every clock and every trajectory, without any initial-law assumption. -/
theorem levy_area_exponential_zero_parameter
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (Q : ℝ≥0 → Ω → ℝ) (T : ℝ) (t : ℝ≥0) (ω : Ω) :
    hX.stochasticAreaExponential hY hF Q 0 T t ω = 1 := by
  rw [IsSemimartingale.stochasticAreaExponential, hX.stochasticAreaExponent_eq hY hF]
  simp only [levyAreaAlpha_zero, levyAreaBeta_zero, Complex.ofReal_zero,
    mul_zero, zero_mul, zero_div, sub_zero, add_zero, Complex.exp_zero]

/-- The initial value has no singularity at horizon zero. No density at zero
is inferred from this exact value of the actual exponential. -/
theorem levy_area_exponential_zero_horizon
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y Q : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (hX0 : X 0 =ᵐ[P] 0) (hY0 : Y 0 =ᵐ[P] 0) (hQ0 : Q 0 =ᵐ[P] 0) (u : ℝ) :
    hX.stochasticAreaExponential hY hF Q u 0 0 =ᵐ[P] 1 := by
  simpa only [mul_zero, Real.cosh_zero, Complex.ofReal_one, inv_one, Pi.one_def] using
    hX.stochasticAreaExponential_zero_ae hY hF hX0 hY0 hQ0 u 0

/-- For the actual time clock the terminal exponential is the source
characteristic-function integrand, with no factor of one half in the area. -/
theorem levy_area_exponential_terminal_clock
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (u : ℝ) (T : ℝ≥0) (ω : Ω) :
    hX.stochasticAreaExponential hY hF (fun t _ ↦ (t : ℝ)) u T T ω =
      Complex.exp (Complex.I * (u : ℂ) * (hX.stochasticArea hY hF T ω : ℂ)) :=
  hX.stochasticAreaExponential_at_terminal_level hY hF u T T ω rfl

/-- Constant integration retains the source initial product: three integrated
against the constant seven is twenty-one, not zero. -/
theorem constant_integrator_nonzero_initial_product
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    Indistinguishable
      ((isSemimartingale_const_initial (P := P) (F := F)
        (Z := fun _ : Ω ↦ (7 : ℝ)) measurable_const).stochasticIntegral hF
          (H := fun (_ : ℝ≥0) (_ : Ω) ↦ (3 : ℝ)) (fun _ ↦ measurable_const)
            (Filter.Eventually.of_forall fun _ ↦ IsContinuousPath.isCagladPath continuous_const))
      (fun _ _ ↦ 21) P := by
  convert stochasticIntegral_const_initial (P := P) (F := F)
    (Z := fun _ : Ω ↦ (7 : ℝ)) measurable_const hF
    (H := fun (_ : ℝ≥0) (_ : Ω) ↦ (3 : ℝ)) (fun _ ↦ measurable_const)
    (Filter.Eventually.of_forall fun _ ↦ IsContinuousPath.isCagladPath continuous_const) using 1
  norm_num

/-- In contrast, the antisymmetric area of any two random constant coordinates
is zero on one event, even without integrability or zero initial values. -/
theorem levy_area_constant_coordinates
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {Z W : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hW : Measurable[F 0] W) (hF : F.IsUsual P) :
    Indistinguishable ((isSemimartingale_const_initial hZ).stochasticArea
      (isSemimartingale_const_initial hW) hF) 0 P := by
  let hX := isSemimartingale_const_initial (P := P) hZ
  let hY := isSemimartingale_const_initial (P := P) hW
  filter_upwards [stochasticIntegral_const_initial hW hF
    (hX.adapted.leftLimitProcess_of_usual hF hX.hasCadlagPaths)
      hX.hasCadlagPaths.hasCagladPaths_leftLimitProcess,
    stochasticIntegral_const_initial hZ hF
      (hY.adapted.leftLimitProcess_of_usual hF hY.hasCadlagPaths)
        hY.hasCadlagPaths.hasCagladPaths_leftLimitProcess] with ω hxy hyx t
  change _ - _ = (0 : ℝ)
  rw [hxy t, hyx t]
  simp only [leftLimitProcess_zero, Pi.zero_apply, zero_mul, sub_self]

/-- The real exponent starts at beta(0), not zero; this is the initial
constant retained by its actual stochastic-integral representation. -/
theorem levy_area_real_exponent_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y Q : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (hX0 : X 0 =ᵐ[P] 0) (hY0 : Y 0 =ᵐ[P] 0) (hQ0 : Q 0 =ᵐ[P] 0) (u T : ℝ) :
    (fun ω ↦ (hX.stochasticAreaExponent hY hF Q u T 0 ω).re) =ᵐ[P]
      fun _ ↦ levyAreaBeta u T 0 := by
  filter_upwards [hX0, hY0, hQ0] with ω hx hy hq
  simp [IsSemimartingale.stochasticAreaExponent, complexProcess, hx, hy, hq]

/-- The entire real exponent vanishes at the terminal clock level, without
requiring a zero initial point or even a Brownian law. -/
theorem levy_area_real_exponent_terminal
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y Q : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (u T : ℝ) (t : ℝ≥0) (ω : Ω) (hQ : Q t ω = T) :
    (hX.stochasticAreaExponent hY hF Q u T t ω).re = 0 := by
  simp [IsSemimartingale.stochasticAreaExponent, complexProcess, hQ]

/-- Rotating any two caglad coefficients by ninety degrees makes the actual
mixed integral bracket vanish under an isotropic clock, without moments. -/
theorem isotropic_integral_pair_rotated_weights
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y Q H K : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P)
    (hQ : IsSemimartingale Q F P) (hF : F.IsUsual P)
    (hqX : Indistinguishable (hX.continuousQuadraticVariation hF) Q P)
    (hqY : Indistinguishable (hY.continuousQuadraticVariation hF) Q P)
    (ho : Indistinguishable (hX.continuousQuadraticCovariation hY hF) 0 P)
    (haH : Adapted F H) (hrH : HasCagladPaths H P)
    (haK : Adapted F K) (hrK : HasCagladPaths K P) :
    let haN : Adapted F (fun t ω ↦ (-1 : ℝ) * K t ω) :=
      fun t ↦ (haK t).const_mul (-1)
    let hrN := hrK.continuous_comp
      (continuous_const.mul continuous_id : Continuous (fun x : ℝ ↦ (-1 : ℝ) * x))
    let hJ := (hX.isSemimartingale_stochasticIntegral hF haH hrH).add
      (hY.isSemimartingale_stochasticIntegral hF haK hrK)
    let hN := (hX.isSemimartingale_stochasticIntegral hF haN hrN).add
      (hY.isSemimartingale_stochasticIntegral hF haH hrH)
    Indistinguishable (hJ.continuousQuadraticCovariation hN hF) 0 P := by
  let haN : Adapted F (fun t ω ↦ (-1 : ℝ) * K t ω) :=
    fun t ↦ (haK t).const_mul (-1)
  let hrN := hrK.continuous_comp
    (continuous_const.mul continuous_id : Continuous (fun x : ℝ ↦ (-1 : ℝ) * x))
  have hi := hX.continuousQuadraticCovariation_stochasticIntegral_pair hY hQ hF hqX hqY ho
    haH hrH haK hrK haN hrN haH hrH
  have he := hQ.stochasticIntegral_congr_integrand hF
    (fun t ↦ ((haH t).mul (haN t)).add ((haK t).mul (haH t)))
    ((hrH.mul hrN).add (hrK.mul hrH))
    (IsSimplePredictable.zero F).adapted ((IsSimplePredictable.zero F).hasCagladPaths P)
    (Filter.Eventually.of_forall fun ω t ↦ by
      change H t ω * ((-1 : ℝ) * K t ω) + K t ω * H t ω = 0
      ring)
  exact hi.trans (he.trans (hQ.stochasticIntegral_zero_integrand hF))

/-- At Fourier parameter zero the exponent itself, not only its exponential,
vanishes for every path and every clock. -/
theorem levy_area_exponent_zero_parameter
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (Q : ℝ≥0 → Ω → ℝ) (T : ℝ) (t : ℝ≥0) (ω : Ω) :
    hX.stochasticAreaExponent hY hF Q 0 T t ω = 0 := by
  apply Complex.ext <;>
    simp [IsSemimartingale.stochasticAreaExponent, complexProcess]

/-- Orthogonality removes the imaginary part of the actual complex bilinear
bracket; this statement makes no nonnegativity claim for its real part. -/
theorem levy_area_exponent_bracket_imaginary_part
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y Q : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P)
    (hQ : IsSemimartingale Q F P) (hF : F.IsUsual P)
    (hqX : Indistinguishable (hX.quadraticVariation hF) Q P)
    (hqY : Indistinguishable (hY.quadraticVariation hF) Q P)
    (ho : Indistinguishable (hX.continuousQuadraticCovariation hY hF) 0 P)
    (hcX : HasContinuousPaths X P) (hcY : HasContinuousPaths Y P)
    (hvQ : HasFiniteVariationPaths Q P) (hcQ : HasContinuousPaths Q P)
    (h0X : X 0 =ᵐ[P] 0) (h0Y : Y 0 =ᵐ[P] 0) (h0Q : Q 0 =ᵐ[P] 0) (u T : ℝ) :
    let hK := hX.isComplexSemimartingale_stochasticAreaExponent hY hQ hF u T
    Indistinguishable (fun t ω ↦ (hK.continuousQuadraticVariation hF t ω).im) 0 P := by
  filter_upwards [hX.continuousQuadraticCovariation_stochasticAreaExponent_re_im hY hQ hF
    hqX hqY ho hcX hcY hvQ hcQ h0X h0Y h0Q u T] with ω hm t
  change 2 * _ = (0 : ℝ)
  rw [hm t]
  simp only [Pi.zero_apply, mul_zero]

/-- The complex source integral retains both coordinates of its nonzero
initial product: integrating 3 + 2i against constant 7 gives 21 + 14i. -/
theorem complex_constant_integrator_nonzero_initial_product
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    Indistinguishable
      ((isSemimartingale_const_initial (P := P) (F := F)
        (Z := fun _ : Ω ↦ (7 : ℝ)) measurable_const).complexIntegrandIntegral hF
        (H := fun (_ : ℝ≥0) (_ : Ω) ↦ (3 : ℂ) + 2 * Complex.I)
        (fun _ ↦ measurable_const)
        (Filter.Eventually.of_forall fun _ ↦ IsContinuousPath.isCagladPath continuous_const))
      (fun _ _ ↦ (21 : ℂ) + 14 * Complex.I) P := by
  filter_upwards [complexIntegrandIntegral_const_initial (P := P) (F := F)
    (Z := fun _ : Ω ↦ (7 : ℝ)) measurable_const hF
    (H := fun (_ : ℝ≥0) (_ : Ω) ↦ (3 : ℂ) + 2 * Complex.I)
    (fun _ ↦ measurable_const)
    (Filter.Eventually.of_forall fun _ ↦ IsContinuousPath.isCagladPath continuous_const)]
      with ω he t
  rw [he t]
  simp only [Complex.ofReal_ofNat]
  ring

/-- Embedding a real integrator as a complex process preserves the existing
complex-integrand integral, including arbitrary nonzero initial integrands. -/
theorem complex_integral_real_integrator_reduction
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {H : ℝ≥0 → Ω → ℂ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCagladPaths H P) :
    let h0 := isSemimartingale_const_initial (P := P) (F := F)
      (Z := fun _ : Ω ↦ (0 : ℝ)) measurable_const
    Indistinguishable ((hX.complex h0).stochasticIntegral hF ha hr)
      (hX.complexIntegrandIntegral hF ha hr) P := by
  let h0 := isSemimartingale_const_initial (P := P) (F := F)
    (Z := fun _ : Ω ↦ (0 : ℝ)) measurable_const
  exact (hX.complex h0).stochasticIntegral_of_zero_imaginary_part hF ha hr
    (Filter.Eventually.of_forall fun _ _ ↦ rfl)

/-- The Fourier parameter zero gives one without any Brownian assumptions. -/
theorem levy_area_characteristic_zero_parameter
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (S : ℝ≥0) :
    (∫ ω, Complex.exp (Complex.I * (0 : ℂ) * (hX.stochasticArea hY hF S ω : ℂ)) ∂P) = 1 := by
  simp

/-- At time zero the actual area characteristic function is one, even if
the coordinates have arbitrary nonzero initial values. -/
theorem levy_area_characteristic_at_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (u : ℝ) :
    (∫ ω, Complex.exp (Complex.I * (u : ℂ) * (hX.stochasticArea hY hF 0 ω : ℂ)) ∂P) = 1 := by
  calc
    _ = ∫ _ω : Ω, (1 : ℂ) ∂P := integral_congr_ae (by
      filter_upwards [hX.stochasticArea_zero_ae hY hF] with ω h0
      simp only [h0, Pi.zero_apply, Complex.ofReal_zero, mul_zero, Complex.exp_zero])
    _ = 1 := by simp

/-- The time-zero law is a Dirac measure, not a positive-time Lebesgue density. -/
theorem levy_area_law_at_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X Y : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hY : IsSemimartingale Y F P) (hF : F.IsUsual P) :
    P.map (hX.stochasticArea hY hF 0) = Measure.dirac 0 := by
  rw [Measure.map_congr (hX.stochasticArea_zero_ae hY hF)]
  change P.map (fun _ : Ω ↦ (0 : ℝ)) = Measure.dirac 0
  simp

/-- The zero-scale density is the zero function, so using it at time zero
would give the wrong measure. The zero-safe law is Dirac at zero. -/
theorem hyperbolic_secant_zero_density_not_law :
    volume.withDensity (hyperbolicSecantPDF 0) ≠ hyperbolicSecantMeasure 0 := by
  intro h
  have hm := congrArg (fun μ : Measure ℝ ↦ μ Set.univ) h
  simp [hyperbolicSecantPDF, hyperbolicSecantPDFReal] at hm

/-- The source twice-signed-area normalization gives density one half at
the origin at time one. -/
theorem hyperbolic_secant_unit_density_at_origin : hyperbolicSecantPDFReal 1 0 = 1 / 2 := by
  norm_num [hyperbolicSecantPDFReal]

/-- The proved characteristic function includes negative Fourier parameters. -/
theorem hyperbolic_secant_negative_parameter (T : ℝ≥0) (u : ℝ) :
    charFun (hyperbolicSecantMeasure T) (-u) = charFun (hyperbolicSecantMeasure T) u := by
  simp only [charFun_hyperbolicSecantMeasure, neg_mul, Real.cosh_neg]

/-- Zero Poisson rate is included in the exact first-moment calculation. -/
theorem poisson_mean_zero_rate :
    (∫ n : ℕ, (n : ℝ) ∂poissonMeasure 0) = 0 := integral_natCast_poisson 0

/-- Reversing time order gives a negative real increment mean. This is not
natural-number truncated subtraction. -/
theorem poisson_real_increment_mean_reverse
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {N : ℝ≥0 → Ω → ℕ} (hN : IsPoissonProcess N 3 P) :
    (∫ ω, ((N 1 ω : ℝ) - (N 2 ω : ℝ)) ∂P) = -3 := by
  have h := hN.integral_real_increment 2 1
  norm_num at h
  exact h

/-- The second raw Poisson moment includes the linear variance contribution. -/
theorem poisson_second_moment_rate_two :
    (∫ n : ℕ, (n : ℝ) ^ 2 ∂poissonMeasure 2) = 6 := by
  have h := integral_natCast_sq_poisson 2
  norm_num at h
  exact h

/-- At zero intensity the second moment really vanishes. -/
theorem poisson_second_moment_zero_rate :
    (∫ n : ℕ, (n : ℝ) ^ 2 ∂poissonMeasure 0) = 0 := by
  simpa using integral_natCast_sq_poisson 0

/-- The source's nonconstancy conclusion concerns the drift-subtracted path,
not the integer count itself. No probabilistic assumption is needed here. -/
theorem integer_count_drift_nonconstant (n : ℝ≥0 → ℕ) :
    ¬ Set.EqOn (fun t ↦ (n t : ℝ) - t) (fun _ ↦ (n 0 : ℝ)) (Set.Icc 0 1) := by
  simpa only [NNReal.coe_zero, sub_zero] using
    natCast_sub_time_not_eqOn_Icc n (by norm_num : (0 : ℝ≥0) < 1)

/-- Independence from the right-continuation past includes equal endpoints;
there is no strict-time or positive-variance requirement. -/
theorem rightCont_increment_equal_endpoints
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hr : HasRightContinuousPaths X P) (ha : Adapted F X)
    (hi : ∀ s t, s ≤ t → Indep (F s)
      (MeasurableSpace.comap (fun ω ↦ X t ω - X s ω) inferInstance) P) (s : ℝ≥0) :
    Indep (F.rightCont s) (MeasurableSpace.comap (fun _ : Ω ↦ (0 : ℝ)) inferInstance) P := by
  simpa only [sub_self] using hr.indep_increment_rightCont ha hi (s := s) le_rfl

/-- Completion keeps the actual zero-starting Brownian version, not just its law. -/
theorem completion_brownian_zero_time
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {B : ℝ≥0 → Ω → ℝ}
    (hB : IsBrownianReal B P) :
    (fun ω : NullMeasurableSpace Ω P ↦ B 0 ω) =ᵐ[P.completion] fun _ ↦ 0 :=
  hB.completion.eval_zero_ae_eq_zero

/-- Genuine usual augmentation does not license arbitrary information enlargement:
even on the completed space the full-information Brownian process is not a martingale. -/
theorem completion_brownian_not_fullInformation
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {B : ℝ≥0 → Ω → ℝ} (hB : IsBrownianReal B P) :
    ¬ Martingale (fun t (ω : NullMeasurableSpace Ω P) ↦ B t ω)
      (Filtration.const ℝ≥0 (inferInstance : MeasurableSpace (NullMeasurableSpace Ω P)) le_rfl)
      P.completion := hB.completion.toIsPreBrownianReal.not_martingale_fullInformation

open Filter Set in
open scoped Topology in
/-- A translated affine map scales increment QV by the slope squared; no
normalization of the original path's initial value is imposed. -/
theorem c1_quadraticVariation_affine {π : ℕ → LocallyFinitePartition}
    {T : ℝ≥0} {x A : ℝ≥0 → ℝ} (hx : ContinuousOn x (Icc 0 T))
    (hm : Tendsto (fun n ↦ (((π n).restrict T).mesh : ℝ)) atTop (𝓝 0))
    (hQ : ∀ s ≤ T, HasQuadraticVariationAlong (fun n ↦ (π n).restrict s) x (A s))
    {hv : LocallyBoundedVariationOn A univ} {hr : ∀ t, ContinuousWithinAt A (Ici t) t} :
    HasQuadraticVariationAlong (fun n ↦ (π n).restrict T) (fun t ↦ 3 * x t + 7) (9 * A T) := by
  have hf : ContDiff ℝ 1 (fun z : ℝ ↦ 3 * z + 7) := by fun_prop
  have hd (z : ℝ) : HasDerivAt (fun u : ℝ ↦ 3 * u + 7) 3 z := by
    convert ((hasDerivAt_id z).const_mul (3 : ℝ)).add_const 7 using 1 <;>
      first | rfl | norm_num
  have he : (fun t ↦ deriv (fun z : ℝ ↦ 3 * z + 7) (x t) ^ 2) = fun _ ↦ (9 : ℝ) := by
    funext t
    rw [(hd (x t)).deriv]
    norm_num
  have h := hasQuadraticVariationAlong_contDiff_of_stieltjes (hv := hv) (hr := hr) hx hm hQ hf
  rw [he, pathStieltjesIntegral_const] at h
  exact h

/-- An initial atom contributes to cumulative integration even for the empty
partition; it is distinct from the zero-starting increment-QV convention. -/
theorem cumulative_step_initial_mass (a : Fin 2 → ℝ≥0) (c : Fin 2 → ℝ) (f : ℝ≥0 → ℝ) :
    (∑ i : Fin 2, TimePartition.empty.leftStep f (a i) * c i) =
      f 0 * cumulativeStepSum a c 0 := by
  have h := TimePartition.empty.sum_leftStep_mul_eq_cumulative a c f
  have hz : (∑ j : Fin TimePartition.empty.size, f (TimePartition.empty.left j) *
      (cumulativeStepSum a c (TimePartition.empty.right j) -
        cumulativeStepSum a c (TimePartition.empty.left j))) = 0 :=
    Finset.sum_eq_zero fun j _ ↦ Fin.elim0 j
  rwa [hz, add_zero] at h

open Filter in
/-- A nonzero constant image still has zero increment QV, including at time zero. -/
theorem c1_quadraticVariation_constant {π : ℕ → LocallyFinitePartition} (T : ℝ≥0) :
    HasQuadraticVariationAlong (fun n ↦ (π n).restrict T) (fun _ ↦ (7 : ℝ)) 0 := by
  simp only [HasQuadraticVariationAlong, quadraticVariationSum_const]
  exact tendsto_const_nhds

/-- Horizon zero does not collapse an admissible infinite partition to a bounded
endpoint set, even though its finite-horizon increment QV is zero. -/
theorem admissible_zero_qv_zero_horizon :
    ∃ P : ℕ → LocallyFinitePartition, IsAdmissiblePartitionSequence P ∧
      HasQuadraticVariationAlong (fun n ↦ (P n).restrict 0) (fun _ ↦ (7 : ℝ)) 0 ∧
      ∀ n, ¬ BddAbove (P n).points := by
  obtain ⟨P, hP, hq⟩ := exists_admissible_zeroQuadraticVariation
    (T := 0) (continuous_const.continuousOn (f := fun _ : ℝ≥0 ↦ (7 : ℝ)))
  exact ⟨P, hP, hq, fun n ↦ (P n).unbounded⟩

open Filter in
/-- The two limits are not artifacts of different endpoint enumerations. -/
theorem partition_dependent_endpoint_sets :
    ∃ P : ℕ → LocallyFinitePartition, IsAdmissiblePartitionSequence P ∧
      ¬ (∀ n, Set.range ((P n).restrict 1).point =
        Set.range ((LocallyFinitePartition.dyadic n).restrict 1).point) := by
  obtain ⟨x, P, _, hP, h0, h1⟩ :=
    ProbabilityTheory.exists_continuous_partition_dependent_quadraticVariation
  refine ⟨P, hP, fun he ↦ ?_⟩
  have h0' := h0.congr (fun n ↦ quadraticVariationSum_eq_of_range_eq (he n) x)
  have h : (0 : ℝ) = 1 := tendsto_nhds_unique h0' h1
  norm_num at h

/-- Inserting an existing endpoint contributes zero product error, even for an
arbitrary discontinuous path and a degenerate cell. -/
theorem insert_existing_endpoint_preserves_square_sum {T : ℝ≥0} (π : TimePartition T)
    (i : Fin π.size) (x : ℝ≥0 → ℝ) :
    ∃ ρ : TimePartition T, ρ.Refines π ∧ Set.range ρ.point = Set.range π.point ∧
      quadraticVariationSum ρ x = quadraticVariationSum π x := by
  obtain ⟨ρ, hr, hp, hq⟩ := π.exists_insertPoint_in_cell i ⟨le_rfl, π.left_le_right i⟩ x
  have hi : π.left i ∈ Set.range π.point := ⟨i.castSucc, rfl⟩
  rw [Set.insert_eq_of_mem hi] at hp
  exact ⟨ρ, hr, hp, by simpa only [sub_self, mul_zero, zero_mul, sub_zero] using hq⟩

open Filter Set in
open scoped Topology in
/-- The nonconvergent example does not contradict zero QV for continuous BV paths. -/
theorem nonconvergent_qv_path_not_boundedVariation :
    ∃ (x : ℝ≥0 → ℝ) (P : ℕ → LocallyFinitePartition), Continuous x ∧
      IsAdmissiblePartitionSequence P ∧ ¬ BoundedVariationOn x (Icc 0 1) := by
  obtain ⟨x, P, hx, hP, hq⟩ :=
    ProbabilityTheory.exists_continuous_nonconvergent_admissible_quadraticVariation
  refine ⟨x, P, hx, hP, fun hv ↦ ?_⟩
  apply hq
  refine ⟨0, hasQuadraticVariationAlong_zero_of_continuous_boundedVariation hx.continuousOn hv ?_⟩
  exact_mod_cast (NNReal.continuous_coe.tendsto 0).comp (hP.restrict_mesh_tendsto (fun _ ↦ 1))

/-- Horizon zero retains the full initial square in the maximal estimate. -/
theorem doob_zero_horizon_retains_initial_square
    {Ω E : Type*} [NormedAddCommGroup E] (X : ℝ≥0 → Ω → E) (ω : Ω) :
    denseRunningSupremum (fun t ω ↦ ‖X t ω‖ ^ 2) 0 ω =
      ENNReal.ofReal (‖X 0 ω‖ ^ 2) := by
  simp [denseRunningSupremum, denseTimeUpTo]

/-- The square supremum of the constant five is twenty-five, not zero. -/
theorem doob_nonzero_constant_square_supremum {Ω : Type*} (T : ℝ≥0) (ω : Ω) :
    denseRunningSupremum (fun _ (_ : Ω) ↦ ‖(5 : ℝ)‖ ^ 2) T ω = 25 := by
  norm_num [denseRunningSupremum]

/-- The common-event bound applies even to nonmeasurable choices of time;
measurability is only needed for subsequent integration of a sampled value. -/
theorem doob_maximal_envelope_random_times
    {Ω E : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → E} {T : ℝ≥0}
    (hX : Martingale X F P) (hr : HasRightContinuousPaths X P) (hT : MemLp (X T) 2 P) :
    ∃ g : Ω → ℝ, MemLp g 2 P ∧
      ∀ᵐ ω ∂P, ‖X 0 ω‖ ≤ g ω ∧ ‖X T ω‖ ≤ g ω ∧
        ∀ τ : Ω → ℝ≥0, τ ω ≤ T → ‖X (τ ω) ω‖ ≤ g ω := by
  obtain ⟨g, _, _, hg, hb, _⟩ := hX.exists_memLp_two_maximalEnvelope hr hT
  refine ⟨g, hg, ?_⟩
  filter_upwards [hb] with ω hω
  exact ⟨hω 0 bot_le, hω T le_rfl, fun τ hτ ↦ hω (τ ω) hτ⟩

/-- The moment identity for a nonzero constant martingale is twenty-five,
including at time zero; it is not the centered bracket identity. -/
theorem raw_bracket_constant_second_moment
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] (hF : F.IsUsual P) (T : ℝ≥0) :
    (∫ ω, (isSemimartingale_const_initial (P := P) (F := F)
      (measurable_const (a := (5 : ℝ)))).quadraticVariation hF T ω ∂P) = 25 := by
  have hM : IsSquareIntegrableMartingale (fun (_ : ℝ≥0) (_ : Ω) ↦ (5 : ℝ)) F P :=
    ⟨martingale_const_fun F P stronglyMeasurable_const (integrable_const 5),
      fun _ ↦ memLp_const 5⟩
  have he := ((isSemimartingale_const_initial (P := P) (F := F)
    (measurable_const (a := (5 : ℝ))))).integrable_quadraticVariation_and_integral_eq hF hM T |>.2
  norm_num at he
  exact he

/-- A genuine jump martingale is covered. Its second moment is recovered
from its actual Poisson raw bracket, with the filtration premise retained. -/
theorem compensated_poisson_second_moment_via_bracket
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F]
    {N : ℝ≥0 → Ω → ℕ} {rate : ℝ≥0}
    (hN : IsPoissonProcess N rate P) (hF : F.IsUsual P) (ha : Adapted F N)
    (hi : ∀ s t, s ≤ t → Indep (F s) (MeasurableSpace.comap
      (fun ω ↦ (N t ω : ℝ) - (N s ω : ℝ)) inferInstance) P) (T : ℝ≥0) :
    (∫ ω, ((N T ω : ℝ) - (rate : ℝ) * T) ^ 2 ∂P) = (rate : ℝ) * T := by
  have hM : IsSquareIntegrableMartingale
      (fun t ω ↦ (N t ω : ℝ) - (rate : ℝ) * t) F P := by
    refine ⟨hN.martingale_compensated_of_indep_past ha hi, fun t ↦ ?_⟩
    have hlp : MemLp (fun ω ↦ (N t ω : ℝ)) 2 P :=
      (memLp_two_iff_integrable_sq (hN.integrable_real t).aestronglyMeasurable).mpr
        (hN.hasLaw t).integrable_natCast_sq_poissonMeasure
    exact hlp.sub (memLp_const ((rate : ℝ) * t))
  have he := ((hN.isSemimartingale_compensated hF ha).integrable_quadraticVariation_and_integral_eq
    hF hM T).2
  rw [integral_congr_ae ((hN.quadraticVariation_compensated_eq hF ha).ae_eq T),
    hN.integral_real T] at he
  exact he.symm

/-- The time-zero jump estimate retains the actual initial value on the
same event for all later horizons. -/
theorem raw_jump_bound_keeps_initial_value
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    ∀ᵐ ω ∂P, ∀ T, ‖X 0 ω‖ ≤ Real.sqrt (hX.quadraticVariation hF T ω) := by
  filter_upwards [hX.norm_jump_le_sqrt_quadraticVariation hF] with ω hω T
  simpa only [jumpProcess_zero] using hω 0 T bot_le

/-- A non-L2 initial value rules out an integrable raw bracket at every
finite horizon, even when an increment-only bracket could vanish. -/
theorem non_square_initial_forbids_integrable_raw_bracket
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (h0 : ¬ MemLp (X 0) 2 P) :
    ∀ T, ¬ Integrable (hX.quadraticVariation hF T) P :=
  fun _ hQ ↦ h0 (hX.memLp_initial_of_integrable_quadraticVariation hF hQ)

/-- Localization includes nonzero, unbounded L2 initial variables. -/
theorem integrable_bracket_localizes_nonzero_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {Z : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hF : F.IsUsual P) (hZlp : MemLp Z 2 P) :
    Locally (fun Y ↦ IsSquareIntegrableMartingale Y F P) F (fun _ ↦ Z) P := by
  apply IsSemimartingale.locally_squareIntegrableMartingale_of_integrable_quadraticVariation
    (isSemimartingale_const_initial hZ) hF (isContinuousLocalMartingale_const_initial hZ).1
  intro T
  exact hZlp.integrable_sq.congr ((quadraticVariation_const_initial hZ hF).ae_eq T).symm

/-- The converse obtains compensated Poisson L2 from the integrable counting
bracket, without assuming the compensated process's second moments. -/
theorem compensated_poisson_squareIntegrable_via_bracket
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F]
    {N : ℝ≥0 → Ω → ℕ} {rate : ℝ≥0}
    (hN : IsPoissonProcess N rate P) (hF : F.IsUsual P) (ha : Adapted F N)
    (hi : ∀ s t, s ≤ t → Indep (F s) (MeasurableSpace.comap
      (fun ω ↦ (N t ω : ℝ) - (N s ω : ℝ)) inferInstance) P) :
    IsSquareIntegrableMartingale (fun t ω ↦ (N t ω : ℝ) - (rate : ℝ) * t) F P := by
  apply IsSemimartingale.isSquareIntegrableMartingale_of_integrable_quadraticVariation
    (hN.isSemimartingale_compensated hF ha) hF
      (hN.isLocalMartingale_compensated_of_indep_past ha hi)
  intro T
  exact (hN.integrable_real T).congr ((hN.quadraticVariation_compensated_eq hF ha).ae_eq T).symm

/-- Constant continuous local martingales satisfy the moment criterion
exactly when their original initial variable is L2, not automatically. -/
theorem constant_local_martingale_square_criterion
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {Z : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hF : F.IsUsual P) :
    IsSquareIntegrableMartingale (fun _ ↦ Z) F P ↔ MemLp Z 2 P := by
  constructor
  · exact fun hM ↦ hM.2 0
  · intro hZlp
    apply (IsContinuousLocalMartingale.squareIntegrableMartingale_iff_integrable_quadraticVariation
      (isContinuousLocalMartingale_const_initial hZ) hF).mpr
    intro T
    exact hZlp.integrable_sq.congr ((quadraticVariation_const_initial hZ hF).ae_eq T).symm

/-- The compensated square is a true martingale with zero raw residual at
time zero; no zero-initial assumption on the original martingale is used. -/
theorem square_residual_true_martingale_nonzero_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (hM : IsSquareIntegrableMartingale X F P) :
    Martingale (fun t ω ↦ X t ω ^ 2 - hX.quadraticVariation hF t ω) F P ∧
      (fun ω ↦ X 0 ω ^ 2 - hX.quadraticVariation hF 0 ω) =ᵐ[P] fun _ ↦ 0 := by
  refine ⟨hX.martingale_sq_sub_quadraticVariation_of_squareIntegrable hF hM, ?_⟩
  filter_upwards [hX.quadraticVariation_zero_ae hF] with ω hω
  rw [hω, sub_self]

/-- Normalized compensation retains the original initial second moment. -/
theorem normalized_square_retains_initial_moment
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (hc : HasContinuousPaths X P)
    (hM : IsSquareIntegrableMartingale X F P) (T : ℝ≥0) :
    (∫ ω, X T ω ^ 2 - hX.continuousQuadraticVariation hF T ω ∂P) =
      ∫ ω, X 0 ω ^ 2 ∂P := by
  have he := (hX.martingale_sq_sub_continuousQuadraticVariation hF hc hM).setIntegral_eq
    (show (0 : ℝ≥0) ≤ T from bot_le) (s := Set.univ) MeasurableSet.univ
  simpa only [Measure.restrict_univ, hX.continuousQuadraticVariation_zero hF,
    sub_zero] using he.symm

/-- Integrability of a zero normalized bracket does not remove the initial
L2 condition. This applies in particular to constant local martingales. -/
theorem normalized_bracket_zero_does_not_remove_initial_L2
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P)
    (hC : Indistinguishable ((hX.isSemimartingale hF).continuousQuadraticVariation hF) 0 P)
    (h0 : ¬ MemLp (X 0) 2 P) :
    (∀ T, Integrable ((hX.isSemimartingale hF).continuousQuadraticVariation hF T) P) ∧
      ¬ IsSquareIntegrableMartingale X F P := by
  refine ⟨fun T ↦ (integrable_const (0 : ℝ)).congr ((hC.ae_eq T).symm), fun hM ↦ ?_⟩
  exact h0 ((hX.squareIntegrable_iff_initial_and_continuousBracket_integrable hF).mp hM).1

/-- The compensated Poisson process has zero continuous bracket but its
square is not a martingale. The continuity premise of normalized compensation
cannot be dropped. -/
theorem jump_square_not_martingale_without_raw_bracket
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {N : ℝ≥0 → Ω → ℕ}
    (hN : IsPoissonProcess N 1 P) (hF : F.IsUsual P) (ha : Adapted F N)
    (hi : ∀ s t, s ≤ t → Indep (F s) (MeasurableSpace.comap
      (fun ω ↦ (N t ω : ℝ) - (N s ω : ℝ)) inferInstance) P) :
    Indistinguishable
      ((hN.isSemimartingale_compensated hF ha).continuousQuadraticVariation hF) 0 P ∧
      ¬ Martingale (fun t ω ↦ ((N t ω : ℝ) - (t : ℝ)) ^ 2) F P := by
  refine ⟨IsSemimartingale.continuousQuadraticVariation_zero_of_finiteVariation
    (hN.isSemimartingale_compensated hF ha) hF hN.hasFiniteVariationPaths_compensated, fun hs ↦ ?_⟩
  have he := hs.setIntegral_eq (show (0 : ℝ≥0) ≤ 1 from bot_le)
    (s := Set.univ) MeasurableSet.univ
  simp only [Measure.restrict_univ, NNReal.coe_zero, NNReal.coe_one, sub_zero] at he
  have h0 : (fun ω ↦ (N 0 ω : ℝ) ^ 2) =ᵐ[P] fun _ ↦ 0 := by
    filter_upwards [hN.initial] with ω hω
    simp only [hω, Nat.cast_zero, zero_pow (by decide : 2 ≠ 0)]
  have h1 := compensated_poisson_second_moment_via_bracket hN hF ha hi 1
  norm_num at h1
  rw [integral_congr_ae h0, integral_zero, h1] at he
  norm_num at he

/-- Terminal raw energy retains an arbitrary initial square, even for a
constant process without an integrable initial value. -/
theorem terminal_bracket_retains_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {Z : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hF : F.IsUsual P) :
    (isSemimartingale_const_initial hZ).quadraticVariationInfinity hF =ᵐ[P]
      fun ω ↦ ENNReal.ofReal (Z ω ^ 2) := by
  filter_upwards [quadraticVariation_const_initial hZ hF] with ω hω
  simp only [IsSemimartingale.quadraticVariationInfinity, hω, iSup_const]

theorem constant_terminal_energy_finite_iff_initial_L2
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {Z : Ω → ℝ}
    (hZ : Measurable[F 0] Z) (hF : F.IsUsual P) :
    (∫⁻ ω, (isSemimartingale_const_initial hZ).quadraticVariationInfinity hF ω ∂P) < ∞ ↔
      MemLp Z 2 P := by
  have hm : AEStronglyMeasurable Z P := (hZ.mono (F.le 0) le_rfl).aestronglyMeasurable
  have hms : AEStronglyMeasurable (fun ω ↦ Z ω ^ 2) P := hm.pow 2
  rw [lintegral_congr_ae (terminal_bracket_retains_initial hZ hF), lt_top_iff_ne_top,
    lintegral_ofReal_ne_top_iff_integrable hms
      (Filter.Eventually.of_forall fun ω ↦ sq_nonneg (Z ω))]
  exact (memLp_two_iff_integrable_sq hm).symm

/-- Brownian terminal energy is genuinely infinite. In particular, the
finite-energy premise cannot be replaced by integrability of its totalized
real conversion, which would vanish in this example. -/
theorem brownian_terminal_bracket_infinite
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hB : IsBrownianReal X P) (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    (hX.quadraticVariationInfinity hF =ᵐ[P] fun _ ↦ ∞) ∧
      ¬ (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P) < ∞ := by
  have he : hX.quadraticVariationInfinity hF =ᵐ[P] fun _ ↦ ∞ := by
    filter_upwards [hB.quadraticVariation_eq_time_of_semimartingale hX hF] with ω hω
    simp only [IsSemimartingale.quadraticVariationInfinity, hω, NNReal.coe_natCast,
      ENNReal.ofReal_natCast, ENNReal.iSup_natCast]
  refine ⟨he, ?_⟩
  simp [lintegral_congr_ae he]

/-- The whole-half-line Doob envelope cannot erase the initial value. -/
theorem global_doob_constant_initial_not_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    ∃ g : Ω → ℝ, MemLp g 2 P ∧ (∀ᵐ ω ∂P, (5 : ℝ) ≤ g ω) ∧
      25 ≤ (∫ ω, g ω ^ 2 ∂P) ∧ (∫ ω, g ω ^ 2 ∂P) ≤ 100 := by
  have hM : Martingale (fun (_ : ℝ≥0) (_ : Ω) ↦ (5 : ℝ)) F P :=
    martingale_const_fun F P stronglyMeasurable_const (integrable_const 5)
  have hc : HasRightContinuousPaths (fun (_ : ℝ≥0) (_ : Ω) ↦ (5 : ℝ)) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  obtain ⟨g, _, _, hg, hb, hi⟩ := hM.exists_memLp_two_globalEnvelope hc
    (fun _ ↦ memLp_const 5) (C := 25) (by intro t; norm_num)
  have h5 : ∀ᵐ ω ∂P, (5 : ℝ) ≤ g ω := by
    filter_upwards [hb] with ω hω
    simpa only [Real.norm_eq_abs, abs_of_pos (by norm_num : (0 : ℝ) < 5)] using hω 0
  refine ⟨g, hg, h5, ?_, by norm_num at hi; exact hi⟩
  have hle := integral_mono_ae (integrable_const (25 : ℝ)) hg.integrable_sq (by
    filter_upwards [h5] with ω hω
    change (25 : ℝ) ≤ g ω ^ 2
    nlinarith)
  simpa using hle

/-- The common-event global envelope also controls unbounded random times;
only measurability of the evaluation, not stopping or an L2 premise, is used. -/
theorem finite_terminal_energy_random_time_L2
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (hM : IsLocalMartingale X F P)
    (hI : (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P) < ∞)
    (τ : Ω → ℝ≥0) (hτ : AEStronglyMeasurable (fun ω ↦ X (τ ω) ω) P) :
    MemLp (fun ω ↦ X (τ ω) ω) 2 P := by
  obtain ⟨g, _, _, hg, hb, _⟩ :=
    hX.exists_memLp_two_globalEnvelope_of_integrable_terminal_energy hF hM hI
  exact hg.mono' hτ (hb.mono fun ω hω ↦ hω (τ ω))

/-- Brownian finite-time L2 does not give a uniform bound over all times. -/
theorem brownian_no_global_second_moment_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hB : IsBrownianReal X P) (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (hM : IsSquareIntegrableMartingale X F P) :
    ¬ ∃ C : ℝ, ∀ t, (∫ ω, X t ω ^ 2 ∂P) ≤ C := by
  rintro ⟨C, hC⟩
  exact (brownian_terminal_bracket_infinite hB hX hF).2
    ((hX.lintegral_quadraticVariationInfinity_le_of_bounded_second_moments
      hF hM hC).trans_lt ENNReal.ofReal_lt_top)

/-- The constructed L2 closing variable of a constant process is the
original initial variable, not a newly imposed zero value. -/
theorem l2_closing_constant_retains_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ}
    (hV : Measurable[F 0] V) (hL : MemLp V 2 P) :
    ∃ Z : Ω → ℝ, MemLp Z 2 P ∧ Z =ᵐ[P] V ∧
      (∀ t, V =ᵐ[P] P[Z | F t]) := by
  have hM : Martingale (fun (_ : ℝ≥0) ↦ V) F P :=
    martingale_const_fun F P hV.stronglyMeasurable (hL.integrable (by norm_num))
  obtain ⟨Z, hZ, hlim, _, hclose, _⟩ :=
    hM.exists_memLp_two_closing_of_globalEnvelope hL.norm
      (Filter.Eventually.of_forall fun _ _ ↦ le_rfl)
  refine ⟨Z, hZ, ?_, hclose⟩
  filter_upwards [hlim] with ω hω
  exact tendsto_nhds_unique hω tendsto_const_nhds

/-- The terminal moment formula keeps nonzero initial energy: the constant
five martingale has closing second moment 25. -/
theorem terminal_energy_closing_keeps_initial_square
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] (hF : F.IsUsual P) :
    ∃ Z : Ω → ℝ, MemLp Z 2 P ∧ (∫ ω, Z ω ^ 2 ∂P) = 25 := by
  have hV : Measurable[F 0] (fun (_ : Ω) ↦ (5 : ℝ)) := measurable_const
  have hI := (constant_terminal_energy_finite_iff_initial_L2 hV hF).mpr (memLp_const 5)
  obtain ⟨Z, hZ, _, _, _, _, hE⟩ :=
    IsSemimartingale.exists_memLp_two_closing_terminal_energy
      (isSemimartingale_const_initial hV) hF (isContinuousLocalMartingale_const_initial hV).1 hI
  refine ⟨Z, hZ, ?_⟩
  rw [lintegral_congr_ae (terminal_bracket_retains_initial hV hF)] at hE
  norm_num at hE
  exact hE

/-- Even a continuous bounded path can vanish at every integer without
converging along the half-line. Integer convergence needs a genuine extension. -/
theorem integer_convergence_not_halfline_convergence :
    ∃ f : ℝ≥0 → ℝ, Continuous f ∧
      (∀ n : ℕ, f (n : ℝ≥0) = 0) ∧ ¬ Filter.Tendsto f Filter.atTop (nhds 0) := by
  let f (t : ℝ≥0) := Real.sin (2 * Real.pi * t)
  have hn (n : ℕ) : f (n : ℝ≥0) = 0 := by
    change Real.sin (2 * Real.pi * (n : ℝ)) = 0
    rw [show 2 * Real.pi * (n : ℝ) = 0 + (n : ℝ) * (2 * Real.pi) by ring,
      Real.sin_add_nat_mul_two_pi, Real.sin_zero]
  refine ⟨f, Real.continuous_sin.comp (continuous_const.mul NNReal.continuous_coe), hn, ?_⟩
  intro h
  let u (n : ℕ) : ℝ≥0 := (n : ℝ≥0) + 1 / 4
  have hu : Filter.Tendsto u Filter.atTop Filter.atTop := by
    apply Filter.tendsto_atTop_mono (fun n ↦ le_add_of_nonneg_right (by positivity))
      tendsto_natCast_atTop_atTop
  have hv (n : ℕ) : f (u n) = 1 := by
    simp only [f, u, NNReal.coe_add, NNReal.coe_natCast, NNReal.coe_div,
      NNReal.coe_one, NNReal.coe_ofNat]
    rw [show 2 * Real.pi * ((n : ℝ) + 1 / 4) =
      Real.pi / 2 + (n : ℝ) * (2 * Real.pi) by ring,
      Real.sin_add_nat_mul_two_pi, Real.sin_pi_div_two]
  have hzero : Filter.Tendsto (fun _ : ℕ ↦ (1 : ℝ)) Filter.atTop (nhds 0) :=
    (h.comp hu).congr' (Filter.Eventually.of_forall hv)
  have hbad : (1 : ℝ) = 0 := tendsto_nhds_unique tendsto_const_nhds hzero
  norm_num at hbad

/-- Whole-half-line convergence of a constant martingale retains its
arbitrary nonzero initial random variable. -/
theorem halfline_limit_constant_retains_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ}
    (hV : Measurable[F 0] V) (hL : MemLp V 2 P) :
    ∃ Z : Ω → ℝ, MemLp Z 2 P ∧ Z =ᵐ[P] V ∧
      (∀ᵐ ω ∂P, Filter.Tendsto (fun _ : ℝ≥0 ↦ V ω) Filter.atTop (nhds (Z ω))) := by
  have hM : Martingale (fun (_ : ℝ≥0) ↦ V) F P :=
    martingale_const_fun F P hV.stronglyMeasurable (hL.integrable (by norm_num))
  obtain ⟨Z, hZ, hlim, _, _, _⟩ := hM.exists_memLp_two_limit_of_bounded_second_moments
    (Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const) (fun _ ↦ hL)
      (C := ∫ ω, V ω ^ 2 ∂P) (fun _ ↦ le_rfl)
  refine ⟨Z, hZ, ?_, hlim⟩
  filter_upwards [hlim] with ω hω
  exact tendsto_nhds_unique hω tendsto_const_nhds

/-- One full-half-line event supports sample-dependent clocks escaping to
infinity; neither deterministic sampling nor a stopping property is required. -/
theorem terminal_energy_random_clock_limit
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (hM : IsLocalMartingale X F P)
    (hI : (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P) < ∞)
    (τ : ℝ≥0 → Ω → ℝ≥0)
    (hτ : ∀ᵐ ω ∂P, Filter.Tendsto (fun t ↦ τ t ω) Filter.atTop Filter.atTop) :
    ∃ Z : Ω → ℝ, MemLp Z 2 P ∧
      (∀ᵐ ω ∂P, Filter.Tendsto (fun t ↦ X (τ t ω) ω) Filter.atTop (nhds (Z ω))) ∧
      (∫ ω, Z ω ^ 2 ∂P) = (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P).toReal := by
  obtain ⟨Z, hZ, hlim, _, _, hE⟩ := hX.exists_memLp_two_limit_terminal_energy hF hM hI
  refine ⟨Z, hZ, ?_, hE⟩
  filter_upwards [hlim, hτ] with ω hω hτω
  exact hω.comp hτω

/-- Any claimed full-time terminal value is AE the constructed value, so
its L2 membership and moment identity cannot depend on a choice of witness. -/
theorem terminal_energy_limit_independent_of_choice
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (hM : IsLocalMartingale X F P)
    (hI : (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P) < ∞) {W : Ω → ℝ}
    (hW : ∀ᵐ ω ∂P, Filter.Tendsto (fun t : ℝ≥0 ↦ X t ω) Filter.atTop (nhds (W ω))) :
    MemLp W 2 P ∧
      (∫ ω, W ω ^ 2 ∂P) = (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P).toReal := by
  obtain ⟨Z, hZ, hlim, _, _, hE⟩ := hX.exists_memLp_two_limit_terminal_energy hF hM hI
  have he : Z =ᵐ[P] W := by
    filter_upwards [hlim, hW] with ω hω hWω
    exact tendsto_nhds_unique hω hWω
  refine ⟨hZ.ae_eq he, ?_⟩
  have he2 : (fun ω ↦ Z ω ^ 2) =ᵐ[P] fun ω ↦ W ω ^ 2 := he.pow_const 2
  exact (integral_congr_ae he2).symm.trans hE

/-- An explicit value at infinity is not Mathlib's totalized finite-time
evaluation. Agreement requires a mathematical terminal-value hypothesis. -/
theorem terminal_value_at_infinity_is_explicit :
    stoppedValueWithTerminal (fun (_ : ℝ≥0) (_ : Unit) ↦ (5 : ℝ)) (fun _ ↦ 7)
      (fun _ ↦ ⊤) () = 7 ∧
    stoppedValue (fun (_ : ℝ≥0) (_ : Unit) ↦ (5 : ℝ)) (fun _ ↦ ⊤) () = 5 := by
  constructor
  · exact stoppedValueWithTerminal_of_top rfl
  · rfl

/-- Supplying a false terminal value does not create convergence of the
finite truncations. This rejects omission of the full-time limit premise. -/
theorem wrong_terminal_value_breaks_truncation_limit :
    ¬ Filter.Tendsto (fun n : ℕ ↦ stoppedValue
      (fun (_ : ℝ≥0) (_ : Unit) ↦ (5 : ℝ))
      (fun _ ↦ min (⊤ : WithTop ℝ≥0) ((n : ℝ≥0) : WithTop ℝ≥0)) ())
      Filter.atTop (nhds (stoppedValueWithTerminal
        (fun (_ : ℝ≥0) (_ : Unit) ↦ (5 : ℝ)) (fun _ ↦ 7) (fun _ ↦ ⊤) ())) := by
  intro h
  have h' : Filter.Tendsto (fun _ : ℕ ↦ (5 : ℝ)) Filter.atTop (nhds 7) := h
  have he : (5 : ℝ) = 7 := tendsto_nhds_unique tendsto_const_nhds h'
  norm_num at he

/-- Finite and infinite samples use their respective values on the same
random time; no almost-sure-finiteness assumption is smuggled in. -/
theorem terminal_value_mixed_finite_infinite {Ω : Type*}
    (X : ℝ≥0 → Ω → ℝ) (Z : Ω → ℝ) (A : Set Ω) [DecidablePred (· ∈ A)] :
    stoppedValueWithTerminal X Z (fun ω ↦ if ω ∈ A then 0 else ⊤) =
      fun ω ↦ if ω ∈ A then X 0 ω else Z ω := by
  ext ω
  by_cases hω : ω ∈ A
  · simp only [stoppedValueWithTerminal, if_pos hω, if_neg (by simp : (0 : WithTop ℝ≥0) ≠ ⊤),
      stoppedValue]
    rfl
  · simp only [stoppedValueWithTerminal, if_neg hω, ite_true]

/-- Sampling when both times are infinite gives the actual terminal value,
measurable in the stopping sigma-field, rather than a totalized evaluation. -/
theorem infinite_sampling_both_top_uses_terminal
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Z : Ω → ℝ}
    (hX : Martingale X F P) (hu : UniformIntegrable X 1 P)
    (hF : F.IsUsual P) (hr : HasRightContinuousPaths X P)
    (hlim : ∀ᵐ ω ∂P, Filter.Tendsto (fun t : ℝ≥0 ↦ X t ω) Filter.atTop (nhds (Z ω))) :
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    Z =ᵐ[P] P[Z | htop.measurableSpace] := by
  have htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
  simpa only [stoppedValueWithTerminal_top] using
    hX.stoppedValueWithTerminal_ae_eq_condExp_of_ae_le hu hF hr hlim htop htop
      (Filter.Eventually.of_forall fun _ ↦ le_rfl)

/-- Infinite-terminal sampling at time zero preserves the original initial
variable as a conditional expectation, without assuming it vanishes. -/
theorem infinite_sampling_from_time_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Z : Ω → ℝ}
    (hX : Martingale X F P) (hu : UniformIntegrable X 1 P)
    (hF : F.IsUsual P) (hr : HasRightContinuousPaths X P)
    (hlim : ∀ᵐ ω ∂P, Filter.Tendsto (fun t : ℝ≥0 ↦ X t ω) Filter.atTop (nhds (Z ω))) :
    X 0 =ᵐ[P] P[Z | F 0] := by
  simpa only [stoppedValueWithTerminal_coe, IsStoppingTime.measurableSpace_const] using
    hX.stoppedValueWithTerminal_ae_eq_condExp_terminal hu hF hr hlim (isStoppingTime_const F 0)

/-- Finite energy supplies the terminal variable, both stopped L2 values
and optional sampling even when the times are infinite and ordered only AE. -/
theorem finite_energy_supplies_unbounded_sampling
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (hM : IsLocalMartingale X F P)
    (hI : (∫⁻ ω, hX.quadraticVariationInfinity hF ω ∂P) < ∞)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) :
    ∃ Z : Ω → ℝ, MemLp Z 2 P ∧ MemLp (stoppedValueWithTerminal X Z σ) 2 P ∧
      MemLp (stoppedValueWithTerminal X Z τ) 2 P ∧
      stoppedValueWithTerminal X Z σ =ᵐ[P]
        P[stoppedValueWithTerminal X Z τ | hσ.measurableSpace] := by
  obtain ⟨Z, hZ, _, _, hS, hO⟩ := hX.exists_terminal_optionalSampling_of_finite_energy hF hM hI
  exact ⟨Z, hZ, (hS σ hσ).1, (hS τ hτ).1, hO σ τ hσ hτ hle⟩

/-- At horizon zero, weak Doob controls the actual initial variable, with
no path regularity or square-integrability premise. -/
theorem weak_doob_zero_horizon
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : Martingale X F P) (ε : ℝ≥0) :
    (ε : ℝ≥0∞) * P {ω | (ε : ℝ) < ‖X 0 ω‖} ≤ ENNReal.ofReal (∫ ω, ‖X 0 ω‖ ∂P) := by
  have he : {ω | (ε : ℝ≥0∞) < denseRunningSupremum (fun t ω ↦ ‖X t ω‖) 0 ω} =
      {ω | (ε : ℝ) < ‖X 0 ω‖} := by
    have hz (n : ℕ) : denseTimeUpTo 0 n = 0 := min_eq_left bot_le
    ext ω
    simpa only [Set.mem_ofPred_eq, denseRunningSupremum, hz, iSup_const,
      ENNReal.ofReal_coe_nnreal] using
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg ε.coe_nonneg :
        ENNReal.ofReal (ε : ℝ) < ENNReal.ofReal ‖X 0 ω‖ ↔ (ε : ℝ) < ‖X 0 ω‖)
  rw [← he]
  exact hX.measure_denseRunningSupremum_norm_gt_le 0 ε

/-- A non-L2 but integrable constant martingale still satisfies weak L1
Doob, and the conclusion does not promote it to square-integrability. -/
theorem weak_doob_non_L2_constant
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hV : Measurable[F 0] V)
    (hi : Integrable V P) (hnot : ¬ MemLp V 2 P) :
    (∀ (T : ℝ≥0) (ε : ℝ≥0), (ε : ℝ≥0∞) * P {ω | (ε : ℝ≥0∞) <
      denseRunningSupremum (fun (_ : ℝ≥0) ω ↦ ‖V ω‖) T ω} ≤
        ENNReal.ofReal (∫ ω, ‖V ω‖ ∂P)) ∧
      ¬ IsSquareIntegrableMartingale (fun (_ : ℝ≥0) ↦ V) F P := by
  have hM := martingale_const_fun F P hV.stronglyMeasurable hi
  exact ⟨fun T ε ↦ hM.measure_denseRunningSupremum_norm_gt_le T ε, fun h ↦ hnot (h.2 0)⟩

/-- A nonzero constant crosses a lower level already at time zero. -/
theorem weak_doob_retains_constant_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    P {_ω | (4 : ℝ) < ‖(5 : ℝ)‖} = 1 ∧
      (4 : ℝ≥0∞) * P {_ω | (4 : ℝ) < ‖(5 : ℝ)‖} ≤ 5 := by
  have hM : Martingale (fun (_ : ℝ≥0) (_ : Ω) ↦ (5 : ℝ)) F P :=
    martingale_const_fun F P stronglyMeasurable_const (integrable_const 5)
  refine ⟨by norm_num, ?_⟩
  simpa using weak_doob_zero_horizon hM 4

/-- UI convergence retains an integrable initial variable even when that
variable is not square-integrable. The terminal value remains non-L2. -/
theorem ui_non_L2_constant_terminal
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hV : Measurable[F 0] V)
    (hi : Integrable V P) (hnot : ¬ MemLp V 2 P) :
    ∃ Z : Ω → ℝ, Integrable Z P ∧
      (∀ᵐ ω ∂P, Filter.Tendsto (fun (_ : ℝ≥0) ↦ V ω) Filter.atTop (nhds (Z ω))) ∧
      Filter.Tendsto (fun (_ : ℝ≥0) ↦ eLpNorm (V - Z) 1 P) Filter.atTop (nhds 0) ∧
      Z =ᵐ[P] V ∧ ¬ MemLp Z 2 P := by
  have hM := martingale_const_fun F P hV.stronglyMeasurable hi
  have hc : HasRightContinuousPaths (fun (_ : ℝ≥0) ↦ V) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  have hu : UniformIntegrable (fun (_ : ℝ≥0) ↦ V) 1 P :=
    uniformIntegrable_const le_rfl (by simp) (memLp_one_iff_integrable.mpr hi)
  obtain ⟨Z, hZ, ha, hL, _⟩ := hM.exists_integrable_limit_of_uniformIntegrable hc hu
  have he : Z =ᵐ[P] V := by
    filter_upwards [ha] with ω hω
    exact tendsto_nhds_unique hω tendsto_const_nhds
  exact ⟨Z, hZ, ha, hL, he, fun h ↦ hnot (h.ae_eq he)⟩

/-- General UI, not terminal energy or a supplied limit, constructs the
integrable values and sampling identity at two possibly infinite times. -/
theorem ui_terminal_sampling_without_limit_premise
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : Martingale X F P) (hc : HasRightContinuousPaths X P)
    (hu : UniformIntegrable X 1 P) (hF : F.IsUsual P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) :
    ∃ Z : Ω → ℝ, Integrable Z P ∧
      Integrable (stoppedValueWithTerminal X Z σ) P ∧
      Integrable (stoppedValueWithTerminal X Z τ) P ∧
      stoppedValueWithTerminal X Z σ =ᵐ[P]
        P[stoppedValueWithTerminal X Z τ | hσ.measurableSpace] := by
  obtain ⟨Z, hZ, _, _, _, hS, hO⟩ :=
    hM.exists_terminal_optionalSampling_of_uniformIntegrable hc hu hF
  exact ⟨Z, hZ, (hS σ hσ).1, (hS τ hτ).1, hO σ τ hσ hτ hle⟩

/-- Actual whole-time UI convergence applies to sample-dependent escaping
clocks, without stopping-time, measurability or independence assumptions. -/
theorem ui_terminal_follows_escaping_clocks
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hM : Martingale X F P) (hc : HasRightContinuousPaths X P)
    (hu : UniformIntegrable X 1 P) (clock : ℕ → Ω → ℝ≥0)
    (hclock : ∀ᵐ ω ∂P, Filter.Tendsto (fun n ↦ clock n ω) Filter.atTop Filter.atTop) :
    ∃ Z : Ω → ℝ, Integrable Z P ∧
      (∀ᵐ ω ∂P, Filter.Tendsto (fun n ↦ X (clock n ω) ω) Filter.atTop (nhds (Z ω))) := by
  obtain ⟨Z, hZ, hlim, _, _⟩ := hM.exists_integrable_limit_of_uniformIntegrable hc hu
  refine ⟨Z, hZ, ?_⟩
  filter_upwards [hlim, hclock] with ω hω hcω
  exact hω.comp hcω

/-- On a symmetric two-point probability space, a nonzero sign variable
closes the zero martingale in the trivial filtration. Its terminal projection
is zero, not that sign variable. This is a concrete nonuniqueness guard. -/
theorem arbitrary_closing_variable_not_terminal :
    let p : unitInterval := ⟨1 / 2, by constructor <;> norm_num⟩
    let P := bernoulliMeasure false true p
    let Y : Bool → ℝ := fun b ↦ if b then 1 else -1
    let F := Filtration.const (m := inferInstance) ℝ≥0 (⊥ : MeasurableSpace Bool) bot_le
    Integrable Y P ∧ (∀ t, (fun _ ↦ (0 : ℝ)) =ᵐ[P] P[Y | F t]) ∧
      P[Y | ⨆ t, F t] = (fun _ ↦ (0 : ℝ)) ∧ ¬ Y =ᵐ[P] (fun _ ↦ (0 : ℝ)) := by
  intro p P Y F
  have hE : (∫ ω, Y ω ∂P) = 0 := by
    rw [integral_bernoulliMeasure]
    norm_num [Y, p]
  have hF (t : ℝ≥0) : F t = ⊥ := rfl
  have hsup : (⨆ t, F t) = ⊥ := by simp only [hF, iSup_const]
  refine ⟨integrable_bernoulliMeasure _ _ _ _, ?_, ?_, ?_⟩
  · intro t
    rw [hF, condExp_bot, hE]
  · rw [hsup, condExp_bot, hE]
  · intro h
    obtain ⟨b, hb⟩ := Filter.Eventually.exists h
    cases b <;> norm_num [Y] at hb

/-- A closing variable is itself the actual limit when it is measurable
in the terminal sigma-field; ambient measurability alone is not substituted. -/
theorem terminal_projection_recovers_measurable_closing
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Y Z : Ω → ℝ}
    (hi : Integrable Y P) (hm : StronglyMeasurable[⨆ t, F t] Y)
    (hclose : ∀ t, X t =ᵐ[P] P[Y | F t])
    (hlim : ∀ᵐ ω ∂P, Filter.Tendsto (fun t : ℝ≥0 ↦ X t ω) Filter.atTop (nhds (Z ω))) :
    Z =ᵐ[P] Y := by
  have h := ae_eq_condExp_iSup_of_closing_limit hclose hlim
  rwa [condExp_of_stronglyMeasurable (iSup_le F.le) hm hi] at h

/-- The extended-index martingale retains a random integrable initial
variable, at both time zero and infinity, with no square-moment assumption. -/
theorem extended_constant_preserves_random_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ}
    (hm : StronglyMeasurable[F 0] V) (hi : Integrable V P) :
    Martingale (fun t : WithTop ℝ≥0 ↦
      stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) V (fun _ ↦ t)) F.withTerminal P ∧
      stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) V (fun _ ↦ (0 : WithTop ℝ≥0)) = V ∧
      stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) V (fun _ ↦ ⊤) = V := by
  have hM := martingale_const_fun F P hm hi
  have hC (t : ℝ≥0) : V =ᵐ[P] P[V | F t] := by
    rw [condExp_of_stronglyMeasurable (F.le t) (hm.mono (F.mono bot_le)) hi]
  refine ⟨hM.withTerminal_of_integrable_closing hi (hm.mono (le_iSup F 0)) hC, ?_, ?_⟩
  · exact stoppedValueWithTerminal_coe (fun _ ↦ (0 : ℝ≥0))
  · exact stoppedValueWithTerminal_top

/-- Closing-variable input suffices for native sampling after the terminal
projection, with no terminal measurability or path-limit premise on that input. -/
theorem closing_projection_sampling_without_terminal_measurability
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Y : Ω → ℝ}
    (hM : Martingale X F P) (hc : HasRightContinuousPaths X P) (hF : F.IsUsual P)
    (hY : Integrable Y P) (hclose : ∀ t, X t =ᵐ[P] P[Y | F t])
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) :
    Integrable (stoppedValueWithTerminal X P[Y | ⨆ t, F t] σ) P ∧
      Integrable (stoppedValueWithTerminal X P[Y | ⨆ t, F t] τ) P ∧
      stoppedValueWithTerminal X P[Y | ⨆ t, F t] σ =ᵐ[P] P[Y | hσ.measurableSpace] ∧
      stoppedValueWithTerminal X P[Y | ⨆ t, F t] σ =ᵐ[P]
        P[stoppedValueWithTerminal X P[Y | ⨆ t, F t] τ | hσ.measurableSpace] :=
  ⟨hM.integrable_stoppedValue_closingProjection hc hF hY hclose hσ,
    hM.integrable_stoppedValue_closingProjection hc hF hY hclose hτ,
    hM.stoppedValue_closingProjection_ae_eq_condExp hc hF hY hclose hσ,
    hM.stoppedValue_closingProjection_optionalSampling hc hF hY hclose hσ hτ hle⟩

/-- The symmetric two-point closing counterexample has a usual filtration.
At two infinite stopping times the unprojected variable fails native optional
sampling. Thus usual conditions do not repair the terminal sigma-field mismatch. -/
theorem unprojected_closing_fails_native_infinite_sampling :
    let p : unitInterval := ⟨1 / 2, by constructor <;> norm_num⟩
    let P := bernoulliMeasure false true p
    let Y : Bool → ℝ := fun b ↦ if b then 1 else -1
    let F := Filtration.const (m := inferInstance) ℝ≥0 (⊥ : MeasurableSpace Bool) bot_le
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    F.IsUsual P ∧ ¬ stoppedValueWithTerminal (fun (_ : ℝ≥0) (_ : Bool) ↦ (0 : ℝ)) Y
      (fun _ ↦ ⊤) =ᵐ[P] P[stoppedValueWithTerminal (fun (_ : ℝ≥0) (_ : Bool) ↦ (0 : ℝ)) Y
        (fun _ ↦ ⊤) | htop.measurableSpace] := by
  classical
  intro p P Y F htop
  have hpos (b : Bool) : P {b} ≠ 0 := by
    rw [bernoulliMeasure_apply p (measurableSet_singleton b)]
    cases b <;> norm_num [p, unitInterval.toNNReal, unitInterval.symm]
    all_goals
      apply ENNReal.coe_ne_zero.mpr
      apply NNReal.coe_ne_zero.mp
      change (1 / 2 : ℝ) ≠ 0
      norm_num
  refine ⟨⟨⟨fun t ↦ ?_⟩, fun s hs ↦ ?_⟩, ?_⟩
  · rw [F.rightCont_eq_of_neBot_nhdsGT]
    exact iInf₂_le_of_le (t + 1) (by simp) le_rfl
  · have he : s = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro b hb
      exact hpos b (measure_mono_null (Set.singleton_subset_iff.mpr hb) hs)
    rw [he]
    exact @MeasurableSet.empty Bool (F ⊥)
  · obtain ⟨_, _, hproj, hnot⟩ := arbitrary_closing_variable_not_terminal
    have hp : P[Y | ⨆ t, F t] = (fun _ ↦ (0 : ℝ)) := hproj
    have hn : ¬ Y =ᵐ[P] (fun _ ↦ (0 : ℝ)) := hnot
    simpa only [stoppedValueWithTerminal_top, htop.measurableSpace_top, hp] using hn

/-- The native count is strict-before: an upper crossing at index one is
absent before one and present before two. Finite partitions must use size+1. -/
theorem upcrossing_terminal_sample_requires_successor
    {Ω : Type*} {f : ℕ → Ω → ℝ} {ω : Ω} {a b : ℝ}
    (hab : a < b) (h0 : f 0 ω < a) (h1 : b < f 1 ω) :
    upcrossingsBefore a b f 1 ω = 0 ∧ 0 < upcrossingsBefore a b f 2 ω := by
  constructor
  · apply Nat.eq_zero_of_not_pos
    intro h
    have hu := upperCrossingTime_lt_of_le_upcrossingsBefore (N := 1) (n := 1)
      (by decide) hab h
    have hz : upperCrossingTime a b f 1 1 ω = 0 := by omega
    have hv := stoppedValue_upperCrossingTime (n := 0) hu.ne
    change b ≤ f (upperCrossingTime a b f 1 1 ω) ω at hv
    rw [hz] at hv
    linarith
  · simpa only [upcrossingsBefore_zero] using
      (upcrossingsBefore_lt_of_exists_upcrossing (N := 0) (N₁ := 0) (N₂ := 1)
        hab le_rfl h0 (by decide) h1)

/-- Monotone sampling may repeat times. It preserves a proper submartingale
and the negative supermartingale, but does not turn either inequality into
a martingale identity. -/
theorem repeated_sampling_preserves_one_sided_martingales
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    let e : ℕ → ℝ≥0 := fun n ↦ min (n : ℝ≥0) 1
    let G := F.reindex e (fun _ _ h ↦ min_le_min_right 1 (Nat.cast_le.mpr h))
    Submartingale (fun n (_ : Ω) ↦ (e n : ℝ)) G P ∧
      Supermartingale (fun n (_ : Ω) ↦ -(e n : ℝ)) G P ∧
      ¬ Martingale (fun n (_ : Ω) ↦ (e n : ℝ)) G P := by
  intro e G
  have he : Monotone e := fun _ _ h ↦ min_le_min_right 1 (Nat.cast_le.mpr h)
  have hX : Submartingale (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ)) F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_, fun t ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ (NNReal.coe_le_coe.mpr hst)
  refine ⟨hX.reindex e he, hX.neg.reindex e he, fun h ↦ ?_⟩
  have hC : P[(fun _ : Ω ↦ (1 : ℝ)) | G 0] =ᵐ[P] (fun _ : Ω ↦ (0 : ℝ)) := by
    simpa [e] using h.condExp_ae_eq (show (0 : ℕ) ≤ 1 by decide)
  rw [condExp_const (G.le 0)] at hC
  obtain ⟨ω, hω⟩ := Filter.Eventually.exists hC
  norm_num at hω

/-- The upcrossing estimate is valid for a finite, not necessarily probability,
measure. The level correction retains the total mass and the actual endpoint. -/
theorem upcrossing_partition_retains_mass_and_endpoint
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {T : ℝ≥0}
    (hX : Submartingale X F P) (a b : ℝ) (π : TimePartition T) :
    (b - a) * (∫ ω,
      (upcrossingsBefore a b (fun n ↦ X (π.pointNat n)) (π.size + 1) ω : ℝ) ∂P) ≤
        (∫ ω, ‖X T ω‖ ∂P) + P.real Set.univ * |a| :=
  hX.mul_integral_upcrossings_partition_le_firstMoment a b π

/-- A non-strict target cutoff can discard the very crossing retained by
the sampled process. This rejects weakening the embedding hypothesis. -/
theorem upcrossing_embedding_requires_strict_cutoff
    {Ω : Type*} {f : ℕ → Ω → ℝ} {ω : Ω} {a b : ℝ}
    (hab : a < b) (h0 : f 0 ω < a) (h1 : b < f 1 ω) :
    (∀ n : ℕ, n < 2 → n ≤ 1) ∧
      ¬ upcrossingsBefore a b f 2 ω ≤ upcrossingsBefore a b f 1 ω := by
  obtain ⟨hz, hp⟩ := upcrossing_terminal_sample_requires_successor hab h0 h1
  exact ⟨by omega, by simpa only [hz, not_le] using hp⟩

/-- Repeating every sample twice does not create or remove an upcrossing.
This genuinely uses a non-strict monotone sampling map. -/
theorem upcrossing_repeated_samples_have_same_count
    {Ω : Type*} {f : ℕ → Ω → ℝ} {ω : Ω} {a b : ℝ} (hab : a < b) (N : ℕ) :
    upcrossingsBefore a b (fun n ↦ f (n / 2)) (2 * N) ω = upcrossingsBefore a b f N ω := by
  apply le_antisymm
  · apply MeasureTheory.upcrossingsBefore_comp_le hab (e := fun n ↦ n / 2)
    · exact fun _ _ h ↦ Nat.div_le_div_right h
    · intro n hn
      omega
  · have he : Monotone (fun n : ℕ ↦ 2 * n) := fun _ _ h ↦ Nat.mul_le_mul_left 2 h
    have hb : ∀ n < N, 2 * n < 2 * N := by omega
    have h := MeasureTheory.upcrossingsBefore_comp_le (f := fun n ↦ f (n / 2)) hab he hb
      (ω := ω)
    have hs : (fun n ↦ f (2 * n / 2)) = f := by
      funext n
      congr 1
      omega
    simpa only [hs] using h

/-- The actual union-of-endpoints common refinement controls the upcrossing
counts of both inputs, even when their endpoint lists contain repetitions. -/
theorem upcrossing_common_refinement_controls_both
    {Ω : Type*} {X : ℝ≥0 → Ω → ℝ} {ω : Ω} {a b : ℝ} {T : ℝ≥0}
    (hab : a < b) (π ρ : TimePartition T) :
    upcrossingsBefore a b (fun n ↦ X (π.pointNat n)) (π.size + 1) ω ≤
      upcrossingsBefore a b (fun n ↦ X ((π.commonRefinement ρ).pointNat n))
        ((π.commonRefinement ρ).size + 1) ω ∧
    upcrossingsBefore a b (fun n ↦ X (ρ.pointNat n)) (ρ.size + 1) ω ≤
      upcrossingsBefore a b (fun n ↦ X ((π.commonRefinement ρ).pointNat n))
        ((π.commonRefinement ρ).size + 1) ω :=
  ⟨(π.commonRefinement_refines_left ρ).upcrossingsBefore_le hab,
    (π.commonRefinement_refines_right ρ).upcrossingsBefore_le hab⟩

/-- The earlier continuous bounded integer-convergence counterexample must
have infinitely many dense upcrossings for some rational level pair. This
tests the actual full-time extension rather than merely integer convergence. -/
theorem integer_counterexample_has_infinite_dense_upcrossings :
    ∃ f : ℝ≥0 → ℝ, Continuous f ∧ (∀ n : ℕ, f (n : ℝ≥0) = 0) ∧
      ∃ a b : ℚ, a < b ∧ denseUpcrossings a b (fun t (_ : Unit) ↦ f t) () = ⊤ := by
  obtain ⟨f, hc, hn, hnot⟩ := integer_convergence_not_halfline_convergence
  refine ⟨f, hc, hn, ?_⟩
  by_contra h
  have hf (a b : ℚ) (hab : a < b) :
      denseUpcrossings a b (fun t (_ : Unit) ↦ f t) () < ⊤ := by
    apply lt_top_iff_ne_top.mpr
    exact fun he ↦ h ⟨a, b, hab, he⟩
  have hl : Filter.Tendsto (fun n : ℕ ↦ f (n : ℝ≥0)) Filter.atTop (nhds 0) := by
    simpa only [hn] using
      (tendsto_const_nhds : Filter.Tendsto (fun _ : ℕ ↦ (0 : ℝ)) Filter.atTop (nhds 0))
  exact hnot (tendsto_of_integer_limit_of_denseUpcrossings
    (fun _ ↦ hc.continuousWithinAt) hl hf)

/-- A proper supermartingale is covered, not just a martingale repackaged
with weaker hypotheses. Its finite first moments are bounded and it vanishes
after time one. -/
theorem l1_limit_proper_supermartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ 1 - min (t : ℝ) 1
    Supermartingale X F P ∧ ¬ Martingale X F P ∧
      ∃ Z : Ω → ℝ, Integrable Z P ∧
        ∀ᵐ ω ∂P, Filter.Tendsto (fun t ↦ X t ω) Filter.atTop (nhds (Z ω)) := by
  intro X
  have hS : Supermartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_, fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦
      sub_le_sub_left (min_le_min_right 1 (NNReal.coe_le_coe.mpr hst)) 1
  have hnot : ¬ Martingale X F P := by
    intro hM
    have h := hM.condExp_ae_eq (show (0 : ℝ≥0) ≤ 1 by positivity)
    change P[(fun _ : Ω ↦ 1 - min (1 : ℝ) 1) | F 0] =ᵐ[P]
      (fun _ : Ω ↦ 1 - min (0 : ℝ) 1) at h
    rw [condExp_const (F.le 0)] at h
    obtain ⟨ω, hω⟩ := h.exists
    norm_num at hω
  have hr : HasRightContinuousPaths X P :=
    Filter.Eventually.of_forall fun _ _ ↦
      (continuous_const.sub (NNReal.continuous_coe.min continuous_const)).continuousWithinAt
  have hb (t : ℝ≥0) : (∫ ω, ‖X t ω‖ ∂P) ≤ (1 : ℝ) := by
    have h0 : 0 ≤ 1 - min (t : ℝ) 1 := sub_nonneg.mpr (min_le_right _ _)
    simp only [X, integral_const, probReal_univ, smul_eq_mul, one_mul,
      Real.norm_eq_abs, abs_of_nonneg h0]
    linarith [le_min (NNReal.coe_nonneg t) (show (0 : ℝ) ≤ 1 by norm_num)]
  exact ⟨hS, hnot, hS.exists_integrable_limit_of_L1_bounded hr hb⟩

/-- The general L1-bound entry retains an arbitrary non-L2 initial random
constant; its integrable terminal value is not silently upgraded to L2. -/
theorem l1_bounded_limit_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ}
    (hm : StronglyMeasurable[F 0] V) (hi : Integrable V P) (hnot : ¬ MemLp V 2 P) :
    ∃ Z : Ω → ℝ, Integrable Z P ∧ Z =ᵐ[P] V ∧ ¬ MemLp Z 2 P := by
  have hM : Martingale (fun (_ : ℝ≥0) ↦ V) F P :=
    martingale_const_fun F P hm hi
  have hr : HasRightContinuousPaths (fun (_ : ℝ≥0) ↦ V) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  obtain ⟨Z, hZ, hl⟩ := hM.exists_integrable_limit_of_L1_bounded hr (fun _ ↦ le_rfl)
  have he : Z =ᵐ[P] V := by
    filter_upwards [hl] with ω hω
    exact tendsto_nhds_unique hω tendsto_const_nhds
  exact ⟨Z, hZ, he, fun h ↦ hnot (h.ae_eq he)⟩

/-- General L1-bounded one-sided convergence follows arbitrary sample-dependent
escaping clocks. No UI, stopping-time or measurable-clock assumption is added. -/
theorem l1_bounded_supermartingale_follows_escaping_clocks
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {C : ℝ}
    (hS : Supermartingale X F P) (hr : HasRightContinuousPaths X P)
    (hC : ∀ t, (∫ ω, ‖X t ω‖ ∂P) ≤ C) (clock : ℕ → Ω → ℝ≥0)
    (hc : ∀ᵐ ω ∂P, Filter.Tendsto (fun n ↦ clock n ω) Filter.atTop Filter.atTop) :
    ∃ Z : Ω → ℝ, Integrable Z P ∧
      ∀ᵐ ω ∂P, Filter.Tendsto (fun n ↦ X (clock n ω) ω) Filter.atTop (nhds (Z ω)) := by
  obtain ⟨Z, hZ, hl⟩ := hS.exists_integrable_limit_of_L1_bounded hr hC
  refine ⟨Z, hZ, ?_⟩
  filter_upwards [hl, hc] with ω hω hcω
  exact hω.comp hcω

/-- The countable-range supermartingale inequality is genuinely one-sided.
At zero the declining deterministic process is one, while its time-one
conditional expectation is zero. -/
theorem countable_supermartingale_sampling_not_equality
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ 1 - min (t : ℝ) 1
    let τ : Ω → WithTop ℝ≥0 := fun _ ↦ 0
    let hτ : IsStoppingTime F τ := isStoppingTime_const F 0
    P[X 1 | hτ.measurableSpace] ≤ᵐ[P] stoppedValue X τ ∧
      ¬ P[X 1 | hτ.measurableSpace] =ᵐ[P] stoppedValue X τ := by
  intro X τ hτ
  have hS : Supermartingale X F P := (l1_limit_proper_supermartingale F).1
  have hc : (Set.range τ).Countable := by
    apply (Set.countable_singleton (0 : WithTop ℝ≥0)).mono
    rintro _ ⟨ω, rfl⟩
    exact Set.mem_singleton 0
  refine ⟨hS.condExp_ae_le_stoppedValue_of_le_const_of_countable_range hτ
    (T := 1) (fun _ ↦ by simp [τ]) hc, ?_⟩
  intro h
  have hx : X 1 = (fun _ : Ω ↦ (0 : ℝ)) := by funext ω; simp [X]
  rw [hx] at h
  change P[(0 : Ω → ℝ) | hτ.measurableSpace] =ᵐ[P] stoppedValue X τ at h
  rw [condExp_zero] at h
  obtain ⟨ω, hω⟩ := h.exists
  norm_num [stoppedValue, τ, X, WithTop.untopA] at hω

/-- Bounded stopping needs only finite-time integrability: the deterministic
submartingale t has no global L1 bound, but its bounded stopped value is integrable. -/
theorem bounded_one_sided_stopping_without_global_L1_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime F τ)
    {T : ℝ≥0} (hb : ∀ ω, τ ω ≤ T) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ t
    Submartingale X F P ∧ (¬ ∃ C : ℝ, ∀ t, (∫ ω, ‖X t ω‖ ∂P) ≤ C) ∧
      Integrable (stoppedValue X τ) P := by
  intro X
  have hS : Submartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_, fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ NNReal.coe_le_coe.mpr hst
  have hr : HasRightContinuousPaths X P :=
    Filter.Eventually.of_forall fun _ _ ↦ NNReal.continuous_coe.continuousWithinAt
  refine ⟨hS, ?_, hS.integrable_stoppedValue_of_bounded hτ hb hr⟩
  rintro ⟨C, hC⟩
  obtain ⟨n, hn⟩ := exists_nat_gt C
  have h := hC (n : ℝ≥0)
  have hle : (n : ℝ) ≤ C := by simpa [X] using h
  exact (not_le_of_gt hn) hle

/-- A clipped ceiling index cannot represent an original time outside the
partition. Exact stopped-value transport must retain its range hypothesis. -/
theorem partition_index_requires_range_guard {T : ℝ≥0} (π : TimePartition T) :
    π.pointNat (π.ceilingIndex (T + 1)).val ≠ T + 1 := by
  apply ne_of_lt
  exact (π.point_le_horizon _).trans_lt (lt_add_one T)

/-- The signed first-moment bound also applies to negative supermartingales;
its initial expectation is not erased or assumed nonnegative. -/
theorem bounded_supermartingale_negative_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) (τ : FiniteStoppingTime F) {T : ℝ≥0}
    (hb : ∀ ω, τ ω ≤ T) :
    eLpNorm (fun _ : Ω ↦ (-1 : ℝ)) 1 P ≤ 1 := by
  have hS : Supermartingale (fun (_ : ℝ≥0) (_ : Ω) ↦ (-1 : ℝ)) F P :=
    (martingale_const F P (-1 : ℝ)).supermartingale
  have hr : HasRightContinuousPaths (fun (_ : ℝ≥0) (_ : Ω) ↦ (-1 : ℝ)) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  have h := hS.eLpNorm_finiteStoppingTime_value_le τ hb hr
  norm_num at h
  exact h

/-- Zero expectation at every deterministic time does not characterize a
martingale, even for adapted continuous processes on a two-point space. -/
theorem deterministic_zero_means_do_not_characterize_martingale :
    let p : unitInterval := ⟨1 / 2, by constructor <;> norm_num⟩
    let P := bernoulliMeasure false true p
    let F := Filtration.const ℝ≥0 (inferInstance : MeasurableSpace Bool) le_rfl
    let X : ℝ≥0 → Bool → ℝ := fun t b ↦ (t : ℝ) * (if b then 1 else -1)
    Adapted F X ∧ (∀ b, Continuous (fun t ↦ X t b)) ∧
      (∀ t, Integrable (X t) P ∧ (∫ b, X t b ∂P) = 0) ∧ ¬ Martingale X F P := by
  intro p P F X
  have hi (t : ℝ≥0) : Integrable (X t) P := integrable_bernoulliMeasure _ _ _ _
  have hm (t : ℝ≥0) : Measurable (X t) := measurable_of_countable _
  refine ⟨hm, fun b ↦ ?_, fun t ↦ ⟨hi t, ?_⟩, ?_⟩
  · exact NNReal.continuous_coe.mul continuous_const
  · rw [integral_bernoulliMeasure]
    norm_num [X, p]
  · intro hM
    have h := hM.condExp_ae_eq (show (0 : ℝ≥0) ≤ 1 by positivity)
    have he : P[X 1 | F 0] = X 1 :=
      condExp_of_stronglyMeasurable (F.le 0) (hm 1).stronglyMeasurable (hi 1)
    rw [he] at h
    obtain ⟨b, hb⟩ := h.exists
    cases b <;> norm_num [X] at hb

/-- In I.21, zero expected stopped values do not force a zero initial random
variable. Any nonzero centered integrable random constant passes the test. -/
theorem zero_expected_stopping_retains_random_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hV : Measurable[F 0] V)
    (hi : Integrable V P) (hE : (∫ ω, V ω ∂P) = 0) (hn : ¬ V =ᵐ[P] 0) :
    Martingale (fun (_ : ℝ≥0) ↦ V) F P ∧ UniformIntegrable (fun (_ : ℝ≥0) ↦ V) 1 P ∧
      ¬ Indistinguishable (fun (_ : ℝ≥0) ↦ V) 0 P := by
  have he (τ : Ω → WithTop ℝ≥0) :
      stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) V τ = V := by
    funext ω
    unfold stoppedValueWithTerminal
    split_ifs <;> rfl
  have hs := martingale_uniformIntegrable_of_zero_expected_stopping
    (F := F) (P := P) (Z := V) (fun t ↦ hV.mono (F.mono bot_le) le_rfl)
    (fun τ _ ↦ by rw [he τ]; exact ⟨hi, hE⟩)
  exact ⟨hs.1, hs.2, fun h ↦ hn (h.ae_eq 0)⟩

/-- The equal-expectation version preserves a nonzero initial mean. It is not
silently specialized to zero-starting or centered martingales. -/
theorem expected_stopping_characterization_allows_nonzero_mean
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    Martingale (fun (_ : ℝ≥0) (_ : Ω) ↦ (1 : ℝ)) F P ∧
      UniformIntegrable (fun (_ : ℝ≥0) (_ : Ω) ↦ (1 : ℝ)) 1 P ∧
      (∫ _ : Ω, (1 : ℝ) ∂P) ≠ 0 := by
  have he (τ : Ω → WithTop ℝ≥0) :
      stoppedValueWithTerminal (fun (_ : ℝ≥0) (_ : Ω) ↦ (1 : ℝ)) (fun _ ↦ 1) τ =
        (fun _ ↦ (1 : ℝ)) := by
    funext ω
    unfold stoppedValueWithTerminal
    split_ifs <;> rfl
  have hs := martingale_uniformIntegrable_of_expected_stopping_eq
    (F := F) (P := P) (Z := fun _ ↦ (1 : ℝ)) (fun _ ↦ measurable_const)
    (fun τ _ ↦ by rw [he τ]; exact ⟨integrable_const _, rfl⟩)
  exact ⟨hs.1, hs.2, by simp⟩

/-- The infinite stopping-time test exposes a nonintegrable terminal input;
it cannot be bypassed by the totalized finite-time stopped-value fallback. -/
theorem stopping_characterization_rejects_nonintegrable_terminal
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} {Z : Ω → ℝ} (hn : ¬ Integrable Z P) :
    ¬ (∀ (τ : Ω → WithTop ℝ≥0), IsStoppingTime F τ →
      Integrable (stoppedValueWithTerminal X Z τ) P) := by
  intro h
  have htop : IsStoppingTime F (fun _ : Ω ↦ (⊤ : WithTop ℝ≥0)) := by
    intro t
    simpa only [WithTop.not_top_le_coe, Set.ofPred_false] using (@MeasurableSet.empty Ω (F t))
  apply hn
  simpa only [stoppedValueWithTerminal_top] using h _ htop

/-- A convex decreasing map is allowed for a true martingale. The monotonicity
restriction belongs only to the submartingale-input corollary of I.19. -/
theorem martingale_convex_transform_need_not_be_monotone
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} (hM : Martingale X F P) :
    Submartingale (fun t ω ↦ -X t ω) F P ∧ ¬ Monotone (fun x : ℝ ↦ -x) := by
  refine ⟨hM.convex_comp ((concaveOn_id convex_univ).neg)
    (fun t ↦ (hM.integrable t).neg), ?_⟩
  intro h
  have h01 := h (show (0 : ℝ) ≤ 1 by positivity)
  norm_num at h01

/-- Convexity alone does not preserve a proper submartingale: applying minus
the identity to the increasing deterministic process gives a decreasing one. -/
theorem submartingale_convex_transform_requires_monotone
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ t
    Submartingale X F P ∧ ConvexOn ℝ Set.univ (fun x : ℝ ↦ -x) ∧
      (∀ t, Integrable (fun ω ↦ -X t ω) P) ∧
      ¬ Submartingale (fun t ω ↦ -X t ω) F P := by
  intro X
  refine ⟨⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_,
    fun _ ↦ integrable_const _⟩, (concaveOn_id convex_univ).neg,
    (fun t ↦ show Integrable (fun _ : Ω ↦ -(t : ℝ)) P from integrable_const _), ?_⟩
  · rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ NNReal.coe_le_coe.mpr hst
  · intro hS
    have h := hS.ae_le_condExp (show (0 : ℝ≥0) ≤ 1 by positivity)
    change (fun _ : Ω ↦ -(0 : ℝ)) ≤ᵐ[P] P[fun _ : Ω ↦ -(1 : ℝ) | F 0] at h
    rw [condExp_const (F.le 0)] at h
    obtain ⟨ω, hω⟩ := h.exists
    norm_num [X] at hω

/-- An integrable non-L2 random constant is a true martingale, but its convex
square is not a submartingale. Transformed integrability cannot be omitted. -/
theorem martingale_convex_transform_requires_integrability
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hV : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) :
    Martingale (fun (_ : ℝ≥0) ↦ V) F P ∧
      ConvexOn ℝ Set.univ (fun x : ℝ ↦ x ^ 2) ∧
      ¬ Submartingale (fun (_ : ℝ≥0) ω ↦ V ω ^ 2) F P := by
  refine ⟨martingale_const_fun F P hV hi, (even_two.convexOn_pow), ?_⟩
  intro hS
  exact hn ((memLp_two_iff_integrable_sq hi.aestronglyMeasurable).mpr (hS.integrable 0))

/-- The nondecreasing convex corollary applies to a genuinely nonlinear map
and a proper submartingale, not just to the martingale special case. -/
theorem submartingale_exponential_transform
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    Submartingale (fun (t : ℝ≥0) (_ : Ω) ↦ Real.exp t) F P := by
  have hS : Submartingale (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ)) F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_,
      fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ NNReal.coe_le_coe.mpr hst
  exact hS.convex_monotone_comp convexOn_exp Real.exp_monotone
    (fun _ ↦ integrable_const _)

/-- The general-p maximal inequality applies to proper nonnegative
submartingales, not only to norms of true martingales or to p = 2. -/
theorem doob_lp_proper_submartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ min (t : ℝ) 1
    Submartingale X F P ∧ ¬ Martingale X F P ∧
      eLpNorm (fun ω ↦ ⨆ t, ENNReal.ofReal (X t ω)) 3 P ≤
        ENNReal.ofReal (3 / 2 : ℝ) * ⨆ t, eLpNorm (X t) 3 P := by
  intro X
  have hS : Submartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_,
      fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ min_le_min
      (NNReal.coe_le_coe.mpr hst) le_rfl
  have hr : HasRightContinuousPaths X P := Filter.Eventually.of_forall
    fun _ _ ↦ (NNReal.continuous_coe.min continuous_const).continuousWithinAt
  refine ⟨hS, ?_, ?_⟩
  · intro hM
    have h := hM.condExp_ae_eq (show (0 : ℝ≥0) ≤ 1 by positivity)
    change P[fun _ : Ω ↦ min (1 : ℝ) 1 | F 0] =ᵐ[P]
      (fun _ : Ω ↦ min (0 : ℝ) 1) at h
    rw [condExp_const (F.le 0)] at h
    obtain ⟨ω, hω⟩ := h.exists
    norm_num at hω
  · have h := hS.eLpNorm_iSup_ofReal_le (fun t _ ↦ le_min t.coe_nonneg zero_le_one)
      hr (by norm_num : (1 : ℝ) < 3)
    norm_num at h
    exact h

/-- Extended suprema remain infinite when no finite global bound is present.
Converting this supremum to a real number would incorrectly give zero. -/
theorem doob_lp_infinite_supremum_is_not_zero :
    (⨆ t : ℝ≥0, ENNReal.ofReal (t : ℝ)) = ∞ ∧
      (1 : ℝ) > (⨆ t : ℝ≥0, ENNReal.ofReal (t : ℝ)).toReal := by
  have h : (⨆ t : ℝ≥0, ENNReal.ofReal (t : ℝ)) = ∞ := by
    apply top_unique
    rw [← ENNReal.iSup_natCast]
    apply iSup_le
    intro n
    simpa using le_iSup (fun t : ℝ≥0 ↦ ENNReal.ofReal (t : ℝ)) (n : ℝ≥0)
  exact ⟨h, by rw [h]; norm_num⟩

/-- Without right continuity, even a single isolated spike outside the fixed
dense grid invalidates the all-times supremum bridge. -/
theorem doob_dense_grid_requires_right_continuity {a : ℝ≥0}
    (ha : a ∉ Set.range (TopologicalSpace.denseSeq ℝ≥0)) :
    let f : ℝ≥0 → ℝ := fun t ↦ if t = a then 1 else 0
    (⨆ n, ENNReal.ofReal (f (TopologicalSpace.denseSeq ℝ≥0 n))) = 0 ∧
      (⨆ t, ENNReal.ofReal (f t)) = 1 ∧ ¬ IsRightContinuousPath f := by
  classical
  intro f
  have hd : (⨆ n, ENNReal.ofReal (f (TopologicalSpace.denseSeq ℝ≥0 n))) = 0 := by
    apply bot_unique
    apply iSup_le
    intro n
    have hn : TopologicalSpace.denseSeq ℝ≥0 n ≠ a := fun h ↦ ha ⟨n, h⟩
    simp [f, hn]
  have hf : (⨆ t, ENNReal.ofReal (f t)) = 1 := by
    apply le_antisymm
    · apply iSup_le
      intro t
      by_cases ht : t = a <;> simp [f, ht]
    · simpa [f] using le_iSup (fun t ↦ ENNReal.ofReal (f t)) a
  refine ⟨hd, hf, ?_⟩
  intro hr
  have h := iSup_ofReal_eq_iSup_denseSeq_of_rightContinuous hr
  rw [hf, hd] at h
  exact one_ne_zero h

/-- A nonzero random initial value is retained by the actual global maximal
envelope. The envelope theorem does not normalize the process at zero. -/
theorem doob_lp_random_initial_value
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} {p : ℝ}
    (hV : StronglyMeasurable[F 0] V) (hi : Integrable V P)
    (hn : ∀ ω, 0 ≤ V ω) (hp : 1 < p) (hLp : MemLp V (ENNReal.ofReal p) P) :
    ∃ g : Ω → ℝ, Measurable g ∧ MemLp g (ENNReal.ofReal p) P ∧ g =ᵐ[P] V := by
  have hM := martingale_const_fun F P hV hi
  have hr : HasRightContinuousPaths (fun (_ : ℝ≥0) ↦ V) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  obtain ⟨g, hgm, hgn, hgl, he, _, _⟩ := hM.submartingale.exists_memLp_globalEnvelope
    (fun _ ↦ hn) hr hp hLp.eLpNorm_lt_top (fun _ ↦ le_rfl)
  refine ⟨g, hgm, hgl, ?_⟩
  filter_upwards [he] with ω hω
  simp only [iSup_const] at hω
  exact (ENNReal.ofReal_eq_ofReal_iff (hgn ω) (hn ω)).mp hω

/-- Substituting p = 1 into the totalized real quotient would give a false
zero bound, already for the constant-one martingale. -/
theorem doob_lp_requires_strict_exponent
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P] :
    ¬ eLpNorm (fun _ : Ω ↦ (1 : ℝ)) 1 P ≤
      ENNReal.ofReal ((1 : ℝ) / (1 - 1)) * eLpNorm (fun _ : Ω ↦ (1 : ℝ)) 1 P := by
  simp [eLpNorm_const (1 : ℝ) one_ne_zero (NeZero.ne P)]

/-- Reverse one-sided UI includes a genuine non-martingale; its expectation
increases with the ordinary natural index, in the reverse time direction. -/
theorem reverse_ui_proper_supermartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℕᵒᵈ mΩ) :
    let X : ℕᵒᵈ → Ω → ℝ := fun n _ ↦ min ((OrderDual.ofDual n : ℕ) : ℝ) 1
    Supermartingale X F P ∧ ¬ Martingale X F P ∧ UniformIntegrable X 1 P := by
  intro X
  have hS : Supermartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun i j hij ↦ ?_,
      fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le i)]
    apply Filter.Eventually.of_forall
    intro _
    exact min_le_min (Nat.cast_le.mpr hij) le_rfl
  refine ⟨hS, ?_, hS.uniformIntegrable_of_reverse_expectation_bounded
    (C := 1) (fun n ↦ by
      simp only [X, integral_const, probReal_univ, one_smul]
      exact min_le_right _ _)⟩
  intro hM
  have h := hM.condExp_ae_eq
    (show OrderDual.toDual (1 : ℕ) ≤ OrderDual.toDual 0 from Nat.zero_le 1)
  have h0 : X (OrderDual.toDual 0) = (fun _ : Ω ↦ (0 : ℝ)) := by
    funext ω
    norm_num [X]
  have h1 : X (OrderDual.toDual 1) = (fun _ : Ω ↦ (1 : ℝ)) := by
    funext ω
    norm_num [X]
  rw [h0, h1] at h
  rw [condExp_const (F.le (OrderDual.toDual 1))] at h
  obtain ⟨ω, hω⟩ := h.exists
  norm_num at hω

/-- The reverse-submartingale criterion uses a lower expectation bound and
handles negative values. -/
theorem reverse_ui_negative_submartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℕᵒᵈ mΩ) :
    UniformIntegrable
      (fun (n : ℕᵒᵈ) (_ : Ω) ↦ -min ((OrderDual.ofDual n : ℕ) : ℝ) 1) 1 P := by
  have hS := (reverse_ui_proper_supermartingale (P := P) F).1.neg
  apply hS.uniformIntegrable_of_reverse_expectation_bounded_below (C := -1)
  intro n
  change -1 ≤ ∫ _ : Ω, -min ((OrderDual.ofDual n : ℕ) : ℝ) 1 ∂P
  simp only [integral_const, probReal_univ, one_smul]
  exact neg_le_neg (min_le_right _ _)

/-- Finite-time integrability without a bounded reverse expectation is not
enough for UI: the deterministic natural-index process is a counterexample. -/
theorem reverse_ui_requires_expectation_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℕᵒᵈ mΩ) :
    let X : ℕᵒᵈ → Ω → ℝ := fun n _ ↦ ((OrderDual.ofDual n : ℕ) : ℝ)
    Supermartingale X F P ∧ ¬ UniformIntegrable X 1 P := by
  intro X
  refine ⟨⟨fun _ ↦ stronglyMeasurable_const, fun i j hij ↦ ?_,
    fun _ ↦ integrable_const _⟩, ?_⟩
  · rw [condExp_const (F.le i)]
    exact Filter.Eventually.of_forall fun _ ↦ Nat.cast_le.mpr hij
  · rintro ⟨_, _, B, hb⟩
    obtain ⟨n, hn⟩ := exists_nat_gt (B : ℝ)
    have h := hb (OrderDual.toDual n)
    change eLpNorm (fun _ : Ω ↦ (n : ℝ)) 1 P ≤ (B : ℝ≥0∞) at h
    simp only [eLpNorm_const (n : ℝ) one_ne_zero (NeZero.ne P), measure_univ,
      ENNReal.one_rpow, mul_one, Real.enorm_natCast] at h
    have hle : (n : ℝ) ≤ B := by exact_mod_cast h
    exact (not_le_of_gt hn) hle

/-- Reverse UI has no hidden L2 assumption on the initial random variable. -/
theorem reverse_ui_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {V : Ω → ℝ} (hm : StronglyMeasurable V) (hi : Integrable V P) (hn : ¬ MemLp V 2 P) :
    UniformIntegrable (fun (_ : ℕᵒᵈ) ↦ V) 1 P ∧ ¬ MemLp V 2 P := by
  let F := Filtration.const ℕᵒᵈ mΩ le_rfl
  have hM : Martingale (fun (_ : ℕᵒᵈ) ↦ V) F P :=
    ⟨fun _ ↦ hm, fun _ _ _ ↦ (condExp_of_stronglyMeasurable le_rfl hm hi).eventuallyEq⟩
  exact ⟨hM.supermartingale.uniformIntegrable_of_reverse_expectation_bounded
    (C := ∫ ω, V ω ∂P) (fun _ ↦ le_rfl), hn⟩

/-- The original upper mesh is not decreasing; reverse-time sampling must use
the proved nested dyadic subsequence, not every denominator n + 1. -/
theorem bounded_sampling_requires_nested_subsequence :
    ¬ Antitone (fun n ↦ rightGrid n (1 / 2 : ℝ≥0)) ∧
      Antitone (fun n ↦ dyadicRightGrid n (1 / 2 : ℝ≥0)) := by
  refine ⟨?_, antitone_dyadicRightGrid _⟩
  intro h
  have h12 := h (show (1 : ℕ) ≤ 2 by omega)
  norm_num [rightGrid, Nat.ceil_eq_iff] at h12
  have hbad : (2 : ℝ) / 3 ≤ 1 / 2 := by exact_mod_cast h12
  norm_num at hbad

/-- The conditional inequality works for a negative proper supermartingale
without a global L1 bound, at arbitrary ordered bounded native stopping times. -/
theorem bounded_sampling_negative_without_global_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ ω, σ ω ≤ τ ω) {T : ℝ≥0} (hb : ∀ ω, τ ω ≤ T) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ -(t : ℝ)
    Supermartingale X F P ∧ (¬ ∃ C : ℝ, ∀ t, (∫ ω, ‖X t ω‖ ∂P) ≤ C) ∧
      P[stoppedValue X τ | hσ.measurableSpace] ≤ᵐ[P] stoppedValue X σ := by
  intro X
  have hS := (bounded_one_sided_stopping_without_global_L1_bound (P := P) F hτ hb).1.neg
  refine ⟨hS, ?_, hS.condExp_stoppedValue_ae_le_of_bounded hF
    (Filter.Eventually.of_forall fun _ _ ↦
      NNReal.continuous_coe.neg.continuousWithinAt) hσ hτ hle hb⟩
  rintro ⟨C, hC⟩
  apply (bounded_one_sided_stopping_without_global_L1_bound (P := P) F hτ hb).2.1
  exact ⟨C, fun t ↦ by simpa only [X, norm_neg] using hC t⟩

/-- The two one-sided theorems recover equality for random constant
martingales, retaining integrable initial data that need not belong to L2. -/
theorem bounded_sampling_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) {V : Ω → ℝ}
    (hm : StronglyMeasurable[F 0] V) (hi : Integrable V P) (hn : ¬ MemLp V 2 P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) {T : ℝ≥0} (hb : ∀ᵐ ω ∂P, τ ω ≤ T) :
    V =ᵐ[P] P[V | hσ.measurableSpace] ∧ ¬ MemLp V 2 P := by
  have hM := martingale_const_fun F P hm hi
  have hr : HasRightContinuousPaths (fun (_ : ℝ≥0) ↦ V) P :=
    Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const
  have hl := hM.submartingale.stoppedValue_ae_le_condExp_of_ae_bounded hF hr hσ hτ hle hb
  have hu := hM.supermartingale.condExp_stoppedValue_ae_le_of_ae_bounded hF hr hσ hτ hle hb
  exact ⟨Filter.EventuallyLE.antisymm hl hu, hn⟩

/-- A repeated-endpoint partition preserves the entire stopping sigma-field.
There is no hidden strict-order assumption in finite-index transport. -/
theorem bounded_sampling_repeated_endpoints_preserve_information
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ) :
    let π : TimePartition 0 := ⟨1, fun _ ↦ 0, monotone_const, rfl, rfl⟩
    let τ := FiniteStoppingTime.const F 0
    (τ.isStoppingTime_ceilingIndex π (fun _ ↦ le_rfl)).measurableSpace =
      τ.measurableSpace := by
  intro π τ
  apply τ.measurableSpace_ceilingIndex_eq π (fun _ ↦ le_rfl)
  intro ω
  exact ⟨0, rfl⟩

/-- Neither stopping time need precede the other. On this two-point example
both strict orders occur and the general minimum-conditioning formula applies. -/
theorem stopping_condExp_commutes_without_order
    {P : Measure Bool} [IsFiniteMeasure P] (Y : Bool → ℝ) :
    let F := Filtration.const ℝ≥0 (inferInstance : MeasurableSpace Bool) le_rfl
    let σ : Bool → WithTop ℝ≥0 := fun b ↦ if b then 1 else 2
    let τ : Bool → WithTop ℝ≥0 := fun b ↦ if b then 2 else 1
    ∃ (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ),
      ¬ (∀ ω, σ ω ≤ τ ω) ∧ ¬ (∀ ω, τ ω ≤ σ ω) ∧
      P[P[Y | hτ.measurableSpace] | hσ.measurableSpace] =ᵐ[P]
        P[Y | (hσ.min hτ).measurableSpace] := by
  intro F σ τ
  have hσ : IsStoppingTime F σ := by
    intro t
    change MeasurableSet {ω | σ ω ≤ t}
    exact (Set.toFinite _).measurableSet
  have hτ : IsStoppingTime F τ := by
    intro t
    change MeasurableSet {ω | τ ω ≤ t}
    exact (Set.toFinite _).measurableSet
  refine ⟨hσ, hτ, ?_, ?_, condExp_condExp_stoppingTime_eq_min hσ hτ⟩
  · intro h
    have hb := h false
    norm_num [σ, τ] at hb
  · intro h
    have hb := h true
    norm_num [σ, τ] at hb

/-- At two infinite times the commuting projection is onto the terminal
filtration, not onto all ambient information. The earlier counterexample is
also a nontrivial test of the new commuting formula. -/
theorem stopping_condExp_at_infinity_keeps_terminal_projection :
    let p : unitInterval := ⟨1 / 2, by constructor <;> norm_num⟩
    let P := bernoulliMeasure false true p
    let Y : Bool → ℝ := fun b ↦ if b then 1 else -1
    let F := Filtration.const (m := inferInstance) ℝ≥0 (⊥ : MeasurableSpace Bool) bot_le
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    P[P[Y | htop.measurableSpace] | htop.measurableSpace] =ᵐ[P] (fun _ ↦ (0 : ℝ)) ∧
      ¬ Y =ᵐ[P] (fun _ ↦ (0 : ℝ)) := by
  intro p P Y F htop
  obtain ⟨_, _, hproj, hnot⟩ := arbitrary_closing_variable_not_terminal
  have hp : P[Y | ⨆ t, F t] = (fun _ ↦ (0 : ℝ)) := hproj
  have h := condExp_condExp_stoppingTime_eq_min (Y := Y) (P := P) htop htop
  rw [htop.measurableSpace_min htop, inf_idem, htop.measurableSpace_top, hp] at h
  exact ⟨by simpa only [htop.measurableSpace_top, hp] using h, hnot⟩

/-- The minimum formula retains a random integrable initial variable with
no L2 assumption, without any usual-condition or bounded-time premise. -/
theorem stopping_condExp_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ) :
    P[P[V | hτ.measurableSpace] | hσ.measurableSpace] =ᵐ[P] V ∧ ¬ MemLp V 2 P := by
  have hmin := hσ.min hτ
  have hmV : StronglyMeasurable[hmin.measurableSpace] V :=
    hm.mono (hmin.le_measurableSpace_of_const_le (fun _ ↦ bot_le))
  have h := condExp_condExp_stoppingTime_eq_min (Y := V) (P := P) hσ hτ
  rw [condExp_of_stronglyMeasurable hmin.measurableSpace_le hmV hi] at h
  exact ⟨h, hn⟩

/-- A lower closing variable can be strictly below the actual terminal limit,
even for a deterministic continuous proper supermartingale. -/
theorem lower_closing_is_not_the_actual_limit
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime F τ) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ 2 - min (t : ℝ) 1
    Supermartingale X F P ∧ ¬ Martingale X F P ∧
      (∃ Z : Ω → ℝ, Integrable Z P ∧
        (∀ᵐ ω ∂P, Filter.Tendsto (fun t ↦ X t ω) Filter.atTop (nhds (Z ω))) ∧
        ∀ᵐ ω ∂P, (0 : ℝ) < Z ω) ∧
      Integrable (stoppedValueWithTerminal X (fun _ ↦ (0 : ℝ)) τ) P := by
  intro X
  have hS : Supermartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_,
      fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    exact Filter.Eventually.of_forall fun _ ↦ sub_le_sub_left
      (min_le_min (NNReal.coe_le_coe.mpr hst) le_rfl) 2
  have hr : HasRightContinuousPaths X P := Filter.Eventually.of_forall
    fun _ _ ↦ (continuous_const.sub (NNReal.continuous_coe.min continuous_const)).continuousWithinAt
  have hclose (t) : P[(fun _ : Ω ↦ (0 : ℝ)) | F t] ≤ᵐ[P] X t := by
    rw [show (fun _ : Ω ↦ (0 : ℝ)) = 0 from rfl, condExp_zero]
    exact Filter.Eventually.of_forall fun _ ↦ by dsimp [X]; linarith [min_le_right (t : ℝ) 1]
  have hlim : ∀ᵐ ω ∂P, Filter.Tendsto (fun t : ℝ≥0 ↦ X t ω) Filter.atTop (nhds (1 : ℝ)) := by
    apply Filter.Eventually.of_forall
    intro ω
    apply tendsto_atTop_of_eventually_const (i₀ := (1 : ℝ≥0))
    intro t ht
    have ht' : (1 : ℝ) ≤ t := by exact_mod_cast ht
    norm_num [X, min_eq_right ht']
  refine ⟨hS, ?_, ?_, ?_⟩
  · intro hM
    have h := hM.condExp_ae_eq (show (0 : ℝ≥0) ≤ 1 from zero_le_one)
    change P[(fun _ : Ω ↦ 2 - min (1 : ℝ) 1) | F 0] =ᵐ[P]
      (fun _ : Ω ↦ 2 - min (0 : ℝ) 1) at h
    rw [condExp_const (F.le 0)] at h
    obtain ⟨ω, hω⟩ := h.exists
    norm_num at hω
  · obtain ⟨Z, hi, hl, _⟩ := hS.exists_integrable_limit_of_condExp_lower_bound hr hclose
    refine ⟨Z, hi, hl, ?_⟩
    filter_upwards [hl, hlim] with ω hω heω
    rw [tendsto_nhds_unique hω heω]
    norm_num
  · have h := hS.integrable_stoppedValue_closingProjection hF hr
      (integrable_const (0 : ℝ)) hclose hτ
    simpa only [show (fun _ : Ω ↦ (0 : ℝ)) = 0 from rfl, condExp_zero] using h

/-- Lower closure retains random initial data and does not require L2 for
either the supermartingale or its integrable lower closing input. -/
theorem lower_closing_sampling_retains_random_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) {V : Ω → ℝ}
    (hm : StronglyMeasurable[F 0] V) (hi : Integrable V P) (hn : ¬ MemLp V 2 P)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime F τ) :
    Integrable (stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V)
      (fun ω ↦ V ω - 1) τ) P ∧ ¬ MemLp V 2 P := by
  let Y : Ω → ℝ := fun ω ↦ V ω - 1
  have hiY : Integrable Y P := hi.sub (integrable_const _)
  have hmY : StronglyMeasurable[F 0] Y := hm.sub stronglyMeasurable_const
  have hS := (martingale_const_fun F P hm hi).supermartingale
  have hclose (t) : P[Y | F t] ≤ᵐ[P] V := by
    rw [condExp_of_stronglyMeasurable (F.le t) (hmY.mono (F.mono bot_le)) hiY]
    exact Filter.Eventually.of_forall fun _ ↦ sub_le_self _ zero_le_one
  have h := hS.integrable_stoppedValue_closingProjection hF
    (Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const) hiY hclose hτ
  rw [condExp_of_stronglyMeasurable (iSup_le F.le) (hmY.mono (le_iSup F 0)) hiY] at h
  exact ⟨h, hn⟩

/-- A process that decreases forever cannot have an integrable lower closing
input. Finite-time integrability alone cannot supply the missing hypothesis. -/
theorem unbounded_negative_supermartingale_has_no_lower_closing
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    ¬ ∃ Y : Ω → ℝ, Integrable Y P ∧
      ∀ t : ℝ≥0, P[Y | F t] ≤ᵐ[P] (fun _ : Ω ↦ -(t : ℝ)) := by
  have h := bounded_one_sided_stopping_without_global_L1_bound (P := P) F
    (isStoppingTime_const F 0) (fun _ ↦ le_rfl)
  rintro ⟨Y, _, hclose⟩
  have hb := h.1.neg.integral_norm_le_of_condExp_lower_bound hclose
  apply h.2.1
  refine ⟨(∫ _ : Ω, -(0 : ℝ) ∂P) + 2 * (∫ ω, ‖Y ω‖ ∂P), fun t ↦ ?_⟩
  simpa only [Pi.neg_apply, norm_neg, NNReal.coe_zero] using hb t

/-- Full unbounded sampling applies to a proper supermartingale whose lower
closing variable is not the actual terminal limit. Both times may be infinite. -/
theorem closed_supermartingale_sampling_is_genuinely_one_sided
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ 2 - min (t : ℝ) 1
    ¬ Martingale X F P ∧ Integrable (stoppedValueWithTerminal X 0 σ) P ∧
      Integrable (stoppedValueWithTerminal X 0 τ) P ∧
      P[stoppedValueWithTerminal X 0 τ | hσ.measurableSpace] ≤ᵐ[P]
        stoppedValueWithTerminal X 0 σ := by
  intro X
  have h := lower_closing_is_not_the_actual_limit hF hτ
  have hr : HasRightContinuousPaths X P := Filter.Eventually.of_forall
    fun _ _ ↦ (continuous_const.sub (NNReal.continuous_coe.min continuous_const)).continuousWithinAt
  have hn (t) : 0 ≤ᵐ[P] X t := Filter.Eventually.of_forall
    fun _ ↦ by dsimp [X]; linarith [min_le_right (t : ℝ) 1]
  exact ⟨h.2.1, (lower_closing_is_not_the_actual_limit hF hσ).2.2.2, h.2.2.2,
    h.1.stoppedValue_zeroTerminal_optionalSampling hF hr hn hσ hτ hle⟩

/-- Native unbounded sampling retains a non-L2 random initial value, and
accepts a strictly lower integrable closing variable rather than a closing identity. -/
theorem closed_sampling_retains_non_L2_random_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) {V : Ω → ℝ}
    (hm : StronglyMeasurable[F 0] V) (hi : Integrable V P) (hn : ¬ MemLp V 2 P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ)
    (hle : ∀ᵐ ω ∂P, σ ω ≤ τ ω) :
    P[stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) (fun ω ↦ V ω - 1) τ |
        hσ.measurableSpace] ≤ᵐ[P]
      stoppedValueWithTerminal (fun (_ : ℝ≥0) ↦ V) (fun ω ↦ V ω - 1) σ ∧
      ¬ MemLp V 2 P := by
  let Y : Ω → ℝ := fun ω ↦ V ω - 1
  have hiY : Integrable Y P := hi.sub (integrable_const _)
  have hmY : StronglyMeasurable[F 0] Y := hm.sub stronglyMeasurable_const
  have hclose (t) : P[Y | F t] ≤ᵐ[P] V := by
    rw [condExp_of_stronglyMeasurable (F.le t) (hmY.mono (F.mono bot_le)) hiY]
    exact Filter.Eventually.of_forall fun _ ↦ sub_le_self _ zero_le_one
  have hS := (martingale_const_fun F P hm hi).supermartingale
  exact ⟨hS.stoppedValue_terminalMeasurable_closing_optionalSampling hF
      (Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const) hiY
      (hmY.mono (le_iSup F 0)) hclose hσ hτ hle, hn⟩

/-- Even the one-sided formula fails for an arbitrary ambient closing input
at two infinite times. The native terminal projection cannot be omitted. -/
theorem unprojected_lower_closing_fails_infinite_sampling :
    let p : unitInterval := ⟨1 / 2, by constructor <;> norm_num⟩
    let P := bernoulliMeasure false true p
    let Y : Bool → ℝ := fun b ↦ if b then 1 else -1
    let F := Filtration.const (m := inferInstance) ℝ≥0 (⊥ : MeasurableSpace Bool) bot_le
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    F.IsUsual P ∧ (∀ t, P[Y | F t] ≤ᵐ[P] (fun _ : Bool ↦ (0 : ℝ))) ∧
      ¬ P[Y | htop.measurableSpace] ≤ᵐ[P] Y := by
  intro p P Y F htop
  obtain ⟨hiY, hclose, hproj, hnot⟩ := arbitrary_closing_variable_not_terminal
  have hF : F.IsUsual P := unprojected_closing_fails_native_infinite_sampling.1
  refine ⟨hF, fun t ↦ (hclose t).symm.le, ?_⟩
  intro h
  have hp : P[Y | ⨆ t, F t] = (fun _ ↦ (0 : ℝ)) := hproj
  rw [htop.measurableSpace_top, hp] at h
  have hE : (∫ ω, Y ω ∂P) = 0 := by
    rw [integral_bernoulliMeasure]
    norm_num [Y, p]
  exact hnot ((integral_eq_zero_iff_of_nonneg_ae h hiY).mp hE)

/-- Signed Fatou must retain a negative upper bound, not replace its real
integral by an unguarded nonnegative totalization. -/
theorem signed_fatou_retains_negative_expectations
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P] :
    (∫ _ : Ω, (-1 : ℝ) ∂P) ≤ -1 ∧ ¬ (∫ _ : Ω, (-1 : ℝ) ∂P) ≤ -2 := by
  refine ⟨?_, by simp⟩
  apply integral_le_of_ae_tendsto_of_L1_lower_bound
    (f := fun (_ : ℕ) (_ : Ω) ↦ (-1 : ℝ)) (g := fun (_ : ℕ) (_ : Ω) ↦ (-2 : ℝ))
    (G := fun _ : Ω ↦ (-2 : ℝ)) (fun _ ↦ integrable_const _)
    (fun _ ↦ integrable_const _) (integrable_const _) (integrable_const _)
    (Filter.Eventually.of_forall fun _ ↦ tendsto_const_nhds)
    (Filter.Eventually.of_forall fun _ ↦ tendsto_const_nhds)
  · simpa only [sub_self, eLpNorm_zero] using
      (tendsto_const_nhds : Filter.Tendsto (fun _ : ℕ ↦ (0 : ℝ≥0∞)) Filter.atTop (nhds 0))
  · exact fun _ ↦ Filter.Eventually.of_forall fun _ ↦ by norm_num
  · intro n
    simp

/-- A downward initial jump is a genuine supermartingale but admits no
right-continuous modification: changing its right-limit value would lose X0. -/
theorem regularization_requires_right_continuous_expectations
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t = 0 then 2 else 0
    Supermartingale X F P ∧
      ¬ ∃ Y : ℝ≥0 → Ω → ℝ, IsModification X Y P ∧ HasRightContinuousPaths Y P := by
  intro X
  have hS : Supermartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_,
      fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    apply Filter.Eventually.of_forall
    intro ω
    by_cases hs : s = 0
    · by_cases ht : t = 0 <;> simp [X, hs, ht]
    · have ht : t ≠ 0 := fun ht ↦ hs (le_antisymm (ht ▸ hst) bot_le)
      simp [X, hs, ht]
  refine ⟨hS, ?_⟩
  rintro ⟨Y, hm, hr⟩
  have hc := hS.isRightContinuousPath_integral_of_modification hF hm hr
  have hlim : Function.rightLim (fun t ↦ ∫ ω, X t ω ∂P) 0 = 0 := by
    apply rightLim_eq_of_tendsto
    apply tendsto_const_nhds.congr'
    filter_upwards [self_mem_nhdsWithin (a := (0 : ℝ≥0)) (s := Set.Ioi 0)] with t ht
    have ht0 : t ≠ 0 := ne_of_gt ht
    simp [X, ht0]
  have h := (hc 0).rightLim_eq
  rw [hlim] at h
  norm_num [X] at h

/-- Right-side L1 continuity is local in time; the increasing deterministic
submartingale has no uniform first-moment bound on the whole half-line. -/
theorem right_sampling_L1_needs_no_global_first_moment_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) {a : ℕ → ℝ≥0} (ha : Antitone a) {t : ℝ≥0}
    (hl : Filter.Tendsto a Filter.atTop (nhdsWithin t (Set.Ici t))) :
    Filter.Tendsto (fun n ↦ eLpNorm ((fun _ : Ω ↦ (a n : ℝ)) - (fun _ : Ω ↦ (t : ℝ))) 1 P)
      Filter.atTop (nhds 0) ∧
      ¬ ∃ C : ℝ, ∀ t : ℝ≥0, (∫ _ : Ω, ‖(t : ℝ)‖ ∂P) ≤ C := by
  have h := bounded_one_sided_stopping_without_global_L1_bound (P := P) F
    (isStoppingTime_const F 0) (fun _ ↦ le_rfl)
  exact ⟨h.1.tendsto_eLpNorm_of_antitone_right_sampling
    (Filter.Eventually.of_forall fun _ _ ↦ NNReal.continuous_coe.continuousWithinAt) ha hl,
    h.2.1⟩

/-- Decreasing deterministic sampling retains non-L2 random initial data
and allows repetitions; it does not normalize the sampled process to zero. -/
theorem antitone_sampling_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) {a : ℕ → ℝ≥0} (ha : Antitone a) :
    UniformIntegrable (fun (_ : ℕ) ↦ V) 1 P ∧ ¬ MemLp V 2 P := by
  have hS := (martingale_const_fun F P hm hi).supermartingale
  exact ⟨hS.uniformIntegrable_antitone_reindex ha, hn⟩

/-- Signed maximal control does not require that regularization has already
succeeded: the initial-drop counterexample still has every bounded-skeleton bound. -/
theorem skeleton_bounds_do_not_imply_right_continuous_modification
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) (e : ℕ → ℝ≥0) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t = 0 then 2 else 0
    (∀ᵐ ω ∂P, ∀ T : ℝ≥0, ∃ C : ℝ, ∀ n, e n ≤ T → ‖X (e n) ω‖ ≤ C) ∧
      ¬ ∃ Y : ℝ≥0 → Ω → ℝ, IsModification X Y P ∧ HasRightContinuousPaths Y P := by
  intro X
  have h := regularization_requires_right_continuous_expectations hF
  exact ⟨h.1.ae_locally_bddAbove_norm_sample e, h.2⟩

/-- The signed weak bound retains negative initial means. A constant minus-one
supermartingale has weak constant one, not an invalid negative right-hand side. -/
theorem signed_maximal_bound_retains_negative_initial_mean
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℕ mΩ) (N : ℕ) :
    (1 : ℝ≥0∞) * P {_ω | (1 : ℝ) ≤ (Finset.range (N + 1)).sup'
      Finset.nonempty_range_add_one (fun _ ↦ ‖(-1 : ℝ)‖)} ≤ 1 ∧
      (∫ _ : Ω, (-1 : ℝ) ∂P) = -1 := by
  have hS := (martingale_const (E := ℝ) F P (-1)).supermartingale
  refine ⟨?_, by simp⟩
  convert hS.maximal_ineq_norm_discrete N 1 using 1 <;> norm_num

/-- Zero horizon and arbitrary repeated endpoints retain the full, possibly
non-L2 random initial value in the maximal estimate. -/
theorem skeleton_maximal_zero_horizon_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) (π : TimePartition 0) (ε : ℝ≥0) :
    (ε : ℝ≥0∞) * P {ω | (ε : ℝ) ≤ (Finset.range (π.size + 1)).sup'
      Finset.nonempty_range_add_one (fun _ ↦ ‖V ω‖)} ≤
      ENNReal.ofReal ((∫ ω, V ω ∂P) + 2 * (∫ ω, ‖V ω‖ ∂P)) ∧ ¬ MemLp V 2 P := by
  have hS := (martingale_const_fun F P hm hi).supermartingale
  exact ⟨hS.maximal_ineq_norm_partition π ε, hn⟩

/-- Compact skeleton control and clipped upcrossings require no global moment
bound. The increasing deterministic process is a proper submartingale example. -/
theorem regularization_skeleton_needs_no_global_first_moment_bound
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    (∀ᵐ ω ∂P, ∀ N : ℕ, ∀ a b : ℚ, a < b →
      denseUpcrossings a b (fun t (_ : Ω) ↦ (min t (N : ℝ≥0) : ℝ)) ω < ⊤) ∧
      ¬ ∃ C : ℝ, ∀ t : ℝ≥0, (∫ _ : Ω, ‖(t : ℝ)‖ ∂P) ≤ C := by
  have h := bounded_one_sided_stopping_without_global_L1_bound (P := P) F
    (isStoppingTime_const F 0) (fun _ ↦ le_rfl)
  exact ⟨h.1.ae_all_rat_denseUpcrossings_min_lt_top, h.2.1⟩

/-- Reversing a crossing starting at zero moves its completion to the final
endpoint. The unshifted strict cutoff loses it, while N+1 retains it. -/
theorem upcrossing_reversal_requires_successor_cutoff
    {Ω : Type*} {f : ℕ → Ω → ℝ} {ω : Ω} {a b : ℝ}
    (hab : a < b) (h0 : f 0 ω < a) (h1 : b < f 1 ω) (h2 : b < f 2 ω) :
    ¬ upcrossingsBefore a b f 2 ω ≤
        upcrossingsBefore (-b) (-a) (fun n ω ↦ -f (2 - n) ω) 2 ω ∧
      upcrossingsBefore a b f 2 ω ≤
        upcrossingsBefore (-b) (-a) (fun n ω ↦ -f (2 - n) ω) 3 ω := by
  let g : ℕ → Ω → ℝ := fun n ω ↦ -f (2 - n) ω
  have hg (n : ℕ) (hn : n < 2) : g n ω < -b := by
    interval_cases n
    · exact neg_lt_neg h2
    · exact neg_lt_neg h1
  have hz : upcrossingsBefore (-b) (-a) g 2 ω = 0 := by
    apply Nat.eq_zero_of_not_pos
    intro h
    have hu := upperCrossingTime_lt_of_le_upcrossingsBefore (N := 2) (n := 1)
      (by decide) (neg_lt_neg hab) h
    have hv := stoppedValue_upperCrossingTime (n := 0) hu.ne
    change -a ≤ g (upperCrossingTime (-b) (-a) g 2 1 ω) ω at hv
    have hl := hg _ hu
    linarith
  have hp := (upcrossing_terminal_sample_requires_successor hab h0 h1).2
  refine ⟨?_, upcrossingsBefore_le_neg_reverse hab 2 ω⟩
  change ¬ upcrossingsBefore a b f 2 ω ≤ upcrossingsBefore (-b) (-a) g 2 ω
  simpa only [hz, not_le] using hp

/-- Simultaneous sequence convergence is still not the modification identity:
the isolated initial drop has every bounded monotone dyadic limit. -/
theorem dyadic_sequence_limits_do_not_imply_modification
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t = 0 then 2 else 0
    (∀ᵐ ω ∂P, ∀ e : ℕ → ℝ≥0, (Monotone e ∨ Antitone e) →
      (∀ n, e n ∈ dyadicSkeleton) → (∃ T : ℝ≥0, ∀ n, e n ≤ T) →
      ∃ z : ℝ, Filter.Tendsto (fun n ↦ X (e n) ω) Filter.atTop (nhds z)) ∧
      ¬ ∃ Y : ℝ≥0 → Ω → ℝ, IsModification X Y P ∧ HasRightContinuousPaths Y P := by
  intro X
  have h := regularization_requires_right_continuous_expectations hF
  exact ⟨h.1.ae_exists_limits_monotone_dyadic_samples, h.2⟩

/-- The universal sequence quantifier stays inside the common event and
does not require square-integrable or deterministic initial data. -/
theorem simultaneous_dyadic_limits_retain_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) :
    (∀ᵐ ω ∂P, ∀ e : ℕ → ℝ≥0, (Monotone e ∨ Antitone e) →
      (∀ n, e n ∈ dyadicSkeleton) → (∃ T : ℝ≥0, ∀ n, e n ≤ T) →
      ∃ z : ℝ, Filter.Tendsto (fun _ : ℕ ↦ V ω) Filter.atTop (nhds z)) ∧ ¬ MemLp V 2 P := by
  have hS := (martingale_const_fun F P hm hi).supermartingale
  exact ⟨hS.ae_exists_limits_monotone_dyadic_samples, hn⟩

/-- The constructed dyadic right-limit process is cadlag but is not always
a modification. The isolated initial value is genuinely lost in this example. -/
theorem cadlag_dyadic_extension_can_change_initial_value
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t = 0 then 2 else 0
    HasCadlagPaths (dyadicRightLimitProcess X) P ∧
      dyadicRightLimitProcess X 0 = (fun _ ↦ (0 : ℝ)) ∧
      ¬ IsModification X (dyadicRightLimitProcess X) P := by
  intro X
  have h := regularization_requires_right_continuous_expectations hF
  have hc := h.1.hasCadlagPaths_dyadicRightLimitProcess
  refine ⟨hc, ?_, fun hm ↦ h.2 ⟨_, hm, hc.hasRightContinuousPaths⟩⟩
  funext ω
  let := dyadicSkeleton_right_neBot 0
  apply Filter.Tendsto.limUnder_eq
  apply tendsto_const_nhds.congr'
  filter_upwards [self_mem_nhdsWithin (a := (0 : ℝ≥0))
    (s := dyadicSkeleton ∩ Set.Ioi 0)] with s hs
  have hpos : (0 : ℝ≥0) < s := hs.2
  simp only [X, if_neg (ne_of_gt hpos)]

/-- A constant integrable random initial value is retained by the actual
extension, including when it fails square-integrability. -/
theorem cadlag_dyadic_extension_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) :
    HasCadlagPaths (dyadicRightLimitProcess (fun (_ : ℝ≥0) ↦ V)) P ∧
      dyadicRightLimitProcess (fun (_ : ℝ≥0) ↦ V) = (fun _ ↦ V) ∧ ¬ MemLp V 2 P := by
  have hS := (martingale_const_fun F P hm hi).supermartingale
  refine ⟨hS.hasCadlagPaths_dyadicRightLimitProcess, ?_, hn⟩
  funext t ω
  exact (show IsRightContinuousPath (fun _ : ℝ≥0 ↦ V ω) from
    fun _ ↦ continuousWithinAt_const).dyadicRightLimitProcess_eq t

/-- Cadlag extension permits a jump: the strict-left and strict-right limits
at its jump time need not agree. -/
theorem dyadic_one_sided_limits_allow_a_jump
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    (F : Filtration ℝ≥0 mΩ) (ω : Ω) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t < 1 then 0 else 1
    HasCadlagPaths (dyadicRightLimitProcess X) P ∧
      Filter.Tendsto (fun s ↦ X s ω) (nhdsWithin 1 (dyadicSkeleton ∩ Set.Iio 1)) (nhds 0) ∧
      Filter.Tendsto (fun s ↦ X s ω) (nhdsWithin 1 (dyadicSkeleton ∩ Set.Ioi 1)) (nhds 1) ∧
      (0 : ℝ) ≠ 1 := by
  intro X
  have hS : Submartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun s t hst ↦ ?_, fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le s)]
    apply Filter.Eventually.of_forall
    intro x
    by_cases hs : s < 1
    · by_cases ht : t < 1 <;> simp [X, hs, ht]
    · have ht : ¬ t < 1 := fun ht ↦ hs (hst.trans_lt ht)
      simp [X, hs, ht]
  refine ⟨hS.hasCadlagPaths_dyadicRightLimitProcess, ?_, ?_, by norm_num⟩
  · apply tendsto_const_nhds.congr'
    filter_upwards [self_mem_nhdsWithin (a := (1 : ℝ≥0))
      (s := dyadicSkeleton ∩ Set.Iio 1)] with s hs
    have hlt : s < (1 : ℝ≥0) := hs.2
    simp only [X, if_pos hlt]
  · apply tendsto_const_nhds.congr'
    filter_upwards [self_mem_nhdsWithin (a := (1 : ℝ≥0))
      (s := dyadicSkeleton ∩ Set.Ioi 1)] with s hs
    have hgt : (1 : ℝ≥0) < s := hs.2
    simp only [X, if_neg (not_lt_of_gt hgt)]

/-- Doob regularization accepts an adapted, not assumed path-regular version
of a constant integrable non-L2 random variable and recovers its unique cadlag version. -/
theorem doob_regularization_retains_non_L2_modified_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) {V : Ω → ℝ}
    (hmV : StronglyMeasurable[F 0] V) (hiV : Integrable V P) (hn : ¬ MemLp V 2 P)
    {X : ℝ≥0 → Ω → ℝ} (ha : StronglyAdapted F X)
    (hm : IsModification X (fun _ ↦ V) P) :
    ∃ Y : ℝ≥0 → Ω → ℝ, Martingale Y F P ∧ HasCadlagPaths Y P ∧
      IsModification X Y P ∧ Indistinguishable Y (fun _ ↦ V) P ∧ ¬ MemLp V 2 P := by
  have hX := (martingale_const_fun F P hmV hiV).congr ha hm.symm
  obtain ⟨Y, hY, hc, hmod, huniq⟩ := hX.exists_cadlag_modification hF
  exact ⟨Y, hY, hc, hmod,
    huniq _ hm (Filter.Eventually.of_forall fun _ _ ↦ continuousWithinAt_const), hn⟩

/-- Regularizing a proper submartingale does not turn its one-sided inequality
into martingale equality and requires no global first-moment bound. -/
theorem doob_regularization_preserves_proper_submartingale
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    ∃ Y : ℝ≥0 → Ω → ℝ, Submartingale Y F P ∧ HasCadlagPaths Y P ∧
      IsModification (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ)) Y P ∧ ¬ Martingale Y F P ∧
      ¬ ∃ C : ℝ, ∀ t : ℝ≥0, (∫ _ : Ω, ‖(t : ℝ)‖ ∂P) ≤ C := by
  have h := bounded_one_sided_stopping_without_global_L1_bound (P := P) F
    (isStoppingTime_const F 0) (fun _ ↦ le_rfl)
  have hm : IsRightContinuousPath (fun t : ℝ≥0 ↦ ∫ _ : Ω, (t : ℝ) ∂P) := by
    simpa only [integral_const, probReal_univ, one_smul] using
      (show IsRightContinuousPath (fun t : ℝ≥0 ↦ (t : ℝ)) from
        fun _ ↦ NNReal.continuous_coe.continuousWithinAt)
  obtain ⟨Y, hY, hc, hmod, _⟩ := h.1.exists_cadlag_modification hF hm
  refine ⟨Y, hY, hc, hmod, ?_, h.2.1⟩
  intro hMY
  have hMX := hMY.congr h.1.stronglyAdapted hmod.symm
  have he := hMX.setIntegral_eq (show (0 : ℝ≥0) ≤ 1 from bot_le)
    (@MeasurableSet.univ Ω (F 0))
  norm_num at he

/-- Uniqueness compares any two right-continuous versions, without assuming
the original martingale already has regular paths. -/
theorem doob_regularization_unique_without_original_path_regularity
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    {X Y Z : ℝ≥0 → Ω → ℝ} (hX : Martingale X F P)
    (hY : IsModification X Y P) (hZ : IsModification X Z P)
    (hrY : HasRightContinuousPaths Y P) (hrZ : HasRightContinuousPaths Z P) :
    Indistinguishable Y Z P := by
  obtain ⟨V, _, _, _, huniq⟩ := hX.exists_cadlag_modification hF
  exact (huniq Y hY hrY).symm.trans (huniq Z hZ hrZ)

/-- Class D retains arbitrary integrable initial values; square integrability
is not part of the stopping-family predicate. -/
theorem classD_retains_non_L2_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} (F : Filtration ℝ≥0 mΩ) {V : Ω → ℝ}
    (hi : Integrable V P) (hn : ¬ MemLp V 2 P) :
    IsClassD (fun _ : ℝ≥0 ↦ V) F P ∧ ¬ MemLp V 2 P :=
  ⟨isClassD_const hi, hn⟩

/-- A common-event version change preserves all stopping samples, whereas
the explicit random-time spike is only a modification of the zero process. -/
theorem classD_not_invariant_under_arbitrary_modification :
    ∃ X Y : ℝ≥0 → ℝ → ℝ, IsModification X Y (gaussianReal 0 1) ∧
      IsClassD Y (Filtration.const ℝ≥0 (borel ℝ) le_rfl) (gaussianReal 0 1) ∧
      UniformIntegrable X 1 (gaussianReal 0 1) ∧
      ¬ IsClassD X (Filtration.const ℝ≥0 (borel ℝ) le_rfl) (gaussianReal 0 1) := by
  obtain ⟨X, _, hu, hm, hn⟩ := exists_adapted_uniformIntegrable_not_isClassD
  exact ⟨X, 0, hm, isClassD_const (integrable_zero _ _ _), hu, hn⟩

/-- Separate finite-horizon UI bounds do not give global Class D, even for
a continuous adapted nonnegative submartingale. -/
theorem classDL_does_not_imply_classD {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsProbabilityMeasure P] {F : Filtration ℝ≥0 mΩ}
    (hF : F.IsUsual P) :
    IsClassDL (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ)) F P ∧
      ¬ IsClassD (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ)) F P := by
  have h := bounded_one_sided_stopping_without_global_L1_bound (P := P) F
    (isStoppingTime_const F 0) (fun _ ↦ le_rfl)
  refine ⟨h.1.isClassDL_of_nonneg hF
    (Filter.Eventually.of_forall fun _ _ ↦ NNReal.continuous_coe.continuousWithinAt)
    (Filter.Eventually.of_forall fun _ t ↦ t.coe_nonneg), ?_⟩
  intro hD
  obtain ⟨C, hC⟩ := hD.uniformIntegrable.2.2
  apply h.2.1
  refine ⟨C, fun t ↦ ?_⟩
  have he := hC t
  rw [eLpNorm_one_eq_lintegral_enorm,
    ← ofReal_integral_norm_eq_lintegral_enorm (integrable_const (t : ℝ))] at he
  apply (ENNReal.ofReal_le_ofReal_iff C.coe_nonneg).mp
  simpa only [ENNReal.ofReal_coe_nnreal] using he

/-- Class D stopping at infinity keeps finite-time values. It never assigns
an unrelated nonintegrable terminal random variable to the process. -/
theorem classD_infinite_stopping_keeps_finite_values
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ} (hX : IsClassD X F P)
    {Z : Ω → ℝ} (hn : ¬ Integrable Z P) :
    IsClassD (MeasureTheory.stoppedProcess X (fun _ ↦ (⊤ : WithTop ℝ≥0))) F P ∧
      ¬ Integrable Z P :=
  ⟨hX.stoppedProcess (fun t ↦ by simp), hn⟩

/-- A potential may start from a non-L2 integrable random value. The true
martingale part retains that initial value; only the increasing part starts at zero. -/
theorem doob_potential_retains_non_L2_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℕ mΩ} {V : Ω → ℝ} (hm : StronglyMeasurable[F 0] V)
    (hi : Integrable V P) (hp : ∀ᵐ ω ∂P, 0 ≤ V ω) (hn : ¬ MemLp V 2 P) :
    ∃ (M A : ℕ → Ω → ℝ) (Z : Ω → ℝ), Martingale M F P ∧
      UniformIntegrable M 1 P ∧ IsStronglyPredictable F A ∧ A 0 = 0 ∧
      M 0 = V ∧ ¬ MemLp (M 0) 2 P ∧ Integrable Z P ∧
      (∫ ω, Z ω ∂P) = (∫ ω, V ω ∂P) := by
  obtain ⟨M, A, Z, hM, hu, hA, hA0, hM0, _, _, hiZ, hEZ, _, _, _⟩ :=
    (isPotential_singleDrop hm hi hp).exists_unique_doob_decomposition
  change M 0 = V at hM0
  change (∫ ω, Z ω ∂P) = (∫ ω, V ω ∂P) at hEZ
  exact ⟨M, A, Z, hM, hu, hA, hA0, hM0, hM0 ▸ hn, hiZ, hEZ⟩

/-- A nonzero constant supermartingale is not a potential: positivity alone
does not supply the required vanishing expectation at infinity. -/
theorem constant_one_is_not_potential
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    (F : Filtration ℕ mΩ) : ¬ IsPotential (fun (_ : ℕ) (_ : Ω) ↦ (1 : ℝ)) F P := by
  intro h
  have hl : Filter.Tendsto (fun _ : ℕ ↦ (1 : ℝ)) Filter.atTop (nhds 0) := by
    simpa only [integral_const, probReal_univ, one_smul] using h.tendsto_integral
  have he : (1 : ℝ) = 0 := tendsto_nhds_unique tendsto_const_nhds hl
  norm_num at he

/-- For a decreasing supermartingale the increasing source Doob term uses
the predictable part of the negative process, not its unnegated predictable part. -/
theorem doob_supermartingale_increasing_sign
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    (F : Filtration ℕ mΩ) :
    let X : ℕ → Ω → ℝ := fun n _ ↦ -(n : ℝ)
    Supermartingale X F P ∧ predictablePart (-X) F P 1 =ᵐ[P] (fun _ ↦ (1 : ℝ)) := by
  intro X
  have hS : Supermartingale X F P := by
    refine ⟨fun _ ↦ stronglyMeasurable_const, fun i j hij ↦ ?_, fun _ ↦ integrable_const _⟩
    rw [condExp_const (F.le i)]
    exact Filter.Eventually.of_forall fun _ ↦ neg_le_neg (Nat.cast_le.mpr hij)
  refine ⟨hS, ?_⟩
  simp only [predictablePart, Finset.sum_range_one]
  have he : (-X) 1 - (-X) 0 = (fun _ : Ω ↦ (1 : ℝ)) := by
    funext ω
    norm_num [X]
  rw [he, condExp_const (F.le 0)]

/-- Zero-terminal predictable samples at infinity lose all information. They
cannot replace the terminal-valued generators of the pre-stopping sigma-field. -/
theorem predictable_zero_terminal_generators_at_infinity
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ) :
    (⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsStronglyPredictable F X),
      MeasurableSpace.comap
        (stoppedValueWithTerminal X (fun _ ↦ 0) (fun _ ↦ ⊤)) inferInstance) = ⊥ := by
  simp only [stoppedValueWithTerminal_top, MeasurableSpace.comap_const, iSup_bot]

/-- The actual field before infinity retains the whole terminal filtration,
even when it is strictly larger than the initial information. -/
theorem before_infinity_is_not_initial_information
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ)
    (hne : (⨆ t, F t) ≠ F 0) (hτ : IsStoppingTime F (fun _ ↦ ⊤)) :
    hτ.measurableSpaceBefore = ⨆ t, F t ∧ hτ.measurableSpaceBefore ≠ F 0 := by
  exact ⟨hτ.measurableSpaceBefore_top, hτ.measurableSpaceBefore_top ▸ hne⟩

/-- Predictable stopping measurability does not impose an initial moment bound. -/
theorem predictable_value_before_retains_nonintegrable_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
    {P : Measure Ω} {V : Ω → ℝ} (hV : StronglyMeasurable[F 0] V)
    (hn : ¬ Integrable V P) (τ : FiniteStoppingTime F) :
    IsStronglyPredictable F (fun (_ : ℝ≥0) ↦ V) ∧
      StronglyMeasurable[τ.isStoppingTime.measurableSpaceBefore] V ∧ ¬ Integrable V P := by
  have ha : Adapted F (fun (_ : ℝ≥0) ↦ V) :=
    fun t ↦ hV.measurable.mono (F.mono bot_le) le_rfl
  have hp := ha.isStronglyPredictable_of_leftContinuous
    (fun _ _ ↦ continuousWithinAt_const)
  exact ⟨hp, hp.stronglyMeasurable_finiteStoppingTime_before τ, hn⟩

/-- The source announcing convention is genuinely almost sure. A null sample
can fail to converge even on a nonzero probability space. -/
theorem announcing_convergence_need_not_hold_everywhere :
    letI : MeasurableSpace Bool := ⊤
    let F := Filtration.const ℝ≥0 (inferInstance : MeasurableSpace Bool) le_rfl
    ∃ σ : ℕ → Bool → WithTop ℝ≥0,
      IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 0) σ ∧
        ¬ ∀ ω, Filter.Tendsto (fun n ↦ σ n ω) Filter.atTop (nhds 0) := by
  intro F
  let : MeasurableSpace Bool := ⊤
  let σ : ℕ → Bool → WithTop ℝ≥0 := fun _ ω ↦ if ω then 0 else 1
  have h : IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 0) σ := by
    refine ⟨fun _ _ ↦ ?_, fun _ ↦ monotone_const, fun _ _ ht ↦ (lt_irrefl _ ht).elim, ?_⟩
    · change MeasurableSet[(⊤ : MeasurableSpace Bool)] _
      trivial
    · apply (ae_dirac_iff (by trivial)).mpr
      exact tendsto_const_nhds
  refine ⟨σ, h, ?_⟩
  intro hall
  have hl : Filter.Tendsto (fun _ : ℕ ↦ (1 : WithTop ℝ≥0)) Filter.atTop (nhds 0) := by
    simpa only [σ, Bool.false_eq_true, if_false] using hall false
  exact one_ne_zero (tendsto_nhds_unique tendsto_const_nhds hl)

/-- Optionality does not imply right-continuous paths. The optional sigma-field
is generated by cadlag processes, but its measurable processes form a larger class. -/
theorem optional_does_not_imply_right_continuous_paths
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let X : ℝ≥0 → Ω → ℝ := fun t _ ↦ if t = 0 then 2 else 0
    IsStronglyOptional F X ∧ ¬ HasRightContinuousPaths X P := by
  intro X
  have ha : Adapted F X := fun _ ↦ measurable_const
  have hp := ha.isStronglyPredictable_of_leftContinuous
    (fun _ ↦ (isCagladPath_initialSpike 2).1)
  refine ⟨hp.isStronglyOptional, ?_⟩
  intro hr
  exact (regularization_requires_right_continuous_expectations hF).2
    ⟨X, fun _ ↦ Filter.Eventually.of_forall fun _ ↦ rfl, hr⟩

/-- Stopping an optional process at infinity keeps all finite-time values and
does not require path regularity of that optional process. -/
theorem optional_stopping_at_infinity_keeps_process
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : IsStronglyOptional F X) :
    IsStronglyOptional F (stoppedProcess X (fun _ ↦ (⊤ : WithTop ℝ≥0))) ∧
      stoppedProcess X (fun _ ↦ (⊤ : WithTop ℝ≥0)) = X :=
  ⟨hX.stoppedProcess (fun _ ↦ by simp), stoppedProcess_const_top⟩

/-- Explicit terminal evaluation preserves the supplied measurable terminal
input, without manufacturing a moment bound or claiming it is a process limit. -/
theorem optional_terminal_value_does_not_impose_integrability
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ} {P : Measure Ω}
    {X : ℝ≥0 → Ω → ℝ} {Z : Ω → ℝ} (hX : IsStronglyOptional F X)
    (hZ : StronglyMeasurable[⨆ t, F t] Z) (hn : ¬ Integrable Z P)
    (hτ : IsStoppingTime F (fun _ ↦ ⊤)) :
    StronglyMeasurable[hτ.measurableSpace] (stoppedValueWithTerminal X Z (fun _ ↦ ⊤)) ∧
      stoppedValueWithTerminal X Z (fun _ ↦ ⊤) = Z ∧ ¬ Integrable Z P :=
  ⟨hX.stronglyMeasurable_stoppedValueWithTerminal hZ hτ, stoppedValueWithTerminal_top, hn⟩

/-- A coefficient activated at zero is present immediately. Activation at
infinity leaves every finite-time value zero, regardless of the coefficient. -/
theorem stopping_activation_zero_and_infinity
    {Ω : Type*} (Z : Ω → ℝ) :
    (fun t : ℝ≥0 ↦ {_ω : Ω | (0 : WithTop ℝ≥0) ≤ t}.indicator Z) = (fun _ ↦ Z) ∧
      (fun t : ℝ≥0 ↦ {_ω : Ω | (⊤ : WithTop ℝ≥0) ≤ t}.indicator Z) = 0 := by
  constructor
  · funext t ω
    exact Set.indicator_of_mem (s := {u : Ω | (0 : WithTop ℝ≥0) ≤ t})
      (show (0 : WithTop ℝ≥0) ≤ t from bot_le) Z
  · funext t ω
    exact Set.indicator_of_notMem (s := {u : Ω | (⊤ : WithTop ℝ≥0) ≤ t})
      (WithTop.not_top_le_coe t) Z

/-- Every stopped-measurable real coefficient is an actual cadlag adapted
sample, even when it is nonintegrable and need not be initially measurable. -/
theorem stopped_field_generators_retain_nonintegrable_coefficients
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ} {P : Measure Ω}
    (τ : FiniteStoppingTime F) {Z : Ω → ℝ} (hZ : StronglyMeasurable[τ.measurableSpace] Z)
    (hn : ¬ Integrable Z P) :
    ∃ X : ℝ≥0 → Ω → ℝ, Adapted F X ∧ (∀ ω, IsCadlagPath (fun t ↦ X t ω)) ∧
      IsStronglyOptional F X ∧ (fun ω ↦ X (τ ω) ω) = Z ∧
        ¬ Integrable (fun ω ↦ X (τ ω) ω) P := by
  let X : ℝ≥0 → Ω → ℝ := fun t ↦ {ω | τ.withTop ω ≤ t}.indicator Z
  have ha : Adapted F X := fun t ↦ (hZ.indicator_stoppingTime_le τ.isStoppingTime t).measurable
  have hc : ∀ ω, IsCadlagPath (fun t ↦ X t ω) :=
    isCadlagPath_indicator_lifetime_le τ.withTop Z
  have he : (fun ω ↦ X (τ ω) ω) = Z := by
    funext ω
    exact Set.indicator_of_mem (s := {u | τ.withTop u ≤ (τ ω : WithTop ℝ≥0)})
      (show τ.withTop ω ≤ (τ ω : WithTop ℝ≥0) from le_rfl) Z
  exact ⟨X, ha, hc, ha.isStronglyOptional_of_cadlag hc, he, he ▸ hn⟩

/-- Infinity has no finite graph and belongs to both stopping classes. Omitting
the finite guard in the totally inaccessible test would make this false. -/
theorem stopping_classification_infinity_boundary
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ) (P : Measure Ω) :
    stoppingTimeGraph (fun _ : Ω ↦ ⊤) = ∅ ∧
      IsAccessibleStoppingTime F (fun _ ↦ ⊤) P ∧
        IsTotallyInaccessibleStoppingTime F (fun _ ↦ ⊤) P :=
  ⟨stoppingTimeGraph_top, isAccessibleStoppingTime_top F P,
    isTotallyInaccessibleStoppingTime_top F P⟩

/-- The initial graph is not discarded: zero is predictable and accessible,
and on a probability space it is not totally inaccessible. -/
theorem stopping_classification_zero_boundary
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ)
    (P : Measure Ω) [IsProbabilityMeasure P] :
    stoppingTimeGraph (fun _ : Ω ↦ (0 : WithTop ℝ≥0)) = ({0} ×ˢ (Set.univ : Set Ω)) ∧
      IsAccessibleStoppingTime F (fun _ ↦ 0) P ∧
        ¬ IsTotallyInaccessibleStoppingTime F (fun _ ↦ 0) P :=
  ⟨stoppingTimeGraph_const 0, (isPredictableStoppingTime_const F P 0).isAccessible,
    not_isTotallyInaccessibleStoppingTime_const 0⟩

/-- A countably valued totally inaccessible time is almost surely infinite;
countable predictable coverage cannot describe a non-null inaccessible graph. -/
theorem countable_totally_inaccessible_times_have_no_finite_part
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ} {P : Measure Ω}
    {τ : Ω → WithTop ℝ≥0} (hτ : IsTotallyInaccessibleStoppingTime F τ P)
    (hc : (Set.range τ).Countable) : τ =ᵐ[P] (fun _ ↦ ⊤) :=
  (isAccessibleStoppingTime_of_countable_range hτ.1 hc).ae_eq_top_of_totallyInaccessible hτ

/-- III.3 constructs a decomposition for every stopping time; neither an
announcing witness nor the decomposition itself is a caller-supplied premise. -/
theorem stopping_classification_decomposition_exists_and_is_unique
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
    (P : Measure Ω) [IsProbabilityMeasure P] {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime F τ) :
    ∃ A B : Set Ω, IsAccessibleInaccessibleDecomposition hτ P A B ∧
      ∀ A' B', IsAccessibleInaccessibleDecomposition hτ P A' B' →
        restrictedStoppingTime τ A =ᵐ[P] restrictedStoppingTime τ A' ∧
          restrictedStoppingTime τ B =ᵐ[P] restrictedStoppingTime τ B' := by
  obtain ⟨A, B, h⟩ := exists_accessibleInaccessible_decomposition hτ P
  exact ⟨A, B, h, fun _ _ h' ↦ h.times_unique h'⟩

/-- A constant nonzero initial value has zero conditional remaining tails,
but positive terminal second moment. The zero-starting premise cannot be erased. -/
theorem predictable_energy_requires_zero_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℕ mΩ) :
    let C : ℕ → Ω → ℝ := fun _ _ ↦ 1
    IsStronglyPredictable F C ∧ HasMonotonePaths C P ∧
      (∀ k, P[(fun _ : Ω ↦ (1 : ℝ)) - C k | F k] = 0) ∧
        ¬ (∫ _ : Ω, (1 : ℝ) ^ 2 ∂P) ≤ 2 * (0 : ℝ) ^ 2 := by
  intro C
  refine ⟨IsStronglyPredictable.of_measurable_add_one stronglyMeasurable_const
    (fun _ ↦ stronglyMeasurable_const), Filter.Eventually.of_forall fun _ ↦ monotone_const,
    fun k ↦ ?_, ?_⟩
  · change P[C k - C k | F k] = 0
    rw [sub_self, condExp_zero]
  · norm_num

/-- A terminal variable known not to be L2 cannot meet the source bounded
conditional-tail hypothesis. The energy theorem derives L2 from L1. -/
theorem predictable_energy_rules_out_non_L2_terminal
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℕ mΩ} {C : ℕ → Ω → ℝ} {Z : Ω → ℝ}
    (hp : IsStronglyPredictable F C) (hm : HasMonotonePaths C P)
    (h0 : C 0 =ᵐ[P] 0) (hZ : Integrable Z P) (hnot : ¬ MemLp Z 2 P)
    (hl : ∀ᵐ ω ∂P, Filter.Tendsto (fun k ↦ C k ω) Filter.atTop (nhds (Z ω)))
    {N : ℝ} (hN : 0 ≤ N) :
    ¬ ∀ k, P[Z - C k | F k] ≤ᵐ[P] (fun _ ↦ N) :=
  fun hb ↦ hnot (hp.memLp_two_terminal_of_condExp_tail_bound hm h0 hZ hl hN hb).1

/-- Adding smaller delays directly to infinity cannot announce it: all
terms remain infinite. The capped construction supplies an actual witness. -/
theorem predictable_delay_at_infinity_needs_capping
    {Ω : Type*} [Nonempty Ω] {mΩ : MeasurableSpace Ω} (F : Filtration ℝ≥0 mΩ)
    (P : Measure Ω) {c : ℝ≥0} (hc : 0 < c) :
    IsAnnouncingSequence F P (fun _ : Ω ↦ (⊤ : WithTop ℝ≥0) + c)
      (fun n _ ↦ min ⊤ ((n : ℝ≥0) : WithTop ℝ≥0) +
        ((c - 1 / ((n : ℝ≥0) + 1) : ℝ≥0) : WithTop ℝ≥0)) ∧
      ¬ IsAnnouncingSequence F P (fun _ : Ω ↦ (⊤ : WithTop ℝ≥0) + c)
        (fun n _ ↦ (⊤ : WithTop ℝ≥0) + ((c - 1 / ((n : ℝ≥0) + 1) : ℝ≥0) : WithTop ℝ≥0)) := by
  have hτ : IsStoppingTime F (fun _ : Ω ↦ ⊤) := fun _ ↦ by simp
  refine ⟨hτ.isAnnouncingSequence_add_const P hc, ?_⟩
  intro h
  obtain ⟨ω⟩ := ‹Nonempty Ω›
  have hpos : (0 : WithTop ℝ≥0) < ⊤ + (c : WithTop ℝ≥0) := by
    rw [WithTop.top_add]
    exact WithTop.coe_lt_top 0
  have he : (⊤ : WithTop ℝ≥0) < ⊤ := by
    simpa only [WithTop.top_add] using h.strict 0 ω hpos
  exact lt_irrefl _ he

/-- AE announcing convergence does not control exceptional zero-target samples.
Their naive maxima can violate the required pointwise strict inequality. -/
theorem naive_max_of_ae_announcing_sequences_can_fail :
    letI : MeasurableSpace Bool := ⊤
    let F := Filtration.const ℝ≥0 (inferInstance : MeasurableSpace Bool) le_rfl
    ∃ σ π : ℕ → Bool → WithTop ℝ≥0,
      IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 0) σ ∧
      IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 1) π ∧
      ¬ IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 1)
        (fun n ω ↦ max (σ n ω) (π n ω)) := by
  intro F
  let : MeasurableSpace Bool := ⊤
  let σ : ℕ → Bool → WithTop ℝ≥0 := fun _ ω ↦ if ω then 0 else 2
  let π : ℕ → Bool → WithTop ℝ≥0 :=
    fun n _ ↦ ((1 - 1 / ((n : ℝ≥0) + 1) : ℝ≥0) : WithTop ℝ≥0)
  have hs : IsAnnouncingSequence F (Measure.dirac true) (fun _ ↦ 0) σ := by
    refine ⟨fun _ _ ↦ ?_, fun _ ↦ monotone_const,
      fun _ _ ht ↦ (lt_irrefl _ ht).elim, ?_⟩
    · change MeasurableSet[(⊤ : MeasurableSpace Bool)] _
      trivial
    · exact (ae_dirac_iff (by trivial)).mpr tendsto_const_nhds
  refine ⟨σ, π, hs, isAnnouncingSequence_const F (Measure.dirac true) 1, ?_⟩
  intro h
  have ht := h.strict 0 false (by norm_num : (0 : WithTop ℝ≥0) < 1)
  have hlow : (2 : WithTop ℝ≥0) ≤ max (σ 0 false) (π 0 false) := by
    change (2 : WithTop ℝ≥0) ≤ max 2 (π 0 false)
    exact le_max_left _ _
  have hbad : (2 : WithTop ℝ≥0) < 1 := hlow.trans_lt ht
  norm_num at hbad

/-- Restriction to the empty pre-stopping event is infinity, not a zero time;
the actual construction still makes it predictable. -/
theorem predictable_restriction_empty_retains_infinity
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {F : Filtration ℝ≥0 mΩ}
    {P : Measure Ω} [IsFiniteMeasure P] {τ : Ω → WithTop ℝ≥0}
    (hp : IsPredictableStoppingTime F τ P) (hF : F.IsUsual P) :
    restrictedStoppingTime τ ∅ = (fun _ ↦ ⊤) ∧
      IsPredictableStoppingTime F (restrictedStoppingTime τ ∅) P :=
  ⟨restrictedStoppingTime_empty τ,
    hp.restrictedStoppingTime_before hF (@MeasurableSet.empty Ω hp.1.measurableSpaceBefore)⟩

/-- Zero is not a strictly announced limit of the all-zero sequence. Its
strict-limit restriction is infinity, although the original limit is zero. -/
theorem strict_limit_restriction_excludes_zero :
    let σ : ℕ → Unit → WithTop ℝ≥0 := fun _ _ ↦ 0
    restrictedStoppingTime (fun ω ↦ ⨆ n, σ n ω) {ω | ∀ n, σ n ω < ⨆ k, σ k ω} =
      (fun _ ↦ ⊤) := by
  intro σ
  have hA : {ω | ∀ n, σ n ω < ⨆ k, σ k ω} = ∅ := by
    ext ω
    change (∀ _ : ℕ, (0 : WithTop ℝ≥0) < ⨆ _ : ℕ, (0 : WithTop ℝ≥0)) ↔ False
    rw [iSup_const]
    exact iff_false_intro (fun h ↦ lt_irrefl _ (h 0))
  rw [hA, restrictedStoppingTime_empty]

/-- A deterministic atom at zero distinguishes closed and left-open windows.
The totally-inaccessible premise in the closed-window theorem is essential. -/
theorem conditional_window_closed_endpoint_needs_no_atom
    {Ω : Type*} {mΩ : MeasurableSpace Ω} (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℝ≥0 mΩ) :
    P[{_ω : Ω | (0 : WithTop ℝ≥0) ≤ 0 ∧ (0 : WithTop ℝ≥0) ≤ 0}.indicator
      (fun _ ↦ (1 : ℝ)) | F 0] = (fun _ ↦ (1 : ℝ)) ∧
    P[{_ω : Ω | (0 : WithTop ℝ≥0) < 0 ∧ (0 : WithTop ℝ≥0) ≤ 0}.indicator
      (fun _ ↦ (1 : ℝ)) | F 0] = 0 := by
  simp only [le_refl, and_self, Set.ofPred_true, Set.indicator_univ,
    lt_self_iff_false, false_and, Set.ofPred_false, Set.indicator_empty,
    condExp_const (F.le 0)]
  exact ⟨trivial, rfl⟩

/-- The zero-width left-open window vanishes as an entire process, even
when the stopping time has an atom at zero or may be infinite. -/
theorem conditional_window_zero_width_is_indistinguishable_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} {τ : Ω → WithTop ℝ≥0}
    (hτ : IsStoppingTime F τ) (hF : F.IsUsual P) :
    ∃ R : ℝ≥0 → Ω → ℝ, StronglyAdapted F R ∧ HasCadlagPaths R P ∧
      Indistinguishable R 0 P := by
  obtain ⟨R, ha, hc, he, _⟩ := hτ.exists_cadlag_conditional_window hF 0
  exact ⟨R, ha, hc, cadlag_conditional_window_zero_delay hc.hasRightContinuousPaths he⟩

/-- A capped first threshold time can be finite without a hit. Its fallback
value does not satisfy the threshold inequality used on the trigger event. -/
theorem capped_threshold_time_does_not_imply_threshold :
    let X : ℝ≥0 → Unit → ℝ := fun _ _ ↦ 0
    let S : Unit → WithTop ℝ≥0 := fun ω ↦ min (hittingAfter X (Set.Ioi 1) 0 ω) 1
    S () = 1 ∧ ¬ (1 : ℝ) ≤ X 1 () := by
  intro X S
  norm_num [S, X, hittingAfter]

/-- Sampling at the window's own bounded lifetime retains the strict lower
endpoint, regardless of atoms in the law of that lifetime. -/
theorem conditional_window_sampling_at_own_lifetime_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    (σ : FiniteStoppingTime F) {T : ℝ≥0} (hσ : ∀ ω, σ ω ≤ T)
    {R : ℝ≥0 → Ω → ℝ} {δ : ℝ≥0}
    (haR : StronglyAdapted F R) (hrR : HasRightContinuousPaths R P)
    (heR : ∀ t : ℝ≥0, R t =ᵐ[P]
      P[{ω | (t : WithTop ℝ≥0) < (σ ω : WithTop ℝ≥0) ∧
        (σ ω : WithTop ℝ≥0) ≤ ((t + δ : ℝ≥0) : WithTop ℝ≥0)}.indicator
          (fun _ ↦ (1 : ℝ)) | F t]) : (fun ω ↦ R (σ ω) ω) =ᵐ[P] 0 := by
  have hs := conditional_window_sample σ.isStoppingTime hF haR hrR heR σ hσ
  have hempty : {ω | (σ ω : WithTop ℝ≥0) < (σ ω : WithTop ℝ≥0) ∧
      (σ ω : WithTop ℝ≥0) ≤ ((σ ω + δ : ℝ≥0) : WithTop ℝ≥0)} = ∅ := by
    ext ω
    exact iff_false_intro (fun h ↦ lt_irrefl _ h.1)
  rw [hempty, Set.indicator_empty] at hs
  change (fun ω ↦ R (σ ω) ω) =ᵐ[P] P[(0 : Ω → ℝ) | σ.measurableSpace] at hs
  simpa only [condExp_zero] using hs

/-- An infinite target has no finite future-window occurrence. Sampling its
conditional window cannot introduce a totalized finite terminal value. -/
theorem conditional_window_sampling_infinite_target_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P)
    (σ : FiniteStoppingTime F) {T : ℝ≥0} (hσ : ∀ ω, σ ω ≤ T)
    {R : ℝ≥0 → Ω → ℝ} {δ : ℝ≥0}
    (haR : StronglyAdapted F R) (hrR : HasRightContinuousPaths R P)
    (heR : ∀ t : ℝ≥0, R t =ᵐ[P]
      P[{_ω : Ω | (t : WithTop ℝ≥0) < ⊤ ∧
        (⊤ : WithTop ℝ≥0) ≤ ((t + δ : ℝ≥0) : WithTop ℝ≥0)}.indicator
          (fun _ ↦ (1 : ℝ)) | F t]) : (fun ω ↦ R (σ ω) ω) =ᵐ[P] 0 := by
  have hτ : IsStoppingTime F (fun _ : Ω ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
  have hs := conditional_window_sample hτ hF haR hrR heR σ hσ
  have hempty : {ω | (σ ω : WithTop ℝ≥0) < ⊤ ∧
      (⊤ : WithTop ℝ≥0) ≤ ((σ ω + δ : ℝ≥0) : WithTop ℝ≥0)} = ∅ := by
    ext ω
    exact iff_false_intro (fun h ↦ WithTop.not_top_le_coe _ h.2)
  rw [hempty, Set.indicator_empty] at hs
  change (fun ω ↦ R (σ ω) ω) =ᵐ[P] P[(0 : Ω → ℝ) | σ.measurableSpace] at hs
  simpa only [condExp_zero] using hs

/-- The off-diagonal imaginary Hessian entries are both positive two. -/
theorem complex_quadratic_mixed_hessian :
    coordinateSecondDeriv (fun x : Fin 2 → ℝ ↦ (complexCoordinates x ^ 2).im) 0 1 0 = 2 ∧
      coordinateSecondDeriv (fun x : Fin 2 → ℝ ↦ (complexCoordinates x ^ 2).im) 1 0 0 = 2 := by
  have hf : Differentiable ℂ (fun z : ℂ ↦ z ^ 2) := by fun_prop
  have hd : deriv (fun z : ℂ ↦ z ^ 2) = fun z ↦ 2 * z := by funext z; simp
  constructor
  · change coordinateSecondDeriv
      (fun x ↦ Complex.imCLM ((fun z : ℂ ↦ z ^ 2) (complexCoordinates x))) 0 1 0 = 2
    rw [coordinateSecondDeriv_complex_component hf, hd]
    norm_num
  · change coordinateSecondDeriv
      (fun x ↦ Complex.imCLM ((fun z : ℂ ↦ z ^ 2) (complexCoordinates x))) 1 0 0 = 2
    rw [coordinateSecondDeriv_complex_component hf, hd]
    norm_num

/-- The merely absolutely-continuous predictable Girsanov theorem remains a
genuine one-way result: no reverse absolute-continuity premise is required. -/
theorem absolute_continuous_predictable_girsanov_is_one_way
    {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P Q : Measure Ω} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {F : Filtration ℝ≥0 mΩ} {M : ℝ≥0 → Ω → ℝ}
    (hM : IsLocalMartingale M F P) (hQP : Q ≪ P)
    (hFP : F.IsUsual P) (hFQ : F.IsUsual Q)
    (hV : HasLocallyIntegrableVariation
      (densityRawCovariation (Q := Q) hM hFP) F P) :
    IsLocalMartingale
      (M - absoluteContinuousPredictableGirsanovCorrection
        (Q := Q) hM hQP hFP hFQ hV) F Q :=
  isLocalMartingale_sub_absoluteContinuousPredictableGirsanovCorrection
    hM hQP hFP hFQ hV

/-- Lenglart--Girsanov is also genuinely one-way.  Its extra predictable term
is the compensator of the density-killing jump, not a reverse-density
construction hidden behind an equivalence assumption. -/
theorem absolute_continuous_lenglart_girsanov_is_one_way
    {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P Q : Measure Ω} [IsProbabilityMeasure P] [IsProbabilityMeasure Q]
    {F : Filtration ℝ≥0 mΩ} {M : ℝ≥0 → Ω → ℝ}
    (hM : IsLocalMartingale M F P) (hQP : Q ≪ P)
    (hFP : F.IsUsual P) (hFQ : F.IsUsual Q) :
    IsLocalMartingale
      (M - absoluteContinuousRawGirsanovCorrection hM hQP hFP hFQ +
        absoluteContinuousKillingJumpCompensator (Q := Q) hM hFP) F Q :=
  isLocalMartingale_sub_absoluteContinuousRawGirsanovCorrection_add_killingCompensator
    hM hQP hFP hFQ

end StochLean.SemimartingaleRegression
