    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P) :
    ∀ᵐ ω ∂P, hX.quadraticCovariation hY hF 0 ω = X 0 ω * Y 0 ω ∧
      hX.continuousQuadraticCovariation hY hF 0 ω = 0 := by
  filter_upwards [hX.quadraticCovariation_zero_ae hY hF] with ω hω
  exact ⟨hω, hX.continuousQuadraticCovariation_zero hY hF ω⟩

open ProbabilityTheory in
/-- Closed stopping retains the endpoint jump, including the source jump at zero. -/
theorem stopped_jump_at_endpoint {Ω : Type*} {X : ℝ≥0 → Ω → ℝ} {ω : Ω}
    (hX : IsCadlagPath (X · ω)) (a : ℝ≥0) :
    jumpProcess (MeasureTheory.stoppedProcess X (fun _ ↦ (a : WithTop ℝ≥0))) a ω =
      jumpProcess X a ω := by
  rw [hX.jumpProcess_stoppedProcess]
  exact if_pos le_rfl

open ProbabilityTheory in
/-- The weighted mixed sum includes the moving partial cell, with its weight
sampled at the original left endpoint, not at the moving endpoint. -/
theorem weightedCrossSum_partial_single_cell {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (ω : Ω) :
    StoppingTimePartition.weightedQuadraticCovariationSumProcess
      (StoppingTimePartition.deterministic F (TimePartition.single 2)) (fun u _ ↦ 3 + (u : ℝ))
        (fun u _ ↦ (u : ℝ)) (fun u _ ↦ (u : ℝ)) 1 ω = 3 := by
  change (∑ i : Fin 1, (3 + ((![0, 2] : Fin 2 → ℝ≥0) i.castSucc : ℝ)) *
    (((min ((![0, 2] : Fin 2 → ℝ≥0) i.succ) 1 : ℝ≥0) : ℝ) -
      ((min ((![0, 2] : Fin 2 → ℝ≥0) i.castSucc) 1 : ℝ≥0) : ℝ)) *
    (((min ((![0, 2] : Fin 2 → ℝ≥0) i.succ) 1 : ℝ≥0) : ℝ) -
      ((min ((![0, 2] : Fin 2 → ℝ≥0) i.castSucc) 1 : ℝ≥0) : ℝ))) = 3
  rw [Fin.sum_univ_one]
  norm_num

open ProbabilityTheory in
/-- Even nonzero initial data and weights cannot create an atom in the
increment-only weighted sum. -/
theorem weightedCrossSum_initial_normalization {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (π : StoppingTimePartition F) (H X Y : ℝ≥0 → Ω → ℝ) :
    π.weightedQuadraticCovariationSumProcess H X Y 0 = 0 :=
  π.weightedQuadraticCovariationSumProcess_zero H X Y

open ProbabilityTheory in
/-- The II.30 limit has zero initial value because the source H₀₋ is zero,
even though the raw mixed bracket starts at X₀Y₀. -/
theorem weightedCrossSum_limit_initial_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y H : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P)
    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCadlagPaths H P) :
    (hX.isSemimartingale_quadraticCovariation hY hF).stochasticIntegral hF
      (ha.leftLimitProcess_of_usual hF hr) hr.hasCagladPaths_leftLimitProcess 0 =ᵐ[P] 0 := by
  filter_upwards [(hX.isSemimartingale_quadraticCovariation hY hF).stochasticIntegral_zero_ae
    hF (ha.leftLimitProcess_of_usual hF hr) hr.hasCagladPaths_leftLimitProcess] with ω hω
  simpa only [leftLimitProcess_zero, Pi.zero_apply, zero_mul] using hω

open ProbabilityTheory in
/-- The two-integral formula retains all four initial factors, without moment
assumptions on any of the integrators or integrands. -/
theorem integralCovariation_initial_product {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y H K : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P)
    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (haH : Adapted F H) (hrH : HasCagladPaths H P)
    (haK : Adapted F K) (hrK : HasCagladPaths K P) :
    (hX.isSemimartingale_stochasticIntegral hF haH hrH).quadraticCovariation
      (hY.isSemimartingale_stochasticIntegral hF haK hrK) hF 0 =ᵐ[P]
        fun ω ↦ (H 0 ω * X 0 ω) * (K 0 ω * Y 0 ω) := by
  filter_upwards [hX.quadraticCovariation_stochasticIntegral_both hY hF haH hrH haK hrK,
    (hX.isSemimartingale_quadraticCovariation hY hF).stochasticIntegral_zero_ae hF
      (fun t ↦ (haH t).mul (haK t)) (hrH.mul hrK),
    hX.quadraticCovariation_zero_ae hY hF] with ω hi hj hb
  rw [hi 0, hj, hb]
  simp only [Pi.mul_apply]
  ring

open ProbabilityTheory in
/-- The square-integral bracket formula retains the entire initial square. -/
theorem integralQV_initial_square {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCagladPaths H P) :
    (hX.isSemimartingale_stochasticIntegral hF ha hr).quadraticVariation hF 0 =ᵐ[P]
      fun ω ↦ (H 0 ω * X 0 ω) ^ 2 := by
  filter_upwards [hX.quadraticVariation_stochasticIntegral hF ha hr,
    (hX.isSemimartingale_quadraticVariation hF).stochasticIntegral_zero_ae hF
      (fun t ↦ (ha t).pow_const (2 : ℕ))
      (hr.continuous_comp (f := fun x : ℝ ↦ x ^ 2) (continuous_id.pow 2)),
    hX.quadraticVariation_zero_ae hF] with ω hi hj hb
  rw [hi 0, hj, hb]
  ring

open ProbabilityTheory in
/-- With a constant integrator every positive-time coefficient disappears
from the finite bracket sums, but the initial product survives. -/
theorem simpleIntegral_constant_integrator_crossSum {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (R : SimplePredictableRep F) (π : StoppingTimePartition F)
    (Z : Ω → ℝ) (Y : ℝ≥0 → Ω → ℝ) :
    π.quadraticCovariationSumProcess (R.integralProcess (fun _ ↦ Z)) Y =
      fun _ ω ↦ R.initial ω * Z ω * Y 0 ω := by
  have heq : R.integralProcess (fun _ ↦ Z) = fun _ ω ↦ R.initial ω * Z ω := by
    funext t ω
    simp [SimplePredictableRep.integralProcess_apply]
  rw [heq, π.quadraticCovariationSumProcess_constant_left]

/-- Unlike the raw mixed bracket, its continuous component vanishes when just
one argument is stopped at zero, without initial moment assumptions. -/
theorem continuousCovariation_stopped_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hY : ProbabilityTheory.IsSemimartingale Y F P) (hF : F.IsUsual P) :
    ProbabilityTheory.Indistinguishable
      ((hX.stoppedProcess hF (isStoppingTime_const F 0)).continuousQuadraticCovariation hY hF)
      0 P := by
  filter_upwards [hX.continuousQuadraticCovariation_stoppedProcess_left hY hF
    (isStoppingTime_const F 0)] with ω hs t
  apply (hs t).trans
  change hX.continuousQuadraticCovariation hY hF (min (t : WithTop ℝ≥0) 0).untopA ω = 0
  rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ t from bot_le)]
  exact hX.continuousQuadraticCovariation_zero hY hF ω

open ProbabilityTheory in
/-- A continuous path can have a nonzero source jump at zero. Only positive
times occur in the no-jump characterization of continuity. -/
theorem continuous_path_nonzero_initial_jump :
    IsContinuousPath (fun _ : ℝ≥0 ↦ (1 : ℝ)) ∧
      jumpProcess (fun (_ : ℝ≥0) (_ : Unit) ↦ (1 : ℝ)) 0 () = 1 := by
  exact ⟨continuous_const, by rw [jumpProcess_zero]⟩

open ProbabilityTheory in
/-- Constant continuous local martingales have their full raw initial square,
even if that initial random variable is not integrable. -/
theorem constant_continuous_local_raw_square {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {Z : Ω → ℝ} (hZ : Measurable[F 0] Z) (hF : F.IsUsual P) :
    Indistinguishable
      (((isContinuousLocalMartingale_const_initial hZ).isSemimartingale hF).quadraticVariation hF)
      (fun _ ω ↦ (Z ω) ^ 2) P := quadraticVariation_const_initial hZ hF

open ProbabilityTheory in
/-- The square-minus-raw-bracket local martingale starts at zero without
assuming that the original continuous local martingale starts at zero. -/
theorem continuousLocal_square_compensation_initial_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : IsContinuousLocalMartingale X F P) (hF : F.IsUsual P) :
    (fun ω ↦ (X 0 ω) ^ 2 - (hX.isSemimartingale hF).quadraticVariation hF 0 ω) =ᵐ[P] 0 := by
  filter_upwards [(hX.isSemimartingale hF).quadraticVariation_zero_ae hF] with ω hω
  simp only [hω, sub_self, Pi.zero_apply]

open ProbabilityTheory in
/-- A nonconstant continuous FV process has constant raw QV equal to its
nonzero initial square, not its value squared at later times. -/
theorem linear_continuous_fv_raw_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    (hF : F.IsUsual P) :
    ∃ hX : IsSemimartingale (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) F P,
      Indistinguishable (hX.quadraticVariation hF) (fun _ _ ↦ (1 : ℝ)) P := by
  have hv : HasFiniteVariationPaths (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) P := by
    apply HasMonotonePaths.hasFiniteVariationPaths
    exact ae_of_all _ fun _ _ _ h ↦ add_le_add (NNReal.coe_le_coe.mpr h) le_rfl
  have hc : HasContinuousPaths (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) P :=
    ae_of_all _ fun _ ↦ NNReal.continuous_coe.add continuous_const
  let hX := hv.isSemimartingale (fun _ ↦ measurable_const) hF hc.hasCadlagPaths
  refine ⟨hX, ?_⟩
  simpa only [NNReal.coe_zero, zero_add, one_pow] using
    hX.quadraticVariation_of_continuous_finiteVariation hF hc hv

open ProbabilityTheory in
/-- Equal stopping endpoints remove the entire raw bracket, including the
initial square. The endpoint may be zero or infinity. -/
theorem stopped_difference_same_time_raw_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime F τ) :
    Indistinguishable
      (((hX.stoppedProcess hF hτ).sub (hX.stoppedProcess hF hτ)).quadraticVariation hF) 0 P := by
  simpa only [sub_self] using
    hX.quadraticVariation_stopped_difference hF hτ hτ (ae_of_all _ fun _ ↦ le_rfl)

open ProbabilityTheory in
/-- The full interval `[0,infinity)` is expressed solely with finite evaluations. -/
theorem stopping_constancy_zero_top {Ω : Type*} {X : ℝ≥0 → Ω → ℝ} (ω : Ω) :
    (∀ t, MeasureTheory.stoppedProcess X (fun _ ↦ (⊤ : WithTop ℝ≥0)) t ω =
      MeasureTheory.stoppedProcess X (fun _ ↦ (0 : WithTop ℝ≥0)) t ω) ↔
      ∀ t, X t ω = X 0 ω := by
  have ht (t : ℝ≥0) : MeasureTheory.stoppedProcess X
      (fun _ ↦ (⊤ : WithTop ℝ≥0)) t ω = X t ω := by
    change X (min (t : WithTop ℝ≥0) ⊤).untopA ω = X t ω
    rw [min_eq_left le_top]
    rfl
  have hz (t : ℝ≥0) : MeasureTheory.stoppedProcess X
      (fun _ ↦ (0 : WithTop ℝ≥0)) t ω = X 0 ω := by
    change X (min (t : WithTop ℝ≥0) 0).untopA ω = X 0 ω
    rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ t from bot_le)]
    rfl
  simp only [ht, hz]

/-- At a jump endpoint left and right sampling differ; the jump square is
retained by the actual one-cell sum. -/
theorem endpoint_step_jump_distinction :
    (TimePartition.single 1).leftStep (fun t ↦ if 1 ≤ t then (3 : ℝ) else 1) 1 = 1 ∧
    (TimePartition.single 1).taggedStep (TimePartition.single 1).right
      (fun t ↦ if 1 ≤ t then (3 : ℝ) else 1) 1 = 3 ∧
    quadraticVariationSum (TimePartition.single 1)
      (fun t ↦ if 1 ≤ t then (3 : ℝ) else 1) = 4 := by
  have hi : (TimePartition.single 1).left (0 : Fin 1) < 1 ∧
      1 ≤ (TimePartition.single 1).right (0 : Fin 1) := by
    change (0 : ℝ≥0) < 1 ∧ 1 ≤ 1
    norm_num
  refine ⟨?_, ?_, ?_⟩
  · rw [(TimePartition.single 1).leftStep_eq_of_mem_cell _ hi]
    change (if (1 : ℝ≥0) ≤ 0 then (3 : ℝ) else 1) = 1
    norm_num
  · rw [(TimePartition.single 1).taggedStep_eq_of_mem_cell (TimePartition.single 1).right _ hi]
    change (if (1 : ℝ≥0) ≤ 1 then (3 : ℝ) else 1) = 3
    norm_num
  · norm_num [quadraticVariationSum_single]

open ProbabilityTheory in
/-- The positive-time jump series does not duplicate the raw initial square. -/
theorem finiteVariation_jump_series_initial_zero {Ω : Type*} (X : ℝ≥0 → Ω → ℝ) (ω : Ω) :
    (∑' s : Set.Ioc (0 : ℝ≥0) 0, (jumpProcess X s ω) ^ 2) = 0 := by simp

open ProbabilityTheory in
/-- Quadratic pure jump allows nonconstant continuous FV drift. -/
theorem quadratic_pure_jump_allows_continuous_drift {mΩ : MeasurableSpace Unit}
    {P : Measure Unit} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    ∃ hX : IsSemimartingale (fun (t : ℝ≥0) (_ : Unit) ↦ (t : ℝ) + 1) F P,
      hX.IsQuadraticPureJump hF ∧
        (fun (t : ℝ≥0) (_ : Unit) ↦ (t : ℝ) + 1) 1 () ≠
          (fun (t : ℝ≥0) (_ : Unit) ↦ (t : ℝ) + 1) 0 () := by
  obtain ⟨hX, hraw⟩ := linear_continuous_fv_raw_initial hF
  refine ⟨hX, ?_, by norm_num⟩
  have hc : HasContinuousPaths (fun (t : ℝ≥0) (_ : Unit) ↦ (t : ℝ) + 1) P :=
    ae_of_all _ fun _ ↦ NNReal.continuous_coe.add continuous_const
  apply (hX.isQuadraticPureJump_iff_raw_constant_of_continuous hF hc).mpr
  simpa only [NNReal.coe_zero, zero_add, one_pow] using hraw

/-- Nonnegativity only at nonnegative integer coefficients cannot annihilate
the slope. The mixed-bracket argument requires both integer directions. -/
theorem nonnegative_coefficients_do_not_force_zero_slope :
    (∀ n : ℕ, (0 : ℝ) ≤ 1 + (n : ℝ) * 2) ∧ (2 : ℝ) ≠ 0 := by
  exact ⟨fun n ↦ by positivity, by norm_num⟩

open ProbabilityTheory in
/-- The pure-jump mixed formula does not lose or duplicate the raw initial
product. No integrability of either initial random variable is assumed. -/
theorem pure_jump_mixed_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P)
    (hY : IsSemimartingale Y F P) (hF : F.IsUsual P)
    (hQ : hX.IsQuadraticPureJump hF) :
    hX.quadraticCovariation hY hF 0 =ᵐ[P] fun ω ↦ X 0 ω * Y 0 ω := by
  filter_upwards [hX.quadraticCovariation_of_quadraticPureJump_left hY hF hQ]
    with ω he
  simpa using he 0

open ProbabilityTheory in
/-- A nonconstant continuous FV drift contributes no mixed increments even
against a discontinuous semimartingale, while retaining its initial product. -/
theorem linear_drift_mixed_raw_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {Y : ℝ≥0 → Ω → ℝ} (hY : IsSemimartingale Y F P) (hF : F.IsUsual P) :
    ∃ hX : IsSemimartingale (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) F P,
      Indistinguishable (hX.quadraticCovariation hY hF) (fun _ ω ↦ Y 0 ω) P := by
  obtain ⟨hX, _⟩ := linear_continuous_fv_raw_initial hF
  have hv : HasFiniteVariationPaths (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) P := by
    apply HasMonotonePaths.hasFiniteVariationPaths
    exact ae_of_all _ fun _ _ _ h ↦ add_le_add (NNReal.coe_le_coe.mpr h) le_rfl
  have hc : HasContinuousPaths (fun (t : ℝ≥0) (_ : Ω) ↦ (t : ℝ) + 1) P :=
    ae_of_all _ fun _ ↦ NNReal.continuous_coe.add continuous_const
  refine ⟨hX, ?_⟩
  simpa only [NNReal.coe_zero, zero_add, one_mul] using
    hX.quadraticCovariation_initial_of_continuous_finiteVariation_left hY hF hc hv

open ProbabilityTheory Filter Set in
open scoped Topology in
/-- The path jumping from 1 to 3 at time 1 has square change 8, derivative
increment integral 4 and jump correction 4. Omitting that correction is false. -/
theorem single_jump_c1_change_of_variables :
    let x : ℝ≥0 → ℝ := fun t ↦ if 1 ≤ t then 3 else 1
    ∃ hv : LocallyBoundedVariationOn x univ,
      ∃ hr : ∀ t, ContinuousWithinAt x (Ici t) t,
        pathStieltjesIncrementIntegral x hv hr (fun t ↦ 2 * Function.leftLim x t) 0 1 = 4 ∧
        x 1 ^ 2 - x 0 ^ 2 = 8 ∧
        (∑' s : Ioc (0 : ℝ≥0) 1, (x s ^ 2 - Function.leftLim x s ^ 2 -
          2 * Function.leftLim x s * (x s - Function.leftLim x s))) = 4 := by
  let x : ℝ≥0 → ℝ := fun t ↦ if 1 ≤ t then 3 else 1
  have hm : Monotone x := by
    intro s t hst
    by_cases hs : 1 ≤ s
    · simp only [x, if_pos hs, if_pos (hs.trans hst), le_refl]
    · by_cases ht : 1 ≤ t <;> norm_num [x, hs, ht]
  have hv : LocallyBoundedVariationOn x univ := (hm.monotoneOn univ).locallyBoundedVariationOn
  have hr : ∀ t, ContinuousWithinAt x (Ici t) t := by
    intro t
    change Tendsto x (𝓝[≥] t) (𝓝 (x t))
    by_cases ht : 1 ≤ t
    · rw [show x t = 3 from if_pos ht]
      apply tendsto_const_nhds.congr'
      filter_upwards [self_mem_nhdsWithin] with u hu
      exact (if_pos (ht.trans hu)).symm
    · rw [show x t = 1 from if_neg ht]
      apply tendsto_const_nhds.congr'
      filter_upwards [nhdsWithin_le_nhds (Iio_mem_nhds (lt_of_not_ge ht))] with u hu
      exact (if_neg (not_le_of_gt (show u < 1 from hu))).symm
  have hl (s : ℝ≥0) (hs : s ∈ Ioc 0 1) : Function.leftLim x s = 1 := by
    let : (𝓝[<] s).NeBot := nhdsLT_neBot_of_exists_lt ⟨0, hs.1⟩
    apply leftLim_eq_of_tendsto
    apply tendsto_const_nhds.congr'
    filter_upwards [self_mem_nhdsWithin] with u hu
    exact (if_neg (not_le_of_gt ((show u < s from hu).trans_le hs.2))).symm
  have hi : pathStieltjesIncrementIntegral x hv hr (fun t ↦ 2 * Function.leftLim x t) 0 1 = 4 := by
    calc
      _ = pathStieltjesIncrementIntegral x hv hr (fun _ ↦ 2) 0 1 := by
        apply pathStieltjesIncrementIntegral_congr_ae
        filter_upwards [ae_restrict_mem measurableSet_Ioc] with s hs
        rw [hl s hs, mul_one]
      _ = 4 := by rw [pathStieltjesIncrementIntegral_const 2 (by norm_num)]; norm_num [x]
  have hd (z : ℝ) : deriv (fun u : ℝ ↦ u ^ 2) z = 2 * z := by
    simp
  have he := (pathStieltjesIncrementIntegral_contDiff_rightContinuous hv hr
    (contDiff_id.pow 2) 1).2
  simp only [id_eq, hd, hi] at he
  have hchange : x 1 ^ 2 - x 0 ^ 2 = 8 := by norm_num [x]
  refine ⟨hv, hr, hi, hchange, ?_⟩
  linarith

open ProbabilityTheory in
/-- In the source convention, composing a derivative with the left limit
evaluates that derivative at zero at time zero, not at the original initial value. -/
theorem derivative_left_limit_source_initial {Ω : Type*} (X : ℝ≥0 → Ω → ℝ)
    (f : ℝ → ℝ) (ω : Ω) : deriv f (leftLimitProcess X 0 ω) = deriv f 0 := by simp

/-- Repeated cell values use the actual derivative, not a zero-division slope. -/
theorem differentiated_slope_diagonal_not_zero : dslope (fun u : ℝ ↦ u ^ 2) 3 3 = 6 := by
  norm_num [dslope_same]

/-- Infinite stopping preserves the full continuous bracket without evaluating
any process at infinity. -/
theorem continuousQV_stopped_infinite {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) :
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    ProbabilityTheory.Indistinguishable
      ((hX.stoppedProcess hF htop).continuousQuadraticVariation hF)
      (hX.continuousQuadraticVariation hF) P := by
  dsimp only
  have htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
  filter_upwards [hX.continuousQuadraticVariation_stoppedProcess hF htop] with ω hs t
  simpa only [MeasureTheory.stoppedProcess, min_eq_left le_top,
    WithTop.untopA, WithTop.untopD_coe] using hs t

/-- The normalized Frechet Taylor error is exactly zero on a vector diagonal,
including for a function whose Hessian is not zero. -/
theorem vector_taylor_error_diagonal :
    frechetTaylorErrorCoefficient (fun p : ℝ × ℝ ↦ p.1 * p.2) (2, 3) (2, 3) = 0 := by
  exact frechetTaylorErrorCoefficient_self _ _

/-- A two-coordinate ambient space does not erase a genuine cubic jump error. -/
theorem vector_cubic_jump_error :
    frechetSecondOrderRemainder (fun p : ℝ × ℝ ↦ p.1 ^ 3) (0, 0) (1, 0) = 1 := by
  let f : ℝ × ℝ → ℝ := fun p ↦ p.1 ^ 3
  have hf : ContDiff ℝ 2 f := contDiff_fst.pow 3
  have h₁ := deriv_line_eq_fderiv (hf.differentiable (by decide)) (0, 0) (1, 0) 0
  have h₂ := second_deriv_line_eq_fderiv hf (0, 0) (1, 0) 0
  simp only [f, Prod.fst_add, Prod.smul_fst, smul_eq_mul, zero_add, mul_one,
    zero_smul, add_zero] at h₁ h₂
  have hd : deriv (fun r : ℝ ↦ r ^ 3) = fun r ↦ 3 * r ^ 2 := by funext r; simp
  rw [hd] at h₁ h₂
  norm_num at h₁ h₂
  unfold frechetSecondOrderRemainder
  simp only [Prod.mk_sub_mk, sub_zero, ← h₁, ← h₂]
  norm_num

/-- The product norm energy is a deterministic bound, not the sum of
coordinate brackets: this single vector increment has energy 4, not 5. -/
theorem vector_sup_norm_single_cell_energy :
    normSquareVariationSum (TimePartition.single 1)
      (fun t ↦ ((t : ℝ), 2 * (t : ℝ))) = 4 := by
  change (∑ i : Fin 1, ‖(((TimePartition.single 1).right i : ℝ),
      2 * ((TimePartition.single 1).right i : ℝ)) -
      (((TimePartition.single 1).left i : ℝ), 2 * ((TimePartition.single 1).left i : ℝ))‖ ^ 2) = 4
  rw [Fin.sum_univ_one,
    show (TimePartition.single 1).right (0 : Fin 1) = 1 from rfl,
    show (TimePartition.single 1).left (0 : Fin 1) = 0 from rfl]
  norm_num [Prod.norm_def]

/-- A partial vector cell retains its actual cubic error, rather than the
full cell's error or a discarded terminal remainder. -/
theorem vector_partial_cell_cubic_error :
    frechetTaylorErrorSum (TimePartition.single 2) (fun p : ℝ × ℝ ↦ p.1 ^ 3)
      (fun t ↦ ((t : ℝ), (0 : ℝ))) 1 = 1 := by
  change (∑ i : Fin 1, frechetTaylorErrorCoefficient (fun p : ℝ × ℝ ↦ p.1 ^ 3)
    ((min ((TimePartition.single 2).left i) 1 : ℝ≥0), 0)
    ((min ((TimePartition.single 2).right i) 1 : ℝ≥0), 0) *
      ‖(((min ((TimePartition.single 2).right i) 1 : ℝ≥0) : ℝ), (0 : ℝ)) -
        (((min ((TimePartition.single 2).left i) 1 : ℝ≥0) : ℝ), (0 : ℝ))‖ ^ 2) = 1
  rw [Fin.sum_univ_one, frechetTaylorErrorCoefficient_mul_norm_sq,
    show (TimePartition.single 2).right (0 : Fin 1) = 2 from rfl,
    show (TimePartition.single 2).left (0 : Fin 1) = 0 from rfl]
  norm_num only [zero_min, min_eq_right (by norm_num : (1 : ℝ≥0) ≤ 2),
    NNReal.coe_zero, NNReal.coe_one]
  exact vector_cubic_jump_error

open ProbabilityTheory in
/-- The raw-bracket integral retains its initial square even though its
continuous part and its positive-time jump series both start at zero. -/
theorem raw_bracket_integral_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCagladPaths H P) :
    ∀ᵐ ω ∂P, (hX.isSemimartingale_quadraticVariation hF).stochasticIntegral hF ha hr 0 ω =
      H 0 ω * (X 0 ω) ^ 2 := by
  filter_upwards [(hX.isSemimartingale_quadraticVariation hF).stochasticIntegral_zero_ae hF ha hr,
    hX.quadraticVariation_zero_ae hF] with ω hi h0
  simpa only [h0] using hi

open ProbabilityTheory in
/-- Source left limits cannot commute with arbitrary constant transforms
at zero. The positive-time composition lemma intentionally excludes zero. -/
theorem constant_transform_left_limit_zero :
    leftLimitProcess (fun (_ : ℝ≥0) (_ : Unit) ↦ (7 : ℝ)) 0 () = 0 ∧
      (fun _ : ℝ ↦ (7 : ℝ))
        (leftLimitProcess (fun (_ : ℝ≥0) (_ : Unit) ↦ (0 : ℝ)) 0 ()) = 7 := by
  simp only [leftLimitProcess_zero, Pi.zero_apply, and_self]

/-- The initial Stieltjes integral is not a positive-time measure atom. -/
theorem constant_stieltjes_integral_retains_initial (T : ℝ≥0)
    (hv : LocallyBoundedVariationOn (StieltjesFunction.const ℝ≥0 3) Set.univ) :
    pathStieltjesIntegral (StieltjesFunction.const ℝ≥0 3) hv
      (StieltjesFunction.const ℝ≥0 3).right_continuous (fun _ ↦ 2) T = 6 := by
  rw [pathStieltjesIntegral_const]
  norm_num

open ProbabilityTheory in
/-- The separate source initial jump is not part of the positive-time
product: an initial value of -1 does not itself kill that product. -/
theorem stochastic_exponential_source_initial_jump_not_absorbing
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let hX := isSemimartingale_const_initial (F := F) (P := P)
      (Z := fun _ ↦ (-1 : ℝ)) measurable_const
    ∀ ω, jumpProcess (fun (_ : ℝ≥0) (_ : Ω) ↦ (-1 : ℝ)) 0 ω = -1 ∧
      0 < hX.stochasticExponential hF 0 ω := by
  dsimp only
  intro ω
  constructor
  · simp only [jumpProcess_zero]
  · rw [IsSemimartingale.stochasticExponential_zero]
    exact Real.exp_pos _

/-- A jump of -2 gives a negative, not absolute-value, multiplier. -/
theorem stochastic_exponential_negative_jump_multiplier :
    Real.exp (-2) * exponentialJumpFactor (-2) = -1 := by
  rw [exponentialJumpFactor]
  have h : Real.exp (-2) * Real.exp (2 : ℝ) = 1 := by
    rw [← Real.exp_add]
    norm_num
  norm_num only [neg_neg] at *
  nlinarith only [h]

open ProbabilityTheory in
/-- A positive-time jump of -1 annihilates every subsequent product value,
without an unnecessary positivity or nonzero-jump premise. -/
theorem stochastic_exponential_absorbed_after_minus_one_jump
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) {s : ℝ≥0} {ω : Ω}
    (hs : 0 < s) (hj : jumpProcess X s ω = -1) :
    ∀ t, s ≤ t → hX.stochasticExponential hF t ω = 0 :=
  fun _ ht ↦ hX.stochasticExponential_eq_zero_of_jump_eq_neg_one hF ⟨hs, ht⟩ hj

open ProbabilityTheory in
/-- The positive-time exponential jump identity cannot be extended to the
source time zero: the left-hand side is strictly positive and the right
side is zero, independently of the integrator's initial value. -/
theorem stochastic_exponential_jump_contract_excludes_zero
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → ℝ}
    (hX : IsSemimartingale X F P) (hF : F.IsUsual P) (ω : Ω) :
    jumpProcess (hX.stochasticExponential hF) 0 ω ≠
      leftLimitProcess (hX.stochasticExponential hF) 0 ω * jumpProcess X 0 ω := by
  simp only [jumpProcess_zero, leftLimitProcess_zero, Pi.zero_apply, zero_mul,
    IsSemimartingale.stochasticExponential_zero]
  exact Real.exp_ne_zero _

/-- Even after a zero factor, the actual jump series accounts for the
entire loss of the product's initial value one. -/
theorem cumulative_product_zero_factor_jump_sum
    {f : ℝ≥0 → ℝ}
    (hs : ∀ T : ℝ≥0, Summable (fun s : Set.Ioc 0 T ↦ |f s - 1|))
    {t a : ℝ≥0} (ha : a ∈ Set.Ioc 0 t) (hf : f a = 0) :
    (∑' s : Set.Ioc 0 t, ((∏' u : Set.Ioc 0 (s : ℝ≥0), f u) -
      Function.leftLim (fun v : ℝ≥0 ↦ ∏' u : Set.Ioc 0 v, f u) s)) = -1 := by
  rw [← tprod_Ioc_sub_one_eq_tsum_jumps hs t,
    tprod_of_exists_eq_zero ⟨⟨a, ha⟩, hf⟩]
  ring

/-- Simultaneously activated coefficients are combined into one actual
jump, not silently discarded by an injectivity requirement. -/
theorem step_series_repeated_activation (w : Fin 2 → ℝ) :
    (∑' i, if (1 : ℝ≥0) ≤ 1 then w i else 0) -
      Function.leftLim (fun t : ℝ≥0 ↦ ∑' i, if 1 ≤ t then w i else 0) 1 =
        w 0 + w 1 := by
  rw [tsum_stepCutoff_sub_leftLim (fun _ : Fin 2 ↦ (1 : ℝ≥0))
    (Summable.of_finite (f := fun i ↦ |w i|)) (by norm_num)]
  rw [tsum_subtype]
  simp [Set.indicator, tsum_fintype, Fin.sum_univ_two]

/-- The totalized complex logarithm sends zero to zero; exponentiating it
therefore gives one, not a zero factor. The separate zero guard is essential. -/
theorem exponential_product_complex_log_requires_zero_guard :
    exponentialJumpFactor (-1) = 0 ∧
      (Complex.exp (Complex.log (exponentialJumpFactor (-1) : ℂ))).re = 1 := by
  simp only [exponentialJumpFactor_neg_one, Complex.ofReal_zero, Complex.log_zero,
    Complex.exp_zero, Complex.one_re, and_self]

/-- Complex logarithms preserve the sign of a negative jump multiplier;
using only the real logarithm of its absolute value would fail this check. -/
theorem exponential_product_complex_log_retains_negative_multiplier :
    Real.exp (-2) * (Complex.exp
      (Complex.log (exponentialJumpFactor (-2) : ℂ))).re = -1 := by
  have hf : exponentialJumpFactor (-2) ≠ 0 := by
    intro hz
    have h := (exponentialJumpFactor_eq_zero_iff (-2)).mp hz
    norm_num at h
  have hc : (exponentialJumpFactor (-2) : ℂ) ≠ 0 := by exact_mod_cast hf
  rw [Complex.exp_log hc]
  exact stochastic_exponential_negative_jump_multiplier

open ProbabilityTheory in
/-- The bilinear complex bracket can be negative real even when the energy
bracket is positive: their initial values for the constant I are -1 and 1. -/
theorem complex_bilinear_bracket_is_not_energy
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    let h0 := isSemimartingale_const_initial (F := F) (P := P)
      (Z := fun _ ↦ (0 : ℝ)) measurable_const
    let h1 := isSemimartingale_const_initial (F := F) (P := P)
      (Z := fun _ ↦ (1 : ℝ)) measurable_const
    ∀ᵐ ω ∂P, (h0.complex h1).quadraticVariation hF 0 ω = -1 ∧
      (h0.complex h1).quadraticEnergy hF 0 ω = 1 := by
  dsimp only
  let h0 := isSemimartingale_const_initial (F := F) (P := P)
    (Z := fun _ ↦ (0 : ℝ)) measurable_const
  let h1 := isSemimartingale_const_initial (F := F) (P := P)
    (Z := fun _ ↦ (1 : ℝ)) measurable_const
  filter_upwards [(h0.complex h1).quadraticVariation_zero_ae hF,
    (h0.complex h1).quadraticEnergy_zero_ae hF] with ω hq he
  constructor
  · simpa [complexProcess, Complex.ext_iff, pow_two] using hq
  · simpa [complexProcess, ← Complex.normSq_eq_norm_sq, Complex.normSq_apply] using he

/-- A purely imaginary unit jump has analytic quadratic correction -1,
not the positive Hermitian energy. -/
theorem complex_quadratic_jump_correction :
    Complex.I ^ 2 - (0 : ℂ) ^ 2 -
      deriv (fun z : ℂ ↦ z ^ 2) 0 * (Complex.I - 0) = -1 := by
  norm_num [deriv_pow]

open ProbabilityTheory in
/-- Raw complex bracket integration retains H(0) times Z(0) squared.
The zero-plus comparison must require a vanishing initial integrand. -/
theorem complex_raw_bracket_integral_initial
    {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 mΩ} {Z H : ℝ≥0 → Ω → ℂ}
    (hZ : IsComplexSemimartingale Z F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : HasCagladPaths H P) :
    (hZ.isComplexSemimartingale_quadraticVariation hF).stochasticIntegral hF ha hr 0 =ᵐ[P]
      fun ω ↦ H 0 ω * (Z 0 ω) ^ 2 := by
  filter_upwards [
    (hZ.isComplexSemimartingale_quadraticVariation hF).stochasticIntegral_zero_ae hF ha hr,
    hZ.quadraticVariation_zero_ae hF] with ω hi hq
  exact hi.trans (congrArg (fun z ↦ H 0 ω * z) hq)

/-- Printed p.111 must reverse the correction signs when solving for the
original process from its bounded-jump correction. -/
theorem protter_large_jump_recombination_signs (X Xhat Mhat Mplus Mminus A : ℝ)
    (hc : Xhat = X + Mplus - Mminus) (hd : Xhat = Mhat - A) :
    X = (Mhat - Mplus + Mminus) - A := by
  linarith

/-- Printed p.112's large-amplitude tail is not the bounded component.
The small-amplitude part, rather than the tail, is bounded by the cutoff. -/
theorem protter_large_amplitude_tail_is_not_bounded :
    let tail := (Set.Ioi (1 : ℝ)).indicator id 3
    let bounded := (Set.Iic (1 : ℝ)).indicator id 3
    tail = 3 ∧ bounded = 0 ∧ ¬ |tail| ≤ 1 ∧ |bounded| ≤ 1 := by
  norm_num [Set.indicator_apply]

