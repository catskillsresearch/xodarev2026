/-! # Semimartingale foundation regressions

This module collects executable semantic regressions used across the
Semimartingale package.  The authoritative R01--R38 disposition and the exact
declaration/audit evidence are maintained in
`docs/SEMIMARTINGALE_REGRESSION_MATRIX.md`; not every structural API guard is
represented by a theorem in this one aggregate import module.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal ENNReal

namespace StochLean.SemimartingaleRegression

/-- General C2 preservation allows jumps and needs no moment assumptions. -/
theorem cadlag_c2_semimartingale_preservation {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} {f : ℝ → ℝ}
    (hX : ProbabilityTheory.IsSemimartingale X F P) (hF : F.IsUsual P)
    (hf : ContDiff ℝ 2 f) :
    ProbabilityTheory.IsSemimartingale (fun t ω ↦ f (X t ω)) F P :=
  hX.contDiff_comp hF hf

/-- Positive-time jump corrections do not include an arbitrary time-zero spike. -/
theorem positive_jump_series_excludes_initial (T : ℝ≥0) :
    (∑' s : Set.Ioc 0 T, if (s : ℝ≥0) = 0 then (7 : ℝ) else 0) = 0 := by
  calc
    _ = ∑' _ : Set.Ioc 0 T, (0 : ℝ) := tsum_congr (fun s ↦ if_neg (ne_of_gt s.2.1))
    _ = 0 := tsum_zero

/-- Filling a diagonal cell by the totalized quotient's zero is incorrect. -/
theorem quadratic_taylor_diagonal_not_zero :
    quadraticTaylorSlope (fun u : ℝ ↦ u ^ 2) 3 3 = 1 := by
  have hd : deriv (fun u : ℝ ↦ u ^ 2) = fun u ↦ 2 * u := by
    funext u
    simp
  rw [quadraticTaylorSlope_self, hd]
  norm_num

/-- The cubic Taylor error of an actual jump is nonzero. Omitting the
jump correction cannot extend the continuous formula to cadlag paths. -/
theorem cubic_single_jump_taylor_error :
    quadraticTaylorErrorSum (TimePartition.single 1) (fun u : ℝ ↦ u ^ 3)
      (fun t ↦ if t < 1 then 1 else 3) 1 = 8 := by
  have hd : deriv (fun u : ℝ ↦ u ^ 3) = fun u ↦ 3 * u ^ 2 := by
    funext u
    simp
  unfold quadraticTaylorErrorSum quadraticPairSum
  change (∑ i : Fin 1, _) = 8
  rw [Fin.sum_univ_one]
  rw [show (TimePartition.single 1).left (0 : Fin 1) = 0 from rfl,
    show (TimePartition.single 1).right (0 : Fin 1) = 1 from rfl]
  norm_num [quadraticTaylorSlope, hd]

/-- Nonlinear preservation has no initial-moment or derivative-bound premise. -/
theorem continuous_c2_semimartingale_preservation {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} {f : ℝ → ℝ}
    (hX : ProbabilityTheory.IsSemimartingale X F P) (hF : F.IsUsual P)
    (hc : ProbabilityTheory.HasContinuousPaths X P) (hf : ContDiff ℝ 2 f) :
    ProbabilityTheory.IsSemimartingale (fun t ω ↦ f (X t ω)) F P :=
  hX.contDiff_comp_of_continuous hF hc hf

/-- The bounded-integrand L2 estimate includes the possibly nonzero initial value. -/
theorem bounded_general_integral_initial_L2 {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {X H : ℝ≥0 → Ω → ℝ}
    (hX : ProbabilityTheory.IsSemimartingale X F P) (hF : F.IsUsual P)
    (hM : Martingale X F P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P)
    (C : ℝ≥0) (hb : ∀ᵐ ω ∂P, ∀ t, ‖H t ω‖ ≤ C) (hX0 : MemLp (X 0) 2 P) :
    eLpNorm (hX.stochasticIntegral hF ha hr 0) 2 P ≤ C * eLpNorm (X 0) 2 P :=
  hX.eLpNorm_stochasticIntegral_le_of_bounded hF hM ha hr C hb 0 hX0

/-- Nested general integrals retain the full triple initial product. -/
theorem general_integral_associativity_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X G H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (haG : Adapted F G) (hrG : ProbabilityTheory.HasCagladPaths G P)
    (haH : Adapted F H) (hrH : ProbabilityTheory.HasCagladPaths H P) :
    (hX.isSemimartingale_stochasticIntegral hF haH hrH).stochasticIntegral hF haG hrG 0 =ᵐ[P]
      fun ω ↦ (G 0 ω * H 0 ω) * X 0 ω := by
  filter_upwards [hX.stochasticIntegral_stochasticIntegral hF haG hrG haH hrH,
    hX.stochasticIntegral_zero_ae hF (fun t ↦ (haG t).mul (haH t)) (hrG.mul hrH)]
    with ω hω hz
  exact (hω 0).trans hz

/-- The compact deviation detects an isolated initial value at every horizon. -/
theorem compact_deviation_detects_initial_spike (T : ℝ≥0) :
    ProbabilityTheory.compactDeviation (fun t (_ : Unit) ↦ if t = 0 then 1 else 0) 0 T () = 1 := by
  apply le_antisymm
  · apply iSup_le
    intro t
    apply iSup_le
    intro _
    change ENNReal.ofReal ‖(if t = 0 then (1 : ℝ) else 0) - 0‖ ≤ 1
    split_ifs <;> norm_num
  · simpa using
      (ProbabilityTheory.enorm_sub_le_compactDeviation
        (X := fun t (_ : Unit) ↦ if t = 0 then 1 else 0) (Y := 0) (t := 0)
        (show (0 : ℝ≥0) ≤ T from bot_le) ())

/-- FV preservation is local to an arbitrary event, not only a full-measure event. -/
theorem general_integral_preserves_fv_on_event {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P)
    (A : Set Ω) (hA : ∀ ω ∈ A, LocallyBoundedVariationOn (X · ω) Set.univ) :
    ∀ᵐ ω ∂P, ω ∈ A →
      LocallyBoundedVariationOn (hX.stochasticIntegral hF ha hr · ω) Set.univ :=
  (hX.stochasticIntegral_finiteVariation_on_paths hF ha hr).mono fun ω hω hmem ↦
    hω (hA ω hmem)

/-- Zero variation strictly inside the interval does not remove the right-endpoint jump. -/
theorem open_interval_variation_excludes_endpoint_jump :
    let x : ℝ≥0 → ℝ := fun t ↦ if 1 ≤ t then 1 else 0
    eVariationOn x (Set.Ioo 0 1) = 0 ∧ eVariationOn x (Set.Icc 0 1) = 1 := by
  let x : ℝ≥0 → ℝ := fun t ↦ if 1 ≤ t then 1 else 0
  change eVariationOn x (Set.Ioo 0 1) = 0 ∧ eVariationOn x (Set.Icc 0 1) = 1
  constructor
  · have heq : Set.EqOn x (fun _ ↦ (0 : ℝ)) (Set.Ioo 0 1) := by
      intro t ht
      exact if_neg (not_le_of_gt ht.2)
    rw [eVariationOn.congr heq]
    simp [eVariationOn]
  · have hm : Monotone x := by
      intro s t hst
      by_cases hs : 1 ≤ s
      · simp only [x, if_pos hs, if_pos (hs.trans hst), le_refl]
      · by_cases ht : 1 ≤ t <;> simp [x, hs, ht]
    have heq := (hm.monotoneOn Set.univ).eVariationOn_eq
      (show (0 : ℝ≥0) ∈ Set.univ from Set.mem_univ _)
      (show (1 : ℝ≥0) ∈ Set.univ from Set.mem_univ _)
    simpa [x] using heq

/-- The infinite-upper-end construction only needs local variation bounds;
the linear time path is allowed on the whole half-line. -/
theorem linear_after_has_locally_finite_variation (a : ℝ≥0) :
    LocallyBoundedVariationOn (fun t : ℝ≥0 ↦ (t : ℝ) - (min t a : ℝ≥0)) Set.univ := by
  have hx : ProbabilityTheory.IsCadlagPath (fun t : ℝ≥0 ↦ (t : ℝ)) :=
    ProbabilityTheory.IsContinuousPath.isCadlagPath NNReal.continuous_coe
  apply hx.locallyBoundedVariationOn_after a
  intro b
  have hm : Monotone (fun t : ℝ≥0 ↦ (t : ℝ)) := fun _ _ h ↦ h
  have hv : BoundedVariationOn (fun t : ℝ≥0 ↦ (t : ℝ)) (Set.Icc 0 b) := by
    simpa only [Set.univ_inter] using (hm.monotoneOn Set.univ).locallyBoundedVariationOn
      0 b (Set.mem_univ _) (Set.mem_univ _)
  exact hv.mono (fun _ ht ↦ ⟨bot_le, ht.2.le⟩)

/-- The left-open interval `(0,infinity]` does not constrain the integrand's
initial value; the corresponding integral increments still agree. -/
theorem general_integral_interval_ignores_initial_integrand {Ω : Type*}
    {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H K : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (haH : Adapted F H) (hrH : ProbabilityTheory.HasCagladPaths H P)
    (haK : Adapted F K) (hrK : ProbabilityTheory.HasCagladPaths K P)
    (hHK : ∀ t : ℝ≥0, 0 < t → ∀ ω, H t ω = K t ω) :
    ∀ᵐ ω ∂P, ∀ t, hX.stochasticIntegral hF haH hrH t ω - hX.stochasticIntegral hF haH hrH 0 ω =
      hX.stochasticIntegral hF haK hrK t ω - hX.stochasticIntegral hF haK hrK 0 ω := by
  have htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
  have hzero : IsStoppingTime F (fun _ ↦ (⊥ : WithTop ℝ≥0)) := isStoppingTime_const F 0
  filter_upwards [hX.stochasticIntegral_congr_integrand_on_interval hF haH hrH haK hrK
    hzero htop] with ω hω
  intro t
  have hi := hω (by exact bot_le)
    (fun s hs _ ↦ hHK s (WithTop.coe_lt_coe.mp hs) ω) t
  simp only [stoppedProcess_const_top, stoppedProcess_const_bot] at hi
  change hX.stochasticIntegral hF haH hrH t ω - hX.stochasticIntegral hF haH hrH 0 ω =
    hX.stochasticIntegral hF haK hrK t ω - hX.stochasticIntegral hF haK hrK 0 ω at hi
  exact hi

/-- Without right continuity at the excluded endpoint, equal paths on `(0,1]`
can have different stopped increments. This sample path is intentionally not cadlag. -/
theorem interval_agreement_without_right_continuity_counterexample :
    let X : ℝ≥0 → Unit → ℝ := fun t _ ↦ if t = 0 then 1 else 0
    (∀ t : ℝ≥0, 0 < t → X t () = 0) ∧
      stoppedProcess X (fun _ ↦ (1 : WithTop ℝ≥0)) 1 () -
        stoppedProcess X (fun _ ↦ (0 : WithTop ℝ≥0)) 1 () = -1 := by
  dsimp only
  constructor
  · intro t ht
    simp only [ne_of_gt ht, if_false]
  · norm_num [stoppedProcess, WithTop.untopA]

/-- Integrator linearity retains both original initial values. -/
theorem general_integral_add_integrator_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hY : ProbabilityTheory.IsSemimartingale Y F P) (hF : F.IsUsual P)
    (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    (hX.add hY).stochasticIntegral hF ha hr 0 =ᵐ[P] fun ω ↦ H 0 ω * (X 0 ω + Y 0 ω) := by
  filter_upwards [hX.stochasticIntegral_add_integrator hY hF ha hr,
    hX.stochasticIntegral_zero_ae hF ha hr, hY.stochasticIntegral_zero_ae hF ha hr]
    with ω hsum hx hy
  rw [hsum 0]
  change hX.stochasticIntegral hF ha hr 0 ω + hY.stochasticIntegral hF ha hr 0 ω = _
  rw [hx, hy, mul_add]

/-- Subtracting two stopped integrators removes exactly the shared initial term,
even for zero or infinite stopping times and with no ordering requirement. -/
theorem general_integral_stopped_difference_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P)
    {σ τ : Ω → WithTop ℝ≥0} (hσ : IsStoppingTime F σ) (hτ : IsStoppingTime F τ) :
    ((hX.stoppedProcess hF hτ).sub (hX.stoppedProcess hF hσ)).stochasticIntegral hF ha hr 0
      =ᵐ[P] fun _ ↦ 0 := by
  filter_upwards [(hX.stoppedProcess hF hτ).stochasticIntegral_sub_integrator
    (hX.stoppedProcess hF hσ) hF ha hr,
    (hX.stoppedProcess hF hτ).stochasticIntegral_zero_ae hF ha hr,
    (hX.stoppedProcess hF hσ).stochasticIntegral_zero_ae hF ha hr] with ω hsub hτzero hσzero
  rw [hsub 0]
  change (hX.stoppedProcess hF hτ).stochasticIntegral hF ha hr 0 ω -
    (hX.stoppedProcess hF hσ).stochasticIntegral hF ha hr 0 ω = 0
  rw [hτzero, hσzero]
  rw [stoppedProcess_eq_of_le (τ := τ) (ω := ω) (i := 0) bot_le,
    stoppedProcess_eq_of_le (τ := σ) (ω := ω) (i := 0) bot_le, sub_self]

/-- Agreement may be restricted to an arbitrary event, not necessarily a full event
or an event measurable at the initial time. -/
theorem general_integral_locality_on_event {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y H K : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hY : ProbabilityTheory.IsSemimartingale Y F P) (hF : F.IsUsual P)
    (haH : Adapted F H) (hrH : ProbabilityTheory.HasCagladPaths H P)
    (haK : Adapted F K) (hrK : ProbabilityTheory.HasCagladPaths K P)
    (A : Set Ω) (hHK : ∀ ω ∈ A, ∀ t, H t ω = K t ω)
    (hXY : ∀ ω ∈ A, ∀ t, X t ω = Y t ω) :
    ∀ᵐ ω ∂P, ω ∈ A → ∀ t,
      hX.stochasticIntegral hF haH hrH t ω = hY.stochasticIntegral hF haK hrK t ω := by
  filter_upwards [hX.stochasticIntegral_congr_on_paths hY hF haH hrH haK hrK] with ω hω
  exact fun hA ↦ hω (hHK ω hA) (hXY ω hA)

/-- Finite variation is only assumed on the selected event; no assertion that
this event has full or positive probability is part of the interface. -/
theorem general_integral_pathwise_fv_event {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P)
    (A : Set Ω) (hv : ∀ ω ∈ A, LocallyBoundedVariationOn (X · ω) Set.univ) :
    ∀ᵐ ω ∂P, ∀ hA : ω ∈ A, ∃ hωr : ProbabilityTheory.IsCadlagPath (X · ω), ∀ t,
      hX.stochasticIntegral hF ha hr t ω =
        StochLean.pathStieltjesIntegral (X · ω) (hv ω hA) hωr.1 (H · ω) t := by
  filter_upwards [hX.stochasticIntegral_eq_pathStieltjesIntegral_on_finiteVariation hF ha hr]
    with ω hω
  exact fun hA ↦ hω (hv ω hA)

/-- A zero-weight component need not be dominated by the mixture. -/
theorem zero_weight_component_not_dominated :
    let P : ℕ → Measure ℕ := fun n ↦ if n = 0 then Measure.dirac 0 else Measure.dirac 1
    let c : ℕ → ℝ≥0∞ := fun n ↦ if n = 0 then 1 else 0
    ¬ Measure.dirac 1 ≪ Measure.sum (fun n ↦ c n • P n) := by
  dsimp only
  intro h
  have hz : (Measure.sum (fun n : ℕ ↦ (if n = 0 then (1 : ℝ≥0∞) else 0) •
      (if n = 0 then Measure.dirac (0 : ℕ) else Measure.dirac 1))) {1} = 0 := by
    rw [Measure.sum_apply_of_countable]
    apply ENNReal.tsum_eq_zero.mpr
    intro n
    by_cases hn : n = 0 <;> simp [hn]
  have hbad := h hz
  simp at hbad

/-- Incomparable usual filtrations give the same initial product as well as the
same entire integral; this uses the second filtration's initial-value theorem. -/
theorem general_integral_filtration_change_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F G : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hXF : ProbabilityTheory.IsSemimartingale X F P)
    (hXG : ProbabilityTheory.IsSemimartingale X G P) (hF : F.IsUsual P) (hG : G.IsUsual P)
    (haF : Adapted F H) (haG : Adapted G H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    hXF.stochasticIntegral hF haF hr 0 =ᵐ[P] fun ω ↦ H 0 ω * X 0 ω := by
  filter_upwards [hXF.stochasticIntegral_congr_filtration hXG hF hG haF haG hr,
    hXG.stochasticIntegral_zero_ae hG haG hr] with ω hω hzero
  exact (hω 0).trans hzero

/-- Absolute continuity alone cannot supply usual completeness for the target measure. -/
theorem zero_target_measure_needs_completeness {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (P : Measure Ω) {F : Filtration ℝ≥0 mΩ} {s : Set Ω} (hs : ¬ MeasurableSet[F 0] s) :
    (0 : Measure Ω) ≪ P ∧ ¬ F.IsUsual (0 : Measure Ω) := by
  refine ⟨Measure.AbsolutelyContinuous.zero P, fun hF ↦ ?_⟩
  exact hs (hF.complete_initial s (by simp))

/-- The measure-change identification transports the unnormalized initial product. -/
theorem general_integral_measure_change_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P Q : Measure Ω} [IsFiniteMeasure P] [IsFiniteMeasure Q] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hQP : Q ≪ P) (hFP : F.IsUsual P) (hFQ : F.IsUsual Q)
    (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    (hX.absolutelyContinuous hQP hFP).stochasticIntegral hFQ ha (hQP.ae_le hr) 0 =ᵐ[Q]
      fun ω ↦ H 0 ω * X 0 ω := by
  have hi : ∀ᵐ ω ∂Q, hX.stochasticIntegral hFP ha hr 0 ω = H 0 ω * X 0 ω :=
    hQP.ae_le (hX.stochasticIntegral_zero_ae hFP ha hr)
  filter_upwards [hX.stochasticIntegral_absolutelyContinuous hQP hFP hFQ ha hr, hi] with ω hω hiω
  exact (hω 0).trans hiω

/-- The right endpoint belongs to the source interval, including its integrator jump. -/
theorem elementary_jump_at_right_endpoint {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) {X : ℝ≥0 → Ω → ℝ} {ω : Ω}
    (hX : ProbabilityTheory.IsCadlagPath (X · ω)) {T : ℝ≥0} (hT : 0 < T) :
    ProbabilityTheory.jumpProcess
      ((ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 0 3).integralProcess X)
      T ω = 3 * ProbabilityTheory.jumpProcess X T ω := by
  let R := ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 0 3
  have hp : R.partition.point (0 : Fin 1).castSucc ω < R.partition.point (0 : Fin 1).succ ω := hT
  have hc := R.toProcess_rightEndpoint (0 : Fin 1) hp
  change R.toProcess T ω = 3 at hc
  rw [R.jumpProcess_integralProcess hX T, hc]

/-- The jump theorem includes the original source initial product, not a centered convention. -/
theorem general_integral_jump_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    ProbabilityTheory.jumpProcess (hX.stochasticIntegral hF ha hr) 0 =ᵐ[P]
      fun ω ↦ H 0 ω * X 0 ω := by
  filter_upwards [hX.jumpProcess_stochasticIntegral hF ha hr] with ω hω
  simpa only [ProbabilityTheory.jumpProcess_zero] using hω 0

/-- A zero stopping time preserves the source initial term in the general cutoff integral. -/
theorem general_integral_cutoff_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    ProbabilityTheory.Indistinguishable
      (hX.stochasticIntegral hF
        (ProbabilityTheory.adapted_cutoffIntegrand ha (isStoppingTime_const F 0))
        (hr.cutoffIntegrand (fun _ ↦ (0 : WithTop ℝ≥0))))
      (fun _ ω ↦ H 0 ω * X 0 ω) P := by
  filter_upwards [hX.stochasticIntegral_cutoff hF ha hr (isStoppingTime_const F 0),
    hX.stochasticIntegral_zero_ae hF ha hr] with ω hω hzero t
  rw [hω t]
  change hX.stochasticIntegral hF ha hr (min (t : WithTop ℝ≥0) 0).untopA ω = _
  have ht : (0 : WithTop ℝ≥0) ≤ t := bot_le
  rw [min_eq_right ht]
  exact hzero

/-- Infinite cutoff gives the original general integral, with no evaluation at infinity. -/
theorem general_integral_cutoff_top {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X H : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (ha : Adapted F H) (hr : ProbabilityTheory.HasCagladPaths H P) :
    let htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
    ProbabilityTheory.Indistinguishable
      (hX.stochasticIntegral hF (ProbabilityTheory.adapted_cutoffIntegrand ha htop)
        (hr.cutoffIntegrand (fun _ ↦ ⊤)))
      (hX.stochasticIntegral hF ha hr) P := by
  dsimp only
  have htop : IsStoppingTime F (fun _ ↦ (⊤ : WithTop ℝ≥0)) := fun _ ↦ by simp
  have h := hX.stochasticIntegral_cutoff hF ha hr htop
  filter_upwards [h] with ω hω t
  rw [hω t]
  exact stoppedProcess_eq_of_le (τ := fun _ : Ω ↦ (⊤ : WithTop ℝ≥0))
    (ω := ω) le_top

/-- General integration of a continuous FV process against itself retains the initial square. -/
theorem general_integral_continuous_fv_self {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (hv : ProbabilityTheory.HasFiniteVariationPaths X P)
    (hc : ProbabilityTheory.HasContinuousPaths X P) :
    ProbabilityTheory.Indistinguishable
      (hX.stochasticIntegral hF hX.adapted hc.hasCagladPaths)
      (fun t ω ↦ (X t ω ^ 2 + X 0 ω ^ 2) / 2) P := by
  filter_upwards [hX.stochasticIntegral_eq_pathStieltjesIntegral_ae hF hv
    hX.adapted hc.hasCagladPaths, hc] with ω hω hcω
  obtain ⟨hωv, hωr, hωJ⟩ := hω
  intro t
  rw [hωJ t]
  exact StochLean.pathStieltjesIntegral_self_of_continuous hcω.continuousOn

/-- The constructed general integral of the source closed unit interval is the stopped
integrator, including its original initial value. -/
theorem general_integral_closed_interval {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) (T : ℝ≥0) :
    let R := ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 1 1
    let hR : ProbabilityTheory.IsSimplePredictable R.toProcess F := ⟨R, rfl⟩
    ProbabilityTheory.Indistinguishable
      (hX.stochasticIntegral hF hR.adapted (hR.hasCagladPaths P))
      (fun t ω ↦ X (min T t) ω) P := by
  dsimp only
  let R := ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 1 1
  have hR : ProbabilityTheory.IsSimplePredictable R.toProcess F := ⟨R, rfl⟩
  have h := hX.stochasticIntegral_indistinguishable_of_simple hF
    hR.adapted (hR.hasCagladPaths P) hR
  rw [hR.elementaryIntegralProcess_eq R rfl X] at h
  filter_upwards [h] with ω hω t
  rw [hω t]
  exact ProbabilityTheory.SimplePredictableRep.integral_one_closed F T _ ω

/-- An isolated initial integrand coefficient survives in the general integral for all times. -/
theorem general_integral_initial_spike {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : ProbabilityTheory.IsSemimartingale X F P)
    (hF : F.IsUsual P) :
    let R := ProbabilityTheory.SimplePredictableRep.deterministicInterval F 0 3 0
    let hR : ProbabilityTheory.IsSimplePredictable R.toProcess F := ⟨R, rfl⟩
    ProbabilityTheory.Indistinguishable
      (hX.stochasticIntegral hF hR.adapted (hR.hasCagladPaths P))
      (fun _ ω ↦ 3 * X 0 ω) P := by
  dsimp only
  let R := ProbabilityTheory.SimplePredictableRep.deterministicInterval F 0 3 0
  have hR : ProbabilityTheory.IsSimplePredictable R.toProcess F := ⟨R, rfl⟩
  have h := hX.stochasticIntegral_indistinguishable_of_simple hF
    hR.adapted (hR.hasCagladPaths P) hR
  rw [hR.elementaryIntegralProcess_eq R rfl X] at h
  filter_upwards [h] with ω hω t
  rw [hω t]
  change R.integral (fun s ω ↦ X (min s t) ω) ω = 3 * X 0 ω
  rw [ProbabilityTheory.SimplePredictableRep.integral_deterministicInterval]
  simp only [zero_mul, add_zero, min_eq_left (show (0 : ℝ≥0) ≤ t from bot_le)]

/-- The actual completeness theorem preserves a nonzero constant, up to
indistinguishability, rather than normalizing the initial value to zero. -/
theorem ucp_completion_retains_nonzero_constant {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ} (hF : F.IsUsual P) :
    ∃ Y : ℝ≥0 → Ω → ℝ, Adapted F Y ∧
      (∀ ω, ProbabilityTheory.IsCadlagPath (Y · ω)) ∧
        ProbabilityTheory.Indistinguishable Y (fun _ _ ↦ 2) P := by
  have hr : ∀ ω : Ω, ProbabilityTheory.IsCadlagPath (fun _ : ℝ≥0 ↦ (2 : ℝ)) :=
    fun _ ↦ ProbabilityTheory.IsContinuousPath.isCadlagPath continuous_const
  have hu := ProbabilityTheory.tendstoUCP_const (P := P) (Filter.atTop : Filter ℕ)
    (fun _ : ℝ≥0 ↦ fun _ : Ω ↦ (2 : ℝ))
  obtain ⟨Y, hYa, hYr, hYu⟩ := hu.cauchyUCP.exists_adapted_cadlag_limit
    (fun _ _ ↦ measurable_const) hF (fun _ ↦ Filter.Eventually.of_forall hr)
  exact ⟨Y, hYa, hYr, hYu.indistinguishable_unique hu
    (Filter.Eventually.of_forall fun ω ↦ (hYr ω).1)
    (Filter.Eventually.of_forall fun ω ↦ (hr ω).1)⟩

/-- The corrected actual one-cell construction reproduces the constant source on its cap,
including the first positive-time interval omitted by the printed II.10 formula. -/
theorem corrected_first_interval_constant {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {P : Measure Ω} (hF : F.IsUsual P)
    (T t : ℝ≥0) (ht : t ≤ T) (ω : Ω) :
    let H : ℝ≥0 → Ω → ℝ := fun _ _ ↦ 1
    let ha : Adapted F H := fun _ ↦ measurable_const
    let hc : ProbabilityTheory.HasCagladPaths H P := ae_of_all _ fun _ ↦
      ProbabilityTheory.IsContinuousPath.isCagladPath continuous_const
    (ProbabilityTheory.CagladApproximation.representation H ha hF hc 0 le_rfl 1 T).toProcess t ω =
      1 := by
  dsimp only
  have hright : ProbabilityTheory.rightLimitProcess (fun _ : ℝ≥0 ↦ fun _ : Ω ↦ (1 : ℝ)) =
      fun _ _ ↦ (1 : ℝ) := by
    funext s v
    apply ProbabilityTheory.IsRightContinuousPath.rightLimitProcess_eq
    intro u
    exact continuous_const.continuousWithinAt
  have htime : (t : WithTop ℝ≥0) ≤ ProbabilityTheory.oscillationTimes
      (ProbabilityTheory.rightLimitProcess (fun _ : ℝ≥0 ↦ fun _ : Ω ↦ (1 : ℝ))) 0 1 ω := by
    rw [hright, ProbabilityTheory.oscillationTimes_const_succ (fun _ : Ω ↦ (1 : ℝ)) le_rfl 0 ω]
    exact le_top
  have h := ProbabilityTheory.CagladApproximation.norm_toProcess_sub_le
    (fun _ : ℝ≥0 ↦ fun _ : Ω ↦ (1 : ℝ)) (fun _ ↦ measurable_const) hF
    (ae_of_all _ fun _ ↦ ProbabilityTheory.IsContinuousPath.isCagladPath continuous_const)
    0 le_rfl 1 T (ProbabilityTheory.IsContinuousPath.isCagladPath continuous_const) ht htime
  exact sub_eq_zero.mp (norm_le_zero_iff.mp h)

/-- The right limit of an isolated initial spike is zero, including at time zero. -/
theorem initial_spike_rightLimit_zero (t : ℝ≥0) :
    ProbabilityTheory.rightLimitProcess
      (fun t : ℝ≥0 ↦ fun _ : Unit ↦ if t = 0 then (2 : ℝ) else 0) t () = 0 := by
  apply rightLim_eq_of_tendsto
  apply tendsto_const_nhds.congr'
  filter_upwards [self_mem_nhdsWithin (a := t) (s := Set.Ioi t)] with s hs
  have hs0 : s ≠ (0 : ℝ≥0) := ne_of_gt ((bot_le : (0 : ℝ≥0) ≤ t).trans_lt hs)
  simp only [if_neg hs0]

/-- Reconstruction must retain the independent source initial value, not replace it by H_(0+). -/
theorem initial_spike_differs_from_rightLimit :
    (2 : ℝ) ≠ ProbabilityTheory.rightLimitProcess
      (fun t : ℝ≥0 ↦ fun _ : Unit ↦ if t = 0 then (2 : ℝ) else 0) 0 () := by
  rw [initial_spike_rightLimit_zero]
  norm_num

/-- An isolated source initial value is an actual hit and must not be lost by dense detection. -/
theorem initial_spike_first_exit_zero :
    hittingAfter (fun t : ℝ≥0 ↦ fun _ : Unit ↦ if t = 0 then (2 : ℝ) else 0)
      {x | 1 < ‖x‖} 0 () = (0 : WithTop ℝ≥0) := by
  have hex : ∃ t : ℝ≥0, 0 ≤ t ∧ 1 < ‖(if t = 0 then 2 else 0 : ℝ)‖ :=
    ⟨0, by norm_num⟩
  simp only [hittingAfter, Set.mem_ofPred_eq, if_pos hex]
  have hset : {t : ℝ≥0 | 0 ≤ t ∧ 1 < ‖(if t = 0 then 2 else 0 : ℝ)‖} = {0} := by
    ext t
    by_cases ht : t = 0 <;> simp [ht]
  rw [hset, csInf_singleton]
  rfl

/-- The initial-event mask removes an oversized isolated initial value. -/
theorem initial_spike_first_exit_truncation (t : ℝ≥0) :
    ProbabilityTheory.firstExitTruncation
      (fun t : ℝ≥0 ↦ fun _ : Unit ↦ if t = 0 then (2 : ℝ) else 0) 1 t () = 0 := by
  simp only [ProbabilityTheory.firstExitTruncation, Set.indicator, Set.mem_ofPred_eq,
    initial_spike_first_exit_zero, lt_self_iff_false, if_false]

/-- A right jump at zero may have exit infimum zero while the time-zero value is still zero. -/
theorem right_jump_first_exit_zero :
    hittingAfter (fun t : ℝ≥0 ↦ fun _ : Unit ↦ if t = 0 then (0 : ℝ) else 2)
      {x | 1 < ‖x‖} 0 () = (0 : WithTop ℝ≥0) := by
  have hex : ∃ t : ℝ≥0, 0 ≤ t ∧ 1 < ‖(if t = 0 then 0 else 2 : ℝ)‖ :=
    ⟨1, by norm_num⟩
  simp only [hittingAfter, Set.mem_ofPred_eq, if_pos hex]
  have hset : {t : ℝ≥0 | 0 ≤ t ∧ 1 < ‖(if t = 0 then 0 else 2 : ℝ)‖} =
      Set.Ioi (0 : ℝ≥0) := by
    ext t
    by_cases ht : t = 0 <;> simp [ht, pos_iff_ne_zero]
  rw [hset, csInf_Ioi]
  rfl

/-- The maximal event on the zero horizon still detects the initial value. -/
theorem maximal_event_at_zero {Ω : Type*} (X : ℝ≥0 → Ω → ℝ) (ε : ℝ) :
    {ω | ∃ t ≤ (0 : ℝ≥0), ε < ‖X t ω‖} = {ω | ε < ‖X 0 ω‖} := by
  ext ω
  constructor
  · rintro ⟨t, ht, hω⟩
    have ht0 : t = 0 := le_antisymm ht bot_le
    change ε < ‖X 0 ω‖
    simpa only [ht0] using hω
  · intro hω
    exact ⟨0, le_rfl, hω⟩

/-- The closed source unit interval gives the stopped process, not its centered increment. -/
theorem elementary_process_closed_interval {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (X : ℝ≥0 → Ω → ℝ) (T t : ℝ≥0) (ω : Ω) :
    (ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 1 1).integralProcess X t ω =
      X (min T t) ω := by
  exact ProbabilityTheory.SimplePredictableRep.integral_one_closed F T _ ω

/-- Omitting the source initial coefficient gives only the stopped increment. -/
theorem elementary_process_open_interval {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (X : ℝ≥0 → Ω → ℝ) (T t : ℝ≥0) (ω : Ω) :
    (ProbabilityTheory.SimplePredictableRep.deterministicInterval F T 0 1).integralProcess X t ω =
      X (min T t) ω - X 0 ω := by
  have h := ProbabilityTheory.SimplePredictableRep.integral_one_open F T
    (fun s ω ↦ X (min s t) ω) ω
  simpa only [ProbabilityTheory.SimplePredictableRep.integralProcess,
    min_eq_left (show (0 : ℝ≥0) ≤ t from bot_le)] using h

/-- Stopping at zero retains the initial value of the elementary integral at all later times. -/
theorem elementary_process_cutoff_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {H : ℝ≥0 → Ω → ℝ}
    (hH : ProbabilityTheory.IsSimplePredictable H F) (X : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) (ω : Ω) :
    (hH.cutoff (isStoppingTime_const F 0)).elementaryIntegralProcess X t ω = H 0 ω * X 0 ω := by
  rw [hH.elementaryIntegralProcess_cutoff (isStoppingTime_const F 0) X]
  change hH.elementaryIntegralProcess X (min (t : WithTop ℝ≥0) 0).untopA ω = _
  rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ (t : WithTop ℝ≥0) from
    WithTop.coe_le_coe.mpr bot_le)]
  exact hH.elementaryIntegralProcess_zero X ω

/-- A constant path never triggers the positive oscillation threshold in Protter II.10. -/
theorem constant_oscillation_hitting_top (ε : ℝ) (hε : 0 ≤ ε) :
    hittingAfter (fun _ : ℝ≥0 ↦ fun _ : Unit ↦ (1 : ℝ) - 1)
      {x | ε < ‖x‖} 0 () = ⊤ := by
  apply hittingAfter_eq_top_iff.mpr
  intro t _
  simpa only [sub_self, norm_zero, Set.mem_ofPred_eq] using not_lt_of_ge hε

/-- The printed II.10 tail sum omits `(T₀, T₁]`. For a constant-one path,
all future endpoints are infinite and cap to `n`, so this expression is zero at positive times. -/
theorem omitted_first_density_interval (n : ℕ) (t : ℝ≥0) (ht : t ≠ 0) :
    (if t = 0 then (1 : ℝ) else 0) +
      (∑ _i : Fin n, if (n : ℝ≥0) < t ∧ t ≤ n then (1 : ℝ) else 0) = 0 := by
  have hcell : ¬((n : ℝ≥0) < t ∧ t ≤ n) := fun h ↦ not_lt_of_ge h.2 h.1
  simp only [if_neg ht, if_neg hcell, Finset.sum_const_zero, add_zero]

/-- A continuous path's first hit of an open target can be on its boundary. -/
theorem linear_open_hitting_time :
    hittingAfter (fun t : ℝ≥0 ↦ fun _ : Unit ↦ (t : ℝ)) (Set.Ioi 1) 0 () =
      (1 : WithTop ℝ≥0) := by
  have hex : ∃ t : ℝ≥0, 0 ≤ t ∧ (t : ℝ) ∈ Set.Ioi 1 := ⟨2, by norm_num⟩
  rw [hittingAfter, if_pos hex]
  have hset : {t : ℝ≥0 | 0 ≤ t ∧ (t : ℝ) ∈ Set.Ioi 1} = Set.Ioi (1 : ℝ≥0) := by
    ext t
    simp
  rw [hset, csInf_Ioi]
  rfl

theorem linear_open_hitting_not_mem :
    ((hittingAfter (fun t : ℝ≥0 ↦ fun _ : Unit ↦ (t : ℝ)) (Set.Ioi 1) 0 ()).untopA : ℝ) ∉
      Set.Ioi 1 := by
  rw [linear_open_hitting_time]
  norm_num

/-- A unit-threshold first exit may overshoot to two; there is no stopped upper bound. -/
theorem jump_first_exit_overshoot :
    let X : ℝ≥0 → Unit → ℝ := fun t _ ↦ if 1 ≤ t then 2 else 0
    ‖X (hittingAfter X {x | 1 < ‖x‖} 0 ()).untopA ()‖ = 2 := by
  dsimp only
  have hex : ∃ t : ℝ≥0, 0 ≤ t ∧ 1 < ‖(if 1 ≤ t then 2 else 0 : ℝ)‖ :=
    ⟨1, by norm_num⟩
  simp only [hittingAfter, Set.mem_ofPred_eq, if_pos hex]
  have hset : {t : ℝ≥0 | 0 ≤ t ∧ 1 < ‖(if 1 ≤ t then 2 else 0 : ℝ)‖} =
      Set.Ici (1 : ℝ≥0) := by
    ext t
    by_cases ht : 1 ≤ t <;> simp [ht]
  rw [hset, csInf_Ici]
  norm_num

/-- Bundling the elementary integral as a linear map does not normalize its initial term. -/
theorem elementary_linearMap_const_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (Z : Ω → ℝ)
    (H : ProbabilityTheory.simplePredictableSubmodule F) :
    ProbabilityTheory.elementaryIntegralLinearMap F (fun _ ↦ Z) H =
      fun ω ↦ H.val 0 ω * Z ω :=
  H.property.elementaryIntegral_const_initial Z

/-- Subtraction of the same source process integrates to zero without integrator assumptions. -/
theorem elementary_sub_self_zero {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {H : ℝ≥0 → Ω → ℝ}
    (hH : ProbabilityTheory.IsSimplePredictable H F) (X : ℝ≥0 → Ω → ℝ) :
    (hH.sub hH).elementaryIntegral X = 0 := by
  rw [hH.elementaryIntegral_sub hH X]
  funext ω
  exact sub_self _

/-- A source cutoff at zero keeps the initial integral even for an arbitrary integrator. -/
theorem elementary_cutoff_zero_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {H : ℝ≥0 → Ω → ℝ}
    (hH : ProbabilityTheory.IsSimplePredictable H F) (X : ℝ≥0 → Ω → ℝ) :
    (hH.cutoff (isStoppingTime_const F (0 : ℝ≥0))).elementaryIntegral X =
      fun ω ↦ H 0 ω * X 0 ω := by
  rw [hH.elementaryIntegral_cutoff (isStoppingTime_const F (0 : ℝ≥0))]
  have hzero : stoppedProcess X (fun _ ↦ ((0 : ℝ≥0) : WithTop ℝ≥0)) =
      fun _ ↦ X 0 := by
    ext t ω
    change X (min (t : WithTop ℝ≥0) ((0 : ℝ≥0) : WithTop ℝ≥0)).untopA ω = _
    rw [← WithTop.coe_min]
    change X (min t 0) ω = X 0 ω
    have ht : min t (0 : ℝ≥0) = 0 := by simp
    rw [ht]
  rw [hzero, hH.elementaryIntegral_const_initial]

/-- The infinite stopping endpoint leaves the entire elementary integral unchanged. -/
theorem elementary_cutoff_infinity {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {H : ℝ≥0 → Ω → ℝ}
    (hH : ProbabilityTheory.IsSimplePredictable H F) (X : ℝ≥0 → Ω → ℝ) :
    (hH.cutoff (show IsStoppingTime F (fun _ ↦ ⊤) from fun t ↦ by simp)).elementaryIntegral X =
      hH.elementaryIntegral X := by
  rw [hH.elementaryIntegral_cutoff
    (show IsStoppingTime F (fun _ ↦ ⊤) from fun t ↦ by simp), stoppedProcess_const_top]

/-- The cutoff retains the original value exactly at the finite stopping endpoint. -/
theorem simple_cutoff_closed_endpoint {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (H : ProbabilityTheory.SimplePredictableRep F)
    (τ : ProbabilityTheory.FiniteStoppingTime F) (ω : Ω) :
    (H.cutoffFinite τ).toProcess (τ ω) ω = H.toProcess (τ ω) ω := by
  rw [H.toProcess_cutoffFinite]
  change (if (τ ω : WithTop ℝ≥0) ≤ τ ω then H.toProcess (τ ω) ω else 0) = _
  exact if_pos le_rfl

/-- Different terminal times and independent initial coefficients survive common refinement. -/
theorem simple_add_distinct_horizons {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (ω : Ω) :
    ((ProbabilityTheory.SimplePredictableRep.deterministicInterval F 1 2 3).combine
      (ProbabilityTheory.SimplePredictableRep.deterministicInterval F 2 5 7)
      (· + ·) (measurable_fst.add measurable_snd)).integral
        (fun t _ ↦ (t : ℝ) + 1) ω = 24 := by
  rw [ProbabilityTheory.SimplePredictableRep.integral_combine_add]
  norm_num [ProbabilityTheory.SimplePredictableRep.integral_deterministicInterval]

/-- Multiplication combines the source time-zero coefficients, not the first positive ones. -/
theorem simple_product_initial {Ω : Type*} {mΩ : MeasurableSpace Ω}
    (F : Filtration ℝ≥0 mΩ) (ω : Ω) :
    ((ProbabilityTheory.SimplePredictableRep.deterministicInterval F 1 2 3).combine
      (ProbabilityTheory.SimplePredictableRep.deterministicInterval F 2 5 7)
      (· * ·) (measurable_fst.mul measurable_snd)).toProcess 0 ω = 10 := by
  have h := ProbabilityTheory.SimplePredictableRep.toProcess_combine
    (ProbabilityTheory.SimplePredictableRep.deterministicInterval F 1 2 3)
    (ProbabilityTheory.SimplePredictableRep.deterministicInterval F 2 5 7)
    (fun a b : ℝ ↦ a * b) (measurable_fst.mul measurable_snd) (mul_zero 0)
  exact (congrFun (congrFun h 0) ω).trans (by
    norm_num [ProbabilityTheory.SimplePredictableRep.toProcess_zero,
      ProbabilityTheory.SimplePredictableRep.deterministicInterval])

/-- Splitting at zero introduces repeated endpoints without changing even
unbounded coefficients. -/
theorem simple_zero_split_preserves_process {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} (H : ProbabilityTheory.SimplePredictableRep F) :
    (H.repartition
      (H.partition.splitAt (ProbabilityTheory.FiniteStoppingTime.const F 0))).toProcess =
        H.toProcess :=
  H.toProcess_repartition (H.partition.splitAt_refines _)

/-- Right endpoint tags are genuinely permitted; this coarse sum differs from its left sum. -/
theorem tagged_right_endpoint_sum :
    stieltjesTaggedSum (TimePartition.single 1) (fun _ ↦ 1)
      (fun t ↦ (t : ℝ)) (fun t ↦ (t : ℝ)) 1 = 1 := by
  rw [stieltjesTaggedSum_terminal]
  change (0 : ℝ) * 0 + ∑ i : Fin 1, 1 *
    (((![0, 1] : Fin 2 → ℝ≥0) i.succ : ℝ) - ((![0, 1] : Fin 2 → ℝ≥0) i.castSucc : ℝ)) = 1
  norm_num [Fin.sum_univ_one]

/-- A repeated zero cell contributes no increment, whatever the horizon and coefficients. -/
theorem tagged_repeated_zero_cell (x f : ℝ≥0 → ℝ) (t : ℝ≥0) :
    stieltjesTaggedSum (TimePartition.single 0) (fun _ ↦ 0) x f t = f 0 * x 0 := by
  change f 0 * x 0 + ∑ i : Fin 1, f 0 *
    (x (min ((![0, 0] : Fin 2 → ℝ≥0) i.succ) t) -
      x (min ((![0, 0] : Fin 2 → ℝ≥0) i.castSucc) t)) = f 0 * x 0
  simp

/-- The continuous-FV square formula cannot discard a nonzero source initial value. -/
theorem continuous_fv_self_integral_initial_one {T : ℝ≥0} {x : ℝ≥0 → ℝ}
    (hv : LocallyBoundedVariationOn x Set.univ)
    (hr : ∀ t, ContinuousWithinAt x (Set.Ici t) t)
    (hx : ContinuousOn x (Set.Icc 0 T)) (h0 : x 0 = 1) :
    pathStieltjesIntegral x hv hr x T = (x T ^ 2 + 1) / 2 := by
  rw [pathStieltjesIntegral_self_of_continuous hx, h0, one_pow]

/-- At horizon zero the empty partition still retains the integrand's initial value. -/
theorem empty_leftStep_initial (f : ℝ≥0 → ℝ) : TimePartition.empty.leftStep f 0 = f 0 :=
  TimePartition.leftStep_zero _ _

/-- Stopping the FV integral at zero retains its arbitrary initial value at every later time. -/
theorem finiteVariation_cutoff_zero_initial {Ω : Type*} [MeasurableSpace Ω]
    (X H : ℝ≥0 → Ω → ℝ)
    (hv : ∀ ω, LocallyBoundedVariationOn (fun t ↦ X t ω) Set.univ)
    (hr : ∀ ω, ProbabilityTheory.IsRightContinuousPath (fun t ↦ X t ω)) (t : ℝ≥0) (ω : Ω) :
    ProbabilityTheory.finiteVariationIntegral X hv hr
      (ProbabilityTheory.cutoffIntegrand H (fun _ ↦ 0)) t ω = H 0 ω * X 0 ω := by
  rw [ProbabilityTheory.finiteVariationIntegral_cutoffIntegrand]
  change ProbabilityTheory.finiteVariationIntegral X hv hr H
    (min (t : WithTop ℝ≥0) 0).untopA ω = _
  rw [min_eq_right (show (0 : WithTop ℝ≥0) ≤ t from bot_le)]
  exact ProbabilityTheory.finiteVariationIntegral_zero X hv hr H ω

/-- Cutting off an integrand keeps its value exactly at a finite stopping endpoint. -/
theorem cutoff_keeps_stopping_endpoint {Ω : Type*} (H : ℝ≥0 → Ω → ℝ)
    (τ : Ω → ℝ≥0) (ω : Ω) :
    ProbabilityTheory.cutoffIntegrand H (fun ω ↦ τ ω) (τ ω) ω = H (τ ω) ω := by
  simp only [ProbabilityTheory.cutoffIntegrand, le_refl, if_true]

/-- The stopped Stieltjes measure retains the endpoint atom, rather than its open restriction. -/
theorem stopped_stieltjes_keeps_atom {A B : StieltjesFunction ℝ≥0} (T : ℝ≥0)
    (h : ∀ t, B t = A (min t T)) : B.measure {T} = A.measure {T} := by
  rw [stieltjesMeasure_eq_restrict_of_eq_min T h,
    Measure.restrict_apply (measurableSet_singleton T)]
  congr 1
  exact Set.inter_eq_left.mpr
    (Set.singleton_subset_iff.mpr (show T ∈ Set.Iic T by change T ≤ T; exact le_rfl))

/-- The source initial jump of an FV integral remains `H_0 X_0`, even without L1 assumptions. -/
theorem finiteVariation_source_initial_jump {Ω : Type*} [MeasurableSpace Ω]
    (X H : ℝ≥0 → Ω → ℝ)
    (hv : ∀ ω, LocallyBoundedVariationOn (fun t ↦ X t ω) Set.univ)
    (hr : ∀ ω, ProbabilityTheory.IsRightContinuousPath (fun t ↦ X t ω)) (ω : Ω) :
    ProbabilityTheory.jumpProcess (ProbabilityTheory.finiteVariationIntegral X hv hr H) 0 ω =
      H 0 ω * X 0 ω := by
  rw [ProbabilityTheory.jumpProcess_zero]
  exact ProbabilityTheory.finiteVariationIntegral_zero X hv hr H ω

/-- A repeated interval endpoint has no Stieltjes increment, regardless of coefficient. -/
theorem stieltjes_repeated_endpoint_zero {x : ℝ≥0 → ℝ}
    (hx : LocallyBoundedVariationOn x Set.univ)
    (hr : ∀ t, ContinuousWithinAt x (Set.Ici t) t) (a T : ℝ≥0) (c : ℝ) :
    pathStieltjesIncrementIntegral x hx hr ((Set.Ioc a a).indicator (fun _ ↦ c)) 0 T = 0 := by
  rw [pathStieltjesIncrementIntegral_indicator_Ioc (le_refl a), sub_self, mul_zero]

/-- A source interval beginning after the horizon contributes zero, not a reversed increment. -/
theorem stieltjes_future_interval_zero {x : ℝ≥0 → ℝ}
    (hx : LocallyBoundedVariationOn x Set.univ)
    (hr : ∀ t, ContinuousWithinAt x (Set.Ici t) t) {a b T : ℝ≥0}
    (hab : a ≤ b) (hTa : T ≤ a) (c : ℝ) :
    pathStieltjesIncrementIntegral x hx hr ((Set.Ioc a b).indicator (fun _ ↦ c)) 0 T = 0 := by
  rw [pathStieltjesIncrementIntegral_indicator_Ioc hab,
    min_eq_right hTa, min_eq_right (hTa.trans hab), sub_self, mul_zero]

/-- An atom at time one creates a genuine jump of size one in the primitive. -/
theorem atomic_primitive_jump_at_one :
    (∫ _ in Set.Ioc 0 (1 : ℝ≥0), (1 : ℝ) ∂Measure.dirac (1 : ℝ≥0)) -
      Function.leftLim (fun r : ℝ≥0 ↦ ∫ _ in Set.Ioc 0 r, (1 : ℝ)
        ∂Measure.dirac (1 : ℝ≥0)) 1 = 1 := by
  simpa [measureReal_def] using integral_Ioc_sub_leftLim (μ := Measure.dirac (1 : ℝ≥0))
    (g := fun _ ↦ (1 : ℝ)) (fun _ ↦ integrable_const 1) (show (0 : ℝ≥0) < 1 by norm_num)

/-- Finite-variation integration retains the source initial term. -/
theorem finiteVariation_integral_one_is_process {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ)
    (hv : ∀ ω, LocallyBoundedVariationOn (fun t ↦ X t ω) Set.univ)
    (hr : ∀ ω, ProbabilityTheory.IsRightContinuousPath (fun t ↦ X t ω)) :
    ProbabilityTheory.finiteVariationIntegral X hv hr (fun _ _ ↦ 1) = X := by
  funext t ω
  simpa only [one_mul] using ProbabilityTheory.finiteVariationIntegral_const X hv hr 1 t ω

/-- The variation starts at zero even when the process does not. -/
theorem totalVariation_starts_at_zero {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ) : ProbabilityTheory.totalVariationProcess X 0 = 0 :=
  ProbabilityTheory.totalVariationProcess_zero X

/-- Source initial values are not disguised as mass at the bottom of the time axis. -/
theorem stieltjes_increment_measure_has_no_initial_atom (f : StieltjesFunction ℝ≥0) :
    f.measure {0} = 0 := StochLean.variationStieltjes_measure_zero f

/-- Protter has a time-zero jump even for a constant path when its initial value is nonzero. -/
theorem initial_jump_const {Ω : Type*} (Z : Ω → ℝ) :
    ProbabilityTheory.jumpProcess (fun _ : ℝ≥0 ↦ Z) 0 = Z :=
  ProbabilityTheory.jumpProcess_zero _

/-- Source `T-` stopping discards the time-zero value; it is not ordinary stopping at zero. -/
theorem stopping_before_zero_discards_initial {Ω : Type*} (X : ℝ≥0 → Ω → ℝ) :
    ProbabilityTheory.stoppedProcessBefore X (fun _ ↦ 0) = 0 :=
  ProbabilityTheory.stoppedProcessBefore_zero X

/-- Infinite lifetime leaves every finite coordinate unchanged. -/
theorem stopping_before_infinity_preserves_process {Ω : Type*} (X : ℝ≥0 → Ω → ℝ) :
    ProbabilityTheory.stoppedProcessBefore X (fun _ ↦ ⊤) = X :=
  ProbabilityTheory.stoppedProcessBefore_top X

/-- A positive grid endpoint uses its strict past, not the value at that endpoint. -/
theorem predictable_grid_endpoint_uses_past : ProbabilityTheory.strictLeftGrid 1 1 = 0 := by
  norm_num [ProbabilityTheory.strictLeftGrid]

/-- Source regularity holds for the full class, including repeated stopping endpoints. -/
theorem source_simple_predictable_regularity {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {F : Filtration ℝ≥0 mΩ} {H : ℝ≥0 → Ω → ℝ} (hH : ProbabilityTheory.IsSimplePredictable H F) :
    Adapted F H ∧ (∀ ω, ProbabilityTheory.IsCagladPath (fun t ↦ H t ω)) ∧
      IsStronglyPredictable F H :=
  ⟨hH.adapted, hH.isCagladPath, hH.isStronglyPredictable⟩

/-- R35: the square sum with a moving final partial cell can decrease. -/
theorem partialSquareSum_not_monotone :
    ¬ Monotone (fun T : ℝ≥0 ↦ quadraticVariationSum (TimePartition.single T)
      (fun t ↦ (t : ℝ) * (2 - (t : ℝ)))) := by
  intro h
  have hle := h (show (1 : ℝ≥0) ≤ 2 by norm_num)
  norm_num [quadraticVariationSum_single] at hle

/-- R19: even a single-cell covariation can be negative. -/
theorem covariation_can_be_negative :
    covariationSum (TimePartition.single 1) (fun t ↦ (t : ℝ)) (fun t ↦ -(t : ℝ)) = -1 := by
  norm_num [covariationSum_single]

/-- R16 (increment half): no initial square enters a deterministic increment sum. -/
theorem constant_increment_qv_zero (T : ℝ≥0) (π : TimePartition T) (c : ℝ) :
    quadraticVariationSum π (fun _ ↦ c) = 0 := quadraticVariationSum_const π c

/-- A strict refinement of the single cell `[0,2]`. -/
def unitRefinement : TimePartition 2 where
  size := 2
  point := ![0, 1, 2]
  monotone_point := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> norm_num [Fin.le_def] at *
  first_eq_zero := rfl
  last_eq_horizon := rfl

theorem unitRefinement_refines_single : unitRefinement.Refines (TimePartition.single 2) := by
  rintro t ⟨i, hi⟩
  fin_cases i
  · exact ⟨0, hi⟩
  · exact ⟨Fin.last 2, hi⟩

/-- Klenke 21.60: square sums can decrease when an endpoint is inserted. -/
theorem quadraticVariationSum_refinement_decreases :
    quadraticVariationSum unitRefinement (fun t ↦ (t : ℝ)) <
      quadraticVariationSum (TimePartition.single 2) (fun t ↦ (t : ℝ)) := by
  rw [quadraticVariationSum_single]
  change (∑ i : Fin 2, (((![0, 1, 2] : Fin 3 → ℝ≥0) i.succ : ℝ) -
    ((![0, 1, 2] : Fin 3 → ℝ≥0) i.castSucc : ℝ)) ^ 2) < ((2 : ℝ) - 0) ^ 2
  norm_num [Fin.sum_univ_two]

/-- The reverse inequality also fails: this oscillating path has a larger refined sum. -/
theorem quadraticVariationSum_refinement_increases :
    quadraticVariationSum (TimePartition.single 2) (fun t ↦ (t : ℝ) * (2 - (t : ℝ))) <
      quadraticVariationSum unitRefinement (fun t ↦ (t : ℝ) * (2 - (t : ℝ))) := by
  rw [quadraticVariationSum_single]
  change (2 * (2 - 2) - 0 * (2 - 0) : ℝ) ^ 2 <
    ∑ i : Fin 2, (((![0, 1, 2] : Fin 3 → ℝ≥0) i.succ : ℝ) *
      (2 - ((![0, 1, 2] : Fin 3 → ℝ≥0) i.succ : ℝ)) -
      ((![0, 1, 2] : Fin 3 → ℝ≥0) i.castSucc : ℝ) *
      (2 - ((![0, 1, 2] : Fin 3 → ℝ≥0) i.castSucc : ℝ))) ^ 2
  norm_num [Fin.sum_univ_two]

/-- R35 repair: the completed-cell approximation, rather than the raw partial sum, is monotone. -/
theorem completedSquareSum_monotone (T : ℝ≥0) (π : TimePartition T) (f : ℝ≥0 → ℝ) :
    Monotone (completedQuadraticVariationSum π f) := completedQuadraticVariationSum_mono π f

/-- R34 positive repair: centering permits bounded UI localizations without an L1 hypothesis
on the original initial value. The uncentered counterexample remains in
`InitialValueCounterexample`.
-/
theorem centered_bounded_localizations {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {X : ℝ≥0 → Ω → ℝ}
    (hX : ProbabilityTheory.IsContinuousLocalMartingale X F P) (hF : F.IsUsual P) :
    ∃ τ : ℕ → Ω → WithTop ℝ≥0,
      ProbabilityTheory.IsKlenkeLocalizingSequence (fun t ω ↦ X t ω - X 0 ω) F P τ ∧
      ∀ n, ∀ᵐ ω ∂P, ∀ t,
        ‖stoppedProcess (fun s ω ↦ X s ω - X 0 ω) (τ n) t ω‖ ≤ (n : ℝ) := by
  obtain ⟨τ, hτ, hb⟩ := hX.exists_bounded_centered_localizingSequence hF
  exact ⟨τ, hτ, fun n ↦ (hb n).1⟩

/-- A zero lifetime removes the entire initial value, not merely the later increments. -/
theorem masked_stop_zero {Ω : Type*} (X : ℝ≥0 → Ω → ℝ) :
    stoppedProcess (fun t ↦ {_ω | (0 : WithTop ℝ≥0) < (0 : WithTop ℝ≥0)}.indicator (X t))
      (fun _ ↦ (0 : WithTop ℝ≥0)) = 0 := by
  funext t ω
  simp

/-- A positive lifetime retains the original initial value under masked stopping. -/
theorem masked_stop_initial {Ω : Type*} (X : ℝ≥0 → Ω → ℝ)
    (τ : Ω → WithTop ℝ≥0) (ω : Ω) (hτ : 0 < τ ω) :
    stoppedProcess (fun t ↦ {v | 0 < τ v}.indicator (X t)) τ 0 ω = X 0 ω := by
  rw [stoppedProcess_eq_of_le (show (0 : WithTop ℝ≥0) ≤ τ ω from bot_le)]
  exact Set.indicator_of_mem (show ω ∈ {v | 0 < τ v} from hτ) _

open ProbabilityTheory in
/-- II.20 applies to arbitrary finite initial random values, with no L1/L2 premise
on either the integrator's initial value or the integrand's initial multiplier. -/
theorem constant_initial_integral_locally_L2 {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    [SigmaFiniteFiltration P F] {Z : Ω → ℝ} (hZ : Measurable[F 0] Z)
    (hF : F.IsUsual P) {H : ℝ≥0 → Ω → ℝ} (ha : Adapted F H) (hr : HasCagladPaths H P) :
    Locally (fun Y ↦ IsSquareIntegrableMartingale Y F P) F
      ((isSemimartingale_const_initial hZ).stochasticIntegral hF ha hr) P :=
  (isSemimartingale_const_initial hZ).locally_squareIntegrableMartingale_stochasticIntegral
    hF ((isContinuousLocalMartingale_const_initial hZ).locally_squareIntegrableMartingale hF) ha hr

/-- The outer expectation inequality also handles zero energy against an
unbounded, possibly infinite partner. -/
theorem expectedCovariation_zero_energy {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} {A B C : Ω → ℝ≥0∞}
    (h : ∀ᵐ ω ∂P, A ω ≤ (B ω) ^ (1 / 2 : ℝ) * (C ω) ^ (1 / 2 : ℝ))
    (hB : AEMeasurable B P) (hC : AEMeasurable C P)
    (hz : (∫⁻ ω, B ω ∂P) = 0) : (∫⁻ ω, A ω ∂P) = 0 := by
  have hh := lintegral_le_Lp_mul_Lq_of_ae_sqrt_mul h hB hC Real.HolderConjugate.two_two
  norm_num [hz] at hh
  exact hh

open ProbabilityTheory in
/-- The random Stieltjes realization does not silently discard the initial
square, even with no assumption on its expectation. -/
theorem initialBracketEnergy_not_discarded {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X Y : ℝ≥0 → Ω → ℝ} {hX : IsSemimartingale X F P}
    {hY : IsSemimartingale Y F P} {hF : F.IsUsual P}
    (D : SemimartingaleBracketRealization hX hY hF) (ω : Ω) :
    ((‖X 0 ω‖₊ ^ 2 : ℝ≥0) : ℝ≥0∞) ≤ D.leftEnergy (fun _ ↦ 1) ω := by
  simp only [SemimartingaleBracketRealization.leftEnergy, one_pow, mul_one]
  exact le_add_right le_rfl

/-- A nonzero initial constant is neither a positive-time jump nor a
continuous bracket increment. -/
theorem stieltjesParts_constant (c : ℝ) (t : ℝ≥0) :
    let B : StieltjesFunction ℝ≥0 := ⟨fun _ ↦ c, monotone_const,
      fun _ ↦ continuousWithinAt_const⟩
    stieltjesContinuousPart B t = 0 ∧ stieltjesJumpPart B t = 0 := by
  let B : StieltjesFunction ℝ≥0 := ⟨fun _ ↦ c, monotone_const,
    fun _ ↦ continuousWithinAt_const⟩
  change stieltjesContinuousPart B t = 0 ∧ stieltjesJumpPart B t = 0
  have hB : Continuous B := continuous_const
  constructor
  · exact (stieltjesContinuousPart_eq_of_continuous B hB t).trans (sub_self c)
  · exact stieltjesJumpPart_eq_zero_of_continuous B hB t

/-- A continuous increasing path retains exactly its normalized increment,
not its unnormalized initial value, in the continuous component. -/
theorem stieltjesContinuousPart_preserves_continuous_increment
    (B : StieltjesFunction ℝ≥0) (hB : Continuous B) (t : ℝ≥0) :
    B 0 + stieltjesContinuousPart B t = B t := by
  rw [stieltjesContinuousPart_eq_of_continuous B hB]
  ring

open ProbabilityTheory in
/-- The continuous bracket starts at zero, while the same raw bracket retains
the original initial square, with no moment assumption. -/
theorem continuousBracket_initial_normalization {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    ∀ᵐ ω ∂P, hX.quadraticVariation hF 0 ω = (X 0 ω) ^ 2 ∧
      hX.continuousQuadraticVariation hF 0 ω = 0 := by
  filter_upwards [hX.quadraticVariation_zero_ae hF] with ω hω
  exact ⟨hω, hX.continuousQuadraticVariation_zero hF ω⟩

open ProbabilityTheory in
/-- Positive-time jump sums really use nonnegative real time, including the
empty interval at zero; they are not accidentally indexed by natural numbers. -/
theorem squaredJumpSum_zero_horizon {Ω : Type*} {_mΩ : MeasurableSpace Ω}
    (X : ℝ≥0 → Ω → ℝ) (ω : Ω) :
    (∑' s : Set.Ioc (0 : ℝ≥0) 0, (jumpProcess X s ω) ^ 2) = 0 := by
  let : IsEmpty (Set.Ioc (0 : ℝ≥0) 0) := ⟨fun s ↦ (not_lt_of_ge s.2.2) s.2.1⟩
  exact tsum_empty

open ProbabilityTheory in
/-- Polarization of continuous parts agrees with the continuous square bracket
on the diagonal; it does not introduce another square-bracket owner. -/
theorem continuousCovariation_diagonal {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (hX : IsSemimartingale X F P) (hF : F.IsUsual P) :
    Indistinguishable (hX.continuousQuadraticCovariation hX hF)
      (hX.continuousQuadraticVariation hF) P := hX.continuousQuadraticCovariation_self hF

open ProbabilityTheory in
/-- Both initial conventions coexist: the mixed continuous part is zero,
whereas the raw mixed bracket retains the initial product. -/
theorem continuousCovariation_initial_normalization {Ω : Type*} {mΩ : MeasurableSpace Ω}
    {P : Measure Ω} [IsFiniteMeasure P] {F : Filtration ℝ≥0 mΩ}
