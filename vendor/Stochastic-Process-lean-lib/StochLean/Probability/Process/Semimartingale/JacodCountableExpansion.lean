/-!
# Initial expansion by a countable partition

This file supplies the set- and measure-theoretic core of Jacod's countable-expansion
argument.  The expanded filtration is the smallest filtration containing the old filtration
and making every event of the family measurable at time zero.  For a disjoint family, every
set measurable in the expansion has, on each atom, a representative measurable in the old
field.  A measurable countable partition also decomposes the original measure as the sum of
its restrictions to the atoms.

For a finite family of events we define its Boolean atoms and prove that adjoining the original
events is exactly the same filtration as adjoining all atoms.  These statements isolate the
sigma-algebra calculation used in Protter II, Theorem 5 from the process-level completion
transfer.
-/

@[expose] public section

open MeasureTheory Set
open scoped NNReal ENNReal Function

namespace ProbabilityTheory

variable {Ω ι κ : Type*} {mΩ : MeasurableSpace Ω}

/-- The sigma-algebra generated by a family of events. -/
@[instance_reducible]
def partitionMeasurableSpace (A : ι → Set Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom (Set.range A)

theorem measurableSet_partitionMeasurableSpace (A : ι → Set Ω) (i : ι) :
    MeasurableSet[partitionMeasurableSpace A] (A i) :=
  MeasurableSpace.measurableSet_generateFrom ⟨i, rfl⟩

theorem partitionMeasurableSpace_le_iff {A : ι → Set Ω} {m : MeasurableSpace Ω} :
    partitionMeasurableSpace A ≤ m ↔ ∀ i, MeasurableSet[m] (A i) := by
  constructor
  · intro h i
    exact h _ (measurableSet_partitionMeasurableSpace A i)
  · intro h
    exact MeasurableSpace.generateFrom_le fun _ hs => by
      obtain ⟨i, rfl⟩ := hs
      exact h i

theorem partitionMeasurableSpace_le {A : ι → Set Ω}
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) :
    partitionMeasurableSpace A ≤ mΩ :=
  partitionMeasurableSpace_le_iff.mpr hA

/-- Initial enlargement of `F` by the sigma-algebra generated by `A`.

The added information is present already at time zero, hence at every later time. -/
def initialExpansion (F : Filtration ℝ≥0 mΩ) (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) : Filtration ℝ≥0 mΩ :=
  F ⊔ Filtration.const ℝ≥0 (partitionMeasurableSpace A)
    (partitionMeasurableSpace_le hA)

@[simp]
theorem initialExpansion_apply (F : Filtration ℝ≥0 mΩ) (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) (t : ℝ≥0) :
    initialExpansion F A hA t = F t ⊔ partitionMeasurableSpace A :=
  rfl

theorem le_initialExpansion (F : Filtration ℝ≥0 mΩ) (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) (t : ℝ≥0) :
    F t ≤ initialExpansion F A hA t :=
  le_sup_left

theorem measurableSet_initialExpansion_atom (F : Filtration ℝ≥0 mΩ)
    (A : ι → Set Ω) (hA : ∀ i, MeasurableSet[mΩ] (A i)) (i : ι) (t : ℝ≥0) :
    MeasurableSet[initialExpansion F A hA t] (A i) :=
  (le_sup_right : partitionMeasurableSpace A ≤ F t ⊔ partitionMeasurableSpace A) _
    (measurableSet_partitionMeasurableSpace A i)

/-- The initial expansion is the least filtration above `F` that sees every event at time zero. -/
theorem initialExpansion_le {F G : Filtration ℝ≥0 mΩ} {A : ι → Set Ω}
    (hA : ∀ i, MeasurableSet[mΩ] (A i))
    (hFG : ∀ t, F t ≤ G t) (hAG : ∀ i, MeasurableSet[G 0] (A i)) :
    initialExpansion F A hA ≤ G := by
  intro t
  refine sup_le (hFG t) ?_
  exact (partitionMeasurableSpace_le_iff.mpr hAG).trans (G.mono bot_le)

/-- Sets which admit an `m`-measurable representative after intersection with `a` form a
sigma-algebra.  This trace-extension space is convenient for proving the atomwise trace
description of an initial expansion. -/
@[instance_reducible]
private def traceExtensionMeasurableSpace (m : MeasurableSpace Ω) (a : Set Ω) :
    MeasurableSpace Ω where
  MeasurableSet' s := ∃ b : Set Ω, MeasurableSet[m] b ∧ s ∩ a = b ∩ a
  measurableSet_empty := ⟨∅, MeasurableSet.empty, rfl⟩
  measurableSet_compl s hs := by
    obtain ⟨b, hb, hsb⟩ := hs
    refine ⟨bᶜ, hb.compl, ?_⟩
    ext ω
    have hω := Set.ext_iff.mp hsb ω
    simp only [Set.mem_inter_iff, Set.mem_compl_iff] at hω ⊢
    tauto
  measurableSet_iUnion s hs := by
    choose b hb hsb using hs
    refine ⟨⋃ n, b n, MeasurableSet.iUnion hb, ?_⟩
    ext ω
    constructor
    · rintro ⟨hωs, hωa⟩
      obtain ⟨n, hωsn⟩ := Set.mem_iUnion.mp hωs
      have hω := Set.ext_iff.mp (hsb n) ω
      have hωb : ω ∈ b n := (hω.mp ⟨hωsn, hωa⟩).1
      exact ⟨Set.mem_iUnion.mpr ⟨n, hωb⟩, hωa⟩
    · rintro ⟨hωb, hωa⟩
      obtain ⟨n, hωbn⟩ := Set.mem_iUnion.mp hωb
      have hω := Set.ext_iff.mp (hsb n) ω
      have hωs : ω ∈ s n := (hω.mpr ⟨hωbn, hωa⟩).1
      exact ⟨Set.mem_iUnion.mpr ⟨n, hωs⟩, hωa⟩

private theorem le_traceExtensionMeasurableSpace (m : MeasurableSpace Ω) (a : Set Ω) :
    m ≤ traceExtensionMeasurableSpace m a := by
  intro s hs
  exact ⟨s, hs, rfl⟩

private theorem partitionMeasurableSpace_le_traceExtension
    {A : ι → Set Ω} (hdisj : Pairwise (Disjoint on A)) (i : ι)
    (m : MeasurableSpace Ω) :
    partitionMeasurableSpace A ≤ traceExtensionMeasurableSpace m (A i) := by
  rw [partitionMeasurableSpace_le_iff]
  intro j
  by_cases hji : j = i
  · subst j
    exact ⟨Set.univ, MeasurableSet.univ, by simp⟩
  · refine ⟨∅, MeasurableSet.empty, ?_⟩
    simpa only [Set.empty_inter] using Set.disjoint_iff_inter_eq_empty.mp (hdisj hji)

/-- Atomwise trace description of the countable initial expansion.

No countability is needed for this direction: on a fixed atom, every generator from the added
partition is either `univ` or `empty`, and the property is stable under sigma operations. -/
theorem exists_measurable_inter_eq_of_measurableSet_initialExpansion
    {F : Filtration ℝ≥0 mΩ} {A : ι → Set Ω}
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) (hdisj : Pairwise (Disjoint on A))
    {t : ℝ≥0} {s : Set Ω} (hs : MeasurableSet[initialExpansion F A hA t] s) (i : ι) :
    ∃ b : Set Ω, MeasurableSet[F t] b ∧ s ∩ A i = b ∩ A i := by
  have hle : initialExpansion F A hA t ≤ traceExtensionMeasurableSpace (F t) (A i) := by
    change F t ⊔ partitionMeasurableSpace A ≤ traceExtensionMeasurableSpace (F t) (A i)
    exact sup_le (le_traceExtensionMeasurableSpace (F t) (A i))
      (partitionMeasurableSpace_le_traceExtension hdisj i (F t))
  exact hle s hs

/-- Measure-theoretic form of the atomwise trace description. -/
theorem exists_measurable_ae_eq_restrict_of_measurableSet_initialExpansion
    {F : Filtration ℝ≥0 mΩ} {A : ι → Set Ω} {P : Measure Ω}
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) (hdisj : Pairwise (Disjoint on A))
    {t : ℝ≥0} {s : Set Ω} (hs : MeasurableSet[initialExpansion F A hA t] s) (i : ι) :
    ∃ b : Set Ω, MeasurableSet[F t] b ∧ s =ᵐ[P.restrict (A i)] b := by
  obtain ⟨b, hb, hsb⟩ :=
    exists_measurable_inter_eq_of_measurableSet_initialExpansion hA hdisj hs i
  refine ⟨b, hb, ?_⟩
  apply (ae_restrict_iff' (hA i)).mpr
  exact ae_of_all P fun ω hωa => by
    apply propext
    have hω := Set.ext_iff.mp hsb ω
    change (ω ∈ s) ↔ (ω ∈ b)
    simpa only [Set.mem_inter_iff, hωa, and_true] using hω

/-- On one partition atom, the enlarged field is contained in the completion of the old
field for the restricted measure.  This is the exact filtration comparison used in Jacod's
proof before the atomwise semimartingale statements are recombined. -/
theorem initialExpansion_le_sup_nullSets_restrict
    {F : Filtration ℝ≥0 mΩ} {A : ι → Set Ω} {P : Measure Ω}
    (hA : ∀ i, MeasurableSet[mΩ] (A i)) (hdisj : Pairwise (Disjoint on A))
    (i : ι) (t : ℝ≥0) :
    initialExpansion F A hA t ≤
      F t ⊔ @Filtration.nullSets Ω mΩ (P.restrict (A i)) := by
  intro s hs
  obtain ⟨b, hb, hsb⟩ :=
    exists_measurable_ae_eq_restrict_of_measurableSet_initialExpansion hA hdisj hs i
  exact (measurableSet_sup_nullSets_iff (P := P.restrict (A i))).mpr ⟨b, hb, hsb⟩

/-- A measurable countable partition decomposes a measure into the sum of its restrictions. -/
theorem sum_restrict_countablePartition {A : ℕ → Set Ω} {P : Measure Ω}
    (hA : ∀ n, MeasurableSet[mΩ] (A n)) (hdisj : Pairwise (Disjoint on A))
    (hcover : ⋃ n, A n = Set.univ) :
    Measure.sum (fun n ↦ P.restrict (A n)) = P := by
  rw [← Measure.restrict_iUnion hdisj hA, hcover, Measure.restrict_univ]

/-! ## Finite event families and their atoms -/

section FiniteAtoms

variable [Fintype κ]

/-- Boolean atom cut out by a finite family of events. -/
def finiteEventAtom (E : κ → Set Ω) (v : κ → Bool) : Set Ω :=
  ⋂ i, if v i = true then E i else (E i)ᶜ

theorem measurableSet_finiteEventAtom {E : κ → Set Ω}
    (hE : ∀ i, MeasurableSet[mΩ] (E i)) (v : κ → Bool) :
    MeasurableSet[mΩ] (finiteEventAtom E v) := by
  apply MeasurableSet.iInter
  intro i
  cases v i <;> simp [hE i]

theorem pairwise_disjoint_finiteEventAtom (E : κ → Set Ω) :
    Pairwise (Disjoint on finiteEventAtom E) := by
  intro v w hvw
  apply Set.disjoint_left.mpr
  intro ω hωv hωw
  have hex : ∃ i, v i ≠ w i := Function.ne_iff.mp hvw
  obtain ⟨i, hi⟩ := hex
  have hvi := Set.mem_iInter.mp hωv i
  have hwi := Set.mem_iInter.mp hωw i
  cases hvi' : v i <;> cases hwi' : w i <;>
    simp_all [finiteEventAtom]

omit [Fintype κ] in
theorem iUnion_finiteEventAtom (E : κ → Set Ω) :
    ⋃ v : κ → Bool, finiteEventAtom E v = Set.univ := by
  classical
  apply Set.eq_univ_of_forall
  intro ω
  let v : κ → Bool := fun i ↦ decide (ω ∈ E i)
  refine Set.mem_iUnion.mpr ⟨v, Set.mem_iInter.mpr ?_⟩
  intro i
  by_cases hi : ω ∈ E i
  · simp [v, hi]
  · simp [v, hi]

private theorem measurableSet_event_partitionMeasurableSpace_finiteEventAtom
    (E : κ → Set Ω) (i : κ) :
    MeasurableSet[partitionMeasurableSpace (finiteEventAtom E)] (E i) := by
  classical
  have heq : E i = ⋃ v : {v : κ → Bool // v i = true}, finiteEventAtom E v := by
    ext ω
    constructor
    · intro hω
      let v : κ → Bool := fun j ↦ decide (ω ∈ E j)
      have hvi : v i = true := by simp [v, hω]
      refine Set.mem_iUnion.mpr ⟨⟨v, hvi⟩, ?_⟩
      apply Set.mem_iInter.mpr
      intro j
      by_cases hj : ω ∈ E j
      · simp [v, hj]
      · simp [v, hj]
    · intro hω
      obtain ⟨v, hωv⟩ := Set.mem_iUnion.mp hω
      have hi := Set.mem_iInter.mp hωv i
      simpa only [v.property, if_true] using hi
  rw [heq]
  exact MeasurableSet.iUnion fun v ↦
    measurableSet_partitionMeasurableSpace (finiteEventAtom E) v

/-- A finite family and its Boolean atoms generate the same sigma-algebra. -/
theorem partitionMeasurableSpace_finiteEventAtom (E : κ → Set Ω) :
    partitionMeasurableSpace (finiteEventAtom E) = partitionMeasurableSpace E := by
  apply le_antisymm
  · rw [partitionMeasurableSpace_le_iff]
    intro v
    exact measurableSet_finiteEventAtom
      (fun i ↦ measurableSet_partitionMeasurableSpace E i) v
  · rw [partitionMeasurableSpace_le_iff]
    exact measurableSet_event_partitionMeasurableSpace_finiteEventAtom E

/-- Adjoining finitely many events is exactly adjoining their finite Boolean partition. -/
theorem initialExpansion_finiteEvents_eq_atoms (F : Filtration ℝ≥0 mΩ)
    (E : κ → Set Ω) (hE : ∀ i, MeasurableSet[mΩ] (E i)) :
    initialExpansion F E hE =
      initialExpansion F (finiteEventAtom E) (measurableSet_finiteEventAtom hE) := by
  apply Filtration.ext
  funext t
  simp only [initialExpansion_apply, partitionMeasurableSpace_finiteEventAtom]

end FiniteAtoms

end ProbabilityTheory
