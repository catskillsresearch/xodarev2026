module

public import StochLean.Probability.Process.Semimartingale.PredictableQuadraticVariation.EnvironmentCounterexample
public import StochLean.Probability.Process.Semimartingale.QuadraticCovariation.EnvironmentInvariance

/-! # Actual predictable quadratic variation changes with the filtration

The probability law and bounded UI/L2 martingale are exactly those of the
three-point model. The larger filtration knows the squared jump before one,
but not its sign. Its conditional first moment is still zero, as proved by
actual integrals over the sigma-field generated by the square.

The raw quadratic variation is unchanged. The actual selected angle is now
the squared-jump step itself, whereas the smaller filtration gives the step
of height one half. Both legal local-integrable-variation domains and both
martingale structures are constructed, not supplied as certificates.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal

namespace StochLean.SemimartingaleRegression.ThreePoint

/-- The squared jump is known initially; its sign is revealed at time one. -/
noncomputable def squareRevealFiltration :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Fin 3)) where
  seq t := if 1 ≤ t then ⊤ else
    MeasurableSpace.comap (fun i : Fin 3 ↦ (jumpSize i) ^ 2) inferInstance
  mono' := by
    intro s t hst
    by_cases hs : (1 : ℝ≥0) ≤ s
    · simp only [if_pos hs, if_pos (hs.trans hst), le_refl]
    · simp only [if_neg hs]
      split_ifs <;> first | exact le_top | exact le_rfl
  le' _ := le_top

private theorem reveal_le_squareReveal : revealFiltration ≤ squareRevealFiltration := by
  intro t
  change (if (1 : ℝ≥0) ≤ t then ⊤ else ⊥) ≤
    if 1 ≤ t then ⊤ else
      MeasurableSpace.comap (fun i : Fin 3 ↦ (jumpSize i) ^ 2) inferInstance
  split_ifs <;> first | exact le_rfl | exact bot_le

private theorem squareReveal_usual : squareRevealFiltration.IsUsual measureP := by
  refine ⟨⟨?_⟩, ?_⟩
  · intro t
    rw [Filtration.rightCont_eq]
    by_cases ht : (1 : ℝ≥0) ≤ t
    · change _ ≤ if 1 ≤ t then ⊤ else _
      rw [if_pos ht]
      exact le_top
    · obtain ⟨u, htu, hu⟩ := exists_between (lt_of_not_ge ht)
      apply iInf₂_le_of_le u htu
      change (if 1 ≤ u then ⊤ else _) ≤ if 1 ≤ t then ⊤ else _
      simp only [if_neg (not_le.mpr hu), if_neg ht, le_refl]
  · intro s hs
    exact reveal_le_squareReveal ⊥ s (revealFiltration_isUsual.1.complete_initial s hs)

private theorem squareReveal_before_one :
    (isStoppingTime_const squareRevealFiltration (1 : ℝ≥0)).measurableSpaceBefore =
      MeasurableSpace.comap (fun i : Fin 3 ↦ (jumpSize i) ^ 2) inferInstance := by
  rw [IsStoppingTime.measurableSpaceBefore_const]
  apply le_antisymm
  · refine sup_le ?_ (iSup_le fun t ↦ iSup_le fun ht ↦ ?_)
    · change (if (1 : ℝ≥0) ≤ 0 then ⊤ else _) ≤ _
      norm_num
    · change (if 1 ≤ t then ⊤ else _) ≤ _
      simp only [if_neg (not_le.mpr ht), le_refl]
  · apply le_trans ?_ le_sup_left
    change _ ≤ if (1 : ℝ≥0) ≤ 0 then ⊤ else _
    norm_num

private theorem jumpSize_condExp_square_eq_zero :
    measureP[jumpSize |
      MeasurableSpace.comap (fun i : Fin 3 ↦ (jumpSize i) ^ 2) inferInstance] =ᵐ[measureP] 0 := by
  symm
  apply ae_eq_condExp_of_forall_setIntegral_eq (show
    MeasurableSpace.comap (fun i : Fin 3 ↦ (jumpSize i) ^ 2) inferInstance ≤
      (inferInstance : MeasurableSpace (Fin 3)) from le_top)
    (show Integrable jumpSize measureP from Integrable.of_finite)
  · intro s _ _
    exact (integrable_const (0 : ℝ)).integrableOn
  · intro s hs _
    obtain ⟨S, hS, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
    simp only [Pi.zero_apply, integral_zero]
    symm
    rw [← integral_indicator ((measurable_of_finite
      (fun i : Fin 3 ↦ (jumpSize i) ^ 2)) hS),
      integral_fintype Integrable.of_finite, Fin.sum_univ_three]
    by_cases h1 : (1 : ℝ) ∈ S <;>
      norm_num [measureP, measureReal_def, jumpSize, Pi.single_apply, Fin.ext_iff,
        indicator_apply, mem_preimage, h1]
  · exact stronglyMeasurable_const.aestronglyMeasurable

private theorem squareReveal_jumpMartingale_ui :
    IsUIMartingale jumpMartingale squareRevealFiltration measureP := by
  let hτ := isStoppingTime_const squareRevealFiltration (1 : ℝ≥0)
  have hm : StronglyMeasurable[hτ.measurableSpace] jumpSize := by
    rw [IsStoppingTime.measurableSpace_const]
    have h1 : squareRevealFiltration 1 = (inferInstance : MeasurableSpace (Fin 3)) := by
      change (if (1 : ℝ≥0) ≤ 1 then ⊤ else _) = ⊤
      exact if_pos le_rfl
    rw [h1]
    exact (measurable_of_finite jumpSize).stronglyMeasurable
  have hz : measureP[jumpSize | hτ.measurableSpaceBefore] =ᵐ[measureP] 0 := by
    rw [squareReveal_before_one]
    exact jumpSize_condExp_square_eq_zero
  have hu := isUIMartingale_indicator_stoppingTime_le_of_condExp_before_eq_zero
    hτ hm Integrable.of_finite hz
  change IsUIMartingale (fun (t : ℝ≥0) (i : Fin 3) ↦
    {j : Fin 3 | ((1 : ℝ≥0) : WithTop ℝ≥0) ≤ (t : WithTop ℝ≥0)}.indicator jumpSize i)
      squareRevealFiltration measureP at hu
  change IsUIMartingale (fun t : ℝ≥0 ↦ fun i ↦ if 1 ≤ t then jumpSize i else 0)
    squareRevealFiltration measureP
  simpa only [indicator_apply, mem_ofPred_eq, WithTop.coe_le_coe] using hu

/-- The actual enlargement is usual and preserves both the UI and L2
martingale properties of the original bounded process under the same law. -/
theorem squareRevealFiltration_properties :
    revealFiltration ≤ squareRevealFiltration ∧ squareRevealFiltration.IsUsual measureP ∧
      IsUIMartingale jumpMartingale squareRevealFiltration measureP ∧
      IsSquareIntegrableMartingale jumpMartingale squareRevealFiltration measureP := by
  refine ⟨reveal_le_squareReveal, squareReveal_usual, squareReveal_jumpMartingale_ui,
    ⟨squareReveal_jumpMartingale_ui.1, ?_⟩⟩
  intro t
  exact (memLp_two_iff_integrable_sq
    (measurable_of_finite (jumpMartingale t)).aestronglyMeasurable).mpr Integrable.of_finite

private theorem square_step_predictable :
    IsStronglyPredictable squareRevealFiltration
      (fun t i ↦ if (1 : ℝ≥0) ≤ t then (jumpSize i) ^ 2 else 0) := by
  have hτ := isPredictableStoppingTime_const squareRevealFiltration measureP (1 : ℝ≥0)
  have hf : StronglyMeasurable[hτ.1.measurableSpaceBefore]
      (fun i : Fin 3 ↦ (jumpSize i) ^ 2) := by
    rw [squareReveal_before_one]
    exact (measurable_iff_comap_le.mpr le_rfl).stronglyMeasurable
  have hp := hf.isStronglyPredictable_indicator_stoppingTime_le
    hτ squareReveal_usual.complete_initial
  change IsStronglyPredictable squareRevealFiltration (fun (t : ℝ≥0) (i : Fin 3) ↦
    {j : Fin 3 | ((1 : ℝ≥0) : WithTop ℝ≥0) ≤ (t : WithTop ℝ≥0)}.indicator
      (fun j : Fin 3 ↦ (jumpSize j) ^ 2) i) at hp
  simpa only [indicator_apply, mem_ofPred_eq, WithTop.coe_le_coe] using hp

private theorem square_step_integrableVariation :
    HasIntegrableVariation
      (fun t i ↦ if (1 : ℝ≥0) ≤ t then (jumpSize i) ^ 2 else 0) measureP := by
  have h := hasIntegrableVariation_indicator_lifetime_le
    (τ := fun _ : Fin 3 ↦ ((1 : ℝ≥0) : WithTop ℝ≥0)) measurable_const
    (show Integrable (fun i ↦ (jumpSize i) ^ 2) measureP from Integrable.of_finite)
  change HasIntegrableVariation (fun (t : ℝ≥0) (i : Fin 3) ↦
    {j : Fin 3 | ((1 : ℝ≥0) : WithTop ℝ≥0) ≤ (t : WithTop ℝ≥0)}.indicator
      (fun j : Fin 3 ↦ (jumpSize j) ^ 2) i) measureP at h
  simpa only [indicator_apply, mem_ofPred_eq, WithTop.coe_le_coe] using h

/-- Under the same probability law, enlargement preserves the actual raw
quadratic variation but changes the actual predictable quadratic variation.
The two angular-domain proofs are genuinely constructed from this model. -/
theorem actual_angles_of_enlarged_filtration :
    let hMF := jumpMartingale_ui_and_squareIntegrable.2.1.isLocalMartingale
      (Eventually.of_forall fun i ↦ isCadlagPath_step_Ici 1 (jumpSize i))
    let hMG := squareRevealFiltration_properties.2.2.1.isLocalMartingale
      (Eventually.of_forall fun i ↦ isCadlagPath_step_Ici 1 (jumpSize i))
    let hSF := hMF.isSemimartingale revealFiltration_isUsual.1
    let hSG := hMG.isSemimartingale squareRevealFiltration_properties.2.1
    ∃ hQF : HasLocallyIntegrableVariation
        (hSF.quadraticVariation revealFiltration_isUsual.1) revealFiltration measureP,
      ∃ hQG : HasLocallyIntegrableVariation
        (hSG.quadraticVariation squareRevealFiltration_properties.2.1)
          squareRevealFiltration measureP,
        Indistinguishable (hSF.quadraticVariation revealFiltration_isUsual.1)
          (hSG.quadraticVariation squareRevealFiltration_properties.2.1) measureP ∧
        Indistinguishable (hSF.predictableQuadraticVariation revealFiltration_isUsual.1 hQF)
          (fun t _ ↦ if (1 : ℝ≥0) ≤ t then (1 / 2 : ℝ) else 0) measureP ∧
        Indistinguishable
          (hSG.predictableQuadraticVariation squareRevealFiltration_properties.2.1 hQG)
          (fun t i ↦ if (1 : ℝ≥0) ≤ t then (jumpSize i) ^ 2 else 0) measureP ∧
        ¬ Indistinguishable
          (hSF.predictableQuadraticVariation revealFiltration_isUsual.1 hQF)
          (hSG.predictableQuadraticVariation squareRevealFiltration_properties.2.1 hQG)
          measureP := by
  intro hMF hMG hSF hSG
  obtain ⟨hQF, _, hrawF, _, hangleF, _⟩ := actual_angles_of_equivalent_measures
  have hraw := hSF.quadraticVariation_congr_filtration hSG
    revealFiltration_isUsual.1 squareRevealFiltration_properties.2.1
  have hrawG := hraw.symm.trans hrawF
  have hiQG := square_step_integrableVariation.congr hrawG.symm
  have hQG : HasLocallyIntegrableVariation
      (hSG.quadraticVariation squareRevealFiltration_properties.2.1)
        squareRevealFiltration measureP := hiQG.hasLocallyIntegrableVariation
  have hzero := (isContinuousLocalMartingale_const_initial
    (F := squareRevealFiltration) (P := measureP)
    (Z := fun _ : Fin 3 ↦ (0 : ℝ)) measurable_const).1
  have hres : IsLocalMartingale
      (hSG.quadraticVariation squareRevealFiltration_properties.2.1 -
        (fun t i ↦ if (1 : ℝ≥0) ≤ t then (jumpSize i) ^ 2 else 0))
      squareRevealFiltration measureP := by
    apply hzero.congr squareRevealFiltration_properties.2.1
      ((hSG.adapted_quadraticVariation squareRevealFiltration_properties.2.1).sub
        square_step_predictable.stronglyAdapted.adapted)
    filter_upwards [hrawG] with i hi t
    change 0 = hSG.quadraticVariation squareRevealFiltration_properties.2.1 t i - _
    rw [hi t, sub_self]
  have hangleG := hSG.predictableQuadraticVariation_unique
    squareRevealFiltration_properties.2.1 hQG square_step_predictable
    square_step_integrableVariation.hasFiniteVariationPaths
    (Eventually.of_forall fun i ↦ by norm_num) hres
  refine ⟨hQF, hQG, hraw, hangleF, hangleG, ?_⟩
  intro he
  have hf : ∀ᵐ i ∂measureP, False := by
    filter_upwards [hangleF, hangleG, he] with i hfi hgi hei
    have h := hei 1
    rw [hfi 1, hgi 1] at h
    fin_cases i <;> norm_num [jumpSize] at h
  exact (NeZero.ne measureP) (by simpa using hf)

end StochLean.SemimartingaleRegression.ThreePoint
