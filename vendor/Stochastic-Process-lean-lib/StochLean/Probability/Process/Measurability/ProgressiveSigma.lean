module

public import StochLean.Probability.Process.Measurability.Progressive
public import Mathlib.MeasureTheory.MeasurableSpace.Prod

/-! # The progressive sigma-field

The sole sigma-field is characterized by measurable restrictions to every
finite horizon. It is proved equal to the sigma-field generated by native
real progressively measurable processes, as in Protter III.1. Mathlib's
`IsProgressive` and `IsStronglyProgressive` remain the process predicates.
-/

@[expose] public section

open ProbabilityTheory Set
open scoped NNReal

namespace MeasureTheory.Filtration

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- Events whose restriction to every finite horizon is measurable at that horizon. -/
@[instance_reducible] def progressive (F : Filtration ℝ≥0 mΩ) :
    MeasurableSpace (ℝ≥0 × Ω) :=
  ⨅ t : ℝ≥0, MeasurableSpace.map (fun p : Iic t × Ω ↦ ((p.1 : ℝ≥0), p.2))
    (Subtype.instMeasurableSpace.prod (F t))

theorem measurableSet_progressive_iff (F : Filtration ℝ≥0 mΩ) {A : Set (ℝ≥0 × Ω)} :
    MeasurableSet[F.progressive] A ↔ ∀ t : ℝ≥0,
      MeasurableSet[Subtype.instMeasurableSpace.prod (F t)]
        ((fun p : Iic t × Ω ↦ ((p.1 : ℝ≥0), p.2)) ⁻¹' A) := by
  rw [progressive, MeasurableSpace.measurableSet_iInf]
  rfl

theorem measurable_progressive_iff (F : Filtration ℝ≥0 mΩ)
    {E : Type*} [MeasurableSpace E] {X : ℝ≥0 → Ω → E} :
    Measurable[F.progressive] (Function.uncurry X) ↔ IsProgressive F X := by
  constructor
  · intro h t A hA
    exact (F.measurableSet_progressive_iff.mp (h hA)) t
  · intro h A hA
    exact F.measurableSet_progressive_iff.mpr (fun t ↦ h t hA)

/-- Protter's real-process generator definition gives exactly the restriction field. -/
theorem progressive_eq_iSup_comap (F : Filtration ℝ≥0 mΩ) :
    F.progressive = ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsProgressive F X),
      MeasurableSpace.comap (Function.uncurry X) inferInstance := by
  classical
  apply le_antisymm
  · intro A hA
    let X : ℝ≥0 → Ω → ℝ := fun t ω ↦ A.indicator (fun _ ↦ 1) (t, ω)
    have hm : Measurable[F.progressive] (Function.uncurry X) :=
      measurable_const.indicator hA
    have hp := (F.measurable_progressive_iff).mp hm
    have hle : MeasurableSpace.comap (Function.uncurry X) inferInstance ≤
        ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : IsProgressive F X),
          MeasurableSpace.comap (Function.uncurry X) inferInstance :=
      le_iSup_of_le X (le_iSup_of_le hp le_rfl)
    have hs := hle _ ((comap_measurable (Function.uncurry X)) (measurableSet_singleton (1 : ℝ)))
    convert hs using 1
    ext p
    change p ∈ A ↔ A.indicator (fun _ ↦ (1 : ℝ)) p = 1
    simp
  · refine iSup_le fun X ↦ iSup_le fun hX ↦ ?_
    exact ((F.measurable_progressive_iff).mpr hX).comap_le

theorem measurable_inclusion_progressive (F : Filtration ℝ≥0 mΩ) (t : ℝ≥0) :
    @Measurable (Iic t × Ω) (ℝ≥0 × Ω) (Subtype.instMeasurableSpace.prod (F t))
      F.progressive (fun p ↦ ((p.1 : ℝ≥0), p.2)) :=
  fun _ hA ↦ (F.measurableSet_progressive_iff.mp hA) t

theorem progressive_le_prod (F : Filtration ℝ≥0 mΩ) :
    F.progressive ≤ (inferInstance : MeasurableSpace ℝ≥0).prod mΩ := by
  intro A hA
  have hloc (n : ℕ) : MeasurableSet
      ((fun p : Iic (n : ℝ≥0) × Ω ↦ ((p.1 : ℝ≥0), p.2)) ''
        ((fun p : Iic (n : ℝ≥0) × Ω ↦ ((p.1 : ℝ≥0), p.2)) ⁻¹' A)) := by
    have hm := (F.measurableSet_progressive_iff.mp hA) (n : ℝ≥0)
    have hle : Subtype.instMeasurableSpace.prod (F (n : ℝ≥0)) ≤
        (Subtype.instMeasurableSpace : MeasurableSpace (Iic (n : ℝ≥0))).prod mΩ :=
      sup_le_sup le_rfl (MeasurableSpace.comap_mono (F.le _))
    have hm' : MeasurableSet[Subtype.instMeasurableSpace.prod mΩ]
        ((fun p : Iic (n : ℝ≥0) × Ω ↦ ((p.1 : ℝ≥0), p.2)) ⁻¹' A) :=
      hle _ hm
    exact ((MeasurableEmbedding.subtype_coe measurableSet_Iic).prodMap
      MeasurableEmbedding.id).measurableSet_image.mpr hm'
  have he : A = ⋃ n : ℕ,
      (fun p : Iic (n : ℝ≥0) × Ω ↦ ((p.1 : ℝ≥0), p.2)) ''
        ((fun p : Iic (n : ℝ≥0) × Ω ↦ ((p.1 : ℝ≥0), p.2)) ⁻¹' A) := by
    ext p
    constructor
    · intro hp
      obtain ⟨n, hn⟩ := exists_nat_ge p.1
      exact mem_iUnion.mpr ⟨n, ⟨⟨⟨p.1, hn⟩, p.2⟩, hp, rfl⟩⟩
    · intro hp
      obtain ⟨n, q, hq, rfl⟩ := mem_iUnion.mp hp
      exact hq
  rw [he]
  exact MeasurableSet.iUnion hloc

/-- If the filtration is constantly the ambient field, progressive and joint
measurability coincide. A smaller constant filtration is not substituted here. -/
theorem progressive_const :
    (Filtration.const ℝ≥0 mΩ le_rfl).progressive =
      (inferInstance : MeasurableSpace ℝ≥0).prod mΩ := by
  apply le_antisymm (Filtration.const ℝ≥0 mΩ le_rfl).progressive_le_prod
  intro A hA
  apply (Filtration.const ℝ≥0 mΩ le_rfl).measurableSet_progressive_iff.mpr
  intro t
  exact ((measurable_subtype_coe.comp measurable_fst).prodMk measurable_snd) hA

end MeasureTheory.Filtration

namespace MeasureTheory.IsProgressive

variable {Ω E : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace E]
  {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → E}

theorem isProductMeasurable (hX : IsProgressive F X) : IsProductMeasurable X :=
  ((F.measurable_progressive_iff).mpr hX).mono F.progressive_le_prod le_rfl

theorem const_iff_isProductMeasurable :
    IsProgressive (Filtration.const ℝ≥0 mΩ le_rfl) X ↔ IsProductMeasurable X := by
  rw [← (Filtration.const ℝ≥0 mΩ le_rfl).measurable_progressive_iff,
    Filtration.progressive_const]
  rfl

end MeasureTheory.IsProgressive
