module

public import StochLean.Probability.Process.Measurability.ProgressiveSigma
public import StochLean.Probability.Process.Measurability.Predictable
public import StochLean.Probability.Process.Measurability.CadlagVersion

/-! # The optional sigma-field and the source inclusion chain

Protter III.1 defines the optional sigma-field using adapted cadlag real
processes. Everywhere path regularity is used in its generators. For merely
almost-sure cadlag paths the bridge constructs an indistinguishable optional
version; it does not assert optionality of arbitrary exceptional trajectories.
-/

@[expose] public section

open ProbabilityTheory Set
open scoped NNReal

namespace MeasureTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

namespace Filtration

/-- The source sigma-field generated by adapted, everywhere-cadlag real processes. -/
@[instance_reducible] def optional (F : Filtration ℝ≥0 mΩ) : MeasurableSpace (ℝ≥0 × Ω) :=
  ⨆ (X : ℝ≥0 → Ω → ℝ) (_ : Adapted F X) (_ : ∀ ω, IsCadlagPath (fun t ↦ X t ω)),
    MeasurableSpace.comap (Function.uncurry X) inferInstance

end Filtration

theorem Adapted.measurable_optional_of_cadlag {F : Filtration ℝ≥0 mΩ}
    {X : ℝ≥0 → Ω → ℝ} (ha : Adapted F X) (hc : ∀ ω, IsCadlagPath (fun t ↦ X t ω)) :
    Measurable[F.optional] (Function.uncurry X) :=
  measurable_iff_comap_le.mpr
    (le_iSup_of_le X (le_iSup_of_le ha (le_iSup_of_le hc le_rfl)))

namespace Filtration

theorem optional_le_progressive (F : Filtration ℝ≥0 mΩ) : F.optional ≤ F.progressive := by
  refine iSup_le fun X ↦ iSup_le fun ha ↦ iSup_le fun hc ↦ ?_
  have hsa : StronglyAdapted F X := fun t ↦ (ha t).stronglyMeasurable
  have hp := (hsa.isStronglyProgressive_of_rightContinuous (fun ω ↦ (hc ω).1)).isProgressive
  exact ((F.measurable_progressive_iff).mpr hp).comap_le

theorem optional_le_prod (F : Filtration ℝ≥0 mΩ) :
    F.optional ≤ (inferInstance : MeasurableSpace ℝ≥0).prod mΩ :=
  F.optional_le_progressive.trans F.progressive_le_prod

/-- The predictable-to-optional inclusion uses continuous ramps for strict
future rectangles, avoiding a false claim that caglad paths are cadlag. -/
theorem predictable_le_optional (F : Filtration ℝ≥0 mΩ) : F.predictable ≤ F.optional := by
  classical
  have hclock : Measurable[F.optional] (fun p : ℝ≥0 × Ω ↦ (p.1 : ℝ)) := by
    apply Adapted.measurable_optional_of_cadlag (X := fun t _ ↦ (t : ℝ))
    · exact fun _ ↦ measurable_const
    · exact fun _ ↦ IsContinuousPath.isCadlagPath NNReal.continuous_coe
  apply measurableSpace_le_predictable_of_measurableSet
  · intro A hA
    let V : Ω → ℝ := A.indicator (fun _ ↦ 1)
    have ha : Adapted F (fun (_ : ℝ≥0) ↦ V) :=
      fun t ↦ measurable_const.indicator (F.mono bot_le _ hA)
    have hm := ha.measurable_optional_of_cadlag
      (fun _ ↦ IsContinuousPath.isCadlagPath continuous_const)
    have hs := (hclock (measurableSet_singleton 0)).inter (hm (measurableSet_singleton 1))
    convert hs using 1
    ext ⟨t, ω⟩
    simp [V]
  · intro a A hA
    let V : Ω → ℝ := A.indicator (fun _ ↦ 1)
    let X : ℝ≥0 → Ω → ℝ := fun t ω ↦ ((t - a : ℝ≥0) : ℝ) * V ω
    have ha : Adapted F X := by
      intro t
      by_cases ht : a ≤ t
      · exact measurable_const.mul (measurable_const.indicator (F.mono ht _ hA))
      · have he : X t = 0 := by
          funext ω
          simp only [X, tsub_eq_zero_of_le (le_of_not_ge ht), NNReal.coe_zero, zero_mul,
            Pi.zero_apply]
        rw [he]
        exact measurable_const
    have hc : ∀ ω, IsCadlagPath (fun t ↦ X t ω) := by
      intro ω
      apply IsContinuousPath.isCadlagPath
      change Continuous (fun t : ℝ≥0 ↦ ((t - a : ℝ≥0) : ℝ) * V ω)
      fun_prop
    have hm := ha.measurable_optional_of_cadlag hc
      (measurableSet_Ioi : MeasurableSet (Ioi (0 : ℝ)))
    convert hm using 1
    ext ⟨t, ω⟩
    change (a < t ∧ ω ∈ A) ↔ 0 < X t ω
    by_cases hω : ω ∈ A
    · simp [X, V, hω, NNReal.coe_pos, tsub_pos_iff_lt]
    · simp [X, V, hω]

end Filtration

variable {E : Type*} [TopologicalSpace E] {F : Filtration ℝ≥0 mΩ}

/-- Strong optional measurability; for real processes this is ordinary optional measurability. -/
def IsStronglyOptional (F : Filtration ℝ≥0 mΩ) (X : ℝ≥0 → Ω → E) : Prop :=
  StronglyMeasurable[F.optional] (Function.uncurry X)

theorem IsStronglyPredictable.isStronglyOptional {X : ℝ≥0 → Ω → E}
    (hX : IsStronglyPredictable F X) : IsStronglyOptional F X :=
  hX.mono F.predictable_le_optional

theorem IsStronglyOptional.isStronglyProgressive {X : ℝ≥0 → Ω → E}
    (hX : IsStronglyOptional F X) : IsStronglyProgressive F X := by
  intro t
  exact (hX.mono F.optional_le_progressive).comp_measurable (F.measurable_inclusion_progressive t)

theorem IsStronglyOptional.stronglyAdapted {X : ℝ≥0 → Ω → E}
    (hX : IsStronglyOptional F X) : StronglyAdapted F X :=
  hX.isStronglyProgressive.stronglyAdapted

theorem Adapted.isStronglyOptional_of_cadlag {X : ℝ≥0 → Ω → ℝ} (ha : Adapted F X)
    (hc : ∀ ω, IsCadlagPath (fun t ↦ X t ω)) : IsStronglyOptional F X :=
  (ha.measurable_optional_of_cadlag hc).stronglyMeasurable

theorem Adapted.exists_optional_indistinguishable_of_usual {P : Measure Ω}
    {X : ℝ≥0 → Ω → ℝ} (ha : Adapted F X) (hF : F.IsUsual P) (hc : HasCadlagPaths X P) :
    ∃ Y : ℝ≥0 → Ω → ℝ, Indistinguishable X Y P ∧ IsStronglyOptional F Y ∧
      ∀ ω, IsCadlagPath (fun t ↦ Y t ω) := by
  have hsa : StronglyAdapted F X := fun t ↦ (ha t).stronglyMeasurable
  obtain ⟨Y, hXY, hY, hcY⟩ := hsa.exists_cadlag_indistinguishable_of_usual hF hc
  exact ⟨Y, hXY, hY.isProgressive.adapted.isStronglyOptional_of_cadlag hcY, hcY⟩

end MeasureTheory
