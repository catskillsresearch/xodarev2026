    ∃ (c : ℝ) (a : ℝ → ℝ)
      (φ : Lp ℝ 2 (trimMeasure (μ := P) (Real.toNNReal T) (bsDriver_meas B))),
      (X : Ω → ℝ) =ᵐ[P] fun ω => c +
        ∑ k ∈ strikes, a k * max ((blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).S T ω - k) 0 +
        itoIntegralCLM (bsDriver_isPreBrownian B) (Real.toNNReal T) (bsDriver_meas B) φ ω

