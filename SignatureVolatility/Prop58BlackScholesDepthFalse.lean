open MeasureTheory ProbabilityTheory Set

namespace SignatureVolatility

/-!
# Counterexample: Black–Scholes does not have completeness depth `0` (Prop. 58 / PDF Prop. 5.5)

The paper's Proposition 58 says that "Black–Scholes has `(N^*_S, K) = (0, 1)`". Under
Definition 55, `N^*_S = 0` would mean
`closure span{⟨e_∅, Ŵ_T⟩} ∩ L²(ℱ^S_T) = L²(ℱ^S_T)`. Since `⟨e_∅, Ŵ_T⟩ = 1`, that says
`L²(ℱ^S_T)` consists of constants only.

For the Black–Scholes market (`ℓ = σ₀ e_∅`, `d = 1`), Theorem A's price is, at every `ω`,
`S_T = s₀ exp(σ₀ W_T − σ₀² T / 2)`. So `W_T` is a measurable function of `S_T`, and the events
`{W_T ∈ (k, k+1]}` (for `k : ℕ`) are disjoint, belong to `ℱ^S_T`, and have positive Gaussian
probability. Therefore `L²(ℱ^S_T)` is infinite-dimensional, and
`completenessDepth_eq_top_of_not_finiteDimensional` gives `N^*_S = ∞`, not `0`
(`blackScholes_completenessDepth_eq_top`, `not_prop58_blackScholes_depth_zero`).

The same argument shows that the paper's Definition 55 gives infinite depth for every model whose
price σ-algebra is not generated by finitely many atoms. The equivalence "complete ⇔ `N^*_S < ∞`"
of Theorem 56 / Theorem C would then say that no such market is complete.
-/

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- `⟨σ₀ e_∅, a⟩ = σ₀ · a_∅`. -/
lemma dualPairing_smul_basisWord_nil {d : ℕ} (σ₀ : ℝ) (a : ExtTensorAlgebra d) :
    dualPairing (σ₀ • ExtTensorAlgebra.basisWord ([] : Word d)) a = σ₀ * a.coeff [] := by
  have hcoeff : ∀ I : Word d,
      (σ₀ • ExtTensorAlgebra.basisWord ([] : Word d)).coeff I = if I = [] then σ₀ else 0 := by
    intro I
    change σ₀ * (if I = [] then (1 : ℝ) else 0) = _
    split_ifs <;> simp
  have hlev : ∀ n : ℕ, (σ₀ • ExtTensorAlgebra.basisWord ([] : Word d)).levelInner a n =
      if n = 0 then σ₀ * a.coeff [] else 0 := by
    intro n
    unfold ExtTensorAlgebra.levelInner
    split_ifs with hn
    · subst hn
      rw [Finset.sum_eq_single ([] : Word d)]
      · rw [hcoeff]; simp
      · intro I hI hne; rw [hcoeff, ite_eq_right_iff.mpr (fun h => absurd h hne), zero_mul]
      · intro h; exact absurd (wordsOfLength.mem.mpr (rfl : ([] : Word d).length = 0)) h
    · refine Finset.sum_eq_zero fun I hI => ?_
      have hlen : I.length = n := wordsOfLength.mem.mp hI
      have hne : I ≠ [] := fun h => hn (by rw [← hlen, h, List.length_nil])
      rw [hcoeff, ite_eq_right_iff.mpr (fun h => absurd h hne), zero_mul]
  unfold dualPairing
  simp_rw [hlev]
  exact tsum_ite_eq 0 _

variable (T s₀ σ₀ : ℝ) (hT : 0 < T) (hs₀ : 0 < s₀) (hσ₀ : σ₀ ≠ 0)

/-- The Black–Scholes volatility is the constant `σ₀`. -/
lemma sigma_blackScholes (B : MultiBrownian Ω P 1) :
    SignatureVolatilityModel.sigma (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) (paperSetup B hT) =
      fun _ _ => σ₀ := by
  funext t ω
  unfold SignatureVolatilityModel.sigma
  change dualPairing (σ₀ • ExtTensorAlgebra.basisWord ([] : Word 2)) _ = σ₀
  have h := dualPairing_smul_basisWord_nil σ₀ ((paperSetup B hT).W_hat t ω)
  have h1 : ((paperSetup B hT).W_hat t ω).coeff [] = 1 := (paperSetup B hT).sig2_empty 0 t ω
  rw [h1, mul_one] at h
  exact h

/-- The Black–Scholes market on a one-dimensional Brownian driver. Here H3 holds trivially,
because the volatility is constant. -/
def blackScholesMarket (B : MultiBrownian Ω P 1) : MarketData Ω P where
  M := blackScholesModel T s₀ σ₀ hT hs₀ hσ₀
  B := B
  h3 := by
    change HypH3 P T (SignatureVolatilityModel.sigma (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀)
      (paperSetup B hT))
    rw [sigma_blackScholes]
    intro _ _
    exact integrable_const _

/-- The Black–Scholes price at maturity is geometric Brownian motion, at every `ω`. -/
lemma blackScholesMarket_S_T (B : MultiBrownian Ω P 1) (ω : Ω) :
    (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).S T ω =
      s₀ * Real.exp (σ₀ * B.Wnn (Real.toNNReal T) ω (kitDriver Nat.one_pos) -
        (1 / 2 : ℝ) * (σ₀ ^ 2 * T)) := by
  have h := (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).sol.doleans_repr T ω
  have hσ : SignatureVolatilityModel.sigma (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).M
      (paperSetup (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).B
        (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).M.hT) = fun _ _ => σ₀ :=
    sigma_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B
  rw [hσ] at h
  have h1 := kitItoInt_const B Nat.one_pos σ₀ hT.le ω
  have h2 := kitQuadVar_const B Nat.one_pos σ₀ hT.le ω
  change _ = s₀ * Real.exp (kitItoInt B (fun _ _ => σ₀) T ω -
    (1 / 2 : ℝ) * kitQuadVar B (fun _ _ => σ₀) T ω) at h
  rw [h1, h2] at h
  exact h

/-- `W_T` is `ℱ^S_T`-measurable in the Black–Scholes market. -/
lemma blackScholesMarket_measurable_W_T (B : MultiBrownian Ω P 1) :
    Measurable[(blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).F_ST]
      (fun ω => B.Wnn (Real.toNNReal T) ω (kitDriver Nat.one_pos)) := by
  set mkt := blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B
  have hS : Measurable[mkt.F_ST] (mkt.S T) := mkt.measurable_S hT.le le_rfl
  have heq : (fun ω => B.Wnn (Real.toNNReal T) ω (kitDriver Nat.one_pos)) =
      fun ω => (Real.log (mkt.S T ω / s₀) + (1 / 2 : ℝ) * (σ₀ ^ 2 * T)) / σ₀ := by
    funext ω
    rw [blackScholesMarket_S_T, mul_div_cancel_left₀ _ hs₀.ne', Real.log_exp]
    field_simp
    ring
  rw [heq]
  exact (((hS.div_const s₀).log).add_const _).div_const σ₀

/-- `L²(ℱ^S_T)` of the Black–Scholes market is infinite-dimensional. -/
theorem blackScholesMarket_not_finiteDimensional_L2S (B : MultiBrownian Ω P 1) :
    ¬ FiniteDimensional ℝ (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).L2S := by
  set mkt := blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B
  set W : Ω → ℝ := fun ω => B.Wnn (Real.toNNReal T) ω (kitDriver Nat.one_pos) with hW
  have hWm : Measurable[mkt.F_ST] W := blackScholesMarket_measurable_W_T T s₀ σ₀ hT hs₀ hσ₀ B
  let A : ℕ → Set Ω := fun k => W ⁻¹' Ioc (k : ℝ) (k + 1)
  have hA : ∀ k, MeasurableSet[mkt.F_ST] (A k) := fun k => hWm measurableSet_Ioc
  have hlaw := (B.isBrownian (kitDriver Nat.one_pos)).toIsPreBrownianReal.hasLaw_eval
    (Real.toNNReal T)
  have hpos : ∀ k, P (A k) ≠ 0 := by
    intro k hk
    have hmeasW : Measurable W := B.Wnn_meas _ _
    have hmap : P.map W (Ioc (k : ℝ) (k + 1)) = 0 := by
      rw [Measure.map_apply hmeasW measurableSet_Ioc]; exact hk
    rw [show P.map W = gaussianReal 0 (Real.toNNReal T) from hlaw.map_eq] at hmap
    have hv : Real.toNNReal T ≠ 0 := by
      rw [ne_eq, Real.toNNReal_eq_zero, not_le]; exact hT
    have hvol := gaussianReal_absolutelyContinuous' 0 hv hmap
    rw [Real.volume_Ioc] at hvol
    norm_num at hvol
  have hdisj : Pairwise (Function.onFun Disjoint A) := by
    intro i j hij
    refine Set.disjoint_left.mpr fun x hxi hxj => ?_
    simp only [A, Set.mem_preimage, Set.mem_Ioc] at hxi hxj
    rcases lt_or_gt_of_ne hij with h | h
    · have : ((i : ℝ) + 1) ≤ j := by exact_mod_cast h
      linarith [hxi.2, hxj.1]
    · have : ((j : ℝ) + 1) ≤ i := by exact_mod_cast h
      linarith [hxj.2, hxi.1]
  exact not_finiteDimensional_lpMeas_of_disjoint mkt.F_ST_le A hA hpos hdisj

/-- **Black–Scholes has infinite completeness depth** under the paper's Definition 55. -/
theorem blackScholes_completenessDepth_eq_top (B : MultiBrownian Ω P 1) :
    (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).completenessDepth = ⊤ :=
  MarketData.completenessDepth_eq_top_of_not_finiteDimensional _
    (blackScholesMarket_not_finiteDimensional_L2S T s₀ σ₀ hT hs₀ hσ₀ B)

/-- **Counterexample to Proposition 58 (PDF Prop. 5.5).** Black–Scholes does *not* have
`N^*_S = 0`. -/
theorem not_prop58_blackScholes_depth_zero (B : MultiBrownian Ω P 1) :
    (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).completenessDepth ≠ 0 := by
  rw [blackScholes_completenessDepth_eq_top]; simp

/-- In the Black–Scholes market no finite depth `N` makes the closed signature span restricted to
the price filtration dense in `L²(ℱ^S_T)`. This is the right-hand side of Theorem C /
Theorem 56. -/
theorem blackScholes_no_finite_depth (B : MultiBrownian Ω P 1) (N : ℕ) :
    ((blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).sigSpan N).topologicalClosure ≠
      (blackScholesMarket T s₀ σ₀ hT hs₀ hσ₀ B).L2S :=
  MarketData.sigSpan_ne_L2S_of_not_finiteDimensional _
    (blackScholesMarket_not_finiteDimensional_L2S T s₀ σ₀ hT hs₀ hσ₀ B) N

end SignatureVolatility
