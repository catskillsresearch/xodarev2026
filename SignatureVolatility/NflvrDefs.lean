module

public import Mathlib

@[expose] public section

set_option warn.classDefReducibility false

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal

noncomputable section

namespace SignatureVolatility

/-- Predictable σ-algebra on `[0, T] × Ω`, generated by the left-closed rectangles
`(a, b] × A` with `A` measurable for `σAlg a`. -/
def predSigma {Ω : Type*} [MeasurableSpace Ω] (σAlg : ℝ → MeasurableSpace Ω) (T : ℝ) :
    MeasurableSpace (ℝ × Ω) :=
  MeasurableSpace.generateFrom
    {S | ∃ (a b : ℝ) (A : Set Ω), 0 ≤ a ∧ a ≤ b ∧ b ≤ T ∧ MeasurableSet[σAlg a] A ∧
      S = Ioc a b ×ˢ A}

/-- A process is predictable on `[0, T]` if it is jointly measurable for `predSigma σAlg T`. -/
def IsPredictableProcess {Ω : Type*} [MeasurableSpace Ω] (σAlg : ℝ → MeasurableSpace Ω)
    (T : ℝ) (H : ℝ → Ω → ℝ) : Prop :=
  Measurable[predSigma σAlg T] (Function.uncurry H)

/-- **S-admissible strategy** (paper Def. 2.17): a predictable `H` with
`∫_0^T H_s² S_s² σ_s² ds < ∞` almost surely. No lower bound on wealth. -/
def SAdmissible {Ω : Type*} [MeasurableSpace Ω] (σAlg : ℝ → MeasurableSpace Ω)
    (P : Measure Ω) (S σ : ℝ → Ω → ℝ) (T : ℝ) (H : ℝ → Ω → ℝ) : Prop :=
  IsPredictableProcess σAlg T H ∧
  (∀ᵐ ω ∂P, IntegrableOn (fun s => (H s ω * S s ω * σ s ω) ^ 2) (Icc 0 T) volume)

/-- Uniform-in-time lower bound (Delbaen–Schachermayer admissibility): there is `a ≥ 0` such
that almost every path of `V` stays at least `-a` on `[0, T]`. -/
def IsUniformlyBoundedBelow {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (V : ℝ → Ω → ℝ) (T : ℝ) (a : ℝ) : Prop :=
  0 ≤ a ∧ ∀ᵐ ω ∂P, ∀ t ∈ Icc 0 T, -a ≤ V t ω

/-- Terminal-only lower bound: `V_T ≥ -a` a.s., with no restriction on earlier times. -/
def IsTerminalBoundedBelow {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (V : ℝ → Ω → ℝ) (T : ℝ) (a : ℝ) : Prop :=
  0 ≤ a ∧ ∀ᵐ ω ∂P, -a ≤ V T ω

/-- Left-point Riemann sums of `K` against `B` on the uniform partition of `[0, t]` into
`n + 1` parts. -/
def itoRiemannSum {Ω : Type*} (K B : ℝ → Ω → ℝ) (t : ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∑ k : Fin (n + 1),
    K (k * t / (n + 1 : ℝ)) ω *
      (B ((k + 1 : ℕ) * t / (n + 1 : ℝ)) ω - B (k * t / (n + 1 : ℝ)) ω)

/-- `V` is an Itô integral of `K` against `B` on `[0, T]`: `V_0 = 0`, almost every path is
continuous, and the left-point Riemann sums of `K` against `B` converge to `V_t` in
probability for every `t ∈ [0, T]`. -/
def IsItoIntegral {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (B K V : ℝ → Ω → ℝ) (T : ℝ) : Prop :=
  (∀ ω, V 0 ω = 0) ∧
  (∀ᵐ ω ∂P, ContinuousOn (fun t => V t ω) (Icc 0 T)) ∧
  ∀ t ∈ Icc 0 T, TendstoInMeasure P (fun n => itoRiemannSum K B t n) atTop (V t)

/-- Terminal gains of all `S`-admissible strategies, with no lower bound on wealth
(the paper's literal cone: Def. 2.17 together with Def. 4.3). -/
def LiteralGains {Ω : Type*} [MeasurableSpace Ω] (σAlg : ℝ → MeasurableSpace Ω)
    (P : Measure Ω) (B S σ : ℝ → Ω → ℝ) (T : ℝ) : Set (Ω → ℝ) :=
  {G | ∃ (H V : ℝ → Ω → ℝ),
    SAdmissible σAlg P S σ T H ∧
    IsItoIntegral P B (fun t ω => H t ω * S t ω * σ t ω) V T ∧
    G = V T}

/-- Terminal gains of `S`-admissible strategies whose terminal wealth only is bounded
below (the wording in Section 4.6, without a uniform-in-time bound). -/
def TerminalBoundedBelowGains {Ω : Type*} [MeasurableSpace Ω]
    (σAlg : ℝ → MeasurableSpace Ω) (P : Measure Ω) (B S σ : ℝ → Ω → ℝ) (T : ℝ) :
    Set (Ω → ℝ) :=
  {G | ∃ (H V : ℝ → Ω → ℝ) (a : ℝ),
    SAdmissible σAlg P S σ T H ∧
    IsTerminalBoundedBelow P V T a ∧
    IsItoIntegral P B (fun t ω => H t ω * S t ω * σ t ω) V T ∧
    G = V T}

/-- Terminal gains of uniformly bounded-below admissible strategies: `V_T` for some
`S`-admissible `H` whose Itô integral `V = ∫ (H S σ) dB` stays at least `-a` on `[0, T]`. -/
def BoundedBelowGains {Ω : Type*} [MeasurableSpace Ω] (σAlg : ℝ → MeasurableSpace Ω)
    (P : Measure Ω) (B S σ : ℝ → Ω → ℝ) (T : ℝ) : Set (Ω → ℝ) :=
  {G | ∃ (H V : ℝ → Ω → ℝ) (a : ℝ),
    SAdmissible σAlg P S σ T H ∧
    IsUniformlyBoundedBelow P V T a ∧
    IsItoIntegral P B (fun t ω => H t ω * S t ω * σ t ω) V T ∧
    G = V T}

/-- The Delbaen–Schachermayer cone `(K - L⁰₊) ∩ L∞`. -/
def nflvrCone {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (K : Set (Ω → ℝ)) :
    Set (Ω → ℝ) :=
  {g | MemLp g ∞ P ∧ ∃ V ∈ K, ∃ u : Ω → ℝ, (∀ᵐ ω ∂P, 0 ≤ u ω) ∧
    g =ᵐ[P] fun ω => V ω - u ω}

/-- `f` lies in the `σ(L∞, L¹)` closure of `C`: every basic weak-* neighbourhood of `f`
meets `C`. -/
def InWeakStarClosure {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (C : Set (Ω → ℝ)) (f : Ω → ℝ) : Prop :=
  MemLp f ∞ P ∧
  ∀ ε > 0, ∀ (gs : Finset (Ω → ℝ)),
    (∀ g ∈ gs, Integrable g P) →
    ∃ h ∈ C, MemLp h ∞ P ∧ ∀ g ∈ gs,
      |∫ ω, (h ω - f ω) * g ω ∂P| < ε

/-- **NFLVR** in the Delbaen–Schachermayer sense: the `σ(L∞, L¹)` closure of the cone
`(K - L⁰₊) ∩ L∞` meets the nonnegative part of `L∞` only at `0`. -/
def SatisfiesNFLVR_DS {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (K : Set (Ω → ℝ)) : Prop :=
  ∀ f : Ω → ℝ, (∀ᵐ ω ∂P, 0 ≤ f ω) → InWeakStarClosure P (nflvrCone P K) f → f =ᵐ[P] 0

end SignatureVolatility
