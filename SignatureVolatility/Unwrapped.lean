/-!
# Unwrapped statements of the compared theorems

Each `X_unwrapped` restates a compared theorem `X` using only definitions built directly from the
Brownian driver `B`: the signature `paperSig2 B 0 t` of `(t, W_t)`, its filtration, the Itô
integral `kitItoInt B` and quadratic variation `kitQuadVar B`. The bundled structures
`ProlongedBrownianSetup` and `ItoCalculusKit` do not occur in these statements. Each proof applies
the wrapped theorem `X`; the unwrapped definitions agree with the wrapped ones definitionally, or,
for the price `S`, pointwise (by the Doléans representation of Theorem A).
-/

open MeasureTheory Filter Topology Set
open scoped RealInnerProductSpace

noncomputable section

namespace SignatureVolatility

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- The signature filtration `ℱ^Ŵ_t = σ(⟨e_I, Ŵ_u⟩ : 0 ≤ u ≤ t, I a word)` generated by the
coordinates of the signature `Ŵ_u = paperSig2 B 0 u` of the time-extended path `(u, W_u)`. -/
def sigFiltration {d : ℕ} (B : MultiBrownian Ω P d) : IndexedFiltration Ω :=
  generatedFiltration (fun u I ω => (paperSig2 B 0 u ω).coeff I) (measurable_paperSig2_coeff B 0)

/-- The signature volatility `σ_t = ⟨ℓ, Ŵ_t⟩` of the model `M` driven by `B`. -/
def sigVol (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d) (t : ℝ) (ω : Ω) : ℝ :=
  dualPairing M.ℓ (paperSig2 B 0 t ω)

/-- Finite signature transform on `[0, T]` for the initial datum `u₀`:
`𝔼 exp⟨u₀, Ŵ_t⟩ < ∞` for every `t ∈ [0, T]`. -/
def SigTransformFinite {d : ℕ} (B : MultiBrownian Ω P d) (T : ℝ)
    (u₀ : ExtTensorAlgebra (d + 1)) : Prop :=
  ∀ t ∈ Icc 0 T, Integrable (fun ω => Real.exp (dualPairing u₀ (paperSig2 B 0 t ω))) P

/-- `S` is a signature-price solution of `dS = S σ dW`, `S_0 = s₀` (paper Theorem A): it is
measurable, adapted to the signature filtration, strictly positive, has almost surely continuous
paths on `[0, T]`, equals the Doléans exponential `s₀ exp(∫σ dW - ½ ∫σ² dt)` almost surely at
each `t ∈ [0, T]`, solves the SDE a.s. at each `t ∈ [0, T]`, has a square-integrable running
supremum, and is a martingale on `[0, T]`. -/
structure IsSignaturePrice (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (S : ℝ → Ω → ℝ) : Prop where
  S_zero : ∀ ω, S 0 ω = M.s₀
  S_meas : ∀ t, Measurable (S t)
  S_adapted : ∀ t (s : {s : ℝ // 0 ≤ s ∧ s ≤ t}), Measurable[(sigFiltration B).σAlg t] (S s.1)
  S_strictly_pos : ∀ t ω, 0 < S t ω
  doleans_repr : (∀ᵐ ω ∂P, ContinuousOn (fun t => S t ω) (Icc 0 M.T)) ∧
    ∀ t ∈ Icc 0 M.T, S t =ᵐ[P] fun ω =>
      M.s₀ * Real.exp (kitItoInt B (sigVol M B) t ω -
        (1 / 2 : ℝ) * kitQuadVar B (sigVol M B) t ω)
  solves_sde : ∀ t ∈ Icc 0 M.T, ∀ᵐ ω ∂P,
    S t ω = M.s₀ + kitItoInt B (fun s ω' => S s ω' * sigVol M B s ω') t ω
  sup_l2_integrable : ∃ S_sup : Ω → ℝ, Measurable S_sup ∧
    (∀ᵐ ω ∂P, ∀ t ∈ Icc 0 M.T, |S t ω| ≤ S_sup ω) ∧ Integrable (fun ω => (S_sup ω) ^ 2) P
  is_martingale : ∀ ⦃s t : ℝ⦄, 0 ≤ s → s ≤ t → t ≤ M.T →
    Integrable (S t) P ∧ P[S t | (sigFiltration B).σAlg s] =ᵐ[P] S s

lemma isSignaturePrice_of_solution {M : SignatureVolatilityModel} {B : MultiBrownian Ω P M.d}
    (sol : SignaturePriceSolution M (paperSetup B M.hT) (itoCalculusKit_of_mathfin B M.hT))
    (hcont : ∀ᵐ ω ∂P, ContinuousOn (fun t => sol.S t ω) (Icc 0 M.T)) :
    IsSignaturePrice M B sol.S :=
  ⟨sol.S_zero, sol.S_meas, sol.S_adapted, sol.S_strictly_pos,
    ⟨hcont, fun t _ => Filter.Eventually.of_forall fun ω => sol.doleans_repr t ω⟩,
    sol.solves_sde, sol.sup_l2_integrable, sol.is_martingale⟩

lemma measurable_sigVol (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d) (t : ℝ) :
    Measurable (sigVol M B t) := by
  change Measurable fun ω => ∑' n : ℕ, M.ℓ.levelInner (paperSig2 B 0 t ω) n
  exact Measurable.tsum fun n => measurable_levelInner_paperSig2 B M.ℓ t n

lemma sigPriceCont_ae_eq_sol {M : SignatureVolatilityModel} {B : MultiBrownian Ω P M.d}
    (h3 : HypH3 P M.T (sigVol M B))
    (sol : SignaturePriceSolution M (paperSetup B M.hT) (itoCalculusKit_of_mathfin B M.hT))
    {t : ℝ} (ht : t ∈ Icc 0 M.T) :
    sigPriceCont M B t =ᵐ[P] sol.S t := by
  filter_upwards [sigPriceCont_ae_eq_doleans M B h3 ht] with ω h
  rw [h, sol.doleans_repr t ω]
  rfl

lemma closure_Icc_inter_rat {a b : ℝ} (hab : a < b) :
    closure (Icc a b ∩ Set.range ((↑) : ℚ → ℝ)) = Icc a b := by
  refine subset_antisymm (closure_minimal inter_subset_left isClosed_Icc) ?_
  intro x hx
  refine Metric.mem_closure_iff.2 fun ε hε => ?_
  have hopen : max a (x - ε) < min b (x + ε) := by
    rcases le_total a (x - ε) with h1 | h1 <;>
      rcases le_total (x + ε) b with h2 | h2
    · rw [max_eq_right h1, min_eq_right h2]; linarith
    · rw [max_eq_right h1, min_eq_left h2]; linarith [hx.2, hε]
    · rw [max_eq_left h1, min_eq_right h2]; linarith [hx.1, hε]
    · rw [max_eq_left h1, min_eq_left h2]; linarith [hab]
  obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn hopen
  have hqI : (q : ℝ) ∈ Icc a b :=
    ⟨(le_max_left a (x - ε)).trans hq1.le, hq2.le.trans (min_le_left b (x + ε))⟩
  have hd : dist (q : ℝ) x < ε := by
    have hxl : x - ε ≤ max a (x - ε) := le_max_right _ _
    have hxr : min b (x + ε) ≤ x + ε := min_le_right _ _
    rw [Real.dist_eq, abs_sub_lt_iff]
    exact ⟨by linarith, by linarith⟩
  exact ⟨(q : ℝ), ⟨hqI, ⟨q, rfl⟩⟩, dist_comm (q : ℝ) x ▸ hd⟩

set_option maxHeartbeats 800000

/-- The continuous Doléans exponential is a signature-price solution in the unwrapped sense. -/
lemma isSignaturePrice_sigPriceCont (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (h3 : HypH3 P M.T (sigVol M B)) :
    IsSignaturePrice M B (sigPriceCont M B) := by
  obtain ⟨sol, _huniq⟩ := theorem_A M B h3
  have hae : ∀ t ∈ Icc 0 M.T, sigPriceCont M B t =ᵐ[P] sol.S t :=
    fun t ht => sigPriceCont_ae_eq_sol h3 sol ht
  refine ⟨sigPriceCont_zero M B, measurable_sigPriceCont M B, ?adapt,
    sigPriceCont_strictly_pos M B, ?doleans, ?sde, ?sup, ?mart⟩
  · intro t s
    rw [sigFiltration, sigFiltration_eq_pathFiltration B t]
    exact sigPriceCont_adapted_path M B t s
  · exact ⟨ae_continuousOn_sigPriceCont M B, fun t ht =>
      sigPriceCont_ae_eq_doleans M B h3 ht⟩
  · intro t ht
    have hsol := sol.solves_sde t ht
    have hcongr :=
      kitItoInt_congr_ae (H := fun s ω' => sigPriceCont M B s ω' * sigVol M B s ω')
        (H' := fun s ω' => sol.S s ω' * sigVol M B s ω') B ht.1
        (fun u => (measurable_sigPriceCont M B u).mul (measurable_sigVol M B u))
        (fun u => (sol.S_meas u).mul (measurable_sigVol M B u))
        (fun u hu => (hae u ⟨hu.1, hu.2.trans ht.2⟩).mul (EventuallyEq.refl _ _))
    filter_upwards [hae t ht, hsol, hcongr] with ω h1 h2 h3
    rw [h1, h2, h3]
    rfl
  · obtain ⟨S_sup, hSm, hSbd, hSint⟩ := sol.sup_l2_integrable
    refine ⟨S_sup, hSm, ?_, hSint⟩
    have hq : ∀ q : ℚ, ∀ᵐ ω ∂P,
        (q : ℝ) ∈ Icc 0 M.T → sigPriceCont M B (q : ℝ) ω = sol.S (q : ℝ) ω := by
      intro q
      by_cases hqI : (q : ℝ) ∈ Icc 0 M.T
      · filter_upwards [hae _ hqI] with ω hω _; exact hω
      · exact Filter.Eventually.of_forall fun _ h' => (hqI h').elim
    have hq' : ∀ᵐ ω ∂P, ∀ q : ℚ,
        (q : ℝ) ∈ Icc 0 M.T → sigPriceCont M B (q : ℝ) ω = sol.S (q : ℝ) ω := by
      rw [ae_all_iff]; exact hq
    filter_upwards [hSbd, ae_continuousOn_sigPriceCont M B, hq'] with ω hbd hcont hqω
    intro t ht
    have hcl := closure_Icc_inter_rat (a := (0 : ℝ)) (b := M.T) M.hT
    have htcl : t ∈ closure (Icc 0 M.T ∩ Set.range ((↑) : ℚ → ℝ)) := by
      rw [hcl]; exact ht
    obtain ⟨u, huD, hut⟩ := mem_closure_iff_seq_limit.mp htcl
    have hbound : ∀ n, |sigPriceCont M B (u n) ω| ≤ S_sup ω := by
      intro n
      have huI : u n ∈ Icc 0 M.T := (huD n).1
      obtain ⟨q, hq⟩ := (huD n).2
      have hqI : (q : ℝ) ∈ Icc 0 M.T := hq.symm ▸ huI
      rw [← hq, hqω q hqI]
      exact hbd _ hqI
    have hut' : Filter.Tendsto u atTop (nhdsWithin t (Icc 0 M.T)) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _
        hut (Filter.Eventually.of_forall fun n => (huD n).1)
    have htu : Filter.Tendsto (fun n => sigPriceCont M B (u n) ω) atTop
        (nhds (sigPriceCont M B t ω)) :=
      (hcont.continuousWithinAt ht).tendsto.comp hut'
    have htend : Filter.Tendsto (fun n => |sigPriceCont M B (u n) ω|) atTop
        (nhds |sigPriceCont M B t ω|) :=
      (continuous_abs.tendsto (sigPriceCont M B t ω)).comp htu
    exact le_of_tendsto htend (Filter.Eventually.of_forall hbound)
  · intro s t hs hst htT
    have hsol := sol.is_martingale hs hst htT
    have htI : t ∈ Icc 0 M.T := ⟨hs.trans hst, htT⟩
    have hsI : s ∈ Icc 0 M.T := ⟨hs, hst.trans htT⟩
    refine ⟨hsol.1.congr (hae t htI).symm, ?_⟩
    filter_upwards [condExp_congr_ae (m := (sigFiltration B).σAlg s) (hae t htI),
      hsol.2, hae s hsI] with ω h1 h2 h3
    exact h1.trans (h2.trans h3.symm)

/-- **Paper Theorem A (unwrapped).** Under the analytic H3 hypothesis there is a signature-price
solution `S`, unique (up to modification on `[0, T]`) among adapted strong solutions in
`KitStrongSolutionClass`. -/
theorem theorem_A_unwrapped (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (h3 : HypH3 P M.T (sigVol M B)) :
    ∃ S : ℝ → Ω → ℝ, IsSignaturePrice M B S ∧
      ∀ S_tilde : ℝ → Ω → ℝ,
        (∀ t ∈ Icc 0 M.T, Measurable[(sigFiltration B).σAlg t] (S_tilde t)) →
        KitStrongSolutionClass P M.T (sigVol M B) S_tilde →
        (∀ t ∈ Icc 0 M.T, ∀ᵐ ω ∂P,
          S_tilde t ω = M.s₀ + kitItoInt B (fun s ω' => S_tilde s ω' * sigVol M B s ω') t ω) →
        ∀ t ∈ Icc 0 M.T, ∀ᵐ ω ∂P, S_tilde t ω = S t ω := by
  obtain ⟨sol, huniq⟩ := theorem_A M B h3
  refine ⟨sigPriceCont M B, isSignaturePrice_sigPriceCont M B h3, ?_⟩
  intro S_tilde hadapt hclass hsde t ht
  filter_upwards [huniq S_tilde hadapt hclass hsde t ht,
    sigPriceCont_ae_eq_sol h3 sol ht] with ω h1 h2
  exact h1.trans h2.symm

/-- **Paper Theorem B, `→` direction (unwrapped).** The signature price is a martingale, the
market satisfies Delbaen–Schachermayer NFLVR for uniformly bounded-below admissible gains,
every signature coordinate is a special semimartingale, and a classical Riccati solution
exists whenever the affine transform formula holds. -/
theorem theorem_B_mp_unwrapped (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (h3 : HypH3 P M.T (sigVol M B)) :
    ∃ S : ℝ → Ω → ℝ, IsSignaturePrice M B S ∧
      (∀ ⦃s t : ℝ⦄, 0 ≤ s → s ≤ t → t ≤ M.T →
        Integrable (S t) P ∧ P[S t | (sigFiltration B).σAlg s] =ᵐ[P] S s) ∧
      SatisfiesNFLVR_DS P
        (BoundedBelowGains (sigFiltration B).σAlg P
          (fun t ω => B.W t ω (kitDriver M.hd))
          S (sigVol M B) M.T) ∧
      (∀ I : Word (M.d + 1), Nonempty (IsSpecialSemimartingale P (sigFiltration B) M.T
        (fun t ω => (paperSig2 B 0 t ω).coeff I))) ∧
      (∀ u₀ : ExtTensorAlgebra.FreeTensorAlgebra (M.d + 1),
        SigTransformFinite B M.T u₀.1 →
        (∃ rSol : ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1,
          ∀ t ∈ Icc 0 M.T,
            Integrable (fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω))) P ∧
            P[fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω)) |
              (sigFiltration B).σAlg t] =ᵐ[P]
              fun ω => Real.exp (dualPairing (rSol.ψ (M.T - t)) (paperSig2 B 0 t ω))) →
        Nonempty (ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1)) := by
  obtain ⟨sol, _hmart, hnflvr, hsemi, hric⟩ := theorem_B_mp M B h3
  exact ⟨sigPriceCont M B, isSignaturePrice_sigPriceCont M B h3,
    (isSignaturePrice_sigPriceCont M B h3).is_martingale, hnflvr, hsemi, hric⟩

/-- **Refutation of the affine/Riccati `←` direction (unwrapped).** -/
theorem not_affine_riccati_duality_mpr_unwrapped (M : SignatureVolatilityModel)
    (B : MultiBrownian Ω P M.d) :
    ¬ ∀ u₀ : ExtTensorAlgebra.FreeTensorAlgebra (M.d + 1),
      SigTransformFinite B M.T u₀.1 →
      Nonempty (ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1) →
      ∃ sol : ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1,
        ∀ t ∈ Icc 0 M.T,
          Integrable (fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω))) P ∧
          P[fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω)) |
            (sigFiltration B).σAlg t] =ᵐ[P]
            fun ω => Real.exp (dualPairing (sol.ψ (M.T - t)) (paperSig2 B 0 t ω)) :=
  not_affine_riccati_duality_mpr M B

/-- **Refutation of the affine/Riccati iff (unwrapped).** -/
theorem not_affine_riccati_duality_unwrapped (M : SignatureVolatilityModel)
    (B : MultiBrownian Ω P M.d) :
    ¬ ∀ u₀ : ExtTensorAlgebra.FreeTensorAlgebra (M.d + 1),
      SigTransformFinite B M.T u₀.1 →
      ((∃ sol : ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1,
          ∀ t ∈ Icc 0 M.T,
            Integrable (fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω))) P ∧
            P[fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω)) |
              (sigFiltration B).σAlg t] =ᵐ[P]
              fun ω => Real.exp (dualPairing (sol.ψ (M.T - t)) (paperSig2 B 0 t ω))) ↔
        Nonempty (ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1)) :=
  not_affine_riccati_duality M B

/-- **Refutation of the Theorem B `←` direction (unwrapped).** -/
theorem not_theorem_B_mpr_unwrapped (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (h3 : HypH3 P M.T (sigVol M B)) :
    ¬ ∀ u₀ : ExtTensorAlgebra.FreeTensorAlgebra (M.d + 1),
      SigTransformFinite B M.T u₀.1 →
      Nonempty (ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1) →
      ∃ rSol : ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1,
        ∀ t ∈ Icc 0 M.T,
          Integrable (fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω))) P ∧
          P[fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω)) |
            (sigFiltration B).σAlg t] =ᵐ[P]
            fun ω => Real.exp (dualPairing (rSol.ψ (M.T - t)) (paperSig2 B 0 t ω)) :=
  not_theorem_B_mpr M B h3

/-- **Refutation of Theorem B as stated (unwrapped).** -/
theorem not_theorem_B_unwrapped (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d)
    (h3 : HypH3 P M.T (sigVol M B)) :
    ¬ ∃ S : ℝ → Ω → ℝ, IsSignaturePrice M B S ∧
      (∀ ⦃s t : ℝ⦄, 0 ≤ s → s ≤ t → t ≤ M.T →
        Integrable (S t) P ∧ P[S t | (sigFiltration B).σAlg s] =ᵐ[P] S s) ∧
      SatisfiesNFLVR_DS P
        (BoundedBelowGains (sigFiltration B).σAlg P
          (fun t ω => B.W t ω (kitDriver M.hd))
          S (sigVol M B) M.T) ∧
      (∀ I : Word (M.d + 1), Nonempty (IsSpecialSemimartingale P (sigFiltration B) M.T
        (fun t ω => (paperSig2 B 0 t ω).coeff I))) ∧
      (∀ u₀ : ExtTensorAlgebra.FreeTensorAlgebra (M.d + 1),
        SigTransformFinite B M.T u₀.1 →
        ((∃ rSol : ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1,
          ∀ t ∈ Icc 0 M.T,
            Integrable (fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω))) P ∧
            P[fun ω => Real.exp (dualPairing u₀.1 (paperSig2 B 0 M.T ω)) |
              (sigFiltration B).σAlg t] =ᵐ[P]
              fun ω => Real.exp (dualPairing (rSol.ψ (M.T - t)) (paperSig2 B 0 t ω))) ↔
        Nonempty (ClassicalRiccatiSolution M.w M.T riccatiOp u₀.1))) := by
  rintro ⟨S, hS, hmart, hnflvr, hsemi, hiff⟩
  exact not_affine_riccati_duality M B hiff

/-- The signature price `S_t = s₀ exp(∫_0^t σ dW - ½ ∫_0^t σ² ds)` (the Doléans exponential of
Theorem A), with the Itô integral `kitItoInt B` and quadratic variation `kitQuadVar B`. -/
def sigPrice (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d) (t : ℝ) (ω : Ω) : ℝ :=
  M.s₀ * Real.exp (kitItoInt B (sigVol M B) t ω - (1 / 2 : ℝ) * kitQuadVar B (sigVol M B) t ω)

lemma sigPrice_meas (M : SignatureVolatilityModel) (B : MultiBrownian Ω P M.d) (t : ℝ) :
    Measurable (sigPrice M B t) :=
  measurable_const.mul ((kitItoInt_meas B _ t).sub
    (measurable_const.mul (kitQuadVar_meas B _ t))).exp

/-- Market data for Theorems C–D (unwrapped): the model, its Brownian driver, and the analytic
H3 hypothesis of Theorem A. -/
structure Market (Ω : Type*) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] where
  M : SignatureVolatilityModel
  B : MultiBrownian Ω P M.d
  h3 : HypH3 P M.T (sigVol M B)

namespace Market

/-- The signature price `S = sigPrice M B` of the market. -/
def S (mkt : Market Ω P) : ℝ → Ω → ℝ := sigPrice mkt.M mkt.B

/-- The price filtration `ℱ^S_t = σ(S_u : 0 ≤ u ≤ t)`. -/
def F_S (mkt : Market Ω P) : IndexedFiltration Ω :=
  priceFiltration mkt.S (sigPrice_meas mkt.M mkt.B)

/-- The constant payoff `1 ∈ L²(ℙ)`. -/
def oneLp (P : Measure Ω) [IsProbabilityMeasure P] : Lp ℝ 2 P :=
  indicatorConstLp 2 MeasurableSet.univ (measure_ne_top P univ) (1 : ℝ)

/-- `L²(ℱ^S_T, ℙ)` as a closed subspace of `L²(ℙ)`. -/
def L2S (mkt : Market Ω P) : Submodule ℝ (Lp ℝ 2 P) :=
  lpMeas ℝ ℝ (mkt.F_S.σAlg mkt.M.T) 2 P

/-- Square-integrable stochastic integrals against `S`: `∫_0^T H_s S_s σ_s dW_s` with `H`
adapted to `ℱ^S`, lying in `L²(ℱ^S_T)`. -/
def gainsSet (mkt : Market Ω P) : Set (Lp ℝ 2 P) :=
  {X | X ∈ mkt.L2S ∧ ∃ H : ℝ → Ω → ℝ, (∀ t, Measurable[mkt.F_S.σAlg t] (H t)) ∧
    (X : Ω → ℝ) =ᵐ[P] kitItoInt mkt.B
      (fun s ω => H s ω * mkt.S s ω * sigVol mkt.M mkt.B s ω) mkt.M.T}

/-- **Definition 65.** `H0`, the closed span of the constant `1` and the gains `gainsSet`. -/
def H0 (mkt : Market Ω P) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (insert (Market.oneLp P) mkt.gainsSet)).topologicalClosure

lemma memLp_coord (mkt : Market Ω P) (I : Word (mkt.M.d + 1)) :
    MemLp (fun ω => (paperSig2 mkt.B 0 mkt.M.T ω).coeff I) 2 P :=
  MarketData.memLp_coord ⟨mkt.M, mkt.B, mkt.h3⟩ I

/-- The terminal signature coordinate `⟨e_I, Ŵ_T⟩` as an `L²(ℙ)` class: the `MemLp.toLp`
embedding when the coordinate is square-integrable, and `0` otherwise. Every `Market`
has square-integrable coordinates (`memLp_coord`), so on the markets that appear in
the compared theorems this is the genuine coordinate. -/
def coord (mkt : Market Ω P) (I : Word (mkt.M.d + 1)) : Lp ℝ 2 P :=
  haveI := Classical.dec (MemLp (fun ω => (paperSig2 mkt.B 0 mkt.M.T ω).coeff I) 2 P)
  if h : MemLp (fun ω => (paperSig2 mkt.B 0 mkt.M.T ω).coeff I) 2 P then h.toLp _ else 0

/-- The depth-`≤ N` terminal signature coordinates `{⟨e_I, Ŵ_T⟩ : |I| ≤ N}` in `L²(ℙ)`. -/
def coordSet (mkt : Market Ω P) (N : ℕ) : Set (Lp ℝ 2 P) :=
  {f | ∃ I : Word (mkt.M.d + 1), I.length ≤ N ∧ f = mkt.coord I}

/-- **Definition 55.** The completeness depth `N^*_S`: the least `N` with
`closure span {⟨e_I, Ŵ_T⟩ : |I| ≤ N} ∩ L²(ℱ^S_T) = L²(ℱ^S_T)`, and `⊤` if there is none. -/
def completenessDepth (mkt : Market Ω P) : ℕ∞ :=
  sInf {K : ℕ∞ | ∃ n : ℕ, K = (n : ℕ∞) ∧
    (Submodule.span ℝ (mkt.coordSet n)).topologicalClosure ⊓ mkt.L2S = mkt.L2S}

/-- The wrapped `MarketData` with the same model, driver and H3. -/
abbrev toMarketData (mkt : Market Ω P) : MarketData Ω P := ⟨mkt.M, mkt.B, mkt.h3⟩

lemma coord_eq (mkt : Market Ω P) (I : Word (mkt.M.d + 1)) :
    mkt.coord I = mkt.toMarketData.coord I := by
  have h := memLp_coord mkt I
  unfold coord MarketData.coord
  rw [dif_pos h]
  rfl

lemma coordSet_eq (mkt : Market Ω P) (N : ℕ) :
    mkt.coordSet N = mkt.toMarketData.coordSet N := by
  ext f
  constructor
  · rintro ⟨I, hI, rfl⟩
    exact ⟨I, hI, (coord_eq mkt I).symm ▸ rfl⟩
  · rintro ⟨I, hI, rfl⟩
    exact ⟨I, hI, (coord_eq mkt I) ▸ rfl⟩

lemma S_eq (mkt : Market Ω P) : mkt.toMarketData.S = mkt.S :=
  funext fun t => funext fun ω => mkt.toMarketData.sol.doleans_repr t ω

lemma F_S_eq (mkt : Market Ω P) : mkt.toMarketData.F_S = mkt.F_S := by
  have key : ∀ (S S' : ℝ → Ω → ℝ) (h : ∀ t, Measurable (S t)) (h' : ∀ t, Measurable (S' t)),
      S = S' → priceFiltration S h = priceFiltration S' h' := by
    rintro S _ h h' rfl; rfl
  exact key _ _ _ _ mkt.S_eq

lemma L2S_eq (mkt : Market Ω P) : mkt.toMarketData.L2S = mkt.L2S := by
  simp only [MarketData.L2S, MarketData.F_ST, L2S, F_S_eq]

lemma gainsSet_eq (mkt : Market Ω P) : mkt.toMarketData.gainsSet = mkt.gainsSet := by
  have h1 := mkt.F_S_eq
  have h2 := mkt.S_eq
  have h3 := mkt.L2S_eq
  unfold MarketData.gainsSet gainsSet
  rw [h1, h3, ← h2]
  rfl

lemma H0_eq (mkt : Market Ω P) : mkt.toMarketData.H0 = mkt.H0 := by
  simp only [MarketData.H0, H0, gainsSet_eq]
  rfl

lemma completenessDepth_eq (mkt : Market Ω P) :
    mkt.toMarketData.completenessDepth = mkt.completenessDepth := by
  simp only [MarketData.completenessDepth, MarketData.sigSpan, completenessDepth, L2S_eq]
  simp [coordSet_eq]

end Market

/-- **Paper Theorem D / Theorem 66, GKW part (unwrapped).** Every `X ∈ L²(ℱ^S_T)` splits uniquely
as `X = 𝔼X + G + ε` with `G ∈ H0`, `G ⟂ 1`, `ε ∈ L²(ℱ^S_T)`, `ε ⟂ H0` and `ε` orthogonal to all
gains, with the Pythagorean identity. -/
theorem theorem_D_unwrapped (mkt : Market Ω P) (X : Lp ℝ 2 P) (hX : X ∈ mkt.L2S) :
    ∃ G ε : Lp ℝ 2 P,
      G ∈ mkt.H0 ∧ ⟪G, Market.oneLp P⟫ = 0 ∧ ε ∈ mkt.L2S ∧ ε ∈ mkt.H0ᗮ ∧
      (∀ Z ∈ mkt.gainsSet, ⟪ε, Z⟫ = 0) ∧
      X = (∫ ω, X ω ∂P) • Market.oneLp P + G + ε ∧
      ‖X‖ ^ 2 = ‖(∫ ω, X ω ∂P) • Market.oneLp P + G‖ ^ 2 + ‖ε‖ ^ 2 ∧
      ∀ (c : ℝ) (G' ε' : Lp ℝ 2 P), G' ∈ mkt.H0 → ⟪G', Market.oneLp P⟫ = 0 →
        ε' ∈ mkt.H0ᗮ → X = c • Market.oneLp P + G' + ε' →
          c = ∫ ω, X ω ∂P ∧ G' = G ∧ ε' = ε := by
  rw [← mkt.L2S_eq] at hX
  have h := theorem_D mkt.toMarketData X hX
  rwa [mkt.H0_eq, mkt.L2S_eq, mkt.gainsSet_eq] at h

section BlackScholes

variable (T s₀ σ₀ : ℝ) (hT : 0 < T) (hs₀ : 0 < s₀) (hσ₀ : σ₀ ≠ 0)

lemma sigVol_blackScholes (B : MultiBrownian Ω P 1) (t : ℝ) (ω : Ω) :
    sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B t ω = σ₀ := by
  unfold sigVol blackScholesModel
  have h := dualPairing_smul_basisWord_nil σ₀ (paperSig2 B 0 t ω)
  have h1 : (paperSig2 B 0 t ω).coeff [] = 1 := paperSig2_empty B 0 t ω
  rw [h1, mul_one] at h
  exact h

lemma hypH3_blackScholes (B : MultiBrownian Ω P 1) :
    HypH3 P T (sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B) := by
  intro _ _
  have hσ : sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B = fun _ _ => σ₀ :=
    funext fun t => funext fun ω => sigVol_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B t ω
  simp only [hσ]
  exact integrable_const _

/-- The Black–Scholes market (constant volatility `σ₀`) on a one-dimensional Brownian driver. -/
def bsMarket (B : MultiBrownian Ω P 1) : Market Ω P :=
  ⟨blackScholesModel T s₀ σ₀ hT hs₀ hσ₀, B, hypH3_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B⟩

/-- **Theorem D residual hypothesis fails (unwrapped).** For Black–Scholes, `N^*_S = ∞`. -/
theorem theorem_D_residual_hypothesis_fails_unwrapped (B : MultiBrownian Ω P 1) :
    ¬ (bsMarket T s₀ σ₀ hT hs₀ hσ₀ B).completenessDepth < ⊤ := by
  rw [← Market.completenessDepth_eq]
  exact theorem_D_residual_hypothesis_fails T s₀ σ₀ hT hs₀ hσ₀ B

end BlackScholes

section Completeness

open scoped NNReal

variable (T s₀ σ₀ : ℝ) (hT : 0 < T) (hs₀ : 0 < s₀) (hσ₀ : σ₀ ≠ 0)

/-- Elementary Brownian gains on `[0, T]`: the finite sums `∑_{p ∈ V} h_p (W_{p.2} - W_{p.1})`
over time intervals `p.1 ≤ p.2 ≤ T`, where each `h_p` is bounded and measurable for
`σ(W_u : u ≤ p.1)`. -/
def elemGains (B : MultiBrownian Ω P 1) : Set (Lp ℝ 2 P) :=
  {G | ∃ (V : Finset (ℝ≥0 × ℝ≥0)) (h : ℝ≥0 × ℝ≥0 → Ω → ℝ),
    (∀ p ∈ V, p.1 ≤ p.2 ∧ (p.2 : ℝ) ≤ T ∧
      Measurable[⨆ u ≤ p.1, MeasurableSpace.comap (fun ω => B.Wnn u ω 0) inferInstance] (h p) ∧
      ∃ C : ℝ, ∀ ω, |h p ω| ≤ C) ∧
    (G : Ω → ℝ) =ᵐ[P] fun ω => ∑ p ∈ V, h p ω * (B.Wnn p.2 ω 0 - B.Wnn p.1 ω 0)}

/-- **Completeness with finitely many calls** (Theorem C, left-hand side; unwrapped), for the
Black–Scholes market: every claim `X ∈ L²(ℱ^S_T)` is a.s. equal to a cash position `c`, static
call positions `a k` at the strikes, and dynamic gains `G` in the `L²(ℙ)`-closed span of the
elementary Brownian gains on `[0, T]` (the space of Itô integrals `∫_0^T φ dW`). -/
def IsCompleteWithCallsUnwrapped (B : MultiBrownian Ω P 1) (strikes : Finset ℝ) : Prop :=
  ∀ X : Lp ℝ 2 P, X ∈ (bsMarket T s₀ σ₀ hT hs₀ hσ₀ B).L2S →
    ∃ (c : ℝ) (a : ℝ → ℝ), ∃ G ∈ (Submodule.span ℝ (elemGains T B)).topologicalClosure,
      (X : Ω → ℝ) =ᵐ[P] fun ω => c +
        ∑ k ∈ strikes, a k * max ((bsMarket T s₀ σ₀ hT hs₀ hσ₀ B).S T ω - k) 0 + G ω

/-- Every MathFin Itô integral on `[0, T]` lies in the closed span of the elementary gains. -/
lemma itoIntegralCLM_mem_closure_elemGains (hT0 : 0 < T) (B : MultiBrownian Ω P 1)
    (φ : Lp ℝ 2 (MathFin.ItoIntegralCLM.trimMeasure (μ := P) (Real.toNNReal T)
      (bsDriver_meas B))) :
    MathFin.ItoIntegralCLM.itoIntegralCLM (bsDriver_isPreBrownian B) (Real.toNNReal T)
      (bsDriver_meas B) φ ∈ (Submodule.span ℝ (elemGains T B)).topologicalClosure := by
  set E := (Submodule.span ℝ (elemGains T B)).topologicalClosure
  have hE : IsClosed (E : Set (Lp ℝ 2 P)) := Submodule.isClosed_topologicalClosure _
  set f := MathFin.ItoIntegralCLM.itoIntegralCLM (bsDriver_isPreBrownian B) (Real.toNNReal T)
    (bsDriver_meas B)
  refine (MathFin.ItoIntegralCLM.simpleAssemblyHorizon_denseRange (μ := P) (Real.toNNReal T)
    (bsDriver_meas B)).induction_on (p := fun φ => f φ ∈ E) φ
    (hE.preimage (ContinuousLinearMap.continuous _)) fun V => ?_
  rw [MathFin.ItoIntegralCLM.itoIntegralCLM_simpleAssemblyHorizon]
  refine Submodule.le_topologicalClosure _ (Submodule.subset_span ?_)
  refine ⟨V.val.value.support, V.val.value,
    fun p hp => ⟨V.val.le_of_mem_support_value p hp, ?_, ?_, ?_⟩, ?_⟩
  · have h := NNReal.coe_le_coe.mpr (V.prop p hp)
    rwa [Real.coe_toNNReal _ hT0.le] at h
  · exact V.val.measurable_value' p hp
  · obtain ⟨C, hC⟩ := V.val.bounded_value
    exact ⟨C, fun ω => by simpa [Real.norm_eq_abs] using hC p hp ω⟩
  · filter_upwards [MemLp.coeFn_toLp (MathFin.ItoIntegralL2.memLp_itoSimple
      (bsDriver_isPreBrownian B) (bsDriver_meas B) V.val)] with ω hω
    rw [MathFin.ItoIntegralL2.itoSimpleLp, hω, MathFin.ItoIntegralL2.itoSimple_apply,
      Finsupp.sum]
    rfl

/-- Black–Scholes is complete with calls in the unwrapped sense, for every finite strike set. -/
theorem bsMarket_isCompleteWithCallsUnwrapped (B : MultiBrownian Ω P 1) (strikes : Finset ℝ) :
    IsCompleteWithCallsUnwrapped T s₀ σ₀ hT hs₀ hσ₀ B strikes := by
  intro X hX
  rw [← Market.L2S_eq] at hX
  obtain ⟨c, a, φ, h⟩ := blackScholes_isCompleteWithCalls T s₀ σ₀ hT hs₀ hσ₀ B strikes X hX
  refine ⟨c, a, _, itoIntegralCLM_mem_closure_elemGains T hT B φ, h.trans ?_⟩
  rw [← (bsMarket T s₀ σ₀ hT hs₀ hσ₀ B).S_eq]
  rfl

/-- **Refutation of Theorem C (unwrapped).** For the Black–Scholes market and any finite set of
call strikes, "complete with calls ⇔ `N^*_S < ∞`" is false: the market is complete but
`N^*_S = ∞`. -/
theorem not_theorem_C_unwrapped (B : MultiBrownian Ω P 1) (strikes : Finset ℝ) :
    ¬ (IsCompleteWithCallsUnwrapped T s₀ σ₀ hT hs₀ hσ₀ B strikes ↔
      (bsMarket T s₀ σ₀ hT hs₀ hσ₀ B).completenessDepth < ⊤) := fun h =>
  theorem_D_residual_hypothesis_fails_unwrapped T s₀ σ₀ hT hs₀ hσ₀ B
    (h.mp (bsMarket_isCompleteWithCallsUnwrapped T s₀ σ₀ hT hs₀ hσ₀ B strikes))

lemma bmCoord_eq_Wnn_toNNReal (B : MultiBrownian Ω P 1) {t : ℝ} (ht : 0 ≤ t) (ω : Ω) :
    bmCoord B t ω = B.Wnn (Real.toNNReal t) ω (kitDriver (Nat.succ_pos 0)) := by
  rw [bmCoord_eq_wnn B ht, Real.toNNReal_of_nonneg ht]
  rfl

lemma kitItoInt_sigVol_blackScholes (B : MultiBrownian Ω P 1) {t : ℝ} (ht : 0 ≤ t)
    (ω : Ω) :
    kitItoInt B (sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B) t ω =
      σ₀ * bmCoord B t ω := by
  have hσ : sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B = fun _ _ => σ₀ :=
    funext fun _ => funext fun _ => sigVol_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B _ _
  rw [hσ, kitItoInt_const B (Nat.succ_pos 0) σ₀ ht ω, bmCoord_eq_Wnn_toNNReal B ht ω]

lemma kitQuadVar_sigVol_blackScholes (B : MultiBrownian Ω P 1) {t : ℝ} (ht : 0 ≤ t)
    (ω : Ω) :
    kitQuadVar B (sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B) t ω =
      σ₀ ^ 2 * t := by
  have hσ : sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B = fun _ _ => σ₀ :=
    funext fun _ => funext fun _ => sigVol_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B _ _
  rw [hσ, kitQuadVar_const B (Nat.succ_pos 0) σ₀ ht ω]

lemma bsPrice_eq_sigPrice (B : MultiBrownian Ω P 1) {t : ℝ} (ht : 0 ≤ t) (ω : Ω) :
    sigPrice (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B t ω = bsPrice s₀ σ₀ B t ω := by
  have hexp :
      kitItoInt B (sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B) t ω -
          (1 / 2 : ℝ) * kitQuadVar B (sigVol (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B) t ω =
        σ₀ * bmCoord B t ω - (1 / 2 : ℝ) * σ₀ ^ 2 * t := by
    have hI := kitItoInt_sigVol_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B ht ω
    have hQ := kitQuadVar_sigVol_blackScholes T s₀ σ₀ hT hs₀ hσ₀ B ht ω
    rw [hI, hQ, mul_assoc]
  have hs0 : (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀).s₀ = s₀ := rfl
  simp only [sigPrice, bsPrice, hs0, max_eq_right ht]
  exact congrArg (fun z => s₀ * Real.exp z) hexp

lemma sAdmissible_congr_S {σAlg : ℝ → MeasurableSpace Ω}
    {S S' σ : ℝ → Ω → ℝ} {T : ℝ} {H : ℝ → Ω → ℝ}
    (hS : ∀ t ∈ Icc 0 T, S t = S' t) :
    SAdmissible σAlg P S σ T H ↔ SAdmissible σAlg P S' σ T H := by
  constructor <;> intro h
  · refine ⟨h.1, ?_⟩
    filter_upwards [h.2] with ω hInt
    have hEq : Set.EqOn (fun s => (H s ω * S s ω * σ s ω) ^ 2)
        (fun s => (H s ω * S' s ω * σ s ω) ^ 2) (Icc 0 T) := by
      intro s hs; simp [hS s hs]
    exact (integrableOn_congr_fun hEq measurableSet_Icc).mp hInt
  · refine ⟨h.1, ?_⟩
    filter_upwards [h.2] with ω hInt
    have hEq : Set.EqOn (fun s => (H s ω * S' s ω * σ s ω) ^ 2)
        (fun s => (H s ω * S s ω * σ s ω) ^ 2) (Icc 0 T) := by
      intro s hs; simp [hS s hs]
    exact (integrableOn_congr_fun hEq measurableSet_Icc).mp hInt

lemma itoRiemannSum_congr {K K' B : ℝ → Ω → ℝ} {t : ℝ} (ht0 : 0 ≤ t)
    (hK : ∀ u ∈ Icc 0 t, K u = K' u) (n : ℕ) (ω : Ω) :
    itoRiemannSum K B t n ω = itoRiemannSum K' B t n ω := by
  unfold itoRiemannSum
  refine Finset.sum_congr rfl fun k _ => ?_
  have hk0 : (0 : ℝ) ≤ (k : ℝ) * t / (n + 1 : ℝ) :=
    div_nonneg (mul_nonneg (Nat.cast_nonneg _) ht0) (by positivity)
  have hkT : (k : ℝ) * t / (n + 1 : ℝ) ≤ t := by
    have hk : (k : ℝ) ≤ (n + 1 : ℝ) := by
      exact_mod_cast (le_of_lt k.isLt)
    have : (k : ℝ) * t ≤ t * (n + 1 : ℝ) := by
      rw [mul_comm t]; exact mul_le_mul_of_nonneg_right hk ht0
    exact (div_le_iff₀ (by positivity : 0 < (n + 1 : ℝ))).mpr this
  rw [hK _ ⟨hk0, hkT⟩]

lemma isItoIntegral_congr_K {B K K' V : ℝ → Ω → ℝ} {T : ℝ}
    (hK : ∀ u ∈ Icc 0 T, K u = K' u) :
    IsItoIntegral P B K V T ↔ IsItoIntegral P B K' V T := by
  have hsum : ∀ t ∈ Icc 0 T, ∀ n ω,
      itoRiemannSum K B t n ω = itoRiemannSum K' B t n ω :=
    fun t ht n ω => itoRiemannSum_congr ht.1 (fun u hu => hK u ⟨hu.1, hu.2.trans ht.2⟩) n ω
  constructor <;> intro h
  · refine ⟨h.1, h.2.1, fun t ht => ?_⟩
    have heq : (fun n => itoRiemannSum K' B t n) = fun n => itoRiemannSum K B t n :=
      funext fun n => funext fun ω => (hsum t ht n ω).symm
    simpa [heq] using h.2.2 t ht
  · refine ⟨h.1, h.2.1, fun t ht => ?_⟩
    have heq : (fun n => itoRiemannSum K B t n) = fun n => itoRiemannSum K' B t n :=
      funext fun n => funext fun ω => hsum t ht n ω
    simpa [heq] using h.2.2 t ht

lemma literalGains_congr_S {σAlg : ℝ → MeasurableSpace Ω} {B S S' σ : ℝ → Ω → ℝ} {T : ℝ}
    (hS : ∀ t ∈ Icc 0 T, S t = S' t) :
    LiteralGains σAlg P B S σ T = LiteralGains σAlg P B S' σ T := by
  ext G; constructor
  · rintro ⟨H, V, hadm, hIto, rfl⟩
    refine ⟨H, V, (sAdmissible_congr_S hS).mp hadm, ?_, rfl⟩
    exact (isItoIntegral_congr_K (fun t ht => by simp [hS t ht])).mp hIto
  · rintro ⟨H, V, hadm, hIto, rfl⟩
    refine ⟨H, V, (sAdmissible_congr_S hS).mpr hadm, ?_, rfl⟩
    exact (isItoIntegral_congr_K (fun t ht => by simp [hS t ht])).mpr hIto

lemma terminalBoundedBelowGains_congr_S {σAlg : ℝ → MeasurableSpace Ω}
    {B S S' σ : ℝ → Ω → ℝ} {T : ℝ}
    (hS : ∀ t ∈ Icc 0 T, S t = S' t) :
    TerminalBoundedBelowGains σAlg P B S σ T =
      TerminalBoundedBelowGains σAlg P B S' σ T := by
  ext G; constructor
  · rintro ⟨H, V, a, hadm, hterm, hIto, rfl⟩
    refine ⟨H, V, a, (sAdmissible_congr_S hS).mp hadm, hterm, ?_, rfl⟩
    exact (isItoIntegral_congr_K (fun t ht => by simp [hS t ht])).mp hIto
  · rintro ⟨H, V, a, hadm, hterm, hIto, rfl⟩
    refine ⟨H, V, a, (sAdmissible_congr_S hS).mpr hadm, hterm, ?_, rfl⟩
    exact (isItoIntegral_congr_K (fun t ht => by simp [hS t ht])).mpr hIto

/-- Literal NFLVR fails in the unwrapped Black–Scholes market: the doubling strategy
transferred by `H = K/(S σ₀)` is admissible and ends at `V_T = 1` a.s. -/
theorem not_literal_nflvr_unwrapped (B : MultiBrownian Ω P 1) :
    ¬ SatisfiesNFLVR_DS P
        (LiteralGains (pathFiltration B).σAlg P (bmCoord B)
          (sigPrice (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B)
          (fun _ _ => σ₀) T) := by
  have hS : ∀ t ∈ Icc 0 T, sigPrice (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B t =
      bsPrice s₀ σ₀ B t := fun t ht => funext fun ω =>
    bsPrice_eq_sigPrice T s₀ σ₀ hT hs₀ hσ₀ B ht.1 ω
  rw [literalGains_congr_S hS]
  exact not_literal_nflvr hT hs₀ hσ₀ B

/-- Terminal-only bounded-below NFLVR also fails in the unwrapped Black–Scholes market. -/
theorem not_terminal_bdd_nflvr_unwrapped (B : MultiBrownian Ω P 1) :
    ¬ SatisfiesNFLVR_DS P
        (TerminalBoundedBelowGains (pathFiltration B).σAlg P (bmCoord B)
          (sigPrice (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B)
          (fun _ _ => σ₀) T) := by
  have hS : ∀ t ∈ Icc 0 T, sigPrice (blackScholesModel T s₀ σ₀ hT hs₀ hσ₀) B t =
      bsPrice s₀ σ₀ B t := fun t ht => funext fun ω =>
    bsPrice_eq_sigPrice T s₀ σ₀ hT hs₀ hσ₀ B ht.1 ω
  rw [terminalBoundedBelowGains_congr_S hS]
  exact not_terminal_bdd_nflvr hT hs₀ hσ₀ B

end Completeness

end SignatureVolatility
