module

public import SignatureVolatility.ItoCalculusKit.BrownianQuadVarAS
public import SignatureVolatility.ItoCalculusKit.ConstVol
public import SignatureVolatility.ItoCalculusKit.JointPast


@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped NNReal

noncomputable section

namespace SignatureVolatility

/-!
# Geometric Brownian motion is a martingale in the joint path filtration

`gbm B k c t = exp (c W^k_t - c² t / 2)` is integrable and satisfies
`𝔼[gbm_t | 𝓕_s] = gbm_s` for `0 ≤ s ≤ t`, where `𝓕` is the path filtration generated by all
driver coordinates (`condExp_gbm`). Ingredients: the increment `W^k_t - W^k_s` is independent of
`𝓕_s` (`indep_wnnIncr_pathFiltration`) and Gaussian with variance `t - s`.
-/

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {d : ℕ}

/-- Geometric Brownian motion `exp (c W^k_t - c² t / 2)` driven by coordinate `k`. -/
def gbm (B : MultiBrownian Ω P d) (k : Fin d) (c t : ℝ) (ω : Ω) : ℝ :=
  Real.exp (c * B.Wnn (Real.toNNReal t) ω k - c ^ 2 / 2 * t)

lemma measurable_gbm (B : MultiBrownian Ω P d) (k : Fin d) (c t : ℝ) :
    Measurable (gbm B k c t) :=
  Real.measurable_exp.comp (((B.Wnn_meas _ k).const_mul c).sub measurable_const)

lemma gbm_pos (B : MultiBrownian Ω P d) (k : Fin d) (c t : ℝ) (ω : Ω) : 0 < gbm B k c t ω :=
  Real.exp_pos _

lemma measurable_gbm_pathFiltration (B : MultiBrownian Ω P d) (k : Fin d) (c : ℝ) {s : ℝ}
    (hs : 0 ≤ s) : Measurable[(pathFiltration B).σAlg s] (gbm B k c s) := by
  have hW : Measurable[(pathFiltration B).σAlg s] (fun ω => B.Wnn (Real.toNNReal s) ω k) :=
    measurable_W_pathFiltration B (T := s) ⟨s, hs, le_rfl⟩ k
  exact Real.measurable_exp.comp ((hW.const_mul c).sub measurable_const)

lemma integrable_gbm (B : MultiBrownian Ω P d) (k : Fin d) (c t : ℝ) :
    Integrable (gbm B k c t) P := by
  have h := (integrable_exp_mul_Wnn B k c (Real.toNNReal t)).mul_const (Real.exp (-(c ^ 2 / 2 * t)))
  refine h.congr (ae_of_all _ fun ω => ?_)
  simp only [gbm, sub_eq_add_neg, Real.exp_add]

/-- Exponential of the normalised increment over `[s, t]`. -/
private def gbmIncr (B : MultiBrownian Ω P d) (k : Fin d) (c s t : ℝ) (ω : Ω) : ℝ :=
  Real.exp (c * wnnIncr B k s t ω - c ^ 2 / 2 * (t - s))

private lemma integral_gbmIncr (B : MultiBrownian Ω P d) (k : Fin d) (c : ℝ) {s t : ℝ}
    (hs : 0 ≤ s) (hst : s ≤ t) : ∫ ω, gbmIncr B k c s t ω ∂P = 1 := by
  have hlaw := hasLaw_wnnIncr B k hs hst
  have hm := mgf_gaussianReal hlaw c
  simp only [mgf] at hm
  have hv : ((Real.toNNReal (t - s) : ℝ≥0) : ℝ) = t - s := Real.coe_toNNReal _ (by linarith)
  simp only [gbmIncr, sub_eq_add_neg, Real.exp_add]
  rw [integral_mul_const, hm, hv, ← Real.exp_add]
  simp only [zero_mul, zero_add, Real.exp_eq_one_iff]
  ring

private lemma integrable_gbmIncr (B : MultiBrownian Ω P d) (k : Fin d) (c : ℝ) {s t : ℝ}
    (hs : 0 ≤ s) (hst : s ≤ t) : Integrable (gbmIncr B k c s t) P := by
  have h := ((hasLaw_wnnIncr B k hs hst).integrable_comp
    (integrable_exp_mul_gaussianReal c)).mul_const (Real.exp (-(c ^ 2 / 2 * (t - s))))
  refine h.congr (ae_of_all _ fun ω => ?_)
  simp only [gbmIncr, Function.comp_apply, sub_eq_add_neg, Real.exp_add]

private lemma gbm_eq_mul (B : MultiBrownian Ω P d) (k : Fin d) (c s t : ℝ) :
    gbm B k c t = gbm B k c s * gbmIncr B k c s t := by
  funext ω
  simp only [Pi.mul_apply, gbm, gbmIncr, wnnIncr, ← Real.exp_add]
  congr 1
  ring

/-- **Geometric Brownian motion is a martingale** in the joint path filtration. -/
theorem condExp_gbm (B : MultiBrownian Ω P d) (k : Fin d) (c : ℝ) {s t : ℝ} (hs : 0 ≤ s)
    (hst : s ≤ t) :
    P[gbm B k c t | (pathFiltration B).σAlg s] =ᵐ[P] gbm B k c s := by
  have hle := (pathFiltration B).le_ambient s
  have hsm : StronglyMeasurable[(pathFiltration B).σAlg s] (gbm B k c s) :=
    (measurable_gbm_pathFiltration B k c hs).stronglyMeasurable
  have hI := integrable_gbmIncr B k c hs hst
  rw [gbm_eq_mul B k c s t]
  have h1 := condExp_mul_of_stronglyMeasurable_left hsm
    (by rw [← gbm_eq_mul B k c s t]; exact integrable_gbm B k c t) hI
  have hcomap : StronglyMeasurable[MeasurableSpace.comap (fun ω => wnnIncr B k s t ω)
      inferInstance] (gbmIncr B k c s t) := by
    have hm : Measurable[MeasurableSpace.comap (fun ω => wnnIncr B k s t ω) inferInstance]
        (fun ω => wnnIncr B k s t ω) := comap_measurable _
    exact (Real.measurable_exp.comp ((hm.const_mul c).sub measurable_const)).stronglyMeasurable
  have h2 := condExp_indep_eq ((measurable_wnnIncr B k s t).comap_le) hle hcomap
    (indep_wnnIncr_pathFiltration B k hst)
  rw [integral_gbmIncr B k c hs hst] at h2
  filter_upwards [h1, h2] with ω h1ω h2ω
  rw [h1ω, Pi.mul_apply, h2ω, mul_one]

end SignatureVolatility
