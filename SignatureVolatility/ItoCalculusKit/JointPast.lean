module

public import SignatureVolatility.ProlongedBrownianSetup.Sig2StratAdapted


@[expose] public section

open MeasureTheory ProbabilityTheory MeasurableSpace
open scoped NNReal

namespace SignatureVolatility

/-!
# Driver increments are independent of the joint past

For a `MultiBrownian` driver the increment `W^k_u - W^k_s` of **one** coordinate is independent of
the **joint** path filtration `𝓕_s = σ(W^i_r : r ≤ s, i < d)` of **all** coordinates
(`indep_wnnIncr_pathFiltration`). This is where the process-level independence
`MultiBrownian.coordsIndep` is used: the weak Markov property of the coordinate `k` handles its
own past, and independence of the coordinate *processes* handles the other coordinates' pasts
(fixed-time independence of the coordinates would not suffice).

Consequently every `𝓕_s`-measurable random variable — e.g. a signature volatility
`σ_s = ⟨ℓ, Ŵ_s⟩` depending on all coordinates — is independent of the driver increment
(`indepFun_pathFiltration_wnnIncr`): the integrand of the kit Itô–Riemann sums is non-anticipating.
-/

/-- If `m₁ ⟂ m₂` and `(m₁ ⊔ m₂) ⟂ m₃`, then `m₁ ⟂ (m₂ ⊔ m₃)`. -/
theorem indep_sup_of_indep_of_indep_sup {Ω : Type*} {m₁ m₂ m₃ m0 : MeasurableSpace Ω}
    {μ : Measure[m0] Ω} [IsZeroOrProbabilityMeasure μ] (h1 : m₁ ≤ m0) (h2 : m₂ ≤ m0)
    (h3 : m₃ ≤ m0) (h12 : Indep m₁ m₂ μ) (h123 : Indep (m₁ ⊔ m₂) m₃ μ) :
    Indep m₁ (m₂ ⊔ m₃) μ := by
  set p : Set (Set Ω) :=
    {t | ∃ t₂ t₃, MeasurableSet[m₂] t₂ ∧ MeasurableSet[m₃] t₃ ∧ t = t₂ ∩ t₃} with hp
  have hpi : IsPiSystem p := by
    rintro _ ⟨a₂, a₃, ha₂, ha₃, rfl⟩ _ ⟨b₂, b₃, hb₂, hb₃, rfl⟩ _
    exact ⟨a₂ ∩ b₂, a₃ ∩ b₃, ha₂.inter hb₂, ha₃.inter hb₃, by
      ext x; simp only [Set.mem_inter_iff]; tauto⟩
  have hgen : m₂ ⊔ m₃ = generateFrom p := by
    refine le_antisymm (sup_le ?_ ?_) (generateFrom_le ?_)
    · intro t ht
      exact measurableSet_generateFrom ⟨t, Set.univ, ht, MeasurableSet.univ, by simp⟩
    · intro t ht
      exact measurableSet_generateFrom ⟨Set.univ, t, MeasurableSet.univ, ht, by simp⟩
    · rintro _ ⟨t₂, t₃, ht₂, ht₃, rfl⟩
      exact MeasurableSet.inter (le_sup_left (a := m₂) (b := m₃) _ ht₂)
        (le_sup_right (a := m₂) (b := m₃) _ ht₃)
  refine IndepSets.indep (p1 := {t | MeasurableSet[m₁] t}) h1 (sup_le h2 h3)
    (@isPiSystem_measurableSet Ω m₁) hpi (@generateFrom_measurableSet Ω m₁).symm hgen ?_
  rw [IndepSets_iff]
  rintro A _ hA ⟨t₂, t₃, ht₂, ht₃, rfl⟩
  have hA' : MeasurableSet[m₁] A := hA
  have hAB : MeasurableSet[m₁ ⊔ m₂] (A ∩ t₂) :=
    MeasurableSet.inter (le_sup_left (a := m₁) (b := m₂) _ hA')
      (le_sup_right (a := m₁) (b := m₂) _ ht₂)
  have hB : MeasurableSet[m₁ ⊔ m₂] t₂ := le_sup_right (a := m₁) (b := m₂) _ ht₂
  have e1 : μ (A ∩ t₂ ∩ t₃) = μ (A ∩ t₂) * μ t₃ := (Indep_iff _ _ _).mp h123 _ _ hAB ht₃
  have e2 : μ (A ∩ t₂) = μ A * μ t₂ := (Indep_iff _ _ _).mp h12 _ _ hA' ht₂
  have e3 : μ (t₂ ∩ t₃) = μ t₂ * μ t₃ := (Indep_iff _ _ _).mp h123 _ _ hB ht₃
  rw [← Set.inter_assoc, e1, e2, e3, mul_assoc]

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {d : ℕ}

/-- **Independence of a driver increment from the joint past.** For `s ≤ u`, the increment
`W^k_u - W^k_s` is independent of the path filtration `𝓕_s` generated by all coordinates. -/
theorem indep_wnnIncr_pathFiltration (B : MultiBrownian Ω P d) (k : Fin d) {s u : ℝ}
    (hsu : s ≤ u) :
    Indep (MeasurableSpace.comap (fun ω => wnnIncr B k s u ω) inferInstance)
      ((pathFiltration B).σAlg s) P := by
  classical
  -- σ-algebras of the coordinate paths
  set path : Fin d → Ω → (ℝ≥0 → ℝ) := fun i ω t => B.Wnn t ω i with hpath
  have hpath_meas : ∀ i, Measurable (path i) := fun i =>
    measurable_pi_iff.mpr fun t => B.Wnn_meas t i
  set Pm : Fin d → MeasurableSpace Ω := fun i => MeasurableSpace.comap (path i) inferInstance
    with hPm
  have hPmle : ∀ i, Pm i ≤ ‹MeasurableSpace Ω› := fun i => (hpath_meas i).comap_le
  have hI : iIndep Pm P := (iIndepFun_iff_iIndep _ _ _).mp B.coordsIndep
  -- future increments and own past of coordinate `k`
  set s' : ℝ≥0 := Real.toNNReal s with hs'
  set fut : Ω → (ℝ≥0 → ℝ) := fun ω t => B.Wnn (s' + t) ω k - B.Wnn s' ω k with hfut
  set own : Ω → (Set.Iic s' → ℝ) := fun ω t => B.Wnn t ω k with hown
  have hwm : Indep (MeasurableSpace.comap fut inferInstance)
      (MeasurableSpace.comap own inferInstance) P :=
    (IndepFun_iff_Indep _ _ _).mp ((B.isBrownian k).toIsPreBrownianReal.indepFun_shift s')
  have hfut_le : MeasurableSpace.comap fut inferInstance ≤ Pm k := by
    have h : Measurable[Pm k] fut := by
      have hΦ : Measurable fun (p : ℝ≥0 → ℝ) (t : ℝ≥0) => p (s' + t) - p s' :=
        measurable_pi_iff.mpr fun t => (measurable_pi_apply _).sub (measurable_pi_apply _)
      exact hΦ.comp (comap_measurable (path k))
    exact h.comap_le
  have hown_le : MeasurableSpace.comap own inferInstance ≤ Pm k := by
    have h : Measurable[Pm k] own := by
      have hΨ : Measurable fun (p : ℝ≥0 → ℝ) (t : Set.Iic s') => p t :=
        measurable_pi_iff.mpr fun t => measurable_pi_apply _
      exact hΨ.comp (comap_measurable (path k))
    exact h.comap_le
  -- the other coordinates
  have hrest_le := iSup₂_le (f := fun i (_ : i ∈ ({k}ᶜ : Set (Fin d))) => Pm i)
    fun i _ => hPmle i
  have hkrest : Indep (Pm k) (⨆ i ∈ ({k}ᶜ : Set (Fin d)), Pm i) P := by
    have h := indep_iSup_of_disjoint hPmle hI (S := {k}) (T := ({k}ᶜ : Set (Fin d)))
      (Set.disjoint_compl_right_iff_subset.mpr subset_rfl)
    rw [iSup_singleton] at h
    exact h
  have h123 : Indep (MeasurableSpace.comap fut inferInstance ⊔
      MeasurableSpace.comap own inferInstance) (⨆ i ∈ ({k}ᶜ : Set (Fin d)), Pm i) P :=
    indep_of_indep_of_le_left hkrest (sup_le hfut_le hown_le)
  have hmain := indep_sup_of_indep_of_indep_sup (hfut_le.trans (hPmle k))
    (hown_le.trans (hPmle k)) hrest_le hwm h123
  -- the increment is a function of the future increments; `𝓕_s` sits inside own past ⊔ rest
  refine indep_of_indep_of_le hmain ?_ ?_
  · have h : Measurable[MeasurableSpace.comap fut inferInstance]
        (fun ω => wnnIncr B k s u ω) := by
      have he : (fun ω => wnnIncr B k s u ω) =
          fun ω => fut ω (Real.toNNReal u - s') := by
        funext ω
        simp only [wnnIncr, hfut]
        rw [add_tsub_cancel_of_le (Real.toNNReal_le_toNNReal hsu)]
      rw [he]
      exact (measurable_pi_apply _).comp (comap_measurable fut)
    exact h.comap_le
  · refine iSup_le fun r => iSup_le fun i => ?_
    by_cases hik : i = k
    · subst hik
      refine le_sup_of_le_left ?_
      have h : Measurable[MeasurableSpace.comap own inferInstance]
          (fun ω => MultiBrownian.W B r.1 ω i) := by
        have hr : Real.toNNReal r.1 ∈ Set.Iic s' := Real.toNNReal_le_toNNReal r.2.2
        have h2 : Measurable[MeasurableSpace.comap own inferInstance]
            (fun ω => own ω ⟨Real.toNNReal r.1, hr⟩) :=
          (measurable_pi_apply (⟨Real.toNNReal r.1, hr⟩ : Set.Iic s')).comp
            (comap_measurable own)
        exact h2
      exact h.comap_le
    · refine le_sup_of_le_right (le_iSup₂_of_le i hik ?_)
      have h : Measurable[Pm i] (fun ω => MultiBrownian.W B r.1 ω i) := by
        have h2 : Measurable[Pm i] (fun ω => path i ω (Real.toNNReal r.1)) :=
          (measurable_pi_apply (Real.toNNReal r.1)).comp (comap_measurable (path i))
        exact h2
      exact h.comap_le

/-- Any `𝓕_s`-measurable random variable is independent of the driver increment over `[s, u]`
(non-anticipation of adapted integrands, in the joint filtration). -/
theorem indepFun_pathFiltration_wnnIncr (B : MultiBrownian Ω P d) (k : Fin d) {s u : ℝ}
    (hsu : s ≤ u) {β : Type*} [MeasurableSpace β] {g : Ω → β}
    (hg : Measurable[(pathFiltration B).σAlg s] g) :
    IndepFun g (fun ω => wnnIncr B k s u ω) P := by
  rw [IndepFun_iff_Indep]
  exact (indep_of_indep_of_le_right (indep_wnnIncr_pathFiltration B k hsu) hg.comap_le).symm

end SignatureVolatility
